---
// 书籍模块巡检与结构校验开发工具 · 服务端表现层组件（仅 dev 渲染）
// -----------------------------------------------------------------------------
// 目的：在开发期为图书清洗校对提供全书模块索引速查、同章序号冲突、跨章同名聚合、
// 异常拆分审查与一键跳转定位能力，辅助图书开发者高效纠偏。
// 挂载：由 FooterOverride.astro 引入，开发时渲染，生产构建零输出。
// -----------------------------------------------------------------------------
import { features } from '../../../config/features.config.mjs';
import M3Loading from '../../../components/common/M3Loading.astro';
const isDev = import.meta.env.DEV;
import '../styles/module-inspector.css';
---

{
  features.inspector.enabled && (
    <div id="dsh-inspector-root" class="insp-root" data-is-dev={isDev ? 'true' : 'false'} aria-label="书籍模块索引与巡检速查工具">
      <div class="insp-backdrop"></div>
      <aside class="insp-panel" role="dialog" aria-label="模块巡检抽屉面板">
        <!-- 头部 -->
        <header class="insp-header">
          <div class="insp-header-left">
            <div class="insp-header-title-box">
              <div class="insp-header-kicker-row">
                <span class="insp-header-kicker">模块索引</span>
                {isDev && <span class="insp-header-dev-tag" title="开发环境巡检模式">DEV</span>}
              </div>
              <h2 class="insp-header-title">书籍模块索引</h2>
              <div class="insp-book-select-wrap">
                <select class="insp-book-select" title="切换当前索引图书"></select>
              </div>
            </div>
          </div>
          <div class="insp-header-actions">
            <button type="button" class="insp-icon-btn insp-refresh-btn" title="重新扫描全书数据 (刷新)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a9 9 0 1 1-.57-8.38l6.73-6.19" />
              </svg>
            </button>
            <button type="button" class="insp-icon-btn insp-close" title="关闭 (Esc)" aria-label="关闭">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
        </header>

        <!-- 工具栏：检索与章节筛选 -->
        <div class="insp-toolbar">
          <div class="insp-search-box">
            <svg class="insp-search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5" />
              <path d="M12.5 12.5L17 17" />
            </svg>
            <input type="text" class="insp-search-input" placeholder="搜索模块、定义、例题、定理..." autocomplete="off" />
            <button type="button" class="insp-search-clear" title="清空检索" aria-label="清空检索">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="12" y1="4" x2="4" y2="12" />
                <line x1="4" y1="4" x2="12" y2="12" />
              </svg>
            </button>
          </div>
          <div class="insp-chapter-filter-box">
            <select class="insp-chapter-select" title="筛选所属章节"></select>
          </div>
        </div>

        <!-- 视图标签栏 -->
        <nav class="insp-tabs" aria-label="巡检视图切换">
          <button type="button" class="insp-tab active" data-tab="all">
            <span>全量索引</span>
            <span class="insp-tab-count">0</span>
          </button>
          {isDev && (
            <button type="button" class="insp-tab insp-tab-dev" data-tab="same_chapter_dups" title="同一章节内出现的重名模块（仅开发模式）">
              <span>同章冲突</span>
              <span class="insp-tab-count">0</span>
            </button>
          )}
          <button type="button" class="insp-tab" data-tab="all_dups">
            <span>跨章聚合</span>
            <span class="insp-tab-count">0</span>
          </button>
          {isDev && (
            <button type="button" class="insp-tab insp-tab-dev" data-tab="suspicious" title="OCR切分异常与清洗审查（仅开发模式）">
              <span>结构审查</span>
              <span class="insp-tab-count">0</span>
            </button>
          )}
          {isDev && (
            <button type="button" class="insp-tab insp-tab-dev" data-tab="formula_errors" title="公式语法异常排查（仅开发模式）">
              <span>公式异常</span>
              <span class="insp-tab-count">0</span>
            </button>
          )}
        </nav>

        <!-- 卡片类型筛选 Chips -->
        <div class="insp-kind-chips-wrap">
          <div class="insp-kind-chips"></div>
        </div>

        <!-- 主体列表容器 -->
        <main class="insp-body">
          <div class="insp-list">
            <M3Loading
              variant="contained"
              size="medium"
              layout="block"
              label="正在扫描全书模块结构..."
              sublabel="解析章节卡片并构建索引"
            />
          </div>
        </main>

        <!-- 底部快捷操作与提示 -->
        <footer class="insp-footer">
          <div class="insp-footer-tip">
            <span class="insp-tip-desktop">快捷键：<kbd>Alt+M</kbd> 展开/收起 · <kbd>Esc</kbd> 关闭</span>
            <span class="insp-tip-mobile">点击条目即可快速定位直达正文卡片</span>
          </div>
          <span class="insp-footer-tag">AstroLib Academic</span>
        </footer>
      </aside>
    </div>
  )
}


<script>
  let loaded = false;
  async function loadAndOpen() {
    if (!loaded) {
      loaded = true;
      const { initModuleInspector } = await import('../client/inspector');
      initModuleInspector();
      const ctrl = (window as any).__dshModuleInspector;
      if (ctrl && !ctrl.isOpen) ctrl.open();
    } else {
      const ctrl = (window as any).__dshModuleInspector;
      if (ctrl) ctrl.open();
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest('[data-inspector-trigger]');
    if (btn) {
      e.preventDefault();
      loadAndOpen();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.altKey && (e.key === 'm' || e.key === 'M')) {
      e.preventDefault();
      loadAndOpen();
    }
  });

  window.addEventListener('inspector:open', () => loadAndOpen());
</script>
