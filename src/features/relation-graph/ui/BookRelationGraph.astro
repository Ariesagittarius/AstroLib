---
import { features } from '../../../config/features.config.mjs';
import { collections } from '../../../config/collections.config.mjs';
import M3Loading from '../../../components/common/M3Loading.astro';

const pathname = Astro.url.pathname;
let currentBook = null;
let currentCol = null;

for (const col of collections) {
  const matched = col.books.find(b => pathname.includes(`/collections/${col.slug}/${b.slug}/`));
  if (matched) {
    currentCol = col;
    currentBook = matched;
    break;
  }
}

if (!currentBook || !currentCol) {
  currentCol = collections[0];
  currentBook = collections[0]?.books[0];
}

const bookKey = `${currentCol?.slug ?? 'math'}/${currentBook?.slug ?? 'math_senior'}`;
const colSlug = currentCol?.slug ?? 'math';
const bookSlug = currentBook?.slug ?? 'math_senior';
import '../styles/relation-graph.css';
---

{
  features.relationGraph.enabled && (
    <div id="book-relation-graph-root" class="brg-root" data-feature="relationGraph" data-book-key={bookKey} data-col={colSlug} data-book={bookSlug} aria-label="全书各章节内联关系图谱">
      <div class="brg-backdrop"></div>
      <div class="brg-modal" role="dialog" aria-label="全书章节内联关系图谱与知识导图">

        <header class="brg-header">
          <div class="brg-header-left">
            <span class="brg-header-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="3"/>
                <circle cx="6" cy="18" r="3"/>
                <circle cx="18" cy="12" r="3"/>
                <line x1="8.59" y1="7.49" x2="15.42" y2="10.51"/>
                <line x1="8.59" y1="16.51" x2="15.42" y2="13.49"/>
              </svg>
            </span>
            <div class="brg-header-title-box">
              <h2 class="brg-header-title">{currentBook.title} · 章节内联关系图谱</h2>
              <div class="brg-header-stats-pill">
                <span class="brg-stat-tag" id="brg-stat-chapters">0 章节</span>
                <span class="brg-stat-tag" id="brg-stat-cross-refs">0 跨章引用</span>
                <span class="brg-stat-tag" id="brg-stat-links">0 关联边</span>
              </div>
            </div>
          </div>

          <nav class="brg-nav-tabs" aria-label="图表视图切换">
            <button type="button" class="brg-tab active" data-view="force">
              <svg class="brg-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="8.5" y1="7.5" x2="15.5" y2="16.5"/><line x1="8.5" y1="16.5" x2="15.5" y2="7.5"/></svg>
              <span>拓扑网络</span>
            </button>
            <button type="button" class="brg-tab" data-view="circular">
              <svg class="brg-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/><path d="M12 2a10 10 0 0 0-10 10"/></svg>
              <span>环形依存</span>
            </button>
            <button type="button" class="brg-tab" data-view="mindmap">
              <svg class="brg-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/><path d="M15 5l4 4"/></svg>
              <span>思维导图</span>
            </button>
            <button type="button" class="brg-tab" data-view="matrix">
              <svg class="brg-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>
              <span>关联清单</span>
            </button>
          </nav>

          <div class="brg-header-actions">

            <select id="brg-scope-select" class="brg-scope-select" title="选择关系网络显示层级与范围" aria-label="图谱层级与视角选择">
              <option value="all">🌐 全书细分章节</option>
              <option value="group">📦 按篇章/大章聚合</option>
              <option value="focus">🎯 聚焦当前章及关联</option>
              <option value="connected">🔗 仅看有引用的节点</option>
            </select>

            <div class="brg-search-box">
              <svg class="brg-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="brg-search-input" class="brg-search-input" placeholder="搜索章节、定理或例题..." autocomplete="off" />
              <button type="button" id="brg-search-clear" class="brg-search-clear" title="清空搜索">✕</button>
            </div>
            <button type="button" id="brg-btn-fullscreen" class="brg-icon-btn" title="切换全屏" aria-label="切换全屏">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            </button>
            <button type="button" id="brg-btn-close" class="brg-icon-btn brg-close-btn" title="关闭 (Esc)" aria-label="关闭">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </header>

        <div class="brg-body">

          <div class="brg-canvas-wrapper">
            <div id="brg-echarts-container" class="brg-echarts-container"></div>

            <div id="brg-canvas-toolbar" class="brg-canvas-toolbar" role="toolbar" aria-label="图表缩放与画布控制">
              <button type="button" id="brg-zoom-in" class="brg-toolbar-btn" title="放大图表 (滚轮或此按钮)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              </button>
              <button type="button" id="brg-zoom-out" class="brg-toolbar-btn" title="缩小图表">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              </button>
              <button type="button" id="brg-zoom-reset" class="brg-toolbar-btn" title="重置视角并居中适配">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
              </button>
              <div class="brg-toolbar-divider"></div>
              <button type="button" id="brg-toggle-physics" class="brg-toolbar-btn active" title="开关拓扑网络物理引力模拟">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </button>
            </div>

            <div id="brg-matrix-container" class="brg-matrix-container" style="display: none;">
              <div class="brg-matrix-table-wrap">
                <table class="brg-matrix-table">
                  <thead>
                    <tr>
                      <th style="width: 28%;">章节名称</th>
                      <th style="width: 14%;">所属分组</th>
                      <th style="width: 10%;">卡片数</th>
                      <th style="width: 10%;">被引用度</th>
                      <th style="width: 10%;">跨章出度</th>
                      <th style="width: 28%;">主要引用目标</th>
                    </tr>
                  </thead>
                  <tbody id="brg-matrix-tbody"></tbody>
                </table>
              </div>
            </div>

            <div id="brg-loading-mask" class="brg-loading-mask">
              <M3Loading
                variant="contained"
                size="large"
                layout="block"
                label="正在分析并生成全书章节关系拓扑..."
              />
            </div>
          </div>

          <aside class="brg-info-panel">
            <div id="brg-inspector-card" class="brg-inspector-card">

              <div class="brg-default-view">
                <div class="brg-info-section">
                  <h3 class="brg-info-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    核心知识枢纽章节
                  </h3>
                  <p class="brg-info-desc">被全书其他章节引用频次最高的基石章节：</p>
                  <ul id="brg-hubs-list" class="brg-hubs-list"></ul>
                </div>

                <div class="brg-info-section brg-tip-box">
                  <h4 class="brg-tip-title">图谱交互提示</h4>
                  <ul class="brg-tip-list">
                    <li><b>视角放大/缩小</b>：使用左下角工具栏 <kbd>+</kbd>/<kbd>-</kbd> 或鼠标滚轮；</li>
                    <li><b>大书防混淆</b>：顶部选择<b>“按篇章/大章聚合”</b>或<b>“聚焦当前章”</b>；</li>
                    <li><b>视图平移与拖拽</b>：拖动画布或节点；双击节点直达原文。</li>
                  </ul>
                </div>

                <div class="brg-info-section brg-pref-box">
                  <h4 class="brg-tip-title">界面显示偏好</h4>
                  <label class="brg-pref-label">
                    <input type="checkbox" id="brg-pref-show-sidebar-btn" checked />
                    <span>在右侧栏显示 [关系图] 按钮</span>
                  </label>
                  <div class="brg-pref-tip">关闭后按钮隐藏，您随时可按 Alt+G 或在此开启。</div>
                </div>
              </div>

              <div class="brg-node-detail-view" style="display: none;">
                <div class="brg-node-header">
                  <span id="brg-node-group-badge" class="brg-node-group-badge">第1章</span>
                  <h3 id="brg-node-title" class="brg-node-title">1.1 集合、映射与函数</h3>
                </div>

                <div class="brg-node-stats-grid">
                  <div class="brg-node-stat-item">
                    <div class="brg-node-stat-num" id="brg-node-card-count">0</div>
                    <div class="brg-node-stat-label">包含模块</div>
                  </div>
                  <div class="brg-node-stat-item">
                    <div class="brg-node-stat-num" id="brg-node-in-degree">0</div>
                    <div class="brg-node-stat-label">被外部引用</div>
                  </div>
                  <div class="brg-node-stat-item">
                    <div class="brg-node-stat-num" id="brg-node-out-degree">0</div>
                    <div class="brg-node-stat-label">引用外部</div>
                  </div>
                </div>

                <div class="brg-node-actions">
                  <a id="brg-node-jump-btn" href="#" class="brg-btn-primary">
                    <span>前往该章节阅读</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>

                <div class="brg-ref-section">
                  <h4 class="brg-ref-section-title">
                    <span class="brg-ref-dot out"></span>
                    本章引用的外部知识 (出链)
                  </h4>
                  <ul id="brg-node-out-refs" class="brg-ref-list"></ul>
                </div>

                <div class="brg-ref-section">
                  <h4 class="brg-ref-section-title">
                    <span class="brg-ref-dot in"></span>
                    引用本章的其他章节 (入链)
                  </h4>
                  <ul id="brg-node-in-refs" class="brg-ref-list"></ul>
                </div>

                <div class="brg-ref-section">
                  <h4 class="brg-ref-section-title">
                    <span class="brg-ref-dot local"></span>
                    本章核心知识卡片
                  </h4>
                  <div id="brg-node-local-cards" class="brg-local-cards-tags"></div>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  )
}

<script>try {
    if (localStorage.getItem('astro-show-relation-graph-btn') === 'false') {
      document.querySelectorAll('.relation-graph-trigger').forEach((btn) => {
        (btn as HTMLElement).style.display = 'none';
      });
    }
  } catch {}

  let relationGraphLoaded = false;
  let relationGraphLoading: Promise<void> | null = null;

  async function activateRelationGraph() {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('astrolib_lite_mode') === 'true') {
      return;
    }
    if (!relationGraphLoading) {
      relationGraphLoading = (async () => {
        const { initRelationGraphClient } = await import('../client/relation-graph-client');
        initRelationGraphClient();
        relationGraphLoaded = true;
      })();
    }
    await relationGraphLoading;
    window.openBookRelationGraph?.();
  }

  window.openBookRelationGraph = activateRelationGraph;

  document.addEventListener(
    'pointerenter',
    (e) => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('astrolib_lite_mode') === 'true') return;
      if (relationGraphLoaded || relationGraphLoading) return;
      const target = e.target instanceof Element ? e.target : (e.target as Node | null)?.parentElement;
      if (target?.closest?.('[data-open-relation-graph], .relation-graph-trigger')) {
        import('../client/relation-graph-client');
      }
    },
    { capture: true, passive: true }
  );

  document.addEventListener('click', (e) => {
    if (relationGraphLoaded) return;
    const target = e.target instanceof Element ? e.target : (e.target as Node | null)?.parentElement;
    const btn = target?.closest?.('[data-open-relation-graph], .relation-graph-trigger');
    if (btn) {
      e.preventDefault();
      activateRelationGraph();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (relationGraphLoaded) return;
    if ((e.altKey && e.code === 'KeyG') || (e.altKey && (e.key === 'g' || e.key === 'G'))) {
      e.preventDefault();
      activateRelationGraph();
    }
  });

  window.addEventListener('relation-graph:open', () => {
    activateRelationGraph();
  });
</script>
