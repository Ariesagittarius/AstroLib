---
const { title } = Astro.props;
// 将标题转换为适合做 URL 锚点 ID 的格式
const cleanId = title ? encodeURIComponent(title.trim().replace(/\s+/g, '-')) : undefined;
---

<div class="exercise-card toc-chunk" data-title={title} id={cleanId}>
  <div class="card-header">📝 {title}</div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .exercise-card {
    border: 1px solid #f59e0b;
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow: hidden;
  }
  .card-header {
    background-color: #fffbeb;
    color: #92400e;
    padding: 0.6rem 1rem;
    font-weight: bold;
    border-bottom: 1px solid #f59e0b;
  }
  .card-body {
    padding: 1rem;
  }
</style>
