---
const { title } = Astro.props;
// 将标题转换为适合做 URL 锚点 ID 的格式
const cleanId = title ? title.trim().replace(/\s+/g, '-') : undefined;
---

<div class="exercise-card toc-chunk" data-title={title} id={cleanId}>
  <div class="card-header">{title}</div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .exercise-card {
    --card-border: #f59e0b;
    --card-header-bg: #fffbeb;
    --card-header-fg: #92400e;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow: hidden;
  }
  .card-header {
    background-color: var(--card-header-bg);
    color: var(--card-header-fg);
    padding: 0.6rem 1rem;
    font-weight: bold;
    border-bottom: 1px solid var(--card-border);
  }
  .card-body {
    padding: 1rem;
  }

  /* 黑夜主题适配 */
  :global(html[data-theme='dark']) .exercise-card {
    --card-border: #fbbf24;
    --card-header-bg: rgba(245, 158, 11, 0.16);
    --card-header-fg: #fcd34d;
  }
</style>
