---
import QRCode from 'qrcode';
import { srcAttrs } from '../utils/src-attrs.mjs';

interface Props {
  id?: string;
  title?: string;
  url?: string;
}

const { id = '', title = '', url = '' } = Astro.props;

// 清理标题：如 "二维码1.1.3分段函数..." -> "分段函数..."
let cleanTitle = title.replace(/^二维码\s*\d+(\.\d+)*\s*/, '').replace(/[\.\。\s]+$/, '').trim();
let codeId = id;

if (!codeId) {
  const match = title.match(/^二维码\s*(\d+(\.\d+)*)/);
  if (match) {
    codeId = match[1];
  }
}

// 统一标题显示格式 (学术风：如 "1.1.3 分段函数一定不是初等函数吗？")
const fullTitle = codeId ? `${codeId} ${cleanTitle}`.trim() : cleanTitle || '讲解视频';
const modalId = `qr-dialog-${codeId ? codeId.replace(/\./g, '-') : Math.random().toString(36).substring(2, 9)}`;

let qrSvg = '';
if (url) {
  try {
    qrSvg = await QRCode.toString(url, {
      type: 'svg',
      margin: 1,
      color: {
        dark: '#0f172a',
        light: '#ffffff',
      },
    });
  } catch (err) {
    console.error('[QRCodeVideo] Failed to generate QR SVG:', err);
  }
}
---

<div class="qr-video-card" {...srcAttrs(Astro.props)}>
  <div class="qr-video-inner">
    <div class="qr-video-left">
      <!-- 规范学术视频 SVG 图标 -->
      <svg class="qr-icon-video" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="15" height="16" rx="2"></rect>
        <polygon points="22 7 17 11 17 13 22 17 22 7"></polygon>
      </svg>
      <span class="qr-video-title">{fullTitle}</span>
    </div>

    <!-- 右侧纯图标按钮 -->
    <button type="button" class="qr-video-btn js-qr-trigger" data-modal-id={modalId} title="查看讲解视频二维码">
      <svg class="qr-icon-qr" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
        <line x1="7" y1="7" x2="7.01" y2="7"></line>
        <line x1="18" y1="7" x2="18.01" y2="7"></line>
        <line x1="7" y1="18" x2="7.01" y2="18"></line>
        <line x1="18" y1="18" x2="18.01" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- 学术规范弹窗 -->
  <dialog id={modalId} class="qr-modal js-qr-modal">
    <div class="qr-modal-container">
      <div class="qr-modal-header">
        <div class="qr-modal-title">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="15" height="16" rx="2"></rect>
            <polygon points="22 7 17 11 17 13 22 17 22 7"></polygon>
          </svg>
          <span>讲解视频 {codeId ? `(${codeId})` : ''}</span>
        </div>
        <button type="button" class="qr-modal-close js-qr-close" aria-label="关闭">&times;</button>
      </div>

      <div class="qr-modal-body">
        {cleanTitle && <div class="qr-modal-subtitle">{cleanTitle}</div>}
        {qrSvg ? (
          <div class="qr-svg-box" set:html={qrSvg} />
        ) : (
          <div class="qr-error-box">二维码无法显示</div>
        )}
        <p class="qr-tip">扫码或点击下方链接播放视频</p>
      </div>

      {url && (
        <div class="qr-modal-footer">
          <a href={url} target="_blank" rel="noopener noreferrer" class="qr-direct-link">
            <span>在线播放视频</span>
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      )}
    </div>
  </dialog>
</div>

<script>
  function initQRModals() {
    const triggers = document.querySelectorAll('.js-qr-trigger');
    triggers.forEach((btn) => {
      const modalId = btn.getAttribute('data-modal-id');
      if (!modalId) return;
      
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        const dialog = document.getElementById(modalId) as HTMLDialogElement | null;
        if (dialog && typeof dialog.showModal === 'function') {
          dialog.showModal();
        }
      });
    });

    const closes = document.querySelectorAll('.js-qr-close');
    closes.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const dialog = (e.currentTarget as HTMLElement).closest('dialog');
        if (dialog) dialog.close();
      });
    });

    const modals = document.querySelectorAll('.js-qr-modal');
    modals.forEach((dialog) => {
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          (dialog as HTMLDialogElement).close();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initQRModals);
  } else {
    initQRModals();
  }
  document.addEventListener('astro:page-load', initQRModals);
</script>

<style>
  /* 学术风极简卡片 */
  .qr-video-card {
    margin: 0.85rem 0;
    padding: 0.5rem 0.85rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-family: inherit;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .qr-video-card:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
  }

  .qr-video-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .qr-video-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    color: #334155;
  }

  .qr-icon-video {
    flex-shrink: 0;
    color: #64748b;
  }

  .qr-video-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: #334155;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .qr-video-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: #475569;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .qr-video-btn:hover {
    color: #0284c7;
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  /* 规范学术模态框 */
  .qr-modal {
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    max-width: 320px;
    width: 88vw;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.06);
  }

  .qr-modal::backdrop {
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(2px);
  }

  .qr-modal-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .qr-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .qr-modal-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: #334155;
  }

  .qr-modal-close {
    background: transparent;
    border: none;
    font-size: 1.25rem;
    line-height: 1;
    color: #94a3b8;
    cursor: pointer;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }

  .qr-modal-close:hover {
    color: #0f172a;
    background: #e2e8f0;
  }

  .qr-modal-body {
    padding: 1.15rem 1rem 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .qr-modal-subtitle {
    font-size: 0.85rem;
    font-weight: 500;
    color: #475569;
    margin-bottom: 0.85rem;
    line-height: 1.4;
    word-break: break-word;
  }

  .qr-svg-box {
    width: 180px;
    height: 180px;
    padding: 0.4rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
  }

  .qr-svg-box :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .qr-tip {
    font-size: 0.775rem;
    color: #64748b;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .qr-modal-footer {
    padding: 0.65rem 1rem;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    text-align: center;
  }

  .qr-direct-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: #0284c7;
    text-decoration: none;
    font-weight: 500;
  }

  .qr-direct-link:hover {
    text-decoration: underline;
    color: #0369a1;
  }

  /* 暗色模式适配 (Dark Mode) */
  :global(html[data-theme='dark']) .qr-video-card {
    background: rgba(30, 41, 59, 0.3);
    border-color: rgba(51, 65, 85, 0.5);
  }

  :global(html[data-theme='dark']) .qr-video-card:hover {
    background: rgba(30, 41, 59, 0.5);
    border-color: rgba(71, 85, 105, 0.7);
  }

  :global(html[data-theme='dark']) .qr-video-left {
    color: #cbd5e1;
  }

  :global(html[data-theme='dark']) .qr-icon-video {
    color: #94a3b8;
  }

  :global(html[data-theme='dark']) .qr-video-title {
    color: #e2e8f0;
  }

  :global(html[data-theme='dark']) .qr-video-btn {
    color: #94a3b8;
  }

  :global(html[data-theme='dark']) .qr-video-btn:hover {
    color: #38bdf8;
    background: rgba(15, 23, 42, 0.6);
    border-color: rgba(51, 65, 85, 0.8);
  }

  :global(html[data-theme='dark']) .qr-modal-container {
    background: #0f172a;
    border-color: rgba(51, 65, 85, 0.8);
  }

  :global(html[data-theme='dark']) .qr-modal-header {
    background: #1e293b;
    border-bottom-color: rgba(51, 65, 85, 0.6);
  }

  :global(html[data-theme='dark']) .qr-modal-title {
    color: #e2e8f0;
  }

  :global(html[data-theme='dark']) .qr-modal-close {
    color: #64748b;
  }

  :global(html[data-theme='dark']) .qr-modal-close:hover {
    color: #f8fafc;
    background: #334155;
  }

  :global(html[data-theme='dark']) .qr-modal-subtitle {
    color: #cbd5e1;
  }

  :global(html[data-theme='dark']) .qr-modal-footer {
    background: #1e293b;
    border-top-color: rgba(51, 65, 85, 0.6);
  }

  :global(html[data-theme='dark']) .qr-direct-link {
    color: #38bdf8;
  }
</style>
