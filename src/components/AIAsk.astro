---
// AI 书内智能问答主组件 · SSR 壳与表现层组合
import { features } from '../config/features.config.mjs';
import { collections } from '../config/collections.config.mjs';
import ChatDrawer from './ai/ChatDrawer.astro';
import MessageList from './ai/MessageList.astro';
import InputBar from './ai/InputBar.astro';
import './ai/ai-theme.css';

const { enabled = false, config = {} } = features.aiAsk || {};
if (!enabled) return;

const pathname = Astro.url.pathname;
let currentBook = null;
for (const col of collections) {
  const b = col.books.find((x) => pathname.includes(`/collections/${col.slug}/${x.slug}/`));
  if (b) { currentBook = b; break; }
}

const bookList = collections.flatMap((c) =>
  c.books.map((b) => ({ col: c.slug, book: b.slug, title: b.title }))
);

const fullConfig = {
  ...config,
  bookList,
};
const configJson = JSON.stringify(fullConfig);
const bookTitle = currentBook ? currentBook.title : '';
---

<ai-ask data-config={configJson} data-book-title={bookTitle} data-feature="aiAsk">
  <ChatDrawer>
    <MessageList />
    <InputBar />
  </ChatDrawer>
</ai-ask>

<script>
  import { mountToOverlayRoot } from '../utils/overlay/overlay-root';

  function ensureMounted() {
    const el = document.querySelector<HTMLElement>('ai-ask');
    if (!el) return;
    // 保护性守卫：若元素已被停靠至右侧栏侧载底座中，或标记为 is-docked，严禁将其拔出至浮层根节点
    if (
      el.classList.contains('is-docked') ||
      el.closest('#ai-sidebar-panel') ||
      (typeof localStorage !== 'undefined' && localStorage.getItem('astrolib_ai_docked') === 'true')
    ) {
      return;
    }
    mountToOverlayRoot(el);
  }

  let loaded = false;
  async function loadAiAsk() {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('astrolib_lite_mode') === 'true') {
      return;
    }
    ensureMounted();
    if (!loaded) {
      loaded = true;
      await import('../ai/client/chat-controller');
    }
  }

  // 若历史状态为侧载停靠，预先加载控制器以静默就绪
  if (typeof localStorage !== 'undefined' && localStorage.getItem('astrolib_ai_docked') === 'true') {
    loadAiAsk();
  }

  // 点击右下角 AI 悬浮球 (ask-fab) 时按需加载控制器
  document.addEventListener('click', (e) => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('astrolib_lite_mode') === 'true') return;
    const fab = (e.target as HTMLElement)?.closest<HTMLElement>('.ask-fab');
    if (fab) {
      fab.setAttribute('aria-busy', 'true');
      loadAiAsk().then(() => {
        fab.removeAttribute('aria-busy');
        const el = document.querySelector('ai-ask') as any;
        if (el && typeof el._openPanel === 'function') el._openPanel();
      }).catch(() => {
        fab.removeAttribute('aria-busy');
      });
    }
  });

  // 监听外部查询事件：若尚未加载控制器，等待加载后执行外部问答
  window.addEventListener('aiask:query', (e: Event) => {
    const ce = e as CustomEvent;
    const detail = ce.detail;
    if ((ce as any).__handled) return;

    // 若已经定义并挂载了 ai-ask 控制器，优先直接调用，避免重新触发 ensureMounted
    const el = document.querySelector('ai-ask') as any;
    if (el && typeof el._openWithQuestion === 'function' && detail?.prompt) {
      (ce as any).__handled = true;
      el._openWithQuestion(detail.prompt, detail.autoSubmit ?? true);
      return;
    }

    loadAiAsk().then(() => {
      if ((ce as any).__handled) return;
      (ce as any).__handled = true;
      const elReady = document.querySelector('ai-ask') as any;
      if (elReady && typeof elReady._openWithQuestion === 'function' && detail?.prompt) {
        elReady._openWithQuestion(detail.prompt, detail.autoSubmit ?? true);
      }
    });
  });
</script>
