---
import { features } from '../../config/features.config.mjs';
import { listTypographyPresets } from '../../publishing/typography/index.ts';
import FeedbackSubmodal from './submodals/FeedbackSubmodal.astro';
import SourceEditorSubmodal from './submodals/SourceEditorSubmodal.astro';
import AiUploadSubmodal from './submodals/AiUploadSubmodal.astro';
import LatexExportSubmodal from './submodals/LatexExportSubmodal.astro';
import CompilerSettingsSubmodal from './submodals/CompilerSettingsSubmodal.astro';
import './exercise-theme.css';

const { enabled = true } = features.exercises || {};
if (!enabled) return;

const typographyPresets = listTypographyPresets();
---

<div id="exercise-modal-root" class="ex-modal-root" aria-label="章节习题与真题自测中心">
  <div class="ex-modal-backdrop"></div>
  <md-dialog
    id="exercise-modal-dialog"
    class="ex-modal-window ex-modal-m3-dialog"
    quick
    aria-label="真题自测、试卷整卷与题库检索"
  >

    <header slot="headline" class="ex-header">
      <div class="ex-header-left">

        <select class="ex-chapter-select" title="选择要练习的章节">
          <option value="1">第1章 极限与连续</option>
          <option value="2">第2章 一元函数微分学</option>
          <option value="3">第3章 一元函数积分学</option>
          <option value="4">第4章 常微分方程</option>
          <option value="5">第5章 多元函数微分学</option>
          <option value="6">第6章 多元函数积分学</option>
          <option value="7">第7章 无穷级数</option>
        </select>

        <select class="ex-paper-select hidden" title="选择要浏览的期中/期末试卷">
          <option value="loading">正在加载试卷列表...</option>
        </select>
      </div>

      <div class="ex-header-center" role="group" aria-label="练习模式切换">
        <button type="button" class="ex-mode-tab active" data-mode="practice" title="按章节教材目录自测练习" aria-pressed="true">
          <span>章节自测</span>
        </button>
        <button type="button" class="ex-mode-tab" data-mode="paper" title="按真实期末/期中试卷整卷刷题" aria-pressed="false">
          <span>试卷整卷</span>
        </button>
      </div>

      <div class="ex-header-right">
        <button type="button" class="ex-secondary-btn" id="ex-open-latex-btn" title="导出学术 LaTeX 练习册 / 考场试卷" aria-label="导出 LaTeX 文档">
          <md-icon class="ex-btn-mdicon">description</md-icon>
          <span>导出 LaTeX</span>
        </button>
        <button type="button" class="ex-icon-btn ex-fullscreen-btn" title="全屏/窗口切换 (F)" aria-label="全屏切换">
          <md-icon class="ex-btn-mdicon" id="ex-fullscreen-icon">fullscreen</md-icon>
        </button>
        <button type="button" class="ex-icon-btn ex-close-btn" title="关闭 (Esc)" aria-label="关闭">
          <md-icon class="ex-btn-mdicon">close</md-icon>
        </button>
      </div>
    </header>

    <div slot="content" class="ex-modal-dialog-content">

    <div class="ex-toolbar">
      <div class="ex-toolbar-top">
        <div class="ex-stats-row">
          <span class="ex-stat-item">共 <strong class="ex-stat-total">0</strong> 题</span>
        </div>

        <div class="ex-toolbar-actions">
          <div class="ex-search-box">
            <md-icon class="ex-search-icon">search</md-icon>
            <input type="text" class="ex-search-input" placeholder="输入题干关键字、LaTeX 或考点..." autocomplete="off" />
            <button type="button" class="ex-search-clear" title="清空检索" aria-label="清空检索">
              <md-icon class="ex-search-clear-icon">close</md-icon>
            </button>
          </div>

          <button type="button" class="ex-scope-toggle-btn" id="ex-scope-toggle-btn" title="切换检索范围：当前章节 / 全库跨章节检索">
            <md-icon class="ex-scope-icon">public</md-icon>
            <span class="ex-scope-label">全库检索</span>
          </button>

          <button type="button" class="ex-toolbar-toggle-btn" id="ex-toolbar-toggle-btn" title="收起/展开筛选" aria-label="收起/展开筛选">
            <span class="ex-toggle-label">收起筛选</span>
            <md-icon class="ex-toggle-chevron">expand_less</md-icon>
          </button>
        </div>
      </div>

      <div class="ex-filter-drawer">
        <div class="ex-filter-inner">
          <div class="ex-filter-row">

            <div class="ex-nav-flow ex-source-pills">
              <button type="button" class="ex-nav-item active" data-source="all">全部来源</button>
              <button type="button" class="ex-nav-item" data-source="textbook">教材课后习题</button>
              <button type="button" class="ex-nav-item" data-source="exam">大邮数学集（真题）</button>
            </div>

            <div class="ex-nav-flow ex-group-pills hidden">
              <button type="button" class="ex-nav-item active" data-group="all">全部组别</button>
              <button type="button" class="ex-nav-item" data-group="A">A组基础</button>
              <button type="button" class="ex-nav-item" data-group="B">B组提高</button>
            </div>

            <div class="ex-nav-flow ex-section-pills"></div>

            <div class="ex-nav-flow ex-paper-outline-bar hidden"></div>

            <div class="ex-nav-flow ex-type-pills">
              <button type="button" class="ex-nav-item active" data-type="all">全部题型</button>
              <button type="button" class="ex-nav-item" data-type="choice">单选</button>
              <button type="button" class="ex-nav-item" data-type="blank">填空</button>
              <button type="button" class="ex-nav-item" data-type="calc">计算</button>
              <button type="button" class="ex-nav-item" data-type="proof">证明</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="ex-body"></div>

    <FeedbackSubmodal />
    <SourceEditorSubmodal />
    <AiUploadSubmodal />
    <LatexExportSubmodal typographyPresets={typographyPresets} />
    <CompilerSettingsSubmodal />

    <div id="ex-toast-box" class="ex-toast-box" aria-live="polite"></div>
  </div>
  </md-dialog>
</div>

<script>import '@material/web/dialog/dialog.js';
  import '@material/web/icon/icon.js';
  import '@material/web/iconbutton/icon-button.js';
  import '@material/web/chips/chip-set.js';
  import '@material/web/chips/filter-chip.js';
  import '@material/web/button/filled-button.js';
  import '@material/web/button/outlined-button.js';
  import '@material/web/button/filled-tonal-button.js';
  import '@material/web/button/text-button.js';
  import '@material/web/progress/circular-progress.js';
  let controllerPromise: Promise<any> | null = null;
  async function loadAndOpen(detail?: any) {
    try {
      if (!controllerPromise) {
        controllerPromise = import('./exercise-controller').then((m) => m.exerciseController);
      }
      const exerciseController = await controllerPromise;
      if (detail) {
        if (detail.mode === 'paper') {
          exerciseController.openPaper(detail.paperId || 1, detail.targetQid);
        } else {
          exerciseController.open(detail.chapter || 1, detail.section || 'all');
        }
      } else {
        exerciseController.open();
      }
    } catch (err) {
      console.error('[ExerciseModal] 加载习题控制器失败:', err);
      controllerPromise = null;
    }
  }

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement)?.closest('[data-exercise-trigger]');
    if (trigger) {
      e.preventDefault();
      const ch = parseInt(trigger.getAttribute('data-chapter') || '1', 10);
      const sec = trigger.getAttribute('data-section') || 'all';
      loadAndOpen({ chapter: ch, section: sec });
    }
  });

  window.addEventListener('exercises:open', (e: any) => {
    loadAndOpen(e.detail);
  });

  document.addEventListener('keydown', (e) => {
    if (e.altKey && (e.key === 'e' || e.key === 'E')) {
      e.preventDefault();
      loadAndOpen();
    }
  });
</script>
