<div id="ex-source-editor-modal" class="ex-submodal-overlay hidden" role="dialog" aria-modal="true" aria-label="题目源码查看与修改">
    <div class="ex-submodal-box ex-editor-box">
      <div class="ex-submodal-header">
        <div class="ex-submodal-title">
          <md-icon class="ex-submodal-icon">code</md-icon>
          <span>题目源码查看与热持久化编辑器</span>
          <span class="ex-dev-tag">Developer Mode</span>
        </div>
        <div class="ex-header-actions">
          <button type="button" class="ex-icon-btn" id="ex-src-copy-btn" title="复制完整 JSON 源码">
            <md-icon class="ex-btn-mdicon">content_copy</md-icon>
          </button>
          <button type="button" class="ex-submodal-close" data-action="close-source-modal" aria-label="关闭">
            <md-icon class="ex-submodal-close-icon">close</md-icon>
          </button>
        </div>
      </div>
      <div class="ex-submodal-body">
        <div class="ex-editor-toolbar">
          <span class="ex-editor-tip">提示：支持实时修改题干 LaTeX、选项、参考答案、推导解析与考点映射。点击保存将通过 Dev-Server 直接热持久化写回本地题库源文件。</span>
        </div>
        <textarea id="ex-src-editor-textarea" class="ex-code-editor" spellcheck="false" autocomplete="off"></textarea>
      </div>
      <div class="ex-submodal-footer">
        <div class="ex-footer-status" id="ex-src-status-msg"></div>
        <button type="button" class="ex-btn ex-btn-secondary" data-action="close-source-modal">取消</button>
        <button type="button" class="ex-btn ex-btn-primary" id="ex-src-save-btn">
          <md-icon class="ex-btn-mdicon">save</md-icon>
          <span>保存修改并热重载</span>
        </button>
      </div>
    </div>
  </div>
