<div id="ex-ai-upload-modal" class="ex-submodal-overlay hidden" role="dialog" aria-modal="true" aria-label="分享我的 AI 题解">
    <div class="ex-submodal-box">
      <div class="ex-submodal-header">
        <div class="ex-submodal-title">
          <md-icon class="ex-submodal-icon">auto_awesome</md-icon>
          <span>分享我的 AI 规范题解</span>
        </div>
        <button type="button" class="ex-submodal-close" data-action="close-upload-modal" aria-label="关闭">
          <md-icon class="ex-submodal-close-icon">close</md-icon>
        </button>
      </div>
      <div class="ex-submodal-body">
        <div class="ex-field-row">
          <span class="ex-field-label">题目编号：</span>
          <span class="ex-field-badge" id="ex-ai-upload-qid">QID</span>
        </div>

        <div class="ex-form-grid">
          <div class="ex-field-group">
            <label class="ex-field-label" for="ex-ai-model-input">推导模型名称 <span class="ex-req">*</span></label>
            <input type="text" id="ex-ai-model-input" class="ex-input" placeholder="例如：DeepSeek-R1, Claude 3.7 Sonnet, GPT-4o..." value="DeepSeek-R1" />
          </div>
          <div class="ex-field-group">
            <label class="ex-field-label" for="ex-ai-author-input">贡献者昵称</label>
            <input type="text" id="ex-ai-author-input" class="ex-input" placeholder="热心读者" value="热心读者" />
          </div>
        </div>

        <div class="ex-field-group">
          <label class="ex-field-label" for="ex-ai-solution-textarea">AI 题解推导 Markdown / LaTeX 内容 <span class="ex-req">*</span></label>
          <textarea id="ex-ai-solution-textarea" class="ex-textarea ex-code-font" rows="8" placeholder="粘贴您用 AI 生成的规范数学推导 Markdown 内容（支持 $$...$$ 与 $...$ 公式）..."></textarea>
        </div>

        <div class="ex-field-group">
          <label class="ex-field-label" for="ex-ai-remarks-input">解题要点 / 补充备注（选填）</label>
          <input type="text" id="ex-ai-remarks-input" class="ex-input" placeholder="例如：包含 Taylor 展开与等价无穷小两种解法" />
        </div>
      </div>
      <div class="ex-submodal-footer">
        <button type="button" class="ex-btn ex-btn-secondary" data-action="close-upload-modal">取消</button>
        <button type="button" class="ex-btn ex-btn-primary" id="ex-ai-upload-submit-btn">
          <md-icon class="ex-btn-mdicon">cloud_upload</md-icon>
          <span>上传并全网共享</span>
        </button>
      </div>
    </div>
  </div>
