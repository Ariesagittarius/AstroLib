---
import { getExerciseBanksForBook } from '../../config/exercise-banks.config';
import { collections } from '../../config/collections.config.mjs';

interface Props {
  chapter?: number;
  section?: string;
  title?: string;
  book?: string;
}

const {
  chapter = 1,
  section = 'all',
  title = '',
  book: explicitBook,
} = Astro.props;

const pathname = Astro.url.pathname;
let currentBookSlug = explicitBook || '';
if (!currentBookSlug) {
  for (const col of collections) {
    const matched = col.books.find((b) => pathname.includes(`/collections/${col.slug}/${b.slug}/`));
    if (matched) {
      currentBookSlug = matched.slug;
      break;
    }
  }
}
if (!currentBookSlug) currentBookSlug = 'engineering_analysis';

const rawTitle = title || (section !== 'all' ? `第 ${section} 节` : `第 ${chapter} 章`);
const cleanTitle = rawTitle
  .replace(/\s*(?:课后真题与自测练习|课后真题与即时自测练习|课后自测与真题练习|课后真题与练习|课后练习|自测练习)/g, '')
  .trim();

const availableBanks = getExerciseBanksForBook(currentBookSlug);
---

<div
  class="exercise-trigger-card not-content"
  data-exercise-trigger-card
  data-chapter={chapter}
  data-section={section}
  data-book={currentBookSlug}
>
  <div class="exercise-trigger-info">
    <div class="exercise-trigger-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
        <polyline points="10 8 13 11 17 6" />
      </svg>
    </div>
    <div class="exercise-trigger-texts">
      <div class="exercise-trigger-title-row">
        <h4 class="exercise-trigger-title">{cleanTitle}</h4>
      </div>

      <div class="exercise-chip-group">
        <md-chip-set>
          {availableBanks.map((bank) => (
            <md-filter-chip
              class="ex-bank-chip"
              data-bank-id={bank.id}
              data-bank-title={bank.title}
              data-source-type={bank.sourceType}
              data-chapter={chapter}
              data-section={section}
              data-book={currentBookSlug}
              label={bank.title}
              aria-label={bank.title}
            />
          ))}
        </md-chip-set>
      </div>
    </div>
  </div>
</div>

<style>.exercise-trigger-card {
    box-sizing: border-box;
  }
  .exercise-chip-group md-chip-set {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    gap: 0.5rem !important;
    margin: 0 !important;
  }
  .exercise-chip-group md-filter-chip {
    margin: 0 !important;
    margin-top: 0 !important;
    vertical-align: middle !important;
    align-self: center !important;
  }
</style>

<script>import '@material/web/chips/chip-set.js';
  import '@material/web/chips/filter-chip.js';
  import { getExerciseSidebarController } from './exercise-sidebar-controller';

  function initExerciseTriggers() {
    getExerciseSidebarController().init();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExerciseTriggers);
  } else {
    initExerciseTriggers();
  }
  document.addEventListener('astro:page-load', initExerciseTriggers);
</script>
