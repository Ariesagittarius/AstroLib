---
/**
 * ExerciseTrigger.astro
 * 嵌入各章节末尾的真题自测与课后练习 SVG 入口卡片
 */
interface Props {
  chapter?: number;
  section?: string;
  title?: string;
}

const {
  chapter = 1,
  section = 'all',
  title = '本节课后真题与即时自测练习'
} = Astro.props;
---

<div class="exercise-trigger-card" data-exercise-trigger data-chapter={chapter} data-section={section}>
  <div class="exercise-trigger-info">
    <div class="exercise-trigger-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
        <polyline points="10 8 13 11 17 6" />
      </svg>
    </div>
    <div class="exercise-trigger-texts">
      <div class="exercise-trigger-title-row">
        <h4 class="exercise-trigger-title">{title}</h4>
        <span class="exercise-trigger-badge">习题与真题</span>
      </div>
      <p class="exercise-trigger-desc">
        {section !== 'all' ? `收录本小节对应期中、期末与精选习题` : `收录本章期中期末与精选习题`}
        · 提供推导解析、试卷溯源与 LaTeX 导出
      </p>
    </div>
  </div>
  <button type="button" class="exercise-trigger-btn" aria-label="进入习题窗口">
    <span>进入自测</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6" />
    </svg>
  </button>
</div>
