---
import { features } from '../config/features.config.mjs';

const isEnabled = features.analytics?.enabled ?? true;
const analyticsConfig = features.analytics?.config ?? {
  provider: 'clarity',
  clarityProjectId: 'y9on8roaw3',
  productionOnly: true,
  filterBots: true,
  excludePaths: ['/dev/', '/print'],
  trackHighValueEvents: true,
};

const clarityProjectId = analyticsConfig.clarityProjectId || 'y9on8roaw3';
---

{isEnabled && clarityProjectId && (
  <>

    <script is:inline define:vars={{ analyticsConfig, clarityProjectId }}>(function () {
        if (window.__astrolibClarityInjected) return;

        var hostname = window.location.hostname;
        var pathname = window.location.pathname;

        if (analyticsConfig.productionOnly) {
          var isLocal =
            hostname === 'localhost' ||
            hostname === '127.0.0.1' ||
            hostname === '0.0.0.0' ||
            hostname.endsWith('.local') ||
            hostname.indexOf('trycloudflare.com') !== -1 ||
            hostname.indexOf('vaiwan.com') !== -1 ||
            hostname.indexOf('localtunnel.me') !== -1;

          if (isLocal) {

            window.__astrolibTrack = function (name, data) {
              console.log('[Analytics:DevMock]', name, data);
            };
            return;
          }
        }

        if (analyticsConfig.filterBots) {
          if (navigator.webdriver) return;
          var ua = (navigator.userAgent || '').toLowerCase();
          var botPatterns = [
            'bot', 'spider', 'crawler', 'headlesschrome',
            'phantomjs', 'bytespider', 'yisouspider', 'sogou',
            'semrush', 'ahrefs', 'petalbot', 'uptime'
          ];
          for (var i = 0; i < botPatterns.length; i++) {
            if (ua.indexOf(botPatterns[i]) !== -1) {
              return;
            }
          }
        }

        if (Array.isArray(analyticsConfig.excludePaths)) {
          for (var j = 0; j < analyticsConfig.excludePaths.length; j++) {
            var prefix = analyticsConfig.excludePaths[j];
            if (pathname.indexOf(prefix) === 0) {
              return;
            }
          }
        }

        window.__astrolibClarityInjected = true;
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', clarityProjectId);

        window.__astrolibTrack = function (eventName, eventData) {
          try {
            if (window.clarity) {
              window.clarity('event', eventName);
              if (eventData && typeof eventData === 'object') {
                for (var key in eventData) {
                  if (Object.prototype.hasOwnProperty.call(eventData, key)) {
                    window.clarity('set', key, String(eventData[key]));
                  }
                }
              }
            }
          } catch (e) {

          }
        };
      })();
</script>

    <script define:vars={{ trackHighValueEvents: analyticsConfig.trackHighValueEvents !== false }}>document.addEventListener('astro:page-load', () => {
        if (window.clarity) {
          try {
            window.clarity('set', 'page_path', window.location.pathname);
            window.clarity('set', 'page_title', document.title);
          } catch (e) {}
        }
      });

      if (trackHighValueEvents) {
        document.addEventListener('click', (e) => {
          const target = e.target;
          if (!target) return;

          const anchor = target.closest ? target.closest('a') : null;
          if (anchor) {
            const href = anchor.getAttribute('href') || '';
            if (href.endsWith('.epub') || anchor.closest('[data-feature="epub"]')) {
              const bookSlug = href.split('/').pop()?.replace('.epub', '') || 'unknown';
              if (window.__astrolibTrack) {
                window.__astrolibTrack('epub_download', { book: bookSlug });
              }
            }
          }

          const formulaBtn = target.closest ? target.closest('.katex-action-btn') : null;
          if (formulaBtn) {
            const actionType = formulaBtn.getAttribute('aria-label') || 'formula_action';
            if (window.__astrolibTrack) {
              window.__astrolibTrack('formula_action', { action: actionType });
            }
          }

          const crossRef = target.closest ? target.closest('.cross-ref-chip, [data-ref-id]') : null;
          if (crossRef) {
            const refText = crossRef.textContent?.trim() || 'cross_ref';
            if (window.__astrolibTrack) {
              window.__astrolibTrack('cross_ref_click', { ref: refText });
            }
          }
        });
      }
</script>
  </>
)}
