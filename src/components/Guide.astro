---
const title = "章节导读";
const cleanId = "section-guide";
---

<div class="guide-block toc-chunk" data-title={title} id={cleanId}>
  <div class="guide-header">📖 {title}</div>
  <div class="guide-content">
    <slot />
  </div>
</div>

<style>
  .guide-block {
    background-color: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--sl-color-gray-3);
  }
  .guide-header {
    font-weight: bold;
    font-style: normal;
    color: var(--sl-color-white);
    margin-bottom: 0.5rem;
  }
</style>