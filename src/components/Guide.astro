---
const title = "章节导读";
const cleanId = "section-guide";
---

<div class="guide-block toc-chunk" data-title={title} id={cleanId}>
  <div class="guide-header">📖 {title}</div>
  <div class="guide-content">
    <slot />
  </div>
</div>

<style>
  .guide-block {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem 1.2rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #475569;
  }
  .guide-header {
    font-weight: bold;
    font-style: normal;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }
</style>