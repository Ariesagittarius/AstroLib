---
import { srcAttrs } from '../utils/src-attrs.mjs';
const title = "章节导读";
// 与其他卡片组件保持一致的 id 规则（标题转连字符），避免同页多个 Guide 共用写死的
// "section-guide" 导致右侧大纲多个条目指向同一元素、点击全部跳到第一个。
const cleanId = title.trim().replace(/\s+/g, '-');
---

<div class="guide-block toc-chunk" data-title={title} id={cleanId} {...srcAttrs(Astro.props)}>
  <div class="guide-header">{title}</div>
  <div class="guide-content">
    <slot />
  </div>
</div>

<style>
  .guide-block {
    background-color: transparent;
    border: none;
    border-left: 2px solid var(--sl-color-hairline);
    padding: 0.2rem 0 0.2rem 0.85rem;
    margin: 1.5rem 0 1.25rem;
    color: var(--sl-color-gray-2);
  }
  .guide-header {
    font-weight: 700;
    font-style: normal;
    color: var(--sl-color-white);
    margin-bottom: 0.4rem;
    font-size: 1rem;
  }
  .guide-content {
    padding: 0;
  }
</style>