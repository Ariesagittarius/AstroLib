---
const title = "章节导读";
// 与其他卡片组件保持一致的 id 规则（标题转连字符），避免同页多个 Guide 共用写死的
// "section-guide" 导致右侧大纲多个条目指向同一元素、点击全部跳到第一个。
const cleanId = title.trim().replace(/\s+/g, '-');
---

<div class="guide-block toc-chunk" data-title={title} id={cleanId}>
  <div class="guide-header">{title}</div>
  <div class="guide-content">
    <slot />
  </div>
</div>

<style>
  .guide-block {
    background-color: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--sl-color-gray-3);
  }
  .guide-header {
    font-weight: bold;
    font-style: normal;
    color: var(--sl-color-white);
    margin-bottom: 0.5rem;
  }
</style>