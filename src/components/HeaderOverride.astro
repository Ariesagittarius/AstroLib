---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="vp-header-inner">

	<div class="vp-brand-wrapper">

		<button
			type="button"
			class="vp-sidebar-toggle-btn"
			id="vp-sidebar-toggle-btn"
			aria-label="打开全书章节目录"
			aria-expanded="false"
			aria-controls="starlight__sidebar"
		>
			<svg class="vp-icon-bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="3" y1="6" x2="21" y2="6" />
				<line x1="3" y1="12" x2="21" y2="12" />
				<line x1="3" y1="18" x2="21" y2="18" />
			</svg>
			<svg class="vp-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>

		<a href="/" class="vp-brand-link" aria-label="AstroLib 首页">
			<div class="vp-logo-wrap" aria-hidden="true">
				<svg class="vp-logo-svg" viewBox="0 0 32 32" fill="none" stroke="currentColor">
					<path d="M4 22.5C4 22.5 8.5 20.5 16 20.5C23.5 20.5 28 22.5 28 22.5V9.5C28 9.5 23.5 7.5 16 7.5C8.5 7.5 4 9.5 4 9.5V22.5Z" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
					<path d="M16 7.5V20.5" stroke-width="2" stroke-linecap="round"/>
					<path d="M16 1.5L17.2 5.3L21 6.5L17.2 7.7L16 11.5L14.8 7.7L11 6.5L14.8 5.3L16 1.5Z" fill="currentColor" stroke="none"/>
				</svg>
			</div>
			<span class="vp-site-name">AstroLib</span>
		</a>
	</div>

	<div class="vp-search-wrapper print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="print:hidden vp-right-group right-group">

		<div class="vp-header-theme-group sl-hidden md:sl-flex">
			<ThemeSelect />
		</div>

		<div class="vp-nav-divider sl-hidden md:sl-block" aria-hidden="true"></div>

		<div class="vp-social-group sl-hidden lg:sl-flex">
			<a href="/dev/" class="vp-header-link vp-dev-link" title="项目开发与架构文档">开发者</a>
			<SocialIcons />
		</div>

		<div class="sl-hidden md:sl-block">
			<LanguageSelect />
		</div>
	</div>
</div>

<style>.vp-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		height: 100%;
		gap: 0.75rem;
	}

	.vp-brand-wrapper {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.vp-sidebar-toggle-btn {
		display: none;
	}

	@media (max-width: 49.999rem) {
		.vp-sidebar-toggle-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.25rem;
			height: 2.25rem;
			padding: 0.35rem;
			margin-right: 0.45rem;
			border-radius: 4px;
			border: none;
			background: transparent;
			color: var(--sl-color-gray-1, #2c3e50);
			cursor: pointer;
			flex-shrink: 0;
			transition: background-color 0.15s ease, color 0.15s ease;
		}

		:global([data-theme='dark']) .vp-sidebar-toggle-btn {
			color: var(--sl-color-gray-2, #e2e8f0);
		}

		.vp-sidebar-toggle-btn:hover {
			background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.1));
			color: var(--sl-color-text-accent);
		}

		.vp-sidebar-toggle-btn svg {
			width: 1.25rem;
			height: 1.25rem;
		}

		.vp-sidebar-toggle-btn .vp-icon-close {
			display: none;
		}

		:global(body[data-mobile-menu-expanded]) .vp-sidebar-toggle-btn .vp-icon-bars {
			display: none;
		}

		:global(body[data-mobile-menu-expanded]) .vp-sidebar-toggle-btn .vp-icon-close {
			display: block;
		}
	}

	.vp-brand-link {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		text-decoration: none;
		color: inherit;
	}
	.vp-logo-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--sl-color-accent, #3451b2);
	}
	:global([data-theme='dark']) .vp-logo-wrap {
		color: var(--sl-color-accent, #a8b1ff);
	}
	.vp-logo-svg {
		width: 1.35rem;
		height: 1.35rem;
		flex-shrink: 0;
	}
	.vp-site-name {
		font-family: var(--font-brand, 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--sl-color-white, #3c3c43);
		white-space: nowrap;
	}

	.vp-search-wrapper {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		max-width: 16rem;
		margin-left: 0.25rem;
		min-width: 0;
	}

	@media (max-width: 49.999rem) {
		.vp-search-wrapper {
			max-width: none;
			margin-right: 0.25rem;
		}
	}

	.vp-right-group {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-left: auto;
		flex-shrink: 0;
	}

	.vp-header-nav-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}
	.vp-header-link {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.45rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		border-radius: 4px;
		transition: color 0.2s, background-color 0.2s;
		white-space: nowrap;
	}
	.vp-header-link:hover {
		color: var(--sl-color-white);
		background-color: transparent;
	}

	.vp-header-theme-group {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.vp-social-group {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		opacity: 0.6;
		transition: opacity 0.2s ease;
	}
	.vp-social-group:hover {
		opacity: 1;
	}

	.vp-nav-divider {
		width: 1px;
		height: 1.15rem;
		background-color: var(--sl-color-hairline, #e2e2e3);
		margin: 0 0.1rem;
		flex-shrink: 0;
	}
</style>

<script>function setupMobileSidebarToggle() {
		const btn = document.getElementById('vp-sidebar-toggle-btn');
		if (!btn || btn.dataset.bound) return;
		btn.dataset.bound = 'true';

		btn.addEventListener('click', () => {
			const starlightBtn = document.querySelector('starlight-menu-button button') as HTMLButtonElement | null;
			if (starlightBtn) {
				starlightBtn.click();
			} else {
				const isExpanded = document.body.hasAttribute('data-mobile-menu-expanded');
				document.body.toggleAttribute('data-mobile-menu-expanded', !isExpanded);
			}
			const expanded = document.body.hasAttribute('data-mobile-menu-expanded');
			btn.setAttribute('aria-expanded', String(expanded));
		});

		const observer = new MutationObserver(() => {
			const expanded = document.body.hasAttribute('data-mobile-menu-expanded');
			btn.setAttribute('aria-expanded', String(expanded));
		});
		observer.observe(document.body, { attributes: true, attributeFilter: ['data-mobile-menu-expanded'] });
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupMobileSidebarToggle);
	} else {
		setupMobileSidebarToggle();
	}
	document.addEventListener('astro:page-load', setupMobileSidebarToggle);
</script>
