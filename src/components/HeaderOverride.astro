---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import HeaderToolsMenu from './HeaderToolsMenu.astro';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="vp-header-inner">

	<div class="vp-brand-wrapper">

		<button
			type="button"
			class="vp-sidebar-toggle-btn"
			id="vp-sidebar-toggle-btn"
			aria-label="打开全书章节目录"
			aria-expanded="false"
			aria-controls="starlight__sidebar"
		>
			<svg class="vp-icon-bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="3" y1="6" x2="21" y2="6" />
				<line x1="3" y1="12" x2="21" y2="12" />
				<line x1="3" y1="18" x2="21" y2="18" />
			</svg>
			<svg class="vp-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>

		<a href="/" class="vp-brand-link" aria-label="AstroLib 首页">
			<div class="vp-logo-wrap" aria-hidden="true">
				<img src="/astrolib-logo.png" class="vp-logo-img" alt="AstroLib 徽标" width="28" height="22" />
			</div>
			<span class="vp-site-name">AstroLib</span>
		</a>
	</div>

	<div class="vp-search-wrapper print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="print:hidden vp-right-group right-group">

		<HeaderToolsMenu />

		<div class="vp-header-theme-group">
			<ThemeSelect />
		</div>

		<div class="vp-social-group sl-hidden sm:sl-flex">
			<SocialIcons />
		</div>

		<div class="sl-hidden md:sl-block">
			<LanguageSelect />
		</div>
	</div>
</div>

<style>.vp-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		height: 100%;
		gap: 0.75rem;
	}

	.vp-brand-wrapper {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.vp-sidebar-toggle-btn {
		display: none;
	}

	@media (max-width: 49.999rem) {
		.vp-sidebar-toggle-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.25rem;
			height: 2.25rem;
			padding: 0.35rem;
			margin-right: 0.45rem;
			border-radius: 4px;
			border: none;
			background: transparent;
			color: var(--sl-color-gray-1, #2c3e50);
			cursor: pointer;
			flex-shrink: 0;
			transition: background-color 0.15s ease, color 0.15s ease;
		}

		:global([data-theme='dark']) .vp-sidebar-toggle-btn {
			color: var(--sl-color-gray-2, #e2e8f0);
		}

		.vp-sidebar-toggle-btn:hover {
			background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.1));
			color: var(--sl-color-text-accent);
		}

		.vp-sidebar-toggle-btn svg {
			width: 1.25rem;
			height: 1.25rem;
		}

		.vp-sidebar-toggle-btn .vp-icon-close {
			display: none;
		}

		:global(body[data-mobile-menu-expanded]) .vp-sidebar-toggle-btn .vp-icon-bars {
			display: none;
		}

		:global(body[data-mobile-menu-expanded]) .vp-sidebar-toggle-btn .vp-icon-close {
			display: block;
		}
	}

	.vp-brand-link {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		text-decoration: none;
		color: inherit;
	}
	.vp-logo-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.vp-logo-img {
		width: 1.65rem;
		height: auto;
		max-height: 1.5rem;
		object-fit: contain;
		flex-shrink: 0;
		display: block;
		transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
	}
	.vp-brand-link:hover .vp-logo-img {
		transform: scale(1.05);
	}
	.vp-site-name {
		font-family: var(--font-brand, 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--sl-color-white, #3c3c43);
		white-space: nowrap;
	}

	.vp-search-wrapper {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		max-width: 42rem;
		margin-inline: 1rem;
		min-width: 0;
	}

	@media (max-width: 49.999rem) {
		.vp-search-wrapper {
			max-width: none;
			margin-inline: 0.35rem;
		}
	}

	.vp-right-group {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-left: auto;
		flex-shrink: 0;
	}

	.vp-header-theme-group {
		display: contents;
	}

	.vp-social-group {
		display: contents;
	}
</style>

<script>function setupMobileSidebarToggle() {
		const btn = document.getElementById('vp-sidebar-toggle-btn');
		if (!btn || btn.dataset.bound) return;
		btn.dataset.bound = 'true';

		btn.addEventListener('click', () => {
			const starlightBtn = document.querySelector('starlight-menu-button button') as HTMLButtonElement | null;
			if (starlightBtn) {
				starlightBtn.click();
			} else {
				const isExpanded = document.body.hasAttribute('data-mobile-menu-expanded');
				document.body.toggleAttribute('data-mobile-menu-expanded', !isExpanded);
			}
			const expanded = document.body.hasAttribute('data-mobile-menu-expanded');
			btn.setAttribute('aria-expanded', String(expanded));
		});

		const observer = new MutationObserver(() => {
			const expanded = document.body.hasAttribute('data-mobile-menu-expanded');
			btn.setAttribute('aria-expanded', String(expanded));
		});
		observer.observe(document.body, { attributes: true, attributeFilter: ['data-mobile-menu-expanded'] });
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupMobileSidebarToggle);
	} else {
		setupMobileSidebarToggle();
	}
	document.addEventListener('astro:page-load', setupMobileSidebarToggle);
</script>
