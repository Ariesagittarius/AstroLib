---
const { title } = Astro.props;
const cleanId = title ? encodeURIComponent(title.trim().replace(/\s+/g, '-')) : undefined;
---

<div class="variant-card toc-chunk" data-title={title} id={cleanId}>
  <div class="card-header">🎯 {title}</div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .variant-card {
    border: 1px solid #f97316;
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow: hidden;
  }
  .card-header {
    background-color: #fff7ed;
    color: #9a3412;
    padding: 0.6rem 1rem;
    font-weight: bold;
    border-bottom: 1px solid #f97316;
  }
  .card-body {
    padding: 1rem;
  }
</style>