---
// 自定义右侧侧边栏组件 - 替代 Starlight 的 PageSidebar.astro
// 模块化架构：逻辑解耦至 src/components/sidebar/ 与 src/core/indexing/cross-ref-indexer.mjs
import { collections } from '../config/collections.config.mjs';
import { features, crossRefRefs } from '../config/features.config.mjs';
import M3Loading from './common/M3Loading.astro';

// 引用联动模式：'interactive'（默认，可点击/跨页联动）| 'static'（统一静态 chip）。
const refsMode = crossRefRefs() === 'static' ? 'static' : 'interactive';

const pathname = Astro.url.pathname;

// 1. 深度遍历两级结构，感知当前路由所属的图书及其 TOC 规则
let currentBook = null;
let currentCol = null;
for (const col of collections) {
  const matchedBook = col.books.find(book => pathname.includes(`/collections/${col.slug}/${book.slug}/`));
  if (matchedBook) {
    currentCol = col;
    currentBook = matchedBook;
    break;
  }
}

// 2. 备用安全降级方案
if (!currentBook) {
  currentCol = collections[0];
  currentBook = collections[0].books[0];
}
const bookConfigJson = JSON.stringify(currentBook);
---

<aside class="astrolib-sideload-dock custom-page-sidebar" id="astrolib-sideload-dock" data-book-key={`${currentCol.slug}/${currentBook.slug}`} data-refs-mode={refsMode} data-book-config={bookConfigJson}>
  <!-- VitePress outline-marker：跟随滚动高亮项的 2px 品牌色指示条（JS 更新 top） -->
  <div class="outline-marker" aria-hidden="true"></div>

  <!-- 面板 1: 本章大纲 (默认常驻) -->
  <section class="sideload-panel-view" data-panel-id="toc" aria-hidden="false">
    <div class="toc-container">
      <div class="toc-header-block">
        <h2 class="toc-title">本节大纲</h2>
      </div>
      <ul id="custom-toc-list" class="toc-list">
        <li class="toc-loading-item">
          <M3Loading variant="default" size="compact" layout="inline" label="正在提取教辅大纲..." />
        </li>
      </ul>
    </div>
  </section>

  <!-- 面板 2: 课后习题专属右侧抽屉面板 -->
  <section class="sideload-panel-view" data-panel-id="exercises" aria-hidden="true">
    <div class="exercise-sidebar-panel" id="exercise-sidebar-panel" aria-hidden="true">
      <div class="ex-sidebar-header">
        <div class="ex-sidebar-title-group">
          <!-- 返回本章大纲快捷按钮 -->
          <button
            type="button"
            class="sideload-back-btn"
            id="sideload-back-to-toc"
            title="返回本节大纲 (Esc)"
            aria-label="返回本节大纲"
          >
            <md-icon class="sideload-back-icon" aria-hidden="true">arrow_back</md-icon>
          </button>
          <h3 class="ex-sidebar-title" id="ex-sidebar-title">课后习题</h3>
          <span class="ex-sidebar-count-badge" id="ex-sidebar-count">0 题</span>
        </div>
        <div class="ex-sidebar-actions">
          <button
            type="button"
            class="ex-sidebar-action-btn"
            id="ex-sidebar-open-modal"
            title="在完整题库中心打开 (Alt+E)"
            aria-label="打开完整题库"
          >
            <md-icon class="ex-modal-icon" aria-hidden="true">open_in_new</md-icon>
          </button>
          <button
            type="button"
            class="ex-sidebar-action-btn"
            id="ex-sidebar-close"
            title="关闭习题栏并恢复大纲 (Esc)"
            aria-label="关闭习题栏"
          >
            <md-icon class="ex-close-icon" aria-hidden="true">close</md-icon>
          </button>
        </div>
      </div>
      <div class="ex-sidebar-content" id="ex-sidebar-content">
        <!-- 动态渲染轻量题目卡片 -->
      </div>
    </div>
  </section>
</aside>

<!-- 全局侧载抽屉遮罩 (在 Tablet/Mobile 抽屉模式下激活) -->
<div class="astrolib-sideload-scrim" id="astrolib-sideload-scrim" aria-hidden="true"></div>

<!-- 移动端本地导航 VPLocalNav（VitePress 移植：顶部 sticky 条 + 大纲 popup 下拉面板） -->
<div class="vp-local-nav" data-vp-local-nav>
  <div class="vp-local-nav-container">
    <button class="vp-local-nav-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="vp-local-nav-panel" aria-label="本章大纲" title="本章大纲">
      <md-icon class="header-mdicon vp-local-nav-mdicon" aria-hidden="true">toc</md-icon>
    </button>
    <div class="vp-local-nav-items" id="vp-local-nav-panel" aria-hidden="true">
      <div class="vp-local-nav-header">
        <a class="vp-local-nav-top-link" href="#" data-tooltip="返回顶部" title="返回顶部" aria-label="返回顶部">
          <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">arrow_upward</md-icon>
        </a>
        <div class="vp-local-nav-actions">
          {features.exercises?.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-exercise-trigger data-tooltip="课后习题" title="查看本章课后真题与自测练习" aria-label="课后习题与真题">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">quiz</md-icon>
            </button>
          )}
          {features.inspector.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-inspector-trigger data-tooltip="模块速查" title="查看全书模块索引速查" aria-label="模块索引速查">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">table_chart</md-icon>
            </button>
          )}
          {features.relationGraph.enabled && (
            <button type="button" class="vp-local-nav-btn-link relation-graph-trigger" data-feature="relationGraph" data-open-relation-graph data-tooltip="关系图谱" title="查看全书章节内联关系图谱" aria-label="关系图谱">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">account_tree</md-icon>
            </button>
          )}
          {features.feedback?.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-feedback-trigger data-tooltip="读者勘误" title="读者段落勘误与反馈" aria-label="读者勘误">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">rate_review</md-icon>
            </button>
          )}
          {features.chapterExport?.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-chapter-export-trigger data-tooltip="导出本章" title="导出本章为 LaTeX / PDF" aria-label="导出本章">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">download</md-icon>
            </button>
          )}
          <button type="button" class="vp-local-nav-close-btn" data-close-mobile-toc data-tooltip="关闭大纲" title="关闭本页大纲" aria-label="关闭本页大纲">
            <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">close</md-icon>
          </button>
        </div>
      </div>
      <div class="vp-local-nav-outline">
        <ul id="vp-local-nav-toc-list" class="toc-list">
          <li class="toc-loading-item">
            <M3Loading variant="default" size="compact" layout="inline" label="正在提取教辅大纲..." />
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  /* 1. 默认隐藏所有自定义大纲，防止在移动端正文中泄露 */
  .custom-page-sidebar {
    display: none;
  }

  /* 2. 仅在桌面端 (>= 72rem) 显示并置于右栏内部黏性跟随，杜绝超宽屏漂移 */
  @media (min-width: 72rem) {
    .custom-page-sidebar {
      display: block;
      position: sticky;
      top: var(--sl-nav-height);
      width: 100%;
      height: auto;
      max-height: calc(100vh - var(--sl-nav-height));
      overflow-y: auto;
      padding: 1.5rem 0.5rem 2rem 1rem;
      font-size: var(--sl-text-xs);
      z-index: 1;
    }
  }

  /* outline-marker：2px 宽的竖条，绝对定位在 aside 左边缘（与链接左 border 对齐） */
  .outline-marker {
    position: absolute;
    left: 0.5rem;
    width: 2px;
    height: 18px;
    background: var(--sl-color-text-accent);
    border-radius: 1px;
    opacity: 0;
    transition: top 0.25s cubic-bezier(0, 1, 0.5, 1), opacity 0.25s;
    pointer-events: none;
    z-index: 1;
  }

  .toc-header-block {
    margin-bottom: 0.85rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .toc-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 0.45rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .toc-header-actions {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .sidebar-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
    font-size: 0.6875rem;
    font-weight: 500;
    background-color: var(--sl-color-bg-inline-code);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-hairline);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .sidebar-action-btn:hover {
    background-color: var(--sl-color-accent-low);
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }

  .action-btn-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .vp-local-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.65rem;
    border-bottom: 1px solid var(--sl-color-hairline, #e2e2e3);
    min-height: 2.35rem;
    box-sizing: border-box;
    background-color: var(--sl-color-bg-sidebar, #161618);
  }

  .vp-local-nav-top-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border-radius: var(--md-shape-corner-full, 9999px);
    color: var(--sl-color-gray-2);
    background: transparent;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
    text-decoration: none;
    line-height: 1;
  }
  .vp-local-nav-top-link:hover {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-gray-6, rgba(125, 125, 125, 0.12));
  }
  .vp-local-nav-top-link md-icon,
  .vp-local-nav-top-link svg {
    --md-icon-size: 20px;
    --md-icon-font: 'Material Symbols Outlined';
    font-size: 20px;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  .vp-local-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .vp-local-nav-btn-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border-radius: var(--md-shape-corner-full, 9999px);
    color: var(--sl-color-gray-2);
    background: transparent;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
    line-height: 1;
  }
  .vp-local-nav-btn-link:hover {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-gray-6, rgba(125, 125, 125, 0.12));
  }
  .vp-local-nav-btn-link .action-btn-icon,
  .vp-local-nav-btn-link md-icon {
    --md-icon-size: 20px;
    --md-icon-font: 'Material Symbols Outlined';
    font-size: 20px;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  .vp-local-nav-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border-radius: var(--md-shape-corner-full, 9999px);
    background: transparent;
    color: var(--sl-color-gray-2);
    border: none;
    cursor: pointer;
    margin-left: 0.25rem;
    transition: all 0.15s ease;
    flex-shrink: 0;
    line-height: 1;
  }
  .vp-local-nav-close-btn:hover {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-gray-6, rgba(125, 125, 125, 0.12));
  }
  .vp-local-nav-close-btn md-icon,
  .vp-local-nav-close-btn svg {
    --md-icon-size: 20px;
    --md-icon-font: 'Material Symbols Outlined';
    font-size: 20px;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  .sideload-back-icon,
  .ex-modal-icon,
  .ex-close-icon {
    --md-icon-size: 18px;
    --md-icon-font: 'Material Symbols Outlined';
    font-size: 18px;
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  /* ==========================================================================
     Google Material 3 Plain Tooltip System for Outline Header Actions
     ========================================================================== */
  .vp-local-nav-header [data-tooltip] {
    position: relative;
  }

  .vp-local-nav-header [data-tooltip]::before {
    content: attr(data-tooltip);
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(-3px);
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    border-radius: var(--md-shape-corner-extra-small, 4px);
    background-color: var(--md-sys-color-inverse-surface, #313033);
    color: var(--md-sys-color-inverse-on-surface, #f4eff4);
    box-shadow: var(--md-elevation-level-2, 0 2px 6px rgba(0, 0, 0, 0.25));
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s cubic-bezier(0.2, 0, 0, 1), transform 0.15s cubic-bezier(0.2, 0, 0, 1), visibility 0.15s;
    z-index: 100;
  }

  .vp-local-nav-header [data-tooltip]::after {
    content: '';
    position: absolute;
    top: calc(100% + 3px);
    left: 50%;
    transform: translateX(-50%) translateY(-3px);
    border-width: 0 4px 5px 4px;
    border-style: solid;
    border-color: transparent transparent var(--md-sys-color-inverse-surface, #313033) transparent;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s cubic-bezier(0.2, 0, 0, 1), transform 0.15s cubic-bezier(0.2, 0, 0, 1), visibility 0.15s;
    z-index: 100;
  }

  .vp-local-nav-header [data-tooltip]:hover::before,
  .vp-local-nav-header [data-tooltip]:hover::after,
  .vp-local-nav-header [data-tooltip]:focus-visible::before,
  .vp-local-nav-header [data-tooltip]:focus-visible::after {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Left-anchored tooltip for the leftmost return-to-top button */
  .vp-local-nav-header .vp-local-nav-top-link[data-tooltip]::before {
    left: 0;
    transform: translateX(0) translateY(-3px);
  }
  .vp-local-nav-header .vp-local-nav-top-link[data-tooltip]::after {
    left: 1rem;
    transform: translateX(-50%) translateY(-3px);
  }
  .vp-local-nav-header .vp-local-nav-top-link[data-tooltip]:hover::before,
  .vp-local-nav-header .vp-local-nav-top-link[data-tooltip]:focus-visible::before {
    transform: translateX(0) translateY(0);
  }
  .vp-local-nav-header .vp-local-nav-top-link[data-tooltip]:hover::after,
  .vp-local-nav-header .vp-local-nav-top-link[data-tooltip]:focus-visible::after {
    transform: translateX(-50%) translateY(0);
  }

  /* Right-anchored tooltip for the rightmost close button */
  .vp-local-nav-header .vp-local-nav-close-btn[data-tooltip]::before {
    left: auto;
    right: 0;
    transform: translateX(0) translateY(-3px);
  }
  .vp-local-nav-header .vp-local-nav-close-btn[data-tooltip]::after {
    left: auto;
    right: 0.85rem;
    transform: translateX(50%) translateY(-3px);
  }
  .vp-local-nav-header .vp-local-nav-close-btn[data-tooltip]:hover::before,
  .vp-local-nav-header .vp-local-nav-close-btn[data-tooltip]:focus-visible::before {
    transform: translateX(0) translateY(0);
  }
  .vp-local-nav-header .vp-local-nav-close-btn[data-tooltip]:hover::after,
  .vp-local-nav-header .vp-local-nav-close-btn[data-tooltip]:focus-visible::after {
    transform: translateX(50%) translateY(0);
  }

  /* Suppress hover stickiness on touch-only screens */
  @media (hover: none) {
    .vp-local-nav-header [data-tooltip]::before,
    .vp-local-nav-header [data-tooltip]::after {
      display: none !important;
    }
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .toc-item {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.toc-group) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.toc-heading-row) {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-top: 0.45rem;
    margin-bottom: 0.15rem;
  }

  :global(.toc-group:first-child .toc-heading-row) {
    margin-top: 0;
  }

  :global(.toc-collapse-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    border-radius: 50%;
    flex-shrink: 0;
    line-height: 1;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  :global(.toc-collapse-btn:hover) {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.12));
  }

  :global(.toc-collapse-placeholder) {
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    flex-shrink: 0;
  }

  :global(.toc-caret-icon) {
    display: block;
    width: 16px;
    height: 16px;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
  }

  :global(.toc-group[data-collapsed='true'] .toc-caret-icon) {
    transform: rotate(-90deg);
  }

  :global(.toc-sublist) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  :global(.toc-group[data-collapsed='true'] .toc-sublist) {
    display: none;
  }

  :global(.toc-link) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.65rem;
    border-radius: 9999px;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
    line-height: 1.35;
    font-size: 0.8rem;
    flex: 1;
    min-width: 0;
  }

  :global(.toc-link:hover) {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.08));
  }

  :global(.toc-link.active) {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    background-color: var(--sl-color-accent-low);
    border-radius: 9999px;
  }

  /* 章节标题：重置内联 margin，由 .toc-heading-row 统一把控间距，杜绝折叠指示器垂直错位 */
  :global(.toc-heading.toc-level-2) {
    margin: 0;
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--sl-color-white);
    line-height: 1.35;
  }
  :global(.toc-heading.toc-level-3) {
    margin: 0;
    padding-left: 0.5rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
    line-height: 1.35;
  }
  :global(.toc-heading.toc-level-4) {
    margin: 0;
    padding-left: 1rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
    line-height: 1.35;
  }

  /* 子条目（定理/例题/定义等卡片块）微缩进，视觉从属于章节 */
  :global(.toc-link:not(.toc-heading)) {
    padding-left: 0.65rem;
    font-size: 0.775rem;
    line-height: 1.35;
  }

  /* 模块学术排版：纯文字前缀（定理、定义、例等），彻底移除高噪彩色胶囊 */
  :global(.toc-chip) {
    display: inline-block !important;
    font-size: 0.75rem !important;
    font-weight: 600 !important;
    color: var(--sl-color-gray-1) !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 0 !important;
    margin-right: 0.35rem !important;
    line-height: 1.5 !important;
    flex-shrink: 0;
  }
  :global(.toc-link.active .toc-chip) {
    color: var(--sl-color-text-accent) !important;
    background: transparent !important;
    font-weight: 700 !important;
  }
  :global([data-theme='dark'] .toc-link.active .toc-chip) {
    color: var(--sl-color-text-accent) !important;
    background: transparent !important;
    font-weight: 700 !important;
  }

  :global(.toc-number) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .toc-loading {
    color: var(--sl-color-gray-4);
    font-style: italic;
  }
</style>

<script>
  import '@material/web/icon/icon.js';
  import { initPageSidebar } from './sidebar/toc-generator';
  import { setupVPLocalNav } from './sidebar/local-nav';
  import { initMermaid, setupMermaidThemeListener } from './sidebar/mermaid-loader';
  import { initImageBlur } from './sidebar/image-blur-loader';
  import { getExerciseSidebarController } from './exercises/exercise-sidebar-controller';
  import { sideloadManager } from './sideload/sideload-manager';

  function syncRelationGraphButtonVisibility() {
    const isShow = localStorage.getItem('astro-show-relation-graph-btn') !== 'false';
    document.querySelectorAll('.relation-graph-trigger').forEach((btn) => {
      (btn as HTMLElement).style.display = isShow ? '' : 'none';
    });
  }

  function handleInit() {
    sideloadManager.init();
    setupVPLocalNav();
    initPageSidebar();
    syncRelationGraphButtonVisibility();
    initMermaid();
    setupMermaidThemeListener();
    initImageBlur();
    getExerciseSidebarController().init();

    // 绑定侧载抽屉遮罩点击关闭
    const scrim = document.getElementById('astrolib-sideload-scrim');
    if (scrim) {
      scrim.onclick = () => sideloadManager.switchToDefault();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleInit);
  } else {
    handleInit();
  }
  document.addEventListener('astro:page-load', handleInit);
</script>
