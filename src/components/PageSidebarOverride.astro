---
// 自定义右侧侧边栏组件 - 替代 Starlight 的 PageSidebar.astro
// 模块化架构：逻辑解耦至 src/components/sidebar/ 与 src/core/indexing/cross-ref-indexer.mjs
import { collections } from '../config/collections.config.mjs';
import { features, crossRefRefs } from '../config/features.config.mjs';
import '../styles/components/page-sidebar.css';
import '../styles/components/translation-dock.css';

// 引用联动模式：'interactive'（默认，可点击/跨页联动）| 'static'（统一静态 chip）。
const refsMode = crossRefRefs() === 'static' ? 'static' : 'interactive';

const pathname = Astro.url.pathname;

// 1. 深度遍历两级结构，感知当前路由所属的图书及其 TOC 规则
let currentBook = null;
let currentCol = null;
for (const col of collections) {
  const matchedBook = col.books.find(book => pathname.includes(`/collections/${col.slug}/${book.slug}/`));
  if (matchedBook) {
    currentCol = col;
    currentBook = matchedBook;
    break;
  }
}

// 2. 备用安全降级方案
if (!currentBook) {
  currentCol = collections[0];
  currentBook = collections[0].books[0];
}
const bookConfigJson = JSON.stringify(currentBook);
---

<aside class="astrolib-sideload-dock custom-page-sidebar" id="astrolib-sideload-dock" data-book-key={`${currentCol?.slug || 'math'}/${currentBook?.slug || 'linear_algebra_geometry'}`} data-refs-mode={refsMode} data-book-config={bookConfigJson}>
  <!-- VitePress outline-marker：跟随滚动高亮项的 2px 品牌色指示条（JS 更新 top） -->
  <div class="outline-marker" aria-hidden="true"></div>

  <!-- 面板 1: 本章大纲 (默认常驻) -->
  <section class="sideload-panel-view" data-panel-id="toc" aria-hidden="false">
    <div class="toc-container">
      <div class="toc-header-block">
        <h2 class="toc-title">本节大纲</h2>
      </div>
      <ul id="custom-toc-list" class="toc-list">
        <li class="toc-loading-item" aria-live="polite">
          <div class="toc-skeleton-pulse" aria-hidden="true"></div>
          <span class="toc-skeleton-text">正在提取教辅大纲...</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 面板 2: 课后习题专属右侧抽屉面板 -->
  <section class="sideload-panel-view" data-panel-id="exercises" aria-hidden="true">
    <div class="exercise-sidebar-panel" id="exercise-sidebar-panel" aria-hidden="true">
      <div class="ex-sidebar-header">
        <div class="ex-sidebar-title-group">
          <!-- 返回本章大纲快捷按钮 -->
          <button
            type="button"
            class="sideload-back-btn"
            id="sideload-back-to-toc"
            title="返回本节大纲 (Esc)"
            aria-label="返回本节大纲"
          >
            <md-icon class="sideload-back-icon" aria-hidden="true">arrow_back</md-icon>
          </button>
          <h3 class="ex-sidebar-title" id="ex-sidebar-title">课后习题</h3>
          <span class="ex-sidebar-count-badge" id="ex-sidebar-count">0 题</span>
        </div>
        <div class="ex-sidebar-actions">
          <button
            type="button"
            class="ex-sidebar-action-btn"
            id="ex-sidebar-open-modal"
            title="在完整题库中心打开 (Alt+E)"
            aria-label="打开完整题库"
          >
            <md-icon class="ex-modal-icon" aria-hidden="true">open_in_new</md-icon>
          </button>
          <button
            type="button"
            class="ex-sidebar-action-btn"
            id="ex-sidebar-close"
            title="关闭习题栏并恢复大纲 (Esc)"
            aria-label="关闭习题栏"
          >
            <md-icon class="ex-close-icon" aria-hidden="true">close</md-icon>
          </button>
        </div>
      </div>
      <div class="ex-sidebar-content" id="ex-sidebar-content">
        <!-- 动态渲染轻量题目卡片 -->
      </div>
    </div>
  </section>

  <!-- 面板 3: AI 书内智能问答专属侧载面板 -->
  <section class="sideload-panel-view" data-panel-id="ai" aria-hidden="true">
    <div class="ai-sidebar-panel" id="ai-sidebar-panel" aria-hidden="true">
      <!-- 侧载激活时由 chat-controller 将聊天主面板挂载于此 -->
    </div>
  </section>

  <!-- 面板 4: 双语助读与章节翻译专属侧载面板 -->
  <section class="sideload-panel-view" data-panel-id="translate" aria-hidden="true">
    <div class="trans-sidebar-panel" id="trans-sidebar-panel" aria-hidden="true">
      <div class="trans-sidebar-header">
        <div class="trans-sidebar-title-group">
          <!-- 返回本章大纲快捷按钮 -->
          <button
            type="button"
            class="sideload-back-btn"
            id="trans-back-to-toc"
            title="返回本节大纲 (Esc)"
            aria-label="返回本节大纲"
          >
            <md-icon class="sideload-back-icon" aria-hidden="true">arrow_back</md-icon>
          </button>
          <h3 class="trans-sidebar-title">双语助读</h3>
          <span class="trans-sidebar-count-badge" id="trans-para-count">0 段</span>
          <span class="trans-satisfied-count-badge" id="trans-satisfied-count" style="display: none;" title="已采纳满意段落数">0 采纳</span>
        </div>
        <div class="trans-sidebar-actions">
          <button
            type="button"
            class="trans-sidebar-action-btn"
            id="trans-sidebar-export"
            title="导出译文 (Markdown / JSON / TXT)"
            aria-label="导出译文"
          >
            <md-icon class="trans-action-icon" aria-hidden="true">download</md-icon>
          </button>
          <button
            type="button"
            class="trans-sidebar-action-btn"
            id="trans-sidebar-settings"
            title="设置 API Key 与模型配置"
            aria-label="设置 API Key"
          >
            <md-icon class="trans-action-icon" aria-hidden="true">settings</md-icon>
          </button>
          <button
            type="button"
            class="trans-sidebar-action-btn"
            id="trans-sidebar-refresh"
            title="重新翻译本节"
            aria-label="重新翻译"
          >
            <md-icon class="trans-action-icon" aria-hidden="true">refresh</md-icon>
          </button>
          <button
            type="button"
            class="trans-sidebar-action-btn"
            id="trans-sidebar-close"
            title="关闭翻译栏并恢复大纲 (Esc)"
            aria-label="关闭翻译栏"
          >
            <md-icon class="trans-action-icon" aria-hidden="true">close</md-icon>
          </button>
        </div>
      </div>

      <!-- 提供商选择栏 (M3 Filter Chips: Google 翻译默认 / Gemini 可选 / DeepSeek 北邮校内) -->
      <div class="trans-provider-bar">
        <span class="trans-provider-label">接口:</span>
        <div class="trans-provider-chips" role="radiogroup" aria-label="选择翻译服务商">
          <button type="button" class="trans-chip is-active" data-provider="google" title="Google 翻译 (成熟/稳定/默认)">
            <span class="trans-chip-dot"></span>
            Google 翻译
          </button>
          <button type="button" class="trans-chip" data-provider="gemini" title="Google Gemini (前沿理科推理/学术深度翻译)">
            <span class="trans-chip-dot"></span>
            Gemini 学术
          </button>
          <button type="button" class="trans-chip" data-provider="bupt" title="DeepSeek V4 Flash (北京邮电大学「人人有算力」校内专属服务，免翻直连)">
            <span class="trans-chip-dot"></span>
            DeepSeek (北邮)
          </button>
          <button type="button" class="trans-chip" data-provider="zhipu" title="智谱开放平台 GLM-4-Flash (免费模型，国内免翻直连)">
            <span class="trans-chip-dot"></span>
            智谱 GLM-4
          </button>
        </div>
      </div>

      <!-- 翻译设置折叠抽屉 (API Key 配置与说明) -->
      <div class="trans-settings-drawer" id="trans-settings-drawer" style="display: none;" aria-hidden="true">
        <div class="trans-settings-inner">
          <div class="trans-settings-header-row">
            <div class="trans-settings-provider-tag" id="trans-settings-provider-tag">
              <span class="trans-settings-tag-dot"></span>
              <span id="trans-settings-provider-name">DeepSeek (北邮)</span>
            </div>
            <button type="button" class="trans-settings-close-btn" id="trans-settings-close" title="收起设置" aria-label="收起设置">
              <md-icon class="trans-settings-close-icon" aria-hidden="true">expand_less</md-icon>
            </button>
          </div>

          <div class="trans-settings-content">
            <!-- 译文呈现方式选择 (侧边栏对照 vs 段落下方显示) -->
            <div class="trans-settings-field">
              <div class="trans-field-label-row">
                <label class="trans-field-label">译文显示类别</label>
              </div>
              <div class="trans-display-mode-chips" role="radiogroup" aria-label="选择译文显示类别">
                <button type="button" class="trans-mode-chip is-active" data-trans-mode="sidebar" title="在右侧侧载栏以 1:1 对照卡片流呈现">
                  侧边栏对照
                </button>
                <button type="button" class="trans-mode-chip" data-trans-mode="inline" title="在正文所有段落下方直接显示译文，不影响右侧边栏">
                  段落下方显示
                </button>
              </div>
              <div class="trans-settings-mode-tip">
                💡 切换为「段落下方显示」后，译文直接呈现在各段落下方，右侧边栏保持显示本节大纲。
              </div>
            </div>

            <div class="trans-settings-field">
              <div class="trans-field-label-row">
                <label for="trans-api-key-input" class="trans-field-label">API 密钥 (API Key)</label>

                <span class="trans-key-status-badge" id="trans-key-status-badge">默认配置</span>
              </div>
              <div class="trans-field-input-box">
                <input
                  type="password"
                  id="trans-api-key-input"
                  class="trans-field-input"
                  placeholder="sk-bupt-... 或 sk-..."
                  spellcheck="false"
                  autocomplete="off"
                />
                <button type="button" class="trans-field-eye-btn" id="trans-key-toggle-eye" title="显示/隐藏密钥" aria-label="显示/隐藏密钥">
                  <md-icon class="trans-field-eye-icon" aria-hidden="true">visibility</md-icon>
                </button>
              </div>
            </div>

            <div class="trans-settings-tip" id="trans-settings-tip">
              💡 密钥仅保存在本地浏览器。若留空，将自动使用服务端默认配置。
            </div>
            <div class="trans-settings-alert" id="trans-settings-alert" style="display: none;"></div>

            <div class="trans-settings-btn-row">
              <button type="button" class="trans-settings-save-btn" id="trans-settings-save">
                <md-icon class="trans-btn-icon" aria-hidden="true">save</md-icon>
                <span class="trans-btn-text">保存并应用</span>
              </button>
              <button type="button" class="trans-settings-clear-btn" id="trans-settings-clear" title="清空本地密钥恢复默认">
                清空密钥
              </button>
              <button type="button" class="trans-settings-more-btn" id="trans-settings-more" title="打开全站 AI 参数设置">
                全站设置
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 译文导出折叠抽屉 (支持双语 Markdown / 中文 Markdown / 文本 / JSON) -->
      <div class="trans-export-drawer" id="trans-export-drawer" style="display: none;" aria-hidden="true">
        <div class="trans-export-inner">
          <div class="trans-export-header-row">
            <span class="trans-export-title">导出章节译文</span>
            <button type="button" class="trans-export-close-btn" id="trans-export-close" title="收起导出面板" aria-label="收起导出面板">
              <md-icon class="trans-export-close-icon" aria-hidden="true">expand_less</md-icon>
            </button>
          </div>

          <div class="trans-export-content">
            <!-- 格式选择 -->
            <div class="trans-export-field">
              <span class="trans-export-label">导出格式</span>
              <div class="trans-export-chips" id="trans-export-fmt-group">
                <button type="button" class="trans-export-chip is-active" data-export-fmt="bilingual-markdown">
                  双语 Markdown (.md)
                </button>
                <button type="button" class="trans-export-chip" data-export-fmt="chinese-markdown">
                  纯中文 Markdown (.md)
                </button>
                <button type="button" class="trans-export-chip" data-export-fmt="bilingual-text">
                  双语文本 (.txt)
                </button>
                <button type="button" class="trans-export-chip" data-export-fmt="json">
                  对照数据 (.json)
                </button>
              </div>
            </div>

            <!-- 范围选择 -->
            <div class="trans-export-field">
              <span class="trans-export-label">导出范围</span>
              <div class="trans-export-chips" id="trans-export-scope-group">
                <button type="button" class="trans-export-chip is-active" data-export-scope="all">
                  全部已译段落
                </button>
                <button type="button" class="trans-export-chip" data-export-scope="satisfied">
                  仅已采纳段落 (<span id="trans-export-satisfied-num">0</span>)
                </button>
              </div>
            </div>

            <div class="trans-export-btn-row">
              <button type="button" class="trans-export-download-btn" id="trans-export-download">
                <md-icon class="trans-btn-icon" aria-hidden="true">file_download</md-icon>
                <span class="trans-btn-text">立即下载文件</span>
              </button>
              <button type="button" class="trans-export-approve-all-btn" id="trans-export-approve-all" title="将当前所有已翻译段落一键标记为满意采纳">
                全部标记为采纳
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 翻译进度条 -->
      <div class="trans-progress-bar" id="trans-progress-bar" style="display: none;">
        <div class="trans-progress-fill" id="trans-progress-fill"></div>
      </div>

      <!-- 段落卡片流容器 (严格 1:1 双向对应正文段落) -->
      <div class="trans-sidebar-content" id="trans-sidebar-content">
        <!-- 动态注入段落对照卡片 -->
      </div>
    </div>
  </section>
</aside>

<!-- 移动端本地导航 VPLocalNav（VitePress 移植：顶部 sticky 条 + 大纲 popup 下拉面板） -->
<div class="vp-local-nav" data-vp-local-nav>
  <div class="vp-local-nav-container">
    <button class="vp-local-nav-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="vp-local-nav-panel" aria-label="本章大纲" title="本章大纲">
      <md-icon class="header-mdicon vp-local-nav-mdicon" aria-hidden="true">toc</md-icon>
    </button>
    <div class="vp-local-nav-items" id="vp-local-nav-panel" aria-hidden="true">
      <div class="vp-local-nav-header">
        <a class="vp-local-nav-top-link" href="#" data-tooltip="返回顶部" title="返回顶部" aria-label="返回顶部">
          <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">arrow_upward</md-icon>
        </a>
        <div class="vp-local-nav-actions">
          {features.translation?.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-translation-trigger data-tooltip="双语助读" title="双语助读与段落翻译" aria-label="双语助读">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">translate</md-icon>
            </button>
          )}
          {features.exercises?.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-exercise-trigger data-tooltip="课后习题" title="查看本章课后真题与自测练习" aria-label="课后习题与真题">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">quiz</md-icon>
            </button>
          )}
          {features.inspector.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-inspector-trigger data-tooltip="模块速查" title="查看全书模块索引速查" aria-label="模块索引速查">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">table_chart</md-icon>
            </button>
          )}
          {features.relationGraph.enabled && (
            <button type="button" class="vp-local-nav-btn-link relation-graph-trigger" data-feature="relationGraph" data-open-relation-graph data-tooltip="关系图谱" title="查看全书章节内联关系图谱" aria-label="关系图谱">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">account_tree</md-icon>
            </button>
          )}
          {features.feedback?.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-feedback-trigger data-tooltip="读者勘误" title="读者段落勘误与反馈" aria-label="读者勘误">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">rate_review</md-icon>
            </button>
          )}
          {features.chapterExport?.enabled && (
            <button type="button" class="vp-local-nav-btn-link" data-chapter-export-trigger data-tooltip="导出本章" title="导出本章为 LaTeX / PDF" aria-label="导出本章">
              <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">download</md-icon>
            </button>
          )}
          <button type="button" class="vp-local-nav-close-btn" data-close-mobile-toc data-tooltip="关闭大纲" title="关闭本页大纲" aria-label="关闭本页大纲">
            <md-icon class="header-mdicon action-btn-icon" aria-hidden="true">close</md-icon>
          </button>
        </div>
      </div>
      <div class="vp-local-nav-outline">
        <ul id="vp-local-nav-toc-list" class="toc-list">
          <li class="toc-loading-item" aria-live="polite">
            <div class="toc-skeleton-pulse" aria-hidden="true"></div>
            <span class="toc-skeleton-text">正在提取教辅大纲...</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>


<script>
  import '@material/web/icon/icon.js';
  import { initPageSidebar } from './sidebar/toc-generator';
  import { setupVPLocalNav } from './sidebar/local-nav';
  import { initMermaid, setupMermaidThemeListener } from './sidebar/mermaid-loader';
  import { initImageBlur } from './sidebar/image-blur-loader';
  import { initExerciseSidebarTriggerDelegation, probeActiveExerciseSession } from './exercises/lazy-exercise-sidebar';
  import { sideloadManager } from './sideload/sideload-manager';
  import '../services/translation/client/translation-dock-controller';

  function syncRelationGraphButtonVisibility() {
    const isShow = localStorage.getItem('astro-show-relation-graph-btn') !== 'false';
    document.querySelectorAll('.relation-graph-trigger').forEach((btn) => {
      (btn as HTMLElement).style.display = isShow ? '' : 'none';
    });
  }

  function handleInit() {
    sideloadManager.init();
    setupVPLocalNav();
    initPageSidebar();
    syncRelationGraphButtonVisibility();
    initMermaid();
    setupMermaidThemeListener();
    initImageBlur();
    initExerciseSidebarTriggerDelegation();
    probeActiveExerciseSession();

    // 绑定侧载抽屉遮罩点击关闭
    const scrim = document.getElementById('astrolib-sideload-scrim');
    if (scrim && !(scrim as any).__sideloadBound) {
      (scrim as any).__sideloadBound = true;
      scrim.addEventListener('click', () => sideloadManager.switchToDefault());
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleInit);
  } else {
    handleInit();
  }
  document.addEventListener('astro:page-load', handleInit);
</script>
