// 自定义右侧侧边栏组件 - 替代 Starlight 的 PageSidebar.astro
// 终极无任何 SyntaxError 重复定义、无任何 ReferenceError 引用错误版本
import fs from 'node:fs';
import path from 'node:path';
import { collections } from '../config/collections.config.mjs';
import { cleanSlug } from '../utils/sidebar.mjs';

const pathname = Astro.url.pathname;

// 1. 深度遍历两级结构，感知当前路由所属的图书及其 TOC 规则
let currentBook = null;
let currentCol = null;
for (const col of collections) {
  const matchedBook = col.books.find(book => pathname.includes(`/collections/${col.slug}/${book.slug}/`));
  if (matchedBook) {
    currentCol = col;
    currentBook = matchedBook;
    break;
  }
}

// 2. 备用安全降级方案
if (!currentBook) {
  currentCol = collections[0];
  currentBook = collections[0].books[0];
}
const bookConfigJson = JSON.stringify(currentBook);

// 3. 构建期递归扫描，仅提取当前图书的全局跨页路由索引
//（按书隔离可让单页 HTML 减少约 3-4 倍；跨书引用退化为静态徽章）
const globalBlockIndex = {};

function walkDir(dir, fileList = []) {
  const files = fs.readdirSync(dir);
  files.forEach(file => {
    const filePath = path.join(dir, file);
    const stat = fs.statSync(filePath);
    if (stat.isDirectory()) {
      walkDir(filePath, fileList);
    } else if (file.endsWith('.mdx') || file.endsWith('.md')) {
      fileList.push(filePath);
    }
  });
  return fileList;
}

try {
  const docsRoot = path.resolve(`src/content/docs/collections/${currentCol.slug}/${currentBook.slug}`);
  if (fs.existsSync(docsRoot)) {
    const allMdxFiles = walkDir(docsRoot);
    const emojiRegex = /[\u{1F300}-\u{1F6FF}\u{1F900}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}\u{27BF}\uFE0F]/gu;

    allMdxFiles.forEach(file => {
      const content = fs.readFileSync(file, 'utf-8');
      
      const relativePath = path.relative('src/content/docs', file);
      const rawSlug = relativePath.replace(/\.mdx?$/, '').replace(/\\/g, '/');
      
      const cleanSlugPath = cleanSlug(rawSlug);
      let urlPath = `/${cleanSlugPath}/`;
      urlPath = urlPath.replace(/\/+/g, '/');

      const tagRegex = /<(Example|Variant|Knowledge|Summary|Method|Conclusion|Block|Solution)\s+title=["'](.*?)["']/g;
      let match;
      while ((match = tagRegex.exec(content)) !== null) {
        const rawTitle = match[2].trim();
        const cleanTitle = rawTitle.replace(emojiRegex, '').trim();

        const cleanId = encodeURIComponent(cleanTitle.replace(/\s+/g, '-'));
        const targetUrl = `${urlPath}#${cleanId}`;

        globalBlockIndex[cleanTitle.replace(/\s+/g, '')] = targetUrl;
      }
    });
  }
} catch (e) {
  console.error("编译期全局索引构建失败", e);
}

const globalIndexJson = JSON.stringify(globalBlockIndex);
---

<aside class="custom-page-sidebar" data-book-config={bookConfigJson} data-global-index={globalIndexJson}>
