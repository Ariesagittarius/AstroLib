<script>
  import renderMathInElement from 'katex/dist/contrib/auto-render.mjs';
  import { initFormulaActions } from '../scripts/formula-actions';

  // —— 引用联动模式（构建期 siteConfig.refs 注入，'interactive' | 'static'）——
  // 配置与跨页索引按书缓存，避免每次 SPA 切换重复 JSON.parse
  //（static 模式下索引为空字符串，直接跳过全部引用建立开销）
  const bookConfigCache = new Map();
  const globalIndexCache = new Map();

  function getBookConfig(aside) {
    const key = aside?.getAttribute('data-book-key') || '';
    if (bookConfigCache.has(key)) return bookConfigCache.get(key);
    const cfg = JSON.parse(aside?.getAttribute('data-book-config') || '{}');
    bookConfigCache.set(key, cfg);
    return cfg;
  }

  function getGlobalIndex(aside) {
    const key = aside?.getAttribute('data-book-key') || '';
    if (globalIndexCache.has(key)) return globalIndexCache.get(key);
    const raw = aside?.getAttribute('data-global-index') || '{}';
    const idx = raw === '{}' ? {} : JSON.parse(raw);
    globalIndexCache.set(key, idx);
    return idx;
  }

  // 紧凑索引值 = “相对图书根目录的路径#锚点”，这里用当前页的图书根前缀拼回完整 URL
  function resolveIndexUrl(rel) {
    const m = location.pathname.match(/^(\/collections\/[^/]+\/[^/]+\/)/);
    return (m ? m[1] : '') + rel;
  }

  // 大纲/抽屉公式二次渲染共用参数（与正文 auto-render 一致）
  const katexConfig = {
    delimiters: [
      { left: '$$', right: '$$', display: true },
      { left: '$', right: '$', display: false },
    ],
    throwOnError: false
  };


  const CHIP_CLASSES = {
    '例': 'chip-example',
    '例题': 'chip-example',
    '变式': 'chip-variant',
    '结论总结': 'chip-conclusion',
    '结论': 'chip-conclusion',
    '经验总结': 'chip-conclusion',
    '方法总结': 'chip-method',
    '方法': 'chip-method',
    '知识点': 'chip-knowledge',
    '导读': 'chip-guide',
    '问题': 'chip-problem'
  };

  /**
   * 依据配置文件进行全自动数据驱动分词
   * 核心修复：排除 "$" 和空白，允许编号部分以 "$" 开头 \$?
   * 从而完美保证 "例题$10.2.2$" 被安全分离为 "例题" 与 "$10.2.2$"
   * 【注】：本文件中此函数已被彻底收归单一声明，绝无 SyntaxError 重复定义问题！
   */
  function parseTitleFromConfig(title, modules) {
    title = title.trim();
    const emojiRegex = /[\u{1F300}-\u{1F6FF}\u{1F900}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}\u{27BF}\uFE0F]/gu;
    title = title.replace(emojiRegex, '').trim();

    for (const [modKey, modMeta] of Object.entries(modules)) {
      const aliases = modMeta.aliases || [modKey];
      for (const alias of aliases) {
        const escapedAlias = alias.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        // 支持可选空格、支持 $ 公式符不被撕裂的强正则
        const regex = new RegExp(`^(${escapedAlias})\\s*(\\$?[\\d\\s\\.].*)$`, 'i');
        const match = title.match(regex);
        
        if (match) {
          return { type: modKey, number: match[2].trim() };
        }
      }
    }

    if (title.includes('导读')) {
      return { type: '导读', number: '' };
    }
    return { type: '模块', number: title };
  }

  /**
   * HTML 标签安全分词器
   */
  function extractOptionsSafely(html) {
    html = html.replace(/([A-D])．/g, '$1.');

    const regex = /(<[^>]+>)|(\s*\b[A-D]\.\s*)/g;
    const parts = html.split(regex);
    
    const options = [];
    let currentOption = null;

    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      if (part === undefined || part === '') continue;

      const delimiterMatch = part.match(/^\s*\b([A-D])\.\s*$/);
      if (delimiterMatch) {
        const label = delimiterMatch[1];
        currentOption = { label, content: '' };
        options.push(currentOption);
      } else {
        if (currentOption) {
          currentOption.content += part;
        }
      }
    }
    return options;
  }

  /**
   * 智能提取选择题，自适应重构为响应式 MD3 选项卡片 (DOM 节点流版本)
   */
  function formatMultipleChoiceQuestions() {
    const cardBodies = document.querySelectorAll('.card-body');
    
    cardBodies.forEach(body => {
      if (body.classList.contains('formatted-choices-v3')) return;

      const textContent = body.textContent || '';
      const hasA = /[A][\.．]\s*/.test(textContent);
      const hasB = /[B][\.．]\s*/.test(textContent);
      if (!hasA || !hasB) return;

      const childNodes = Array.from(body.childNodes);
      const questionNodes = [];
      const optionNodes = [];
      const trailingElements = []; 
      let foundA = false;
      let isProcessingTrailing = false; 

      for (let i = 0; i < childNodes.length; i++) {
        const node = childNodes[i];
        
        if (node.nodeType === Node.ELEMENT_NODE) {
          const isBlockComponent = node.classList.contains('analysis-block') || 
                                   node.classList.contains('note-block') || 
                                   node.classList.contains('fallback-block') || 
                                   node.classList.contains('conclusion-card') || 
                                   node.classList.contains('summary-card') || 
                                   node.classList.contains('method-card') || 
                                   node.classList.contains('guide-block') || 
                                   node.classList.contains('solution-details') ||
                                   node.classList.contains('knowledge-card');
          
          if (isBlockComponent) {
            isProcessingTrailing = true; 
          }

          // 核心优化：后置图片阻断机制
          if (foundA && !isProcessingTrailing) {
            const hasImg = node.tagName === 'IMG' || node.querySelector('img') !== null;
            const text = node.textContent || '';
            const isFigCaption = text.trim().match(/^图\s*(\d+\s*[-－]\s*\d+)$/) !== null;

            if (hasImg || isFigCaption) {
              isProcessingTrailing = true;
            }
          }
        }

        if (isProcessingTrailing) {
          trailingElements.push(node);
        } else {
          if (!foundA) {
            const nodeText = node.textContent || '';
            const aIndex = nodeText.search(/(?:^|[\s\.（\()停\s])A[\.．]/);
            
            if (aIndex !== -1) {
              foundA = true;
              
              if (node.nodeType === Node.TEXT_NODE) {
                const stemText = nodeText.substring(0, aIndex).trim();
                const optionsText = nodeText.substring(aIndex).trim();
                if (stemText) {
                  questionNodes.push(document.createTextNode(stemText));
                }
                const optSpan = document.createElement('span');
                optSpan.innerHTML = optionsText;
                optionNodes.push(optSpan);
              } else if (node.nodeType === Node.ELEMENT_NODE) {
                const html = node.innerHTML;
                const htmlMatch = html.match(/(?:\s+\.|\s+|^|[\(\)（）\s])(A[\.．])/);
                if (htmlMatch) {
                  const htmlIndex = htmlMatch.index;
                  let stemHtml = html.substring(0, htmlIndex).trim();
                  const optionsHtml = html.substring(htmlIndex).trim();
                  
                  if (stemHtml.endsWith('.')) {
                    stemHtml = stemHtml.slice(0, -1).trim();
                  }
                  if (stemHtml) {
                    const stemElement = document.createElement(node.tagName);
                    stemElement.className = node.className;
                    stemElement.innerHTML = stemHtml;
                    questionNodes.push(stemElement);
                  }
                  const optElement = document.createElement('span');
                  optElement.innerHTML = optionsHtml;
                  optionNodes.push(optElement);
                } else {
                  optionNodes.push(node);
                }
              }
            } else {
              questionNodes.push(node);
            }
          } else {
            optionNodes.push(node);
          }
        }
      }

      let combinedOptionsHtml = '';
      optionNodes.forEach(node => {
        if (node.nodeType === Node.TEXT_NODE) {
          combinedOptionsHtml += node.textContent;
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          combinedOptionsHtml += node.outerHTML;
        }
      });

      const options = extractOptionsSafely(combinedOptionsHtml);

      if (options.length > 0) {
        body.innerHTML = ''; 
        body.classList.add('formatted-choices-v3');

        const stemContainer = document.createElement('div');
        stemContainer.className = 'question-stem';
        questionNodes.forEach(node => {
          stemContainer.appendChild(node);
        });
        body.appendChild(stemContainer);

        let isLongText = false;
        options.forEach(opt => {
          const pureText = opt.content.replace(/<[^>]+>/g, '').trim();
          if (pureText.length > 10) {
            isLongText = true;
          }
        });

        const optionsContainer = document.createElement('div');
        optionsContainer.className = `options-container ${isLongText ? 'options-vertical' : ''}`;
        
        options.forEach(opt => {
          const wrapper = document.createElement('div');
          wrapper.className = 'option-chip-wrapper';
          
          const labelSpan = document.createElement('span');
          labelSpan.className = 'option-chip-label';
          labelSpan.textContent = opt.label;
          
          const contentSpan = document.createElement('span');
          contentSpan.className = 'option-chip-content';
          contentSpan.innerHTML = opt.content;
          
          wrapper.appendChild(labelSpan);
          wrapper.appendChild(contentSpan);
          optionsContainer.appendChild(wrapper);
        });
        body.appendChild(optionsContainer);

        trailingElements.forEach(el => {
          body.appendChild(el);
        });
      }
    });
  }

  /**
   * 极智纯文本树遍历器 (TreeWalker) - 包含模块头部隔离保护
   * 分片异步版：把整页文本节点分批处理（requestIdleCallback/setTimeout），
   * 避免一次性同步扫描数万节点阻塞主线程（SPA 切换卡顿来源之一）。
   * 全部处理完成后调用 done()。
   */
  function walkTextNodes(root, callback, done) {
    const walker = document.createTreeWalker(
      root,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode: function(node) {
          const parent = node.parentElement;
          if (!parent) return NodeFilter.FILTER_REJECT;
          if (parent.tagName === 'SCRIPT' || parent.tagName === 'STYLE') return NodeFilter.FILTER_REJECT;
          if (parent.closest('.custom-page-sidebar') || parent.closest('nav') || parent.closest('header')) return NodeFilter.FILTER_REJECT;
          if (parent.closest('.fig-ref-badge') || parent.closest('.block-ref-badge')) return NodeFilter.FILTER_REJECT;
          if (
            parent.closest('.card-header') || 
            parent.closest('.fallback-header') || 
            parent.closest('.guide-header') || 
            parent.closest('summary')
          ) {
            return NodeFilter.FILTER_REJECT;
          }
          return NodeFilter.FILTER_ACCEPT;
        }
      }
    );

    const nodes = [];
    while (walker.nextNode()) {
      nodes.push(walker.currentNode);
    }

    // 倒序分批处理（保持与原同步版相同的处理顺序）
    const BATCH = 120;
    let i = nodes.length;
    const schedule = window.requestIdleCallback
      ? (fn) => window.requestIdleCallback(fn, { timeout: 40 })
      : (fn) => window.setTimeout(fn, 0);
    function nextBatch() {
      const end = Math.max(0, i - BATCH);
      for (; i > end; i--) {
        callback(nodes[i - 1]);
      }
      if (i > 0) {
        schedule(nextBatch);
      } else if (typeof done === 'function') {
        done();
      }
    }
    nextBatch();
  }

  /**
   * 客户端全时无条件高阶联动引擎
   * @param refsMode 'interactive' | 'static'：static 时统一静态 chip，零引用建立
   */
  function linkPageElements(bookConfig, globalBlockIndex, refsMode) {
    // 【静态 chip 模式】构建期已把全部引用生成为静态徽章（rehype-cross-ref 强制），
    // 这里不做任何升级 / 挂事件 / 补 id —— 引用建立的切换开销直接归零。
    if (refsMode === 'static') return;

    const mainContent = document.querySelector('main') || document.querySelector('.main-pane') || document.querySelector('article') || document.body;
    if (!mainContent) return;

    const modules = bookConfig.modules || {};

    // 防御性安全拦截
    if (modules['图']) {
      modules['图'].isImage = true;
      modules['图'].short = '图';
      modules['图'].theme = 'chip-default';
    }

    // 0. 【方案 B】构建期徽章下沉短路：正文 HTML 已由 rehype-cross-ref 在构建期
    //    生成好全部引用徽章并注入 data-xref-built 标记，SPA 切换时零文本扫描，
    //    只做三件轻量工作后直接挂事件：
    //      ① <Solution> 组件渲染不带 id，按文档序补 sol-ref-block-N（与构建期编号一致）；
    //      ② 构建期无全局索引，跨页引用只能生成 static-badge，此处查全局索引补
    //         data-url 并升级为 interactive，保持跨页跳转能力（不扫描文本节点）；
    //      ③ 对 interactive 徽章挂接联动事件。
    if (mainContent.querySelector('[data-xref-built]')) {
      const solDetails = Array.from(document.querySelectorAll('.solution-details'));
      solDetails.forEach((sol, idx) => {
        if (!sol.id) sol.id = `sol-ref-block-${idx + 1}`;
      });

      mainContent.querySelectorAll('.block-ref-badge.static-badge').forEach((badge) => {
        const text = (badge.querySelector('.block-text')?.textContent || '').trim();
        if (!text) return;
        const targetUrl = globalBlockIndex[text];
        if (targetUrl) {
          badge.classList.remove('static-badge');
          badge.classList.add('interactive-badge');
          badge.setAttribute('data-url', resolveIndexUrl(targetUrl));
        }
      });

      attachInteractiveListeners();
      return;
    }

    // 1. 【同页联动地图】
    const localTargets = {};
    const trackSelectors = bookConfig.trackClasses ? bookConfig.trackClasses.join(', ') : '.toc-chunk';
    const localChunks = Array.from(document.querySelectorAll(trackSelectors));
    const chunks = localChunks;
    
    chunks.forEach((chunk, index) => {
      const rawTitle = chunk.getAttribute('data-title') || chunk.querySelector('.card-header, h1, h2, h3')?.textContent || '';
      if (rawTitle) {
        const { type, number } = parseTitleFromConfig(rawTitle, modules);
        if (number) {
          const cleanKey = `${type}${number}`.replace(/\s+/g, '');
          localTargets[cleanKey] = chunk.id;
        }
      }
    });

    // 收集 Solution 进入同页地图
    const solutions = Array.from(document.querySelectorAll('.solution-details'));
    solutions.forEach((sol, idx) => {
      const summary = sol.querySelector('summary');
      const summaryText = summary ? summary.textContent.trim() : '';
      const { type, number } = parseTitleFromConfig(summaryText, modules);
      if (number) {
        const cleanKey = `${type}${number}`.replace(/\s+/g, '');
        let id = sol.id;
        if (!id) {
          id = `sol-ref-block-${idx + 1}`;
          sol.id = id;
        }
        localTargets[cleanKey] = id;
      }
    });

    // 2. 【大统一构建】：动态编译匹配全书所有注册别名 + 编号的复合正则
    const allAliases = [];
    Object.entries(modules).forEach(([key, meta]) => {
      if (key !== '图' && !meta.isImage && meta.aliases) {
        allAliases.push(...meta.aliases);
      }
    });

    const escapeRegExp = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const typePattern = allAliases.map(escapeRegExp).join('|');
    const globalRefRegex = new RegExp(`(${typePattern})\\s*(\\d+(?:\\.\\d+)*)`, 'g');

    const imageModules = Object.entries(modules).filter(([_, meta]) => meta.isImage);

    // 3. 【核心修正】：等深近邻无冲突匹配算法
    imageModules.forEach(([_, meta]) => {
      const targetQuery = meta.targetQuery || 'p, div, figcaption';
      const targetPattern = /^图\s*(\d+\s*[-－]\s*\d+)$/;
      
      const allImages = Array.from(mainContent.querySelectorAll('img'));
      const allParagraphs = Array.from(mainContent.querySelectorAll(targetQuery));

      allParagraphs.forEach(el => {
        const text = el.textContent || '';
        const captionMatch = text.trim().match(targetPattern);
        
        if (captionMatch) {
          const figNum = captionMatch[1].replace(/\s+/g, '');
          const figId = `${meta.short}-${figNum}`;
          el.id = figId;
          el.classList.add('fig-target-caption');
          
          let prev = el.previousElementSibling;
          if (prev) {
            const img = prev.tagName === 'IMG' ? prev : prev.querySelector('img');
            if (img) {
              img.classList.add('fig-target-image');
              img.setAttribute('data-fig-ref', figId);
            }
          }
        }
      });
    });

    // 4. 开始无损纯文本节点扫描（分片异步：正文先渲染，徽章后台分批补齐）
    walkTextNodes(mainContent, (node) => {
      let text = node.textContent || '';
      let modified = false;

      // A. 执行全时无条件胶囊化替换
      if (globalRefRegex.test(text)) {
        const span = document.createElement('span');
        
        span.innerHTML = text.replace(globalRefRegex, (match, matchedType, matchedNum) => {
          const cleanType = matchedType.trim();
          const cleanNum = matchedNum.trim();
          
          let masterKey = cleanType;
          for (const [modKey, modMeta] of Object.entries(modules)) {
            if (modMeta.aliases && modMeta.aliases.includes(cleanType)) {
              masterKey = modKey;
              break;
            }
          }
          const modMeta = modules[masterKey] || {};
          const emoji = modMeta.emoji || '📦';
          const fullMatchedText = `${matchedType}${matchedNum}`;

          const lookupKey = `${masterKey}${cleanNum}`.replace(/\s+/g, '');
          const localId = localTargets[lookupKey];

          // 从构建期大索引中精准定位跨页 URL（紧凑相对路径 → 完整 URL）
          const keyWithSpace = `${cleanType} ${cleanNum}`;
          const keyNoSpace = `${cleanType}${cleanNum}`;
          const relUrl = globalBlockIndex[keyWithSpace] || globalBlockIndex[keyNoSpace];
          const targetUrl = relUrl ? resolveIndexUrl(relUrl) : '';

          if (localId) {
            return `
              <span class="block-ref-badge interactive-badge" data-target="${localId}" data-type="${masterKey}">
                <span class="block-icon">${emoji}</span>
                <span class="block-text">${fullMatchedText}</span>
              </span>
            `.trim().replace(/\n\s*/g, '');
          } else if (targetUrl) {
            // 跨页引用：带上构建期索引中的目标 URL（含锚点），点击跳转对应页面卡片
            return `
              <span class="block-ref-badge interactive-badge" data-url="${targetUrl}" data-type="${masterKey}">
                <span class="block-icon">${emoji}</span>
                <span class="block-text">${fullMatchedText}</span>
              </span>
            `.trim().replace(/\n\s*/g, '');
          } else {
            return `
              <span class="block-ref-badge static-badge" data-type="${masterKey}">
                <span class="block-icon">${emoji}</span>
                <span class="block-text">${fullMatchedText}</span>
              </span>
            `.trim().replace(/\n\s*/g, '');
          }
        });

        if (span.innerHTML !== text) {
          node.parentNode.replaceChild(span, node);
          modified = true;
        }
      }

      if (modified) return; 

      // B. 独立匹配图片参考组件
      imageModules.forEach(([_, meta]) => {
        const typePattern = meta.aliases.map(escapeRegExp).join('|');
        const refRegex = new RegExp(`(${typePattern})\\s*(\\d+\\s*[-－]\s*\\d+)`, 'g');
        
        if (refRegex.test(text)) {
          const span = document.createElement('span');
          span.innerHTML = text.replace(refRegex, (match, matchedType, matchedNum) => {
            const figNum = matchedNum.replace(/\s+/g, '');
            const figId = `${meta.short}-${figNum}`;
            const localFig = document.getElementById(figId);
            
            if (localFig) {
              return `
                <span class="fig-ref-badge interactive-badge" data-target="${figId}">
                  <span class="fig-icon">图</span>
                  <span class="fig-text">${matchedNum}</span>
                </span>
              `.trim().replace(/\n\s*/g, '');
            } else {
              return `
                <span class="fig-ref-badge static-badge">
                  <span class="fig-icon">图</span>
                  <span class="fig-text">${matchedNum}</span>
                </span>
              `.trim().replace(/\n\s*/g, '');
            }
          });
          node.parentNode.replaceChild(span, node);
        }
      });
    }, () => {
      // 5. 扫描全部完成后，对可交互的徽章绑定监听事件
      attachInteractiveListeners();
    });
  }

  // 绑定高亮与平滑水波跳转事件 (安全作用域版本)
  function attachInteractiveListeners() {
    // 1. 图文联动 (仅限本页拥有的图片目标)
    document.querySelectorAll('.fig-ref-badge.interactive-badge').forEach(badge => {
      if (badge.classList.contains('listeners-attached')) return;
      badge.classList.add('listeners-attached');

      const targetId = badge.getAttribute('data-target');
      
      badge.addEventListener('mouseenter', () => {
        const caption = document.getElementById(targetId);
        const image = document.querySelector(`.fig-target-image[data-fig-ref="${targetId}"]`);
        if (caption) caption.classList.add('fig-highlight');
        if (image) image.classList.add('fig-highlight');
        badge.classList.add('badge-highlight');
      });

      badge.addEventListener('mouseleave', () => {
        const caption = document.getElementById(targetId);
        const image = document.querySelector(`.fig-target-image[data-fig-ref="${targetId}"]`);
        if (caption) caption.classList.remove('fig-highlight');
        if (image) image.classList.remove('fig-highlight');
        badge.classList.remove('badge-highlight');
      });

      badge.addEventListener('click', (e) => {
        e.preventDefault();
        const caption = document.getElementById(targetId);
        if (caption) {
          caption.scrollIntoView({ behavior: 'smooth', block: 'center' });
          const image = document.querySelector(`.fig-target-image[data-fig-ref="${targetId}"]`);
          if (caption) {
            caption.classList.add('fig-flash');
            setTimeout(() => caption.classList.remove('fig-flash'), 1000);
          }
          if (image) {
            image.classList.add('fig-flash');
            setTimeout(() => image.classList.remove('fig-flash'), 1000);
          }
        }
      });
    });

    // 2. 块组件联动 (仅限本页卡片)
    document.querySelectorAll('.block-ref-badge.interactive-badge').forEach(badge => {
      if (badge.classList.contains('listeners-attached')) return;
      badge.classList.add('listeners-attached');

      const targetUrl = badge.getAttribute('data-url') || '';
      const fallbackId = badge.getAttribute('data-target') || '';

      const currentPath = window.location.pathname.replace(/\/$/, '');
      const pathMatch = targetUrl.match(/^([^#]*)(#.*)$/);
      const targetPath = pathMatch ? pathMatch[1].replace(/\/$/, '') : '';
      const targetHash = pathMatch ? pathMatch[2] : '';
      const targetId = targetHash ? decodeURIComponent(targetHash.replace('#', '')) : fallbackId;

      // 仅限同页时激活 hover 浮动效果
      if (targetPath === '' || targetPath === currentPath) {
        badge.addEventListener('mouseenter', () => {
          const card = document.getElementById(targetId);
          if (card) card.classList.add('card-ref-highlight');
          badge.classList.add('badge-highlight');
        });

        badge.addEventListener('mouseleave', () => {
          const card = document.getElementById(targetId);
          if (card) card.classList.remove('card-ref-highlight');
          badge.classList.remove('badge-highlight');
        });
      }

      badge.addEventListener('click', (e) => {
        e.preventDefault();
        if (targetPath === '' || targetPath === currentPath) {
          const card = document.getElementById(targetId);
          if (card) {
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            card.classList.add('card-ref-flash');
            setTimeout(() => card.classList.remove('card-ref-flash'), 1200);
          }
        } else {
          // 跨页跳转，原路打包带上锚点
          window.location.href = targetUrl;
        }
      });
    });
  }

