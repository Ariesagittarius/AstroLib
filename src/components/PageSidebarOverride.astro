  /**
   * 计算一个元素的“可视最右缘”：
   * 行内公式的 getBoundingClientRect() 不会包含溢出子盒，
   * 而直接遍历子元素又会被 KaTeX 的 SVG 幽灵路径（超大几何但零尺寸）污染。
   * 因此：SVG 视为原子盒（取它真实渲染的盒宽），其余子元素取各自真实盒宽的最大值。
   */
  function visibleContentRight(el) {
    let max = el.getBoundingClientRect().right;
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_ELEMENT, {
      acceptNode(node) {
        // 注意：HTML 文档中 SVG 的 tagName 是小写 'svg'；必须整棵跳过，
        // 否则 KaTeX 拉伸字符内部 400000 宽的幽灵路径会把结果污染成上万像素
        if (node.namespaceURI === 'http://www.w3.org/2000/svg') return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    while (walker.nextNode()) {
      const n = walker.currentNode;
      const r = n.getBoundingClientRect();
      if (r.width > 0 && r.right > max) max = r.right;
    }
    el.querySelectorAll('svg').forEach(svg => {
      const r = svg.getBoundingClientRect();
      if (r.width > 0 && r.right > max) max = r.right;
    });
    return max;
  }

  /**
   * 长行内公式“胶囊化”（移动端友好）：
   * 仅当某个行内公式的可视内容超出其所在正文容器的右边缘时，
   * 才给它套上 .katex-scroll-capsule（可横向滚动的内联小盒子）。
   * 其余 99% 正常排版的短公式完全保持原生行内排版，不被任何改动波及。
   * 注：行间公式 $$...$$ 由 .katex-display 的 overflow-x:auto 自行接管，不在此列。
   */
  function tameOverflowingInlineMath() {
    const main = document.querySelector('main');
    if (!main) return;

    // 性能优化：桌面宽屏不需要“长行内公式胶囊化”（该功能本是移动端友好设计）。
    // 此前该函数会对每页上千个行内公式逐个 getBoundingClientRect（强制同步布局），
    // 且每次 SPA 切换执行两遍，是切换卡顿的最大来源；桌面端直接短路，零成本。
    if (!window.matchMedia('(max-width: 1024px)').matches) return;

    const lineSelector = [
      '.sl-markdown-content', '.card-body', '.card-header',
      '.solution-content', '.analysis-content', '.note-content',
      '.fallback-content', '.fallback-header', '.guide-content', '.guide-header',
      '.question-stem', '.option-chip-content'
    ].join(', ');

    main.querySelectorAll('.katex:not(.katex-display .katex)').forEach((el) => {
      if (el.classList.contains('katex-scroll-capsule')) return;
      const line = el.closest(lineSelector);
      if (!line) return;
      // 公式可视内容右缘超出容器右缘 → 判定为“放不下的长公式”
      if (visibleContentRight(el) > line.getBoundingClientRect().right + 1) {
        el.classList.add('katex-scroll-capsule');
      }
    });
  }

  /**
   * 移动端大纲 popup 开关（以 <body> 上的 .mobile-toc-open 类为唯一状态源；
   * 该类同时驱动 custom.css 的 body 滚动锁）。
   * 导航条每次 SPA 切换都会被重建，因此内部一律通过选择器现取，绝不缓存旧节点。
   */
  function setMobileTocOpen(open) {
    document.body.classList.toggle('mobile-toc-open', open);
    const nav = document.querySelector('.vp-local-nav');
    if (!nav) return;
    const btn = nav.querySelector('.vp-local-nav-btn');
    const items = nav.querySelector('.vp-local-nav-items');
    if (btn) btn.setAttribute('aria-expanded', String(open));
    if (items) items.setAttribute('aria-hidden', String(!open));
    if (open) {
      // 面板展开时，让当前章节项保持在可视区内
      const activeLink = items && items.querySelector('.toc-link.active');
      if (activeLink) activeLink.scrollIntoView({ block: 'nearest' });
    }
  }

  /**
   * 移动端本地导航 VPLocalNav 装配（VitePress 移植，顶栏入口版）：
   * - 导航条最初位于右侧栏容器内，而该容器在移动端是 display:none，
   *   这里搬运进固定顶栏（header）的右侧动作区 .right-group —— 大纲入口
   *   “并入顶栏右侧而不是单开一格”（对应 VitePress VPNavBar 右侧动作区）；
   * - 交互对齐 VPLocalNavOutlineDropdown：按钮开合、点击外部关闭、Escape 关闭、
   *   面板内「返回顶部」平滑滚顶、--vp-vh 控制面板最大高度；
   * - SPA 切页后整个容器会被替换，因此每次调用先清理上一页残留再重新挂载。
   */
  function setupVPLocalNav() {
    // 1. 清理上一页残留的导航条与全局状态（含文档级点击监听，避免闭包泄漏）
    document.querySelectorAll('.vp-local-nav.vp-local-nav-teleported').forEach((n) => n.remove());
    document.body.classList.remove('mobile-toc-open');
    document.body.classList.remove('vp-local-nav-active');
    if (window.__vpLocalNavClickHandler) {
      document.removeEventListener('click', window.__vpLocalNavClickHandler);
      window.__vpLocalNavClickHandler = null;
    }

    // 2. 搬运当前页导航条进顶栏右侧 .right-group（页面无大纲时节点不存在，直接跳过）
    const nav = document.querySelector('.vp-local-nav');
    if (!nav) return;
    const header = document.querySelector('.header');
    const rightGroup = header?.querySelector('.right-group');
    nav.classList.add('vp-local-nav-teleported');
    if (rightGroup) {
      if (rightGroup.firstElementChild !== nav) rightGroup.prepend(nav);
    } else if (header && header.lastElementChild !== nav) {
      header.append(nav);
    }
    document.body.classList.add('vp-local-nav-active');

    const btn = nav.querySelector('.vp-local-nav-btn');
    const items = nav.querySelector('.vp-local-nav-items');
    if (!btn || !items) return;

    // 3. 大纲按钮：开合 + 计算面板可见高度（VitePress：vh = innerHeight + min(scrollY - navHeight, 0)）；
    //    无大纲时按钮退化为「返回顶部」（buildBookTOC 会给按钮加 .return-top）
    const navHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--sl-nav-height')) || 64;
    btn.addEventListener('click', () => {
      if (btn.classList.contains('return-top')) {
        window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
        return;
      }
      const vh = window.innerHeight + Math.min(window.scrollY - navHeight, 0);
      nav.style.setProperty('--vp-vh', vh + 'px');
      setMobileTocOpen(!document.body.classList.contains('mobile-toc-open'));
    });

    // 4. 点击面板外任意位置关闭（VPLocalNavOutlineDropdown closeOnClickOutside）
    window.__vpLocalNavClickHandler = (e) => {
      if (!document.body.classList.contains('mobile-toc-open')) return;
      if (!nav.contains(e.target)) setMobileTocOpen(false);
    };
    document.addEventListener('click', window.__vpLocalNavClickHandler);

    // 5. Escape 关闭（文档级监听只注册一次，内部实时查询当前导航条）
    if (!window.__mobileTocKeyHandler) {
      window.__mobileTocKeyHandler = (e) => {
        if (e.key !== 'Escape' || !document.body.classList.contains('mobile-toc-open')) return;
        setMobileTocOpen(false);
        document.querySelector('.vp-local-nav-btn')?.focus();
      };
      document.addEventListener('keydown', window.__mobileTocKeyHandler);
    }

    // 6. 面板内「返回顶部」链接：平滑滚顶并关闭
    nav.querySelector('.vp-local-nav-top-link')?.addEventListener('click', (e) => {
      e.preventDefault();
      setMobileTocOpen(false);
      window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
    });
  }

  function buildBookTOC(sidebarContainer, bookConfig, globalBlockIndex) {
    // 移动端本地导航：清理上一页残留并搬运当前页导航条到 <header> 之后
    setupVPLocalNav();

    if (!sidebarContainer) return;

    const modules = bookConfig.modules || {};

    const tocList = document.getElementById('custom-toc-list');
    if (!tocList) return;
    const mobileTocList = document.getElementById('vp-local-nav-toc-list');
    // VitePress outline-marker 指示条（位于大纲容器内，随高亮项移动）
    const marker = tocList.closest('.custom-page-sidebar')?.querySelector('.outline-marker');

    const trackSelectors = bookConfig.trackClasses && bookConfig.trackClasses.length > 0 
      ? bookConfig.trackClasses.join(', ') 
      : '.toc-chunk';

    const contentRoot = document.querySelector('main .sl-markdown-content') || document.querySelector('.main-pane') || document.querySelector('main') || document.body;

    // 同时抓取“卡片”与“正文标题”：单次 querySelectorAll 天然按文档序返回，
    // 取代原来的 compareDocumentPosition 排序（O(n log n) 的 DOM 遍历比较）
    const trackList = trackSelectors.split(',').map((s) => s.trim()).filter(Boolean);
    const tocEntries = [];
    for (const el of Array.from(contentRoot.querySelectorAll([...trackList, 'h2', 'h3', 'h4'].join(', ')))) {
      if (el.matches('h2, h3, h4')) {
        // 卡片内部的标题不算独立大纲项
        if (!el.closest(trackSelectors) && !el.closest('.custom-page-sidebar')) {
          tocEntries.push({ kind: 'heading', el, level: Number(el.tagName.slice(1)) });
        }
      } else {
        tocEntries.push({ kind: 'card', el });
      }
    }

    const chunks = tocEntries;

    // —— 锚点 id 归一化：给所有目录项分配唯一、稳定的 id ——
    // 原逻辑直接复用卡片 id（由标题拼出，可能含 $()=% 等字符）与标题 slug；
    // 同页重复 id（如多个同标题卡片）会让多个大纲条目指向同一元素，
    // 点击时全部跳到第一个目标，造成“跳转异常”。这里统一去重：
    // 首项保留原 id（跨页引用按“标题转-”规则命中它），重复项追加 -2/-3 后缀。
    const seenTocIds = new Set();
    chunks.forEach((chunk, index) => {
      const el = chunk.el;
      let base = (el.id || '').trim().replace(/\s+/g, '-');
      if (!base) {
        base = chunk.kind === 'heading'
          ? `toc-heading-${index + 1}`
          : (el.getAttribute('data-title') || el.querySelector('.card-header, .fallback-header, .guide-header')?.textContent || '').trim().replace(/\s+/g, '-') || `toc-card-${index + 1}`;
      }
      let finalId = base;
      let n = 2;
      while (seenTocIds.has(finalId)) finalId = `${base}-${n++}`;
      seenTocIds.add(finalId);
      el.id = finalId;
      chunk._tocId = finalId;
    });

    if (tocEntries.length === 0) {
      const emptyHtml = '<li class="toc-loading">本节暂无大纲</li>';
      tocList.innerHTML = emptyHtml;
      if (mobileTocList) mobileTocList.innerHTML = emptyHtml;
      // VitePress：无大纲时大纲按钮退化为「返回顶部」（点击直接平滑滚顶，不弹面板）
      const navBtn = document.querySelector('.vp-local-nav-btn');
      if (navBtn) {
        navBtn.classList.add('return-top');
        navBtn.setAttribute('aria-label', '返回顶部');
        const label = navBtn.querySelector('.vp-local-nav-label');
        if (label) label.textContent = '返回顶部';
      }
      return;
    }

    tocList.innerHTML = '';
    if (mobileTocList) mobileTocList.innerHTML = '';

    // 与 chunks 顺序一一对应的链接数组（桌面列表 + 移动端抽屉列表），供滚动高亮使用
    const desktopLinks = [];
    const mobileLinks = [];

    // 单条目录项构建器：桌面与移动端各渲染一份，保持语义与样式一致
    function makeTocEntry(chunk, index, targetList, links, isMobile) {
      const el = chunk.el;
      const isHeading = chunk.kind === 'heading';
      const rawTitle = isHeading
          ? (el.textContent || '').trim()
          : el.getAttribute('data-title') || el.querySelector('.card-header, .fallback-header, .guide-header')?.textContent || '无标题';
      
      // 锚点 id 已在 buildBookTOC 中统一归一化并去重（chunk._tocId）
      const id = chunk._tocId || el.id;
      if (!el.id) el.id = id;

      // 通过中央配置映射语义解析类型
      const { type, number } = parseTitleFromConfig(rawTitle, modules);

      const modMeta = modules[type] || {};
      const chipClass = modMeta.theme || 'chip-default';
      const labelText = modMeta.short || type;

      const li = document.createElement('li');
      li.className = 'toc-item';

      const a = document.createElement('a');
      a.href = `#${encodeURIComponent(id)}`;
      a.className = 'toc-link';

      if (isHeading) {
          a.classList.add('toc-heading', `toc-level-${chunk.level}`);

          const headingText = document.createElement('span');
          headingText.className = 'toc-heading-text';
          headingText.textContent = rawTitle;

          a.appendChild(headingText);
        } else {
          // 模块项：中性小标签「例」+ 编号「3.2」
          //（类似正文「图 2.5」fig-ref-badge 样式，不抢眼但有指示作用；视觉统一由
          //  vitepress-theme.css 8.8 覆盖为中性，彩色 chip-example 等不再生效）
          const chipSpan = document.createElement('span');
          chipSpan.className = `toc-chip ${chipClass}`;
          chipSpan.textContent = labelText;

          const numSpan = document.createElement('span');
          numSpan.className = 'toc-number';
          numSpan.textContent = number;

          a.appendChild(chipSpan);
          a.appendChild(numSpan);
        }

      // 统一点击跳转（桌面 + 移动端一致，替代浏览器原生 hash 跳转）：
      // 1. 平滑滚动到目标，并补偿固定导航栏与移动端本地导航条高度
      //    （--sl-mobile-toc-height 在 body.vp-local-nav-active 时 = local nav 高），
      //    避免目标被 header / sticky 大纲条遮挡；
      // 2. 用 replaceState 更新 hash（不新增历史记录），防止后退时触发
      //    SPA 整页重载导致页面闪跳、滚动丢失的“异常跳转”。
      a.addEventListener('click', (e) => {
        // 中键 / Ctrl / Shift / Alt 点击：交给浏览器默认行为（新标签打开等）
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        if (isMobile) setMobileTocOpen(false);
        const target = document.getElementById(id);
        if (!target) return;
        const rootStyle = getComputedStyle(document.documentElement);
        const navH = parseFloat(rootStyle.getPropertyValue('--sl-nav-height')) || 56;
        const tocH = parseFloat(rootStyle.getPropertyValue('--sl-mobile-toc-height')) || 0;
        const top = target.getBoundingClientRect().top + window.scrollY - navH - tocH - 16;
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
        history.replaceState({ ...(history.state || {}), scrollY: window.scrollY }, '', `#${encodeURIComponent(id)}`);
      });

      li.appendChild(a);
      targetList.appendChild(li);
      links.push(a);
    }

    chunks.forEach((chunk, index) => {
      makeTocEntry(chunk, index, tocList, desktopLinks, false);
      if (mobileTocList) makeTocEntry(chunk, index, mobileTocList, mobileLinks, true);
    });

    // 注：侧边栏/抽屉公式二次渲染、引用联动挂接、公式操作钮扫描、移动端长公式
    // 胶囊化等非关键工作已移出本函数，改由 onPageLoad 的空闲时段统一执行
    // （正文先绘制，增强后补 —— 见文件底部 onPageLoad）。

    let lastSpyIndex = -1;

    function handleSpyScroll() {
      let activeIndex = -1;
      const scrollPosition = window.scrollY + 120;

      chunks.forEach((chunk, index) => {
        const rect = chunk.el.getBoundingClientRect();
        const elementTop = rect.top + window.scrollY;
        if (scrollPosition >= elementTop) {
          activeIndex = index;
        }
      });

      desktopLinks.forEach((link, index) => link.classList.toggle('active', index === activeIndex));
      mobileLinks.forEach((link, index) => link.classList.toggle('active', index === activeIndex));

      // VitePress outline-marker：2px 品牌色指示条跟随当前高亮项移动（官方 useActiveAnchor 行为）
      if (marker) {
        const activeLink = activeIndex >= 0 ? desktopLinks[activeIndex] : null;
        if (activeLink) {
          marker.style.top = `${activeLink.offsetTop}px`;
          marker.style.opacity = '1';
        } else {
          marker.style.opacity = '0';
        }
      }

      // 抽屉展开时，把当前章节项保持在可视区内（仅当高亮项变化时滚动，避免抖动）
      if (document.body.classList.contains('mobile-toc-open') && activeIndex !== lastSpyIndex) {
        const activeMobile = mobileLinks[activeIndex];
        if (activeMobile) activeMobile.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
      lastSpyIndex = activeIndex;
    }

    // 防止 SPA 多次导航后叠加滚动监听器
    if (window.__slScrollSpy) window.removeEventListener('scroll', window.__slScrollSpy);
    window.__slScrollSpy = handleSpyScroll;
    window.addEventListener('scroll', window.__slScrollSpy);
    handleSpyScroll();
  }

  // 大纲/抽屉公式二次渲染（TOC 数字可能含 $...$；卡片标题公式已在构建期渲染，
  // 这里只处理大纲文本，且放到空闲时段执行）
  function renderSidebarMath() {
    const sidebar = document.querySelector('.custom-page-sidebar');
    if (sidebar && sidebar.textContent.includes('$')) {
      renderMathInElement(sidebar, katexConfig);
    }
    const mobileNav = document.querySelector('.vp-local-nav');
    if (mobileNav && mobileNav.textContent.includes('$')) {
      renderMathInElement(mobileNav, katexConfig);
    }
  }

  // 移动端长行内公式胶囊化（桌面在函数内短路；KaTeX 字形就绪后再校准一次）
  function tameInlineMathWhenReady() {
    tameOverflowingInlineMath();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        const schedule = window.requestIdleCallback || ((fn) => window.setTimeout(fn, 60));
        schedule(() => tameOverflowingInlineMath(), { timeout: 200 });
      });
    }
  }

  /**
   * 每次导航（初次加载 + SPA 切换）的统一入口，按“正文先绘制、增强后补”分阶段执行：
   *   阶段 0（同步）：仅正文必需的轻量处理（选择题重构）；
   *   阶段 1（下一帧）：右侧大纲构建 + 滚动高亮 + 移动端浮层；
   *   阶段 2（空闲时段）：引用联动挂接、公式操作钮扫描、大纲公式二次渲染、
   *                      移动端长公式胶囊化。
   * 把原来阻塞首帧的同步长链拆开，让新文章内容立即可见（VitePress 式体验）。
   */
  function onPageLoad() {
    // 阶段 0（同步，正文必需）
    formatMultipleChoiceQuestions();

    const aside = document.querySelector('.custom-page-sidebar');
    const refsMode = aside?.getAttribute('data-refs-mode') || 'interactive';

    const raf = window.requestAnimationFrame || ((fn) => window.setTimeout(fn, 16));
    raf(() => {
      const bookConfig = getBookConfig(aside);
      const globalBlockIndex = getGlobalIndex(aside);
      buildBookTOC(aside, bookConfig, globalBlockIndex);

      const idle = window.requestIdleCallback || ((fn) => window.setTimeout(fn, 150));
      idle(() => {
        linkPageElements(bookConfig, globalBlockIndex, refsMode);
        initFormulaActions();
        renderSidebarMath();
        tameInlineMathWhenReady();
      }, { timeout: 400 });
    });
  }

  onPageLoad();
  document.addEventListener('astro:page-load', onPageLoad);
</script>
