  /**
   * 计算一个元素的“可视最右缘”：
   * 行内公式的 getBoundingClientRect() 不会包含溢出子盒，
   * 而直接遍历子元素又会被 KaTeX 的 SVG 幽灵路径（超大几何但零尺寸）污染。
   * 因此：SVG 视为原子盒（取它真实渲染的盒宽），其余子元素取各自真实盒宽的最大值。
   */
  function visibleContentRight(el) {
    let max = el.getBoundingClientRect().right;
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_ELEMENT, {
      acceptNode(node) {
        // 注意：HTML 文档中 SVG 的 tagName 是小写 'svg'；必须整棵跳过，
        // 否则 KaTeX 拉伸字符内部 400000 宽的幽灵路径会把结果污染成上万像素
        if (node.namespaceURI === 'http://www.w3.org/2000/svg') return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    while (walker.nextNode()) {
      const n = walker.currentNode;
      const r = n.getBoundingClientRect();
      if (r.width > 0 && r.right > max) max = r.right;
    }
    el.querySelectorAll('svg').forEach(svg => {
      const r = svg.getBoundingClientRect();
      if (r.width > 0 && r.right > max) max = r.right;
    });
    return max;
  }

  /**
   * 长行内公式“胶囊化”（移动端友好）：
   * 仅当某个行内公式的可视内容超出其所在正文容器的右边缘时，
   * 才给它套上 .katex-scroll-capsule（可横向滚动的内联小盒子）。
   * 其余 99% 正常排版的短公式完全保持原生行内排版，不被任何改动波及。
   * 注：行间公式 $$...$$ 由 .katex-display 的 overflow-x:auto 自行接管，不在此列。
   */
  function tameOverflowingInlineMath() {
    const main = document.querySelector('main');
    if (!main) return;

    const lineSelector = [
      '.sl-markdown-content', '.card-body', '.card-header',
      '.solution-content', '.analysis-content', '.note-content',
      '.fallback-content', '.fallback-header', '.guide-content', '.guide-header',
      '.question-stem', '.option-chip-content'
    ].join(', ');

    main.querySelectorAll('.katex:not(.katex-display .katex)').forEach((el) => {
      if (el.classList.contains('katex-scroll-capsule')) return;
      const line = el.closest(lineSelector);
      if (!line) return;
      // 公式可视内容右缘超出容器右缘 → 判定为“放不下的长公式”
      if (visibleContentRight(el) > line.getBoundingClientRect().right + 1) {
        el.classList.add('katex-scroll-capsule');
      }
    });
  }

  /**
   * 移动端抽屉开关（以 <body> 上的 .mobile-toc-open 类为唯一状态源）。
   * 浮层节点每次导航都会被重建，因此内部一律通过选择器现取，绝不缓存旧节点。
   */
  function setMobileTocOpen(open) {
    document.body.classList.toggle('mobile-toc-open', open);
    const fab = document.querySelector('.mobile-toc-fab');
    const drawer = document.querySelector('.mobile-toc-drawer');
    if (fab) fab.setAttribute('aria-expanded', String(open));
    if (drawer) drawer.setAttribute('aria-hidden', String(!open));
    if (open) {
      // 抽屉打开时，让当前章节项保持在可视区内
      const activeLink = drawer && drawer.querySelector('.toc-link.active');
      if (activeLink) activeLink.scrollIntoView({ block: 'nearest' });
      // 键盘用户：焦点移入抽屉的关闭按钮
      const closeBtn = drawer && drawer.querySelector('.mobile-toc-close');
      if (closeBtn && !window.matchMedia('(hover: none)').matches) closeBtn.focus();
    }
  }

  /**
   * 移动端大纲浮层装配：
   * - 按钮 / 遮罩 / 抽屉最初位于右侧栏容器内，而该容器在移动端是 display:none，
   *   这里统一搬运到 <body>，使它们在移动端真正可见；
   * - SPA 切页后整个容器会被替换，因此每次调用先清理上一页残留的浮层再重新挂载。
   */
  function setupMobileTOC() {
    // 1. 清理上一页残留在 <body> 的浮层，并复位全局状态
    document.querySelectorAll('.mobile-toc-teleported').forEach((n) => n.remove());
    document.body.classList.remove('mobile-toc-open');

    // 2. 搬运当前页浮层（页面无大纲时三者都不存在，直接跳过）
    const fab = document.querySelector('.mobile-toc-fab');
    const backdrop = document.querySelector('.mobile-toc-backdrop');
    const drawer = document.querySelector('.mobile-toc-drawer');
    if (!fab || !backdrop || !drawer) return;

    [fab, backdrop, drawer].forEach((n) => {
      n.classList.add('mobile-toc-teleported');
      document.body.appendChild(n);
    });

    // 3. 开关交互：按钮开合 / 遮罩点击关闭 / 关闭按钮关闭
    fab.addEventListener('click', () => {
      setMobileTocOpen(!document.body.classList.contains('mobile-toc-open'));
    });
    backdrop.addEventListener('click', () => setMobileTocOpen(false));
    drawer.querySelector('.mobile-toc-close')?.addEventListener('click', () => setMobileTocOpen(false));

    // 4. Escape 关闭（文档级监听只注册一次，内部实时查询当前浮层）
    if (!window.__mobileTocKeyHandler) {
      window.__mobileTocKeyHandler = (e) => {
        if (e.key !== 'Escape' || !document.body.classList.contains('mobile-toc-open')) return;
        setMobileTocOpen(false);
        document.querySelector('.mobile-toc-fab')?.focus();
      };
      document.addEventListener('keydown', window.__mobileTocKeyHandler);
    }

    // 5. 下拉手势关闭：仅当抽屉自身滚动到顶时生效，避免干扰列表滚动
    let dragStartY = 0;
    drawer.addEventListener('pointerdown', (e) => {
      dragStartY = e.clientY;
    }, { passive: true });
    drawer.addEventListener('pointermove', (e) => {
      if (!document.body.classList.contains('mobile-toc-open')) return;
      if (drawer.scrollTop <= 0 && e.clientY - dragStartY > 90) setMobileTocOpen(false);
    }, { passive: true });
  }

  function buildBookTOC() {
    // 移动端浮层：清理上一页残留并搬运当前页按钮/抽屉到 <body>
    setupMobileTOC();

    const sidebarContainer = document.querySelector('.custom-page-sidebar');
    if (!sidebarContainer) return;

    // 解析出整本书的配置
    const rawConfig = sidebarContainer.getAttribute('data-book-config') || '{}';
    const bookConfig = JSON.parse(rawConfig);
    const modules = bookConfig.modules || {};

    // 解析出全书静态编译大字典
    const rawGlobalIndex = sidebarContainer.getAttribute('data-global-index') || '{}';
    const globalBlockIndex = JSON.parse(rawGlobalIndex);

    const tocList = document.getElementById('custom-toc-list');
    if (!tocList) return;
    const mobileTocList = document.getElementById('mobile-toc-list');

    const trackSelectors = bookConfig.trackClasses && bookConfig.trackClasses.length > 0 
      ? bookConfig.trackClasses.join(', ') 
      : '.toc-chunk';

    const contentRoot = document.querySelector('main .sl-markdown-content') || document.querySelector('.main-pane') || document.querySelector('main') || document.body;

    // 同时抓取“卡片”与“正文标题”，并按它们在正文中的真实顺序合并
    const cards = Array.from(contentRoot.querySelectorAll(trackSelectors));
    const headings = Array.from(contentRoot.querySelectorAll('h2, h3, h4')).filter(
      (heading) => !heading.closest(trackSelectors) && !heading.closest('.custom-page-sidebar')
    );

    const tocEntries = [
      ...cards.map((el) => ({ kind: 'card', el })),
      ...headings.map((el) => ({ kind: 'heading', el, level: Number(el.tagName.slice(1)) }))
    ].sort((a, b) => {
      const position = a.el.compareDocumentPosition(b.el);
      if (position & Node.DOCUMENT_POSITION_FOLLOWING) return -1;
      if (position & Node.DOCUMENT_POSITION_PRECEDING) return 1;
      return 0;
    });

    const chunks = tocEntries;
    
    if (tocEntries.length === 0) {
      const emptyHtml = '<li class="toc-loading">本节暂无大纲</li>';
      tocList.innerHTML = emptyHtml;
      if (mobileTocList) mobileTocList.innerHTML = emptyHtml;
      return;
    }

    tocList.innerHTML = '';
    if (mobileTocList) mobileTocList.innerHTML = '';

    // 与 chunks 顺序一一对应的链接数组（桌面列表 + 移动端抽屉列表），供滚动高亮使用
    const desktopLinks = [];
    const mobileLinks = [];

    // 单条目录项构建器：桌面与移动端各渲染一份，保持语义与样式一致
    function makeTocEntry(chunk, index, targetList, links, isMobile) {
      const el = chunk.el;
      const isHeading = chunk.kind === 'heading';
      const rawTitle = isHeading
          ? (el.textContent || '').trim()
          : el.getAttribute('data-title') || el.querySelector('.card-header, .fallback-header, .guide-header')?.textContent || '无标题';
      
      let id = el.id;
      if (!id) {
        id = isHeading ? `heading-${index + 1}` : `section-block-${index + 1}`;
        el.id = id;
      }

      // 通过中央配置映射语义解析类型
      const { type, number } = parseTitleFromConfig(rawTitle, modules);

      const modMeta = modules[type] || {};
      const chipClass = modMeta.theme || 'chip-default';
      const labelText = modMeta.short || type;

      const li = document.createElement('li');
      li.className = 'toc-item';

      const a = document.createElement('a');
      a.href = `#${encodeURIComponent(id)}`;
      a.className = 'toc-link';

      if (isHeading) {
          a.classList.add('toc-heading', `toc-level-${chunk.level}`);

          const headingText = document.createElement('span');
          headingText.className = 'toc-heading-text';
          headingText.textContent = rawTitle;

          a.appendChild(headingText);
        } else {

      const chipSpan = document.createElement('span');
      chipSpan.className = `toc-chip ${chipClass}`;
      chipSpan.textContent = labelText;

      const numSpan = document.createElement('span');
      numSpan.className = 'toc-number';
      numSpan.textContent = number;

      a.appendChild(chipSpan);
      a.appendChild(numSpan);
        }

      // 移动端抽屉：点选后先收起抽屉，再平滑跳转，避免抽屉遮挡阅读
      if (isMobile) {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          setMobileTocOpen(false);
          history.replaceState({ ...(history.state || {}), scrollY: window.scrollY }, '', a.getAttribute('href'));
          requestAnimationFrame(() => {
            const target = document.getElementById(id);
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });
      }

      li.appendChild(a);
      targetList.appendChild(li);
      links.push(a);
    }

    chunks.forEach((chunk, index) => {
      makeTocEntry(chunk, index, tocList, desktopLinks, false);
      if (mobileTocList) makeTocEntry(chunk, index, mobileTocList, mobileLinks, true);
    });

    // 侧边栏公式二次渲染
    const sidebar = document.querySelector('.custom-page-sidebar');
    if (sidebar && sidebar.textContent.includes('$')) {
      renderMathInElement(sidebar, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false },
        ],
        throwOnError: false
      });
    }

    // 移动端抽屉内的公式同样二次渲染
    const mobileDrawer = document.querySelector('.mobile-toc-drawer');
    if (mobileDrawer && mobileDrawer.textContent.includes('$')) {
      renderMathInElement(mobileDrawer, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false },
        ],
        throwOnError: false
      });
    }

    formatMultipleChoiceQuestions(); // 1. 重构选择题
    linkPageElements(bookConfig, globalBlockIndex); // 2. 激发全时无条件大一统联动

    // 3. 对卡片标题执行公式二次渲染
    const cardHeaders = document.querySelectorAll('.card-header, .fallback-header, .guide-header');
    cardHeaders.forEach(header => {
      if (!header.textContent.includes('$')) return;
      renderMathInElement(header, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false },
        ],
        throwOnError: false
      });
    });




    // 5. 长行内公式胶囊化：KaTeX 字形加载完成后宽度会变化，需再校准一次
    tameOverflowingInlineMath();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => tameOverflowingInlineMath());
    }

    let lastSpyIndex = -1;

    function handleSpyScroll() {
      let activeIndex = -1;
      const scrollPosition = window.scrollY + 120;

      chunks.forEach((chunk, index) => {
        const rect = chunk.el.getBoundingClientRect();
        const elementTop = rect.top + window.scrollY;
        if (scrollPosition >= elementTop) {
          activeIndex = index;
        }
      });

      desktopLinks.forEach((link, index) => link.classList.toggle('active', index === activeIndex));
      mobileLinks.forEach((link, index) => link.classList.toggle('active', index === activeIndex));

      // 抽屉展开时，把当前章节项保持在可视区内（仅当高亮项变化时滚动，避免抖动）
      if (document.body.classList.contains('mobile-toc-open') && activeIndex !== lastSpyIndex) {
        const activeMobile = mobileLinks[activeIndex];
        if (activeMobile) activeMobile.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
      lastSpyIndex = activeIndex;
    }

    // 防止 SPA 多次导航后叠加滚动监听器
    if (window.__slScrollSpy) window.removeEventListener('scroll', window.__slScrollSpy);
    window.__slScrollSpy = handleSpyScroll;
    window.addEventListener('scroll', window.__slScrollSpy);
    handleSpyScroll();
  }

  buildBookTOC();
  document.addEventListener('astro:page-load', buildBookTOC);

  // 文章正文公式操作：一键复制 LaTeX / 下载 SVG（SPA 导航后同样需要重新挂接）
  initFormulaActions();
  document.addEventListener('astro:page-load', initFormulaActions);
</script>
