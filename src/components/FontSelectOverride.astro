---
import { LATIN_PRESETS, CJK_PRESETS } from '../scripts/font-presets';
---

<starlight-font-select class="vp-font-switch" title="切换字体" data-feature="fonts">
  <button
    type="button"
    class="vp-font-btn"
    aria-label="切换字体"
    title="切换字体"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <span class="vp-font-icon" aria-hidden="true"><span class="letter-l">A</span><span class="letter-s">a</span></span>
  </button>

  <div class="vp-font-panel" role="listbox" aria-label="切换字体" aria-hidden="true">
    <div class="vp-font-panel-title">切换字体</div>
    <div class="vp-font-cols">
      <div class="vp-font-col" data-col="cjk">
        <div class="vp-font-col-title">中文字体</div>
        <div class="vp-font-options">
          {CJK_PRESETS.map((opt) => (
            <button
              type="button"
              class="vp-font-option"
              data-setting="cjk"
              data-value={opt.value}
              role="option"
              aria-selected="false"
            >
              <span class="vp-font-check" aria-hidden="true"></span>
              <span class="vp-font-option-text">{opt.label}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="vp-font-col" data-col="latin">
        <div class="vp-font-col-title">英文字体</div>
        <div class="vp-font-options">
          {LATIN_PRESETS.map((opt) => (
            <button
              type="button"
              class="vp-font-option"
              data-setting="latin"
              data-value={opt.value}
              role="option"
              aria-selected="false"
            >
              <span class="vp-font-check" aria-hidden="true"></span>
              <span class="vp-font-option-text">{opt.label}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</starlight-font-select>

<style>.vp-font-switch {
    position: relative;
    display: flex;
    align-items: center;
  }

  .vp-font-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    color: var(--sl-color-gray-2);
    transition: color 0.25s, background-color 0.25s;
  }
  .vp-font-btn:hover,
  .vp-font-btn:focus-visible {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }
  .vp-font-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  .vp-font-icon {
    display: inline-flex;
    align-items: baseline;
    line-height: 1;
    font-weight: 700;
    font-size: 1rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    user-select: none;
  }
  .vp-font-icon .letter-l {
    font-size: 1.15rem;
  }
  .vp-font-icon .letter-s {
    font-size: 0.72rem;
  }

  .vp-font-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: none;
    flex-direction: column;
    width: min(92vw, 22rem);
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
    overflow: hidden;
    z-index: 2147483001;
  }
  .vp-font-switch.vp-open .vp-font-panel {
    display: flex;
  }

  .vp-font-panel-title {
    padding: 0.625rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sl-color-gray-2);
    opacity: 0.8;
  }

  .vp-font-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-bottom: 0.25rem;
  }
  .vp-font-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .vp-font-col + .vp-font-col {
    border-inline-start: 1px solid var(--sl-color-hairline-light);
  }
  .vp-font-col-title {
    padding: 0.4rem 0.85rem 0.3rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-2);
    opacity: 0.7;
  }

  .vp-font-options {
    display: flex;
    flex-direction: column;
  }

  .vp-font-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.45rem 0.85rem;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: var(--sl-color-text);
    transition: background-color 0.15s, color 0.15s;
  }
  .vp-font-option:hover,
  .vp-font-option:focus-visible {
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .vp-font-option:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  .vp-font-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    flex-shrink: 0;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--sl-color-text-accent);
  }
  .vp-font-option[aria-selected='true'] .vp-font-check::before {
    content: '✓';
  }

  .vp-font-col[data-col='cjk'] .vp-font-option[data-value='sans'] .vp-font-option-text,
  .vp-font-col[data-col='latin'] .vp-font-option[data-value='sans'] .vp-font-option-text {
    font-family: var(--font-latin-sans), var(--font-cjk-sans);
  }
  .vp-font-col[data-col='cjk'] .vp-font-option[data-value='serif'] .vp-font-option-text,
  .vp-font-col[data-col='latin'] .vp-font-option[data-value='serif'] .vp-font-option-text {
    font-family: var(--font-latin-serif), var(--font-cjk-serif);
  }
  .vp-font-col[data-col='cjk'] .vp-font-option[data-value='han-sans'] .vp-font-option-text {
    font-family: 'Noto Sans SC Variable', var(--font-latin-sans), var(--font-cjk-sans);
  }
  .vp-font-col[data-col='cjk'] .vp-font-option[data-value='han-serif'] .vp-font-option-text {
    font-family: 'Noto Serif SC Variable', var(--font-latin-serif), var(--font-cjk-serif);
  }
  .vp-font-col[data-col='latin'] .vp-font-option[data-value='katex'] .vp-font-option-text {
    font-family: var(--font-latin-katex), var(--font-cjk-sans);
  }
  .vp-font-option-text {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  @media (max-width: 30rem) {
    .vp-font-panel {
      width: min(88vw, 18rem);
    }
    .vp-font-cols {
      grid-template-columns: 1fr;
    }
    .vp-font-col + .vp-font-col {
      border-inline-start: none;
      border-top: 1px solid var(--sl-color-hairline-light);
    }
  }
</style>

<script>import {
    LATIN_PRESETS,
    CJK_PRESETS,
    loadFontPref,
    saveFontPref,
    applyFontPref,
    type FontPref,
    type LatinFont,
    type CjkFont,
  } from '../scripts/font-presets';

  const parseLatin = (v: unknown): LatinFont =>
    LATIN_PRESETS.some((p) => p.value === v) ? (v as LatinFont) : 'sans';

  const parseCjk = (v: unknown): CjkFont =>
    CJK_PRESETS.some((p) => p.value === v) ? (v as CjkFont) : 'sans';

  class StarlightFontSelect extends HTMLElement {
    connectedCallback() {

      const pref = loadFontPref();
      applyFontPref(pref);
      this.syncSelected(pref);
      if (this.dataset.bound) return;
      this.dataset.bound = '1';

      const btn = this.querySelector<HTMLButtonElement>('.vp-font-btn');
      const panel = this.querySelector<HTMLElement>('.vp-font-panel');

      btn?.addEventListener('click', () => this.toggle(panel));

      this.querySelectorAll<HTMLButtonElement>('.vp-font-option[data-setting="cjk"]').forEach((opt) => {
        opt.addEventListener('click', () => this.applyOne('cjk', parseCjk(opt.dataset.value)));
      });

      this.querySelectorAll<HTMLButtonElement>('.vp-font-option[data-setting="latin"]').forEach((opt) => {
        opt.addEventListener('click', () => this.applyOne('latin', parseLatin(opt.dataset.value)));
      });
    }

    applyOne(kind: 'latin' | 'cjk', value: LatinFont | CjkFont): void {
      const pref = loadFontPref();
      const next: FontPref = kind === 'latin' ? { ...pref, latin: value as LatinFont } : { ...pref, cjk: value as CjkFont };
      saveFontPref(next);
      applyFontPref(next);
      this.syncAll(next);
    }

    private syncAll(pref: FontPref): void {
      document
        .querySelectorAll<StarlightFontSelect>('starlight-font-select')
        .forEach((el) => el.syncSelected(pref));
    }

    toggle(panel?: HTMLElement | null): void {
      document
        .querySelectorAll<StarlightFontSelect>('starlight-font-select')
        .forEach((el) => el !== this && el.close());
      const open = this.classList.toggle('vp-open');
      panel?.setAttribute('aria-hidden', String(!open));
      this.querySelector<HTMLButtonElement>('.vp-font-btn')?.setAttribute('aria-expanded', String(open));
    }

    close(): void {
      this.classList.remove('vp-open');
      this.querySelector<HTMLElement>('.vp-font-panel')?.setAttribute('aria-hidden', 'true');
      this.querySelector<HTMLButtonElement>('.vp-font-btn')?.setAttribute('aria-expanded', 'false');
    }

    syncSelected(pref: FontPref): void {
      this.querySelectorAll<HTMLButtonElement>('.vp-font-option').forEach((opt) => {
        const setting = opt.dataset.setting;
        const val = opt.dataset.value;
        const selected = setting === 'latin' ? val === pref.latin : val === pref.cjk;
        opt.setAttribute('aria-selected', String(selected));
      });
    }
  }

  if (!customElements.get('starlight-font-select')) {
    customElements.define('starlight-font-select', StarlightFontSelect);
  }

  if (!window.__vpFontDocHandlers) {
    window.__vpFontDocHandlers = true;
    document.addEventListener('click', (e) => {
      document.querySelectorAll<StarlightFontSelect>('starlight-font-select').forEach((el) => {
        if (!el.contains(e.target as Node)) el.close();
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelector<StarlightFontSelect>('starlight-font-select.vp-open')?.close();
    });
  }
</script>
