---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title } = Astro.props;
const cleanId = title ? title.trim().replace(/\s+/g, '-') : undefined;
---

<div class="summary-card toc-chunk" data-title={title} id={cleanId} {...srcAttrs(Astro.props)}>
  <div class="card-header" set:html={renderTitleHtml(title)}></div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .summary-card {
    background-color: transparent;
    border: none;
    margin: 1.75rem 0 1.25rem;
    padding: 0;
  }
  .card-header {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin-bottom: 0.65rem;
    letter-spacing: -0.01em;
  }
  .card-body {
    padding: 0 0 0 0.75rem;
  }
</style>