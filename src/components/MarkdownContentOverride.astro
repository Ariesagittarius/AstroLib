---
/**
 * MarkdownContentOverride.astro
 * ============================================================================
 * 覆盖 Starlight 原版 MarkdownContent：
 * 1. 引入原版 Markdown 排版样式规范；
 * 2. 将外层包装容器从普通 <div> 升级为具备高权重文章语义的 <article role="article">；
 * 3. 赋能 Chromium 提纯算法（Readability / Screen2x）秒级识别文章主体，
 *    稳定激活 Chrome 地址栏 [ 📖 朗读模式 / 阅读模式 ] 并精准聚焦正文。
 * ============================================================================
 */
import '@astrojs/starlight/style/markdown.css';
---

<article class="sl-markdown-content" role="article">
  <slot />
</article>
