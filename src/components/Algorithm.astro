---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';

interface Props {
  title?: string;
  caption?: string;
  id?: string;
  [key: string]: any;
}

const { title: rawTitle, caption: rawCaption, id: explicitId, ...rest } = Astro.props;
const fullTitle = (rawTitle || rawCaption || '').trim();

let prefix = '';
let text = '';

if (fullTitle) {

  const match = fullTitle.match(/^((?:Figure|Algorithm|图)\s*[\d\.\-]+[:\.]?)\s*(.*)$/i);
  if (match) {
    prefix = match[1];
    text = match[2];
  } else {
    prefix = fullTitle;
    text = '';
  }
}

const cleanId =
  explicitId ||
  (fullTitle
    ? fullTitle
        .replace(/[^\w\u4e00-\u9fa5\.\-]+/g, '-')
        .replace(/^-+|-+$/g, '')
    : undefined);
---

<div
  class="academic-algorithm toc-chunk"
  id={cleanId}
  data-title={fullTitle || undefined}
  {...srcAttrs(Astro.props)}
>
  {fullTitle && (
    <div class="algorithm-caption" role="heading" aria-level="4">
      <span class="algorithm-caption-prefix">{prefix}</span>
      {text && <span class="algorithm-caption-text" set:html={renderTitleHtml(text)}></span>}
    </div>
  )}
  <div class="algorithm-body">
    <slot />
  </div>
</div>

<style>.academic-algorithm {
    position: relative;
    margin: 1.75rem 0 1.5rem;
    border-top: 2px solid var(--sl-color-gray-1, #1e293b);
    border-bottom: 2px solid var(--sl-color-gray-1, #1e293b);
    border-left: none !important;
    border-right: none !important;
    border-radius: 0 !important;
    background-color: transparent !important;
    box-shadow: none !important;
    text-indent: 0 !important;
    overflow-x: auto;
  }

  :global(:root[data-theme='dark']) .academic-algorithm {
    border-top-color: var(--sl-color-gray-2, #cbd5e1);
    border-bottom-color: var(--sl-color-gray-2, #cbd5e1);
  }

  .algorithm-caption {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    padding: 0.4rem 0.25rem 0.45rem;
    border-bottom: 1px solid var(--sl-color-hairline, rgba(128, 128, 128, 0.25));
    font-family: var(--font-serif, "Source Serif Pro", "Noto Serif SC", serif);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--sl-color-text-main, #0f172a);
    text-indent: 0 !important;
  }

  :global(:root[data-theme='dark']) .algorithm-caption {
    color: var(--sl-color-white, #f8fafc);
  }

  .algorithm-caption-prefix {
    font-weight: 700;
    margin-right: 0.5rem;
    font-family: var(--font-serif, "Source Serif Pro", "Noto Serif SC", serif);
  }

  .algorithm-caption-text {
    font-weight: 400;
    font-family: var(--font-serif, "Source Serif Pro", "Noto Serif SC", serif);
  }

  .algorithm-body {
    display: block;
    padding: 0.75rem 0.25rem 0.65rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    font-size: 0.925rem;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    tab-size: 4;
    text-indent: 0 !important;
    color: var(--sl-color-text-main, #0f172a);
  }

  :global(:root[data-theme='dark']) .algorithm-body {
    color: var(--sl-color-gray-2, #e2e8f0);
  }

  .algorithm-body :global(p),
  .algorithm-body :global(div),
  .algorithm-body :global(span),
  .algorithm-body :global(pre),
  .algorithm-body :global(code) {
    text-indent: 0 !important;
    font-family: inherit;
  }

  .algorithm-body :global(p) {
    margin: 0 !important;
    line-height: inherit;
  }

  .algorithm-body :global(p + p) {
    margin-top: 0.75rem !important;
  }

  .algorithm-body :global(u) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
