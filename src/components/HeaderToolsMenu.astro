---
import { features } from '../config/features.config.mjs';
---

<div class="vp-tools-wrapper" id="vp-tools-wrapper">
  <button
    type="button"
    class="vp-tools-btn"
    id="vp-tools-trigger"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="vp-tools-menu"
    title="书籍与学习工具"
    aria-label="打开书籍与学习工具聚合菜单"
  >

    <md-icon class="vp-tools-grid-icon header-mdicon" aria-hidden="true">apps</md-icon>
  </button>

  <div class="vp-tools-menu" id="vp-tools-menu" role="menu" aria-hidden="true">
    <div class="vp-tools-menu-title">书籍与学习工具</div>

    <div class="vp-tools-list">
      {features.exercises?.enabled && (
        <button type="button" class="vp-tools-item" role="menuitem" data-exercise-trigger title="查看本章课后真题与自测练习 (Alt+E)">
          <md-icon class="vp-tools-icon" aria-hidden="true">quiz</md-icon>
          <span class="vp-tools-label">课后真题与自测练习</span>
          <kbd class="vp-tools-kbd">Alt+E</kbd>
        </button>
      )}

      {features.inspector?.enabled && (
        <button type="button" class="vp-tools-item" role="menuitem" data-inspector-trigger title="查看全书知识模块速查与索引 (Alt+M)">
          <md-icon class="vp-tools-icon" aria-hidden="true">table_chart</md-icon>
          <span class="vp-tools-label">全书知识模块速查</span>
          <kbd class="vp-tools-kbd">Alt+M</kbd>
        </button>
      )}

      {features.relationGraph?.enabled && (
        <button type="button" class="vp-tools-item relation-graph-trigger" role="menuitem" data-open-relation-graph title="查看全书章节内联关系图谱 (Alt+G)">
          <md-icon class="vp-tools-icon" aria-hidden="true">account_tree</md-icon>
          <span class="vp-tools-label">章节内联关系图谱</span>
          <kbd class="vp-tools-kbd">Alt+G</kbd>
        </button>
      )}

      {features.feedback?.enabled && (
        <button type="button" class="vp-tools-item" role="menuitem" data-feedback-trigger title="读者段落勘误与反馈 (Alt+F)">
          <md-icon class="vp-tools-icon" aria-hidden="true">rate_review</md-icon>
          <span class="vp-tools-label">读者段落勘误与反馈</span>
          <kbd class="vp-tools-kbd">Alt+F</kbd>
        </button>
      )}

      {features.chapterExport?.enabled && (
        <button type="button" class="vp-tools-item" role="menuitem" data-chapter-export-trigger title="导出本章为 LaTeX / PDF (Alt+X)">
          <md-icon class="vp-tools-icon" aria-hidden="true">download</md-icon>
          <span class="vp-tools-label">导出本章 (LaTeX / PDF)</span>
          <kbd class="vp-tools-kbd">Alt+X</kbd>
        </button>
      )}
    </div>

    <div class="vp-tools-divider" role="separator" aria-hidden="true"></div>

    <div class="vp-tools-list">
      <a href="/dev/" class="vp-tools-item vp-tools-link" role="menuitem" title="项目开发与架构文档">
        <md-icon class="vp-tools-icon" aria-hidden="true">code</md-icon>
        <span class="vp-tools-label">项目开发与架构文档</span>
      </a>
    </div>
  </div>
</div>

<style>.vp-tools-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    flex-shrink: 0;
  }

  @media (max-width: 49.999rem) {
    .vp-tools-wrapper {
      display: none !important;
    }
  }

  .vp-tools-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    padding: 0;
  }

  .vp-tools-btn:hover {
    background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.1));
    color: var(--sl-color-white);
  }

  .vp-tools-grid-icon {
    --md-icon-size: 20px;
    --md-icon-font: 'Material Symbols Outlined';
    font-size: 20px;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  .vp-tools-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: var(--layer-popover, 300);
    min-width: 16rem;
    padding: 0.5rem 0;
    background-color: var(--sl-color-bg-sidebar, #ffffff);
    border: 1px solid var(--sl-color-hairline, #e2e8f0);
    border-radius: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12), 0 1px 4px rgba(0, 0, 0, 0.06);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.96) translateY(-4px);
    transform-origin: top right;
    transition: opacity 0.18s cubic-bezier(0.2, 0, 0, 1), transform 0.18s cubic-bezier(0.2, 0, 0, 1), visibility 0.18s;
  }

  .vp-tools-wrapper.is-open .vp-tools-menu {
    opacity: 1;
    visibility: visible;
    transform: scale(1) translateY(0);
  }

  .vp-tools-wrapper.is-open .vp-tools-btn {
    background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.15));
    color: var(--sl-color-text-accent);
  }

  .vp-tools-menu-title {
    padding: 0.4rem 1rem 0.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .vp-tools-list {
    display: flex;
    flex-direction: column;
    padding: 0.25rem 0.4rem;
  }

  .vp-tools-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: none;
    border-radius: 0.6rem;
    background: transparent;
    color: var(--sl-color-white);
    font-size: 0.84rem;
    font-weight: 500;
    font-family: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .vp-tools-item:hover {
    background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.08));
    color: var(--sl-color-text-accent);
  }

  .vp-tools-icon {
    --md-icon-size: 1.15rem;
    --md-icon-font: 'Material Symbols Outlined';
    font-size: 1.15rem;
    width: 1.15rem;
    height: 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-2);
    flex-shrink: 0;
    transition: color 0.12s ease;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  .vp-tools-item:hover .vp-tools-icon {
    color: var(--sl-color-text-accent);
  }

  .vp-tools-label {
    flex: 1;
    white-space: nowrap;
  }

  .vp-tools-kbd {
    font-family: inherit;
    font-size: 0.68rem;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    background-color: var(--sl-color-bg-inline-code, rgba(125, 125, 125, 0.08));
    border: 1px solid var(--sl-color-hairline, #e2e8f0);
    color: var(--sl-color-gray-3);
    line-height: 1;
  }

  .vp-tools-divider {
    height: 1px;
    background-color: var(--sl-color-hairline, #e2e8f0);
    margin: 0.35rem 0;
  }
</style>

<script>import '@material/web/icon/icon.js';
  function setupHeaderToolsMenu() {
    const wrapper = document.getElementById('vp-tools-wrapper');
    const trigger = document.getElementById('vp-tools-trigger');
    const menu = document.getElementById('vp-tools-menu');
    if (!wrapper || !trigger || !menu || trigger.dataset.bound) return;
    trigger.dataset.bound = 'true';

    function toggleMenu(open?: boolean) {
      const isCurrentlyOpen = wrapper?.classList.contains('is-open');
      const next = typeof open === 'boolean' ? open : !isCurrentlyOpen;
      if (next) {

        document.querySelectorAll<any>('starlight-feature-toggles').forEach((ft) => ft.closePanel?.());
      }
      wrapper?.classList.toggle('is-open', next);
      trigger?.setAttribute('aria-expanded', String(next));
      menu?.setAttribute('aria-hidden', String(!next));
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    menu.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement)?.closest('.vp-tools-item');
      if (item) {
        toggleMenu(false);
      }
    });

    document.addEventListener('click', (e) => {
      if (wrapper.classList.contains('is-open') && !wrapper.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && wrapper.classList.contains('is-open')) {
        toggleMenu(false);
        trigger.focus();
      }
    });

    const isShowGraph = localStorage.getItem('astro-show-relation-graph-btn') !== 'false';
    wrapper.querySelectorAll('.relation-graph-trigger').forEach((btn) => {
      (btn as HTMLElement).style.display = isShowGraph ? '' : 'none';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderToolsMenu);
  } else {
    setupHeaderToolsMenu();
  }
  document.addEventListener('astro:page-load', setupHeaderToolsMenu);
</script>
