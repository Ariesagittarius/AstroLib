---

---

<button class="ask-fab" type="button" aria-label="AI 书内智能问答" title="AI 书内问答 (Alt+A)">
  <svg class="ask-fab-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path d="m19 9 1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z"/>
  </svg>
  <span class="ask-fab-text">AI 问答</span>
</button>

<div class="ask-panel" role="dialog" aria-label="AI 书内智能问答">

  <div class="ask-resize-handle ask-resize-nw" data-handle="nw" title="拖拽调整尺寸" aria-hidden="true"></div>
  <div class="ask-resize-handle ask-resize-w" data-handle="w" title="拖拽调整宽度" aria-hidden="true"></div>
  <div class="ask-resize-handle ask-resize-n" data-handle="n" title="拖拽调整高度" aria-hidden="true"></div>

  <header class="ask-head">
    <div class="ask-brand">
      <span class="ask-brand-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="m19 9 1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z"/>
        </svg>
      </span>
      <div class="ask-title-group">
        <div class="ask-title">本书智能问答</div>
        <div class="ask-book"></div>
      </div>
    </div>
    <div class="ask-head-actions">

      <button class="ask-icon-btn ask-collapse-tools-btn" type="button" title="折叠前序过程" aria-label="折叠前序过程">
        <svg class="icon-unfold-less" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M7.41 18.59 8.83 20 12 16.83 15.17 20l1.41-1.41L12 14l-4.59 4.59zm9.18-13.18L15.17 4 12 7.17 8.83 4 7.41 5.41 12 10l4.59-4.59z"/>
        </svg>
        <svg class="icon-unfold-more" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display: none;">
          <path d="m12 18.17 3.17-3.17 1.41 1.41L12 21l-4.58-4.59 1.41-1.41L12 18.17zm0-12.34L8.83 9 7.42 7.59 12 3l4.58 4.59L15.17 9 12 5.83z"/>
        </svg>
      </button>

      <button class="ask-icon-btn ask-new-btn" type="button" title="新建会话" aria-label="新建会话">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
        </svg>
      </button>

      <button class="ask-icon-btn ask-history-btn" type="button" title="历史会话" aria-label="历史会话">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/>
        </svg>
      </button>

      <button class="ask-icon-btn ask-settings-btn" type="button" title="AI 设置与偏好" aria-label="打开 AI 设置">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
        </svg>
      </button>

      <button class="ask-icon-btn ask-close" type="button" title="关闭" aria-label="关闭">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
  </header>

  <slot />

  <div class="ask-history" role="region" aria-label="历史会话列表">
    <div class="ask-history-head">
      <span class="ask-history-title">历史会话</span>
      <div class="ask-history-actions">
        <button class="ask-history-new-btn" type="button" title="新建会话">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
          </svg>
          <span>新建会话</span>
        </button>
        <button class="ask-icon-btn ask-history-close-btn" type="button" title="收起历史列表">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
          </svg>
        </button>
      </div>
    </div>
    <div class="ask-history-body">
      <md-list class="ask-history-list"></md-list>
      <div class="ask-history-empty">
        <svg class="ask-history-empty-icon" viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
          <path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/>
        </svg>
        <span>暂无历史会话记录</span>
      </div>
    </div>
  </div>
</div>
