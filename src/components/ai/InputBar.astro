---
// 表现层：InputBar 底部复合输入与操作卡片 (完全对标 Chrome Gemini 侧载官方 UI/UX 规范)
---

<div class="ask-status" aria-live="polite"></div>

<div class="ask-input-bar">
  <!-- 章节选择浮层 (Popover: 输入 @ 或点击 + 时唤出) -->
  <div class="ask-chapter-picker-popover" id="ask-chapter-picker-popover" style="display: none;" role="dialog" aria-modal="false" aria-label="选择章节引用">
    <div class="ask-chapter-picker-header">
      <div class="ask-chapter-search-box">
        <svg class="ask-chapter-search-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
        <input type="text" class="ask-chapter-search-input" id="ask-chapter-search-input" placeholder="搜索本书章节..." autocomplete="off" spellcheck="false" />
      </div>
      <button type="button" class="ask-popover-close-btn" id="ask-chapter-picker-close" title="关闭 (Esc)" aria-label="关闭">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
    </div>
    <div class="ask-chapter-picker-body">
      <ul class="ask-chapter-picker-list" id="ask-chapter-picker-list">
        <!-- 章节列表动态生成 -->
      </ul>
    </div>
    <div class="ask-chapter-picker-footer">
      <span class="ask-chapter-picker-count" id="ask-chapter-picker-count">已选 0 章</span>
      <button type="button" class="ask-chapter-picker-done-btn" id="ask-chapter-picker-done">完成</button>
    </div>
  </div>

  <!-- 模型快捷切换 Popover 菜单 (完全对标 Chrome Gemini 官方截图) -->
  <div class="ask-model-menu" id="ask-model-menu" style="display: none;" role="menu" aria-label="选择模型">
    <div class="ask-model-menu-list">
      <!-- 自动 -->
      <button type="button" class="ask-model-menu-item" data-model-id="auto" role="menuitem">
        <div class="ask-model-item-text">
          <div class="ask-model-item-headline">自动</div>
          <div class="ask-model-item-support">根据需求调整回答</div>
        </div>
        <svg class="ask-model-check-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      </button>

      <!-- 3.5 Flash-Lite -->
      <button type="button" class="ask-model-menu-item" data-model-id="gemini-3.5-flash-lite" role="menuitem">
        <div class="ask-model-item-text">
          <div class="ask-model-item-headline">3.5 Flash-Lite</div>
          <div class="ask-model-item-support">极速回答</div>
        </div>
        <svg class="ask-model-check-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      </button>

      <!-- 3.8 Flash -->
      <button type="button" class="ask-model-menu-item is-active" data-model-id="gemini-3.8-flash" role="menuitem">
        <div class="ask-model-item-text">
          <div class="ask-model-item-headline">3.8 Flash</div>
          <div class="ask-model-item-support">全方位帮助</div>
        </div>
        <svg class="ask-model-check-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      </button>

      <!-- 3.1 Pro -->
      <button type="button" class="ask-model-menu-item" data-model-id="gemini-3.1-pro" role="menuitem">
        <div class="ask-model-item-text">
          <div class="ask-model-item-headline">3.1 Pro</div>
          <div class="ask-model-item-support">高级推理</div>
        </div>
        <svg class="ask-model-check-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      </button>

      <!-- 额外活动模型 (若用户配置了其他模型如 DeepSeek/校内模型) -->
      <button type="button" class="ask-model-menu-item ask-model-extra-item" id="ask-model-extra-item" style="display: none;" role="menuitem">
        <div class="ask-model-item-text">
          <div class="ask-model-item-headline" id="ask-model-extra-headline">当前模型</div>
          <div class="ask-model-item-support" id="ask-model-extra-support">自定义/第三方模型</div>
        </div>
        <svg class="ask-model-check-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      </button>

      <div class="ask-model-menu-divider"></div>

      <!-- 扩展思考开关 -->
      <div class="ask-model-menu-switch-item">
        <div class="ask-model-item-text">
          <div class="ask-model-item-headline">扩展思考</div>
          <div class="ask-model-item-support">思考时间较长，适合处理复杂任务</div>
        </div>
        <label class="ask-m3-switch" for="ask-thinking-switch">
          <input type="checkbox" id="ask-thinking-switch" />
          <span class="ask-m3-switch-track">
            <span class="ask-m3-switch-thumb"></span>
          </span>
        </label>
      </div>

      <!-- 自动折叠工具探索开关 -->
      <div class="ask-model-menu-switch-item">
        <div class="ask-model-item-text">
          <div class="ask-model-item-headline">收起工具探索</div>
          <div class="ask-model-item-support">探索完成后折叠为单行总结</div>
        </div>
        <label class="ask-m3-switch" for="ask-collapse-tools-switch">
          <input type="checkbox" id="ask-collapse-tools-switch" checked />
          <span class="ask-m3-switch-track">
            <span class="ask-m3-switch-thumb"></span>
          </span>
        </label>
      </div>

      <div class="ask-model-menu-footer">已配置的模型均支持公式渲染与知识库问答</div>
    </div>
  </div>

  <!-- Gemini 统一圆角复合输入卡片 (三层架构) -->
  <div class="ask-gemini-input-card">
    
    <!-- 1. 顶层：上下文引用行 (Context Row) -->
    <div class="ask-context-row" id="ask-context-row" style="display: none;">
      <div class="ask-context-indicator">
        <svg class="ask-context-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
        </svg>
        <span class="ask-context-text" id="ask-context-text">正在引用本章节内容</span>
      </div>
      <div class="ask-context-actions">
        <!-- 多章节折叠/展开指示按钮 (>= 2 章时展示) -->
        <button type="button" class="ask-context-expand-btn" id="ask-context-expand-btn" style="display: none;" title="查看已引用的章节列表" aria-label="查看引用的章节" aria-expanded="false">
          <svg class="ask-context-expand-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
          </svg>
        </button>
        <!-- 移除全部引用按钮 -->
        <button type="button" class="ask-context-remove-btn" id="ask-context-remove-btn" title="取消引用" aria-label="取消引用">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- 多章节展开明细列表抽屉 (点击展开箭头展示，支持单独移除某章) -->
    <div class="ask-context-dropdown" id="ask-context-dropdown" style="display: none;">
      <ul class="ask-context-items-list" id="ask-context-items-list">
        <!-- 动态渲染引用的章节单项 -->
      </ul>
    </div>

    <!-- 2. 中层：纯净多行文本输入区 (Textarea Row: 消除底部挤压，垂直居中对齐) -->
    <div class="ask-textarea-row">
      <textarea
        class="ask-input"
        id="ask-main-input"
        rows="1"
        placeholder="输入 @ 即可添加章节，或就本书提问..."
        autocomplete="off"
        spellcheck="false"
      ></textarea>
    </div>

    <!-- 3. 底层：快捷操作工具栏 (Actions Row) -->
    <div class="ask-actions-row">
      <!-- 左侧：添加章节按钮 (+ 按钮 / @ 快捷入口) -->
      <div class="ask-actions-left">
        <button type="button" class="ask-action-btn ask-add-chapter-btn" id="ask-add-chapter-btn" title="添加章节引用 (输入 @ 亦可)" aria-label="添加章节引用">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
          </svg>
        </button>
      </div>

      <!-- 右侧：快捷模型切换胶囊 + 发送/停止按钮 -->
      <div class="ask-actions-right">
        <!-- 模型切换药丸按钮 -->
        <button type="button" class="ask-model-pill-btn" id="ask-model-pill-btn" aria-haspopup="true" aria-expanded="false" title="切换当前问答模型">
          <span class="ask-model-pill-name" id="ask-model-pill-name">3.8 Flash</span>
          <svg class="ask-model-pill-arrow" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
          </svg>
        </button>

        <!-- 发送 / 停止生成主操作按钮 -->
        <button class="ask-send-btn" id="ask-send-btn" type="button" title="发送 (Enter)" aria-label="发送" disabled>
          <!-- 官方 Material Symbol arrow_upward -->
          <svg class="ask-send-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z"/>
          </svg>
          <!-- 官方 Material Symbol stop (生成中展示) -->
          <svg class="ask-stop-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" style="display:none;">
            <path d="M6 6h12v12H6z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- 底部居中快捷键提示 -->
  <div class="ask-hint">Enter 发送 · Shift+Enter 换行</div>
</div>
