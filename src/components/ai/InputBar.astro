---
// 表现层：InputBar 底部输入与操作条 (Material You M3 规范)
---

<div class="ask-status" aria-live="polite"></div>

<div class="ask-input-bar">
  <div class="ask-input-box">
    <textarea class="ask-input" rows="1" placeholder="就本书提问，例如：夹逼定理是什么意思？" autocomplete="off" spellcheck="false"></textarea>
    <button class="ask-send-btn" type="button" title="发送 (Enter)" aria-label="发送" disabled>
      <!-- 官方 Material Symbol arrow_upward -->
      <svg class="ask-send-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z"/>
      </svg>
      <!-- 官方 Material Symbol stop (生成中展示) -->
      <svg class="ask-stop-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" style="display:none;">
        <path d="M6 6h12v12H6z"/>
      </svg>
    </button>
  </div>
  <div class="ask-hint">Enter 发送 · Shift+Enter 换行</div>
</div>
