---
// 文章底部「上一页 / 下一页」翻页 — VitePress 化覆盖组件
// 结构对齐官方 VPDocFooter.vue：nav.prev-next > div.pager > a.pager-link(.prev/.next)
//   > span.desc（小字描述）+ span.title（章节标题）
// 样式全部在 src/styles/vitepress-theme.css 的「翻页 pager」区块（保持覆盖层集中、可整体回退）。
// 回退：移除 astro.config.mjs 中本组件注册即可恢复 Starlight 默认翻页。
// 文案与 VitePress 官方默认一致（VPDocFooter.vue：theme.docFooter?.prev || 'Previous page'）。
// 注意：Starlight 自带 en 翻译是 "Previous"/"Next"，故这里显式写官方文案；
// 若将来做中文 locale，可改为 "上一页"/"下一页"。
const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

{
  (prev || next) && (
    <nav class="prev-next print:hidden" dir={dir} aria-label="Pager">
      {
        prev && (
          <div class="pager">
            <a class="pager-link prev" href={prev.href} rel="prev">
              <span class="desc">← 上一节</span>
              <span class="title">{prev.label}</span>
            </a>
          </div>
        )
      }
      {
        next && (
          <div class="pager">
            <a class="pager-link next" href={next.href} rel="next">
              <span class="desc">下一节 →</span>
              <span class="title">{next.label}</span>
            </a>
          </div>
        )
      }
    </nav>
  )
}
