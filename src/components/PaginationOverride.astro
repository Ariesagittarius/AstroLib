---
import { filterScopedPagination, cleanDisplayTitle } from '../utils/pagination-scope';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = filterScopedPagination(Astro.url.pathname, pagination.prev, pagination.next);
---

{
  (prev || next) && (
    <nav class="prev-next print:hidden" dir={dir} aria-label="Pager">
      {
        prev && (
          <div class="pager">
            <a class="pager-link prev" href={prev.href} rel="prev">
              <span class="desc">← 上一节</span>
              <span class="title">{cleanDisplayTitle(prev.label)}</span>
            </a>
          </div>
        )
      }
      {
        next && (
          <div class="pager">
            <a class="pager-link next" href={next.href} rel="next">
              <span class="desc">下一节 →</span>
              <span class="title">{cleanDisplayTitle(next.label)}</span>
            </a>
          </div>
        )
      }
    </nav>
  )
}
