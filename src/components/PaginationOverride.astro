---
const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

{
  (prev || next) && (
    <nav class="prev-next print:hidden" dir={dir} aria-label="Pager">
      {
        prev && (
          <div class="pager">
            <a class="pager-link prev" href={prev.href} rel="prev">
              <span class="desc">Previous page</span>
              <span class="title">{prev.label}</span>
            </a>
          </div>
        )
      }
      {
        next && (
          <div class="pager">
            <a class="pager-link next" href={next.href} rel="next">
              <span class="desc">Next page</span>
              <span class="title">{next.label}</span>
            </a>
          </div>
        )
      }
    </nav>
  )
}
