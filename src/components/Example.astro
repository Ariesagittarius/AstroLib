---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title } = Astro.props;

const cleanId = title ? title.trim().replace(/\s+/g, '-') : undefined;
---

<div class="example-card toc-chunk" data-title={title} id={cleanId} {...srcAttrs(Astro.props)}>
  <div class="card-header" set:html={renderTitleHtml(title)}></div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>.example-card {
    background-color: transparent;
    border: none;
    margin: 2.25rem 0 1.5rem;
    padding: 0;
  }
  .card-header {
    font-size: 1.05rem;
    font-weight: 650;
    font-family: var(--font-heading, var(--academic-font-heading, sans-serif));
    color: var(--academic-color-heading, var(--sl-color-white));
    margin-bottom: 0.85rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    letter-spacing: 0.01em;
  }
  .card-body {
    padding: 0;
  }
</style>
