---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title } = Astro.props;

const cleanId = title ? title.trim().replace(/\s+/g, '-') : undefined;
---

<div class="example-card toc-chunk" data-title={title} id={cleanId} {...srcAttrs(Astro.props)}>
  <div class="card-header" set:html={renderTitleHtml(title)}></div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>.example-card {
    --card-border: #10b981;
    --card-header-bg: #ecfdf5;
    --card-header-fg: #065f46;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow: hidden;
  }
  .card-header {
    background-color: var(--card-header-bg);
    color: var(--card-header-fg);
    padding: 0.6rem 1rem;
    font-weight: bold;
    border-bottom: 1px solid var(--card-border);
  }
  .card-body {
    padding: 1rem;
  }

  :global(html[data-theme='dark']) .example-card {
    --card-border: #34d399;
    --card-header-bg: rgba(16, 185, 129, 0.16);
    --card-header-fg: #6ee7b7;
  }
</style>
