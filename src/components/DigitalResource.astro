---
import { srcAttrs } from '../utils/src-attrs.mjs';
import { generateArtisticQRSvg, resolveAcademicSymbol } from '../utils/artistic-qr.mjs';

interface Props {
  id?: string;
  title?: string;
  url?: string;
  type?: 'auto' | 'video' | 'courseware' | 'demo' | 'resource';
}

const { id = '', title = '', url = '', type = 'auto' } = Astro.props;

let cleanTitle = title.replace(/^二维码\s*\d+(\.\d+)*\s*/, '').replace(/[\.\。\s]+$/, '').trim();
let codeId = id;

if (!codeId) {
  const match = title.match(/^二维码\s*(\d+(\.\d+)*)/);
  if (match) {
    codeId = match[1];
  }
}

let categoryName = '数字资源';
let iconKind = 'resource';
if (type === 'courseware' || /课件|讲义|PPT|演示文稿/i.test(cleanTitle)) {
  categoryName = '教学课件';
  iconKind = 'courseware';
} else if (type === 'video' || /视频|微课|讲解|录像/i.test(cleanTitle)) {
  categoryName = '微课视频';
  iconKind = 'video';
} else if (type === 'demo' || /动画|演示|仿真|几何画板|GeoGebra/i.test(cleanTitle)) {
  categoryName = '动态演示';
  iconKind = 'demo';
}

const displayTag = codeId ? `${categoryName} ${codeId}` : categoryName;
const displayTitle = cleanTitle || '配套数字化资源';
const popoverId = `res-popover-${codeId ? codeId.replace(/\./g, '-') : Math.random().toString(36).substring(2, 9)}`;

let qrSvg = '';
if (url) {
  try {
    qrSvg = await generateArtisticQRSvg(url, {
      title: cleanTitle,
      moduleStyle: 'sharp',
      margin: 3.6,
      scale: 16,
    });
  } catch (err) {
    console.error('[DigitalResource] Failed to generate artistic QR SVG:', err);
  }
}
---

<div class="academic-digital-resource academic-resource-card qr-video-card not-content" data-res-type={iconKind} {...srcAttrs(Astro.props)}>
  <div class="academic-resource-stream">
    <div class="academic-resource-lead">
      <span class="academic-resource-media-icon" aria-hidden="true">
        {iconKind === 'video' && (
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" />
          </svg>
        )}
        {iconKind === 'courseware' && (
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" />
          </svg>
        )}
        {iconKind === 'demo' && (
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z" />
          </svg>
        )}
        {iconKind === 'resource' && (
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" />
          </svg>
        )}
      </span>
      <span class="academic-resource-prefix">{displayTag}</span>
      {url ? (
        <a href={url} target="_blank" rel="noopener noreferrer" class="academic-resource-title-link" title={`打开数字资源: ${displayTitle}`}>
          <span class="academic-resource-title-text">{displayTitle}</span>
          <span class="academic-resource-link-arrow" aria-hidden="true"> ↗</span>
        </a>
      ) : (
        <span class="academic-resource-title-plain">{displayTitle}</span>
      )}
    </div>

    {url && (
      <span class="academic-resource-actions academic-resource-trigger-wrapper qr-trigger-wrapper">
        <button
          type="button"
          class="academic-resource-action-btn js-copy-resource-url"
          data-url={url}
          aria-label="复制资源链接"
          title="复制链接"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
          </svg>
        </button>

        {qrSvg && (
          <button
            type="button"
            class="academic-resource-action-btn js-resource-trigger js-qr-trigger"
            data-popover-id={popoverId}
            aria-expanded="false"
            aria-haspopup="dialog"
            aria-label="扫码查阅"
            title="手机扫码查阅"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M3 11h8V3H3v8zm2-6h4v4H5V5zM3 21h8v-8H3v8zm2-6h4v4H5v-4zM13 3v8h8V3h-8zm6 6h-4V5h4v4zM13 13h2v2h-2zM15 15h2v2h-2zM13 17h2v2h-2zM17 13h2v2h-2zM19 15h2v2h-2zM17 17h2v2h-2zM15 19h2v2h-2zM19 19h2v2h-2z" />
            </svg>
          </button>
        )}

        {qrSvg && (
          <div id={popoverId} class="academic-resource-popover qr-popover js-resource-popover js-qr-popover" role="dialog" aria-modal="false" hidden>
            <div class="academic-resource-pop-header qr-popover-header">
              <span class="academic-resource-pop-title qr-popover-title">{displayTag}</span>
              <button type="button" class="academic-resource-pop-close qr-popover-close js-resource-close js-qr-close" aria-label="关闭">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
            <div class="academic-resource-pop-body qr-popover-body">
              <div class="academic-resource-qr-svg qr-svg-box" set:html={qrSvg} />
              <p class="academic-resource-tip qr-tip">手机扫码查阅</p>
            </div>
          </div>
        )}
      </span>
    )}
  </div>
</div>

<style>.academic-resource-lead {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .academic-resource-media-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text-accent);
    flex-shrink: 0;
  }
  .academic-resource-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    vertical-align: middle;
    flex-shrink: 0;
  }
  .academic-resource-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 !important;
    padding: 0;
    line-height: 1;
    flex-shrink: 0;
  }
</style>

<script>function setupCopyButtons() {
    document.querySelectorAll('.js-copy-resource-url:not([data-bound])').forEach((btn) => {
      btn.setAttribute('data-bound', 'true');
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const url = btn.getAttribute('data-url');
        if (!url) return;
        navigator.clipboard.writeText(url).then(() => {
          btn.classList.add('is-copied');
          setTimeout(() => {
            btn.classList.remove('is-copied');
          }, 1500);
        }).catch(() => {});
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCopyButtons);
  } else {
    setupCopyButtons();
  }
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
