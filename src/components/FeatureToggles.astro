---
// 站点与阅读设置面板（极简学术风格 · 面向读者与研究者）
// -----------------------------------------------------------------------------
// 挂载：ThemeSelectOverride.astro 在顶栏右侧动作区引入（桌面 header / 移动端抽屉
// 底部各渲染一个 <starlight-feature-toggles>，各自管理自己的开合与下拉面板）。
// -----------------------------------------------------------------------------
import { features } from '../config/features.config.mjs';
import { siteThemes } from '../config/themes.config.mjs';
import { CJK_PRESETS, LATIN_PRESETS } from '../scripts/font-presets';

const isDev = import.meta.env.DEV;

// 可在运行时被用户/读者切换的功能
const RUNTIME_IDS = new Set([
  'theme',
  'fonts',
  'crossRef',
  'formulaActions',
  'prewarm',
  'relationGraph',
  'mermaid',
  'epub',
  'aiAsk',
  'editor',
  'inspector',
]);

const featureMeta = Object.entries(features).map(([id, f]) => ({
  id,
  label: f.label,
  build: f.enabled,
  runtime: RUNTIME_IDS.has(id),
  devOnly: f.devOnly,
}));
const metaJson = JSON.stringify(featureMeta);
---

<starlight-feature-toggles data-meta={metaJson} aria-label="设置">
  <button
    type="button"
    class="ft-toggle-btn"
    title="设置"
    aria-label="打开设置面板"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <svg class="ft-gear-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
  </button>

  <!-- 全局遮罩 (移动端 BottomSheet 遮罩与点击关闭) -->
  <div class="ft-backdrop" aria-hidden="true"></div>

  <!-- 设置面板主体 (移动端向上滑出 Bottom Sheet，桌面端右上角悬浮面板) -->
  <div class="ft-panel" role="dialog" aria-label="设置面板" aria-hidden="true">
    <!-- 移动端顶部拖拽手柄条 -->
    <div class="ft-sheet-handle" aria-hidden="true"></div>

    <div class="ft-panel-head">
      <span class="ft-panel-title">设置</span>
      <button type="button" class="ft-close" title="关闭设置" aria-label="关闭">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="ft-panel-body">
      <!-- 分组一：字体 -->
      {
        features.fonts.enabled && (
          <div class="ft-section">
            <div class="ft-section-title">字体</div>
            <div class="ft-stack">
              <!-- 中文字体 -->
              <div class="ft-segment-wrapper">
                <div class="ft-sub-label">中文</div>
                <div class="ft-segment-track ft-grid-2">
                  {CJK_PRESETS.map((opt) => (
                    <button
                      type="button"
                      class="ft-font-btn"
                      data-font-setting="cjk"
                      data-font-val={opt.value}
                      title={opt.label}
                    >
                      <span class={`ft-font-preview ft-cjk-${opt.value}`}>{opt.label}</span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- 英文字体与公式字体 -->
              <div class="ft-segment-wrapper">
                <div class="ft-sub-label">英文与公式</div>
                <div class="ft-segment-track ft-grid-3">
                  {LATIN_PRESETS.map((opt) => (
                    <button
                      type="button"
                      class="ft-font-btn"
                      data-font-setting="latin"
                      data-font-val={opt.value}
                      title={opt.label}
                    >
                      <span class={`ft-font-preview ft-latin-${opt.value}`}>{opt.label}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )
      }

      <!-- 分组二：界面 -->
      {
        features.theme.enabled && (
          <div class="ft-section">
            <div class="ft-section-title">界面</div>
            <div class="ft-stack">
              {siteThemes && siteThemes.length > 1 && (
                <div class="ft-segment-wrapper">
                  <div class="ft-sub-label">主题</div>
                  <div class="ft-segment-track ft-grid-2">
                    {siteThemes.map((st) => (
                      <button
                        type="button"
                        class="ft-theme-chip"
                        data-site-theme-val={st.id}
                        title={st.desc}
                      >
                        <span>{st.label}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <!-- 主题平滑过渡动画 -->
              <div class="ft-item-row">
                <div class="ft-row-info">
                  <span class="ft-row-name">主题过渡</span>
                </div>
                <label class="ft-switch" title="切换平滑主题过渡">
                  <input type="checkbox" data-theme-transition />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            </div>
          </div>
        )
      }

      <!-- 分组三：功能 -->
      <div class="ft-section">
        <div class="ft-section-title">功能</div>
        <div class="ft-stack">
          <!-- 1. 定理联动 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">定理联动</span>
            </div>
            <label class="ft-switch" title="启用/禁用知识引用联动">
              <input type="checkbox" data-feature-id="crossRef" disabled={!features.crossRef.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- 2. 公式操作 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">公式操作</span>
            </div>
            <label class="ft-switch" title="启用/禁用公式操作">
              <input type="checkbox" data-feature-id="formulaActions" disabled={!features.formulaActions.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- 3. 章节预加载 -->
          <div class="ft-segment-wrapper">
            <div class="ft-sub-label">章节预加载</div>
            <div class="ft-segment-track ft-grid-5">
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="-1" title="全书预加载">全书</button>
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="1" title="前后各 1 页">前后1页</button>
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="2" title="前后各 2 页">前后2页</button>
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="3" title="前后各 3 页">前后3页</button>
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="0" title="关闭预加载">关闭</button>
            </div>
          </div>

          <!-- 4. 模块速查 -->
          {
            features.inspector.enabled && (
              <div class="ft-item-row">
                <div class="ft-row-info">
                  <div class="ft-row-title-line">
                    <span class="ft-row-name">模块速查</span>
                    <button type="button" class="ft-open-inspector-btn" data-inspector-trigger title="立即打开书籍模块速查 (Alt+M)">
                      Alt+M
                    </button>
                  </div>
                </div>
                <label class="ft-switch" title="启用/禁用模块速查">
                  <input type="checkbox" data-feature-id="inspector" />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            )
          }

          <!-- 5. 离线 EPUB -->
          {
            features.epub.enabled && (
              <div class="ft-item-row">
                <div class="ft-row-info">
                  <span class="ft-row-name">离线 EPUB</span>
                </div>
                <label class="ft-switch" title="启用/禁用 EPUB 离线下载">
                  <input type="checkbox" data-feature-id="epub" />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            )
          }
        </div>
      </div>

      <!-- 分组四：AI 服务与功能 -->
      <div class="ft-section">
        <div class="ft-section-title">AI</div>
        <div class="ft-stack">
          <!-- 1. 模型与服务 -->
          <div class="ft-ai-block">
            <div class="ft-sub-label">
              <span>模型与服务</span>
              <button type="button" class="ft-ai-custom-toggle-btn" data-action="toggle-custom-model" title="添加自定义 OpenAI 兼容模型">
                + 自定义
              </button>
            </div>

            <!-- 模型选择 -->
            <select class="ft-ai-select ft-ai-model-select"></select>

            <!-- 自定义模型表单 -->
            <div class="ft-ai-custom-form hidden">
              <div class="ft-ai-form-row">
                <input type="text" class="ft-ai-input ft-ai-custom-id" placeholder="模型 ID（如 my-qwen）" autocomplete="off" />
                <input type="text" class="ft-ai-input ft-ai-custom-label" placeholder="显示名称" autocomplete="off" />
              </div>
              <input type="text" class="ft-ai-input ft-ai-custom-ep" placeholder="OpenAI 兼容端点 URL" autocomplete="off" />
              <div class="ft-ai-custom-actions">
                <button type="button" class="ft-ai-btn ft-ai-btn-ghost" data-action="cancel-custom-model">取消</button>
                <button type="button" class="ft-ai-btn ft-ai-btn-primary" data-action="add-custom-model">保存模型</button>
              </div>
            </div>

            <!-- API Key -->
            <div class="ft-ai-field">
              <div class="ft-ai-field-head">
                <span class="ft-ai-mini-label">API Key</span>
                <span class="ft-ai-key-badge">未配置</span>
              </div>
              <div class="ft-ai-key-row">
                <input type="password" class="ft-ai-input ft-ai-key-input" placeholder="sk-..." autocomplete="off" />
                <button type="button" class="ft-ai-icon-btn ft-ai-key-reveal" data-action="toggle-key-reveal" title="显示/隐藏密钥">
                  <svg class="ft-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="ft-eye-closed hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <!-- API 端点 -->
            <div class="ft-ai-field">
              <span class="ft-ai-mini-label">API 端点</span>
              <input type="text" class="ft-ai-input ft-ai-endpoint-input" placeholder="https://api.deepseek.com/v1/chat/completions" autocomplete="off" />
            </div>

            <!-- 测试连接行 -->
            <div class="ft-ai-test-row">
              <button type="button" class="ft-ai-test-btn" data-action="test-ai-connection" title="测试当前 API Key 与端点连通性">
                测试连接
              </button>
              <span class="ft-ai-test-status" aria-live="polite"></span>
            </div>
          </div>

          <!-- 2. AI 功能开关 -->
          <div class="ft-sub-label" style="margin-top: 4px;">AI 功能</div>
          <!-- 书内问答 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">书内问答</span>
            </div>
            <label class="ft-switch" title="启用/禁用 AI 智能问答">
              <input type="checkbox" data-feature-id="aiAsk" disabled={!features.aiAsk.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- 章节关系图谱 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">章节关系图谱</span>
            </div>
            <label class="ft-switch" title="启用/禁用章节关系图谱">
              <input type="checkbox" data-feature-id="relationGraph" disabled={!features.relationGraph.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- Mermaid 图表 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">Mermaid 图表</span>
            </div>
            <label class="ft-switch" title="启用/禁用 Mermaid 图表">
              <input type="checkbox" data-feature-id="mermaid" disabled={!features.mermaid.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>
        </div>
      </div>

      <!-- 分组五：开发者选项（仅 dev 模式展示） -->
      {
        isDev && (
          <div class="ft-section ft-section-dev">
            <div class="ft-section-title">开发者选项</div>
            <div class="ft-stack">
              <div class="ft-item-row">
                <div class="ft-row-info">
                  <div class="ft-row-title-line">
                    <span class="ft-row-name">MDX 在线精修</span>
                    <span class="ft-badge ft-badge-dev">DEV</span>
                  </div>
                </div>
                <label class="ft-switch" title="启用/禁用在线精修">
                  <input type="checkbox" data-feature-id="editor" />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            </div>
          </div>
        )
      }
    </div>

    <!-- 底部状态与重置 -->
    <div class="ft-panel-footer">
      <span class="ft-footer-hint">设置保存在此浏览器</span>
      <button type="button" class="ft-reset-btn" data-action="reset-defaults" title="恢复所有选项至默认配置">
        恢复默认
      </button>
    </div>
  </div>
</starlight-feature-toggles>

<style is:global>
  /* ===== AstroLib 设置面板（极简学术风格 · 精确与减法） ===== */

  /* 页面中由功能开关控制的 [data-feature] 元素在关闭时隐藏 */
  .dsh-feature-off {
    display: none !important;
  }

  /* 引用联动关闭时：禁用徽章交互，恢复中性展示 */
  .dsh-crossref-off .interactive-badge {
    pointer-events: none !important;
    cursor: default !important;
    text-decoration: none !important;
    opacity: 0.88;
  }

  /* 移动端全屏防滚动穿透 */
  html.ft-scroll-lock {
    overflow: hidden !important;
  }

  /* 宿主控件 */
  starlight-feature-toggles {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: var(--sl-font, system-ui, -apple-system, sans-serif);
  }

  starlight-feature-toggles * {
    box-sizing: border-box;
  }

  /* 顶栏与抽屉触发按钮（VitePress 36px/40px 极简图标按钮） */
  starlight-feature-toggles .ft-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  starlight-feature-toggles .ft-toggle-btn:hover,
  starlight-feature-toggles .ft-toggle-btn:focus-visible {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }

  starlight-feature-toggles .ft-toggle-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  starlight-feature-toggles .ft-gear-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* ==========================================================================
     移动端 Bottom Sheet 模式 (< 800px) —— 独立全屏/底栏 Fragment 体验
     ========================================================================== */
  @media (max-width: 49.999rem) {
    .ft-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.48);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
      z-index: 2147483646;
      opacity: 0;
      display: none;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .ft-backdrop.ft-is-open,
    starlight-feature-toggles.ft-is-open .ft-backdrop {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }

    .ft-panel {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      width: 100vw;
      max-width: 100vw;
      max-height: 86vh;
      max-height: 86dvh;
      border-radius: 16px 16px 0 0;
      background-color: var(--sl-color-bg);
      color: var(--sl-color-white);
      border-top: 1px solid var(--sl-color-hairline);
      border-left: none;
      border-right: none;
      border-bottom: none;
      box-shadow: 0 -12px 36px rgba(0, 0, 0, 0.35);
      z-index: 2147483647;
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      visibility: hidden;
      pointer-events: none;
    }

    .ft-panel.ft-is-open,
    starlight-feature-toggles.ft-is-open .ft-panel {
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .ft-sheet-handle {
      display: block;
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background-color: var(--sl-color-gray-5);
      margin: 8px auto 0;
      flex-shrink: 0;
      cursor: grab;
      touch-action: none;
      user-select: none;
    }

    .ft-panel-head {
      cursor: grab;
      touch-action: none;
      user-select: none;
    }

    .ft-panel.ft-is-dragging {
      cursor: grabbing;
      user-select: none;
    }
  }

  /* ==========================================================================
     桌面端 Popover 浮层模式 (>= 800px)
     ========================================================================== */
  @media (min-width: 50rem) {
    .ft-backdrop,
    .ft-sheet-handle {
      display: none !important;
    }

    .ft-panel {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      width: 368px;
      max-height: min(84vh, 620px);
      display: none;
      flex-direction: column;
      background-color: var(--sl-color-bg, #ffffff) !important;
      color: var(--sl-color-white);
      border: 1px solid var(--sl-color-hairline);
      border-radius: 12px;
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.18), 0 3px 10px rgba(0, 0, 0, 0.08);
      z-index: 2147483001 !important;
      overflow: hidden;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      animation: ftFadeIn 0.16s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes ftFadeIn {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .ft-panel.ft-is-open,
    starlight-feature-toggles.ft-is-open .ft-panel {
      display: flex;
    }
  }

  /* 面板头部 */
  .ft-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 9px;
    border-bottom: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg, #ffffff) !important;
    flex-shrink: 0;
  }

  .ft-panel-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--sl-color-white);
    letter-spacing: -0.01em;
  }

  .ft-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--sl-color-gray-3);
    border-radius: 4px;
    padding: 0;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .ft-close svg {
    width: 14px;
    height: 14px;
  }

  .ft-close:hover,
  .ft-close:focus-visible {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }

  .ft-close:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  /* 面板主体内容区 */
  .ft-panel-body {
    padding: 12px 14px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    min-height: 0;
    background-color: var(--sl-color-bg, #ffffff) !important;
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-gray-5) transparent;
  }

  @media (max-width: 49.999rem) {
