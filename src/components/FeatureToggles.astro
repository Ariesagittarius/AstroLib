<script>let initialized = false;
  function runInit() {
    if (initialized) return;
    initialized = true;
    Promise.all([
      import('../scripts/feature-toggles'),
      import('../themes/material-you/index'),
    ]).then(([{ initFeatureToggles }]) => {
      try {
        initFeatureToggles();
      } catch (e) {
        console.error('[feature-toggles] 初始化失败：', e);
      }
    }).catch((err) => {
      console.error('[feature-toggles] 模块加载失败：', err);
    });
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => runInit(), { timeout: 800 });
  } else {
    setTimeout(runInit, 300);
  }

  const setupTriggers = () => {
    document.querySelectorAll('.ft-toggle-btn').forEach((btn) => {
      btn.addEventListener('pointerenter', runInit, { passive: true, once: true });
      btn.addEventListener('click', runInit, { passive: true, once: true });
    });
  };

  setupTriggers();
  document.addEventListener('astro:page-load', setupTriggers);
</script>
