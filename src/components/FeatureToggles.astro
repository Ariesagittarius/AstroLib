---
// 站点与阅读设置面板（极简学术风格 · 面向读者与研究者）
// -----------------------------------------------------------------------------
// 挂载：ThemeSelectOverride.astro 在顶栏右侧动作区引入（桌面 header / 移动端抽屉
// 底部各渲染一个 <starlight-feature-toggles>，各自管理自己的开合与下拉面板）。
// -----------------------------------------------------------------------------
import { features } from '../config/features.config.mjs';
import { siteThemes } from '../config/themes.config.mjs';
import { CJK_PRESETS, LATIN_PRESETS } from '../scripts/font-presets';
import { THEME_COLOR_PRESETS } from '../themes/material-you/color-engine';

const isDev = import.meta.env.DEV;

// 可在运行时被用户/读者切换的功能
const RUNTIME_IDS = new Set([
  'theme',
  'fonts',
  'crossRef',
  'formulaActions',
  'prewarm',
  'relationGraph',
  'mermaid',
  'epub',
  'aiAsk',
  'editor',
  'inspector',
]);

const featureMeta = Object.entries(features).map(([id, f]) => ({
  id,
  label: f.label,
  build: f.enabled,
  runtime: RUNTIME_IDS.has(id),
  devOnly: f.devOnly,
}));
const metaJson = JSON.stringify(featureMeta);
---

<starlight-feature-toggles data-meta={metaJson} aria-label="设置">
  <button
    type="button"
    class="ft-toggle-btn"
    title="设置"
    aria-label="打开设置面板"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <!-- Google Material Symbols 官方 Outlined 空心齿轮 (settings) -->
    <svg class="ft-gear-icon header-mdicon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zm-1.98-1.71c.04.31.05.52.05.73 0 .21-.02.43-.05.73l-.14 1.13.89.7 1.08.84-.7 1.21-1.27-.51-1.04-.42-.9.68c-.43.32-.84.56-1.3.73l-1.06.42-.16 1.13-.2 1.35h-1.4l-.19-1.35-.16-1.13-1.06-.42c-.46-.18-.88-.42-1.31-.74l-.9-.67-1.04.42-1.28.51-.7-1.21 1.08-.84.89-.7-.14-1.13c-.04-.31-.05-.52-.05-.73 0-.21.02-.43.05-.73l.14-1.13-.89-.7-1.08-.84.7-1.21 1.27.51 1.04.42.9-.68c.43-.32.84-.56 1.3-.73l1.06-.42.16-1.13.2-1.35h1.39l.19 1.35.16 1.13 1.06.42c.46.18.87.42 1.31.74l.9.67 1.04-.42 1.28-.51.7 1.21-1.08.84-.89.7.14 1.13zM12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 6c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
    </svg>
  </button>

  <!-- 全局遮罩 (移动端 BottomSheet 遮罩与点击关闭) -->
  <div class="ft-backdrop" aria-hidden="true"></div>

  <!-- 设置面板主体 (移动端向上滑出 Bottom Sheet，桌面端右上角悬浮面板) -->
  <div class="ft-panel" role="region" aria-label="设置面板" aria-hidden="true">
    <!-- 移动端顶部拖拽手柄条 -->
    <div class="ft-sheet-handle" aria-hidden="true"></div>

    <div class="ft-panel-head">
      <span class="ft-panel-title">快速设置</span>
      <button type="button" class="ft-close" title="关闭设置" aria-label="关闭">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Gmail 风格顶部全宽药丸操作按钮（恢复默认配置） -->
    <div class="ft-m3-header-action">
      <button type="button" class="ft-m3-see-all-btn" data-action="reset-defaults" title="恢复所有选项至默认配置">
        恢复默认设置
      </button>
    </div>

    <div class="ft-panel-body">
      <!-- 分组一：字体 -->
      {
        features.fonts.enabled && (
          <div class="ft-section">
            <div class="ft-section-title">字体</div>
            <div class="ft-stack">
              <!-- 中文字体 (Material You Official md-filter-chip) -->
              <div class="ft-segment-wrapper">
                <div class="ft-sub-label">中文</div>
                <md-chip-set class="ft-font-chip-set ft-font-chip-set-cjk">
                  {CJK_PRESETS.map((opt) => (
                    <md-filter-chip
                      class={`ft-font-chip ft-cjk-${opt.value}`}
                      label={opt.label}
                      data-font-setting="cjk"
                      data-font-val={opt.value}
                      title={opt.label}
                    ></md-filter-chip>
                  ))}
                </md-chip-set>
              </div>

              <!-- 英文字体与公式字体 (Material You Official md-filter-chip) -->
              <div class="ft-segment-wrapper">
                <div class="ft-sub-label">英文与公式</div>
                <md-chip-set class="ft-font-chip-set ft-font-chip-set-latin">
                  {LATIN_PRESETS.map((opt) => (
                    <md-filter-chip
                      class={`ft-font-chip ft-latin-${opt.value}`}
                      label={opt.label}
                      data-font-setting="latin"
                      data-font-val={opt.value}
                      title={opt.label}
                    ></md-filter-chip>
                  ))}
                </md-chip-set>
              </div>
            </div>
          </div>
        )
      }

      <!-- 分组：排版 -->
      <div class="ft-section">
        <div class="ft-section-title">排版</div>
        <div class="ft-stack">
          <!-- 1. 段前空两格 (首行缩进 2em) -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">段前空两格</span>
            </div>
            <label class="ft-switch" title="开启/关闭段落首行缩进两格">
              <input type="checkbox" data-typography-indent checked />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- 2. 数理标点风格 -->
          <div class="ft-segment-wrapper">
            <div class="ft-sub-label">标点风格</div>
            <md-chip-set class="ft-font-chip-set ft-punct-chip-set">
              <md-filter-chip
                class="ft-font-chip ft-punct-chip"
                label="数理圆点 (．)"
                data-punct-val="dot"
                title="大学数理专著标准实心圆点"
              ></md-filter-chip>
              <md-filter-chip
                class="ft-font-chip ft-punct-chip"
                label="中文句号 (。)"
                data-punct-val="circle"
                title="标准中文空心句号"
              ></md-filter-chip>
            </md-chip-set>
          </div>

          <!-- 3. 调整正文字号 (Material 3 md-slider) -->
          <div class="ft-segment-wrapper">
            <div class="ft-slider-header">
              <div class="ft-sub-label">调整正文字号</div>
              <md-assist-chip
                class="ft-slider-val-chip"
                data-font-size-val
                label="1 rem"
                aria-label="当前正文字号"
              ></md-assist-chip>
            </div>
            <div class="ft-slider-row">
              <span class="ft-slider-mark min" title="标准小字阶 (0.875 rem / 14px)">A-</span>
              <md-slider
                class="ft-font-size-slider"
                min="14"
                max="22"
                step="1"
                value="16"
                labeled
                ticks
                data-font-size-slider
                aria-label="调整正文字号"
              ></md-slider>
              <span class="ft-slider-mark max" title="醒目大字阶 (1.375 rem / 22px)">A+</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 分组二：界面与主题 -->
      {
        features.theme.enabled && (
          <div class="ft-section">
            <div class="ft-section-title">界面与主题</div>
            <div class="ft-stack">
              {siteThemes && siteThemes.length > 1 && (
                <div class="ft-segment-wrapper">
                  <div class="ft-sub-label">UI 风格预设</div>
                  <div class="ft-gmail-theme-list">
                    {siteThemes.map((st) => (
                      <button
                        type="button"
                        class={`ft-theme-chip ft-gmail-theme-row${st.disabled ? ' is-disabled' : ''}`}
                        data-site-theme-val={st.id}
                        title={st.disabled ? `${st.label}（已封存，暂不可选）` : st.desc}
                        disabled={st.disabled ? true : undefined}
                        aria-disabled={st.disabled ? 'true' : undefined}
                      >
                        <div class="ft-btn-label-group">
                          <span class={`ft-m3-radio-indicator${st.disabled ? ' is-disabled' : ''}`} aria-hidden="true"></span>
                          <span class="ft-theme-row-label">{st.label}{st.disabled ? '（已封存）' : ''}</span>
                        </div>
                        <div class={`ft-wireframe-card ft-wf-theme-${st.id}`} aria-hidden="true">
                          {st.id === 'vitepress' && (
                            <div class="ft-wf-inner ft-wf-vp">
                              <div class="ft-wf-topbar">
                                <span class="ft-wf-vp-brand"></span>
                                <span class="ft-wf-vp-nav"></span>
                              </div>
                              <div class="ft-wf-body">
                                <div class="ft-wf-vp-sidebar"></div>
                                <div class="ft-wf-vp-content">
                                  <div class="ft-wf-vp-line ft-wf-accent"></div>
                                  <div class="ft-wf-vp-line"></div>
                                </div>
                              </div>
                            </div>
                          )}
                          {st.id === 'starlight' && (
                            <div class="ft-wf-inner ft-wf-sl">
                              <div class="ft-wf-topbar">
                                <span class="ft-wf-sl-star"></span>
                                <span class="ft-wf-sl-search"></span>
                              </div>
                              <div class="ft-wf-body">
                                <div class="ft-wf-sl-sidebar">
                                  <div class="ft-wf-sl-tree"></div>
                                  <div class="ft-wf-sl-tree"></div>
                                </div>
                                <div class="ft-wf-sl-content">
                                  <div class="ft-wf-sl-line ft-wf-accent"></div>
                                  <div class="ft-wf-sl-line"></div>
                                </div>
                              </div>
                            </div>
                          )}
                          {st.id === 'material-you' && (
                            <div class="ft-wf-inner ft-wf-m3">
                              <div class="ft-wf-topbar">
                                <span class="ft-wf-m3-capsule"></span>
                              </div>
                              <div class="ft-wf-body">
                                <div class="ft-wf-m3-rail">
                                  <span class="ft-wf-m3-pill"></span>
                                  <span class="ft-wf-m3-dot"></span>
                                </div>
                                <div class="ft-wf-m3-content">
                                  <div class="ft-wf-m3-card"></div>
                                </div>
                              </div>
                            </div>
                          )}
                        </div>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <!-- Material You 动态主题色 (Google Chrome 4×4 色板矩阵与自定义取色) -->
              <!-- Material You 动态主题色 (Google Chrome 外观分段模式与 4×4 色板矩阵) -->
              <div class="ft-m3-color-section">
                <!-- Chrome 风格外观模式分段控制 (浅色 / 深色 / 设备) -->
                <div class="ft-theme-mode-segmented" role="radiogroup" aria-label="外观模式">
                  <button
                    type="button"
                    class="ft-mode-btn"
                    data-mode-val="light"
                    role="radio"
                    aria-checked="false"
                    title="浅色模式"
                  >
                    <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                      <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                    </svg>
                    <svg class="ft-mode-check-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>浅色</span>
                  </button>
                  <button
                    type="button"
                    class="ft-mode-btn"
                    data-mode-val="dark"
                    role="radio"
                    aria-checked="false"
                    title="深色模式"
                  >
                    <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                      <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" />
                    </svg>
                    <svg class="ft-mode-check-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>深色</span>
                  </button>
                  <button
                    type="button"
                    class="ft-mode-btn"
                    data-mode-val="auto"
                    role="radio"
                    aria-checked="false"
                    title="遵循设备外观"
                  >
                    <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                      <path d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/>
                    </svg>
                    <svg class="ft-mode-check-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>设备</span>
                  </button>
                </div>

                <div class="ft-chrome-swatches-grid">
                  {THEME_COLOR_PRESETS.map((preset) => (
                    <button
                      type="button"
                      class="ft-color-swatch ft-preset-swatch ft-chrome-color-tile"
                      data-m3-color={preset.id}
                      title={preset.label}
                      aria-label={preset.label}
                    >
                      <svg class="ft-color-wheel-svg" viewBox="0 0 36 36" width="42" height="42">
                        <path d="M 0 18 A 18 18 0 0 1 36 18 Z" fill={preset.top} />
                        <path d="M 0 18 A 18 18 0 0 0 18 36 L 18 18 Z" fill={preset.left} />
                        <path d="M 18 18 L 18 36 A 18 18 0 0 0 36 18 Z" fill={preset.right} />
                      </svg>
                      <span class="ft-tile-check-badge" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </span>
                      <md-ripple></md-ripple>
                    </button>
                  ))}

                  <!-- 第 16 项：自定义取色器 (Chrome Eyedropper) -->
                  <div
                    class="ft-chrome-color-tile ft-custom-color-tile"
                    data-action="open-custom-color"
                    role="button"
                    tabindex="0"
                    title="自定义 HEX 主题色"
                    aria-label="自定义主题色"
                  >
                    <input type="color" class="ft-color-native-input" data-action="custom-color-picker" value="#0b57d0" aria-label="自定义主题色" />
                    <div class="ft-eyedropper-circle">
                      <svg class="ft-eyedropper-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                        <path d="M20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-3.12 3.12-1.93-1.91-1.41 1.41 1.42 1.42L3 16.25V21h4.75l8.92-8.92 1.42 1.42 1.41-1.41-1.92-1.92 3.12-3.12c.4-.4.4-1.03.01-1.42zM6.92 19L5 17.08l8.06-8.06 1.92 1.92L6.92 19z"/>
                      </svg>
                    </div>
                    <span class="ft-tile-check-badge" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    <md-ripple></md-ripple>
                  </div>
                </div>
              </div>

              <!-- 主题平滑过渡动画 -->
              <div class="ft-item-row">
                <div class="ft-row-info">
                  <span class="ft-row-name">主题过渡</span>
                </div>
                <label class="ft-switch" title="切换平滑主题过渡">
                  <input type="checkbox" data-theme-transition />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            </div>
          </div>
        )
      }

      <!-- 分组三：功能 -->
      <div class="ft-section">
        <div class="ft-section-title">功能</div>
        <div class="ft-stack">
          <!-- 1. 定理联动 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">定理联动</span>
            </div>
            <label class="ft-switch" title="启用/禁用知识引用联动">
              <input type="checkbox" data-feature-id="crossRef" disabled={!features.crossRef.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- 2. 公式操作 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">公式操作</span>
            </div>
            <label class="ft-switch" title="启用/禁用公式操作">
              <input type="checkbox" data-feature-id="formulaActions" disabled={!features.formulaActions.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- 3. 章节预加载 (M3 Outlined Segmented Button) -->
          <div class="ft-segment-wrapper ft-prewarm-wrapper">
            <div class="ft-sub-label">章节预加载</div>
            <div class="ft-segment-track ft-grid-5 ft-prewarm-track">
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="-1" title="全书预加载">全书</button>
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="1" title="前后各 1 页">前后1页</button>
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="2" title="前后各 2 页">前后2页</button>
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="3" title="前后各 3 页">前后3页</button>
              <button type="button" class="ft-prewarm-btn" data-prewarm-val="0" title="关闭预加载">关闭</button>
            </div>
          </div>

          <!-- 4. 模块速查 -->
          {
            features.inspector.enabled && (
              <div class="ft-item-row">
                <div class="ft-row-info">
                  <div class="ft-row-title-line">
                    <span class="ft-row-name">模块速查</span>
                    <button type="button" class="ft-open-inspector-btn" data-inspector-trigger title="立即打开书籍模块速查 (Alt+M)">
                      Alt+M
                    </button>
                  </div>
                </div>
                <label class="ft-switch" title="启用/禁用模块速查">
                  <input type="checkbox" data-feature-id="inspector" />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            )
          }

          <!-- 5. 离线 EPUB -->
          {
            features.epub.enabled && (
              <div class="ft-item-row">
                <div class="ft-row-info">
                  <span class="ft-row-name">离线 EPUB</span>
                </div>
                <label class="ft-switch" title="启用/禁用 EPUB 离线下载">
                  <input type="checkbox" data-feature-id="epub" />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            )
          }
        </div>
      </div>

      <!-- 分组四：AI 服务与功能 -->
      <div class="ft-section">
        <div class="ft-section-title">AI</div>
        <div class="ft-stack">
          <!-- 1. 模型与提供商服务 -->
          <div class="ft-ai-block">
            <div class="ft-sub-label">
              <span>模型提供商</span>
              <button type="button" class="ft-ai-custom-toggle-btn" data-action="toggle-custom-model" title="添加/管理自定义 OpenAI 兼容模型">
                + 自定义模型
              </button>
            </div>

            <!-- 提供商选择 (M3 Filter Chips) -->
            <md-chip-set class="ft-font-chip-set ft-ai-provider-chip-set" aria-label="选择 AI 提供商">
              <md-filter-chip class="ft-font-chip" label="Google Gemini" data-provider-id="gemini" selected></md-filter-chip>
              <md-filter-chip class="ft-font-chip" label="DeepSeek" data-provider-id="deepseek"></md-filter-chip>
              <md-filter-chip class="ft-font-chip" label="自定义" data-provider-id="custom"></md-filter-chip>
            </md-chip-set>

            <!-- 自定义模型表单 (点击 + 自定义模型 时展开) -->
            <div class="ft-ai-custom-form hidden">
              <div class="ft-ai-form-row">
                <md-outlined-text-field class="ft-ai-input ft-ai-custom-id" label="模型 ID" placeholder="如 gpt-4o 或 qwen-max" autocomplete="off"></md-outlined-text-field>
                <md-outlined-text-field class="ft-ai-input ft-ai-custom-label" label="显示名称" placeholder="显示名称" autocomplete="off"></md-outlined-text-field>
              </div>
              <md-outlined-text-field class="ft-ai-input ft-ai-custom-ep" label="端点 URL" placeholder="https://api.openai.com/v1/chat/completions" autocomplete="off"></md-outlined-text-field>
              <div class="ft-ai-custom-actions">
                <button type="button" class="ft-ai-btn ft-ai-btn-ghost" data-action="cancel-custom-model">取消</button>
                <button type="button" class="ft-ai-btn ft-ai-btn-primary" data-action="add-custom-model">保存模型</button>
              </div>
            </div>

            <!-- API Key 与状态配置 -->
            <div class="ft-ai-field">
              <div class="ft-ai-field-head">
                <!-- 连接测试状态 Chip (与已配置同行) -->
                <div class="ft-ai-test-status ft-ai-test-chip ft-m3-status-chip hidden" aria-live="polite" title="连接测试状态">
                  <svg class="ft-chip-icon ft-test-chip-icon-ok" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                  <svg class="ft-chip-icon ft-test-chip-icon-err hidden" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                  </svg>
                  <svg class="ft-chip-icon ft-test-chip-spinner hidden" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="9" stroke-opacity="0.25"></circle>
                    <path d="M12 3a9 9 0 0 1 9 9" stroke-linecap="round"></path>
                  </svg>
                  <span class="ft-test-chip-text"></span>
                </div>

                <!-- API Key 配置状态 Chip -->
                <div class="ft-ai-key-badge ft-ai-key-chip ft-m3-status-chip" title="API Key 配置状态">
                  <svg class="ft-chip-icon" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                  </svg>
                  <span class="ft-chip-label">未配置</span>
                </div>
              </div>
              <div class="ft-ai-key-row">
                <md-outlined-text-field
                  class="ft-ai-input ft-ai-key-input"
                  label="API Key"
                  type="password"
                  placeholder="填写 API Key"
                  autocomplete="off"
                >
                  <md-icon-button
                    toggle
                    slot="trailing-icon"
                    type="button"
                    class="ft-ai-icon-btn ft-ai-key-reveal"
                    data-action="toggle-key-reveal"
                    touch-target="none"
                    aria-label="显示密钥"
                    aria-label-selected="隐藏密钥"
                    title="显示/隐藏密钥"
                  >
                    <md-icon class="ft-eye-open">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                      </svg>
                    </md-icon>
                    <md-icon slot="selected" class="ft-eye-closed">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                        <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>
                      </svg>
                    </md-icon>
                  </md-icon-button>
                </md-outlined-text-field>
              </div>
            </div>

            <!-- 模型选择 (随提供商联动) -->
            <div class="ft-ai-field ft-ai-model-field" style="margin-top: 6px;">
              <div class="ft-sub-label" style="margin-bottom: 4px;">
                <span>选择模型</span>
                <span class="ft-ai-provider-badge">Google Gemini</span>
              </div>
              <select class="ft-ai-select ft-ai-model-select"></select>
            </div>

            <!-- API 端点与测试连接操作 -->
            <div class="ft-ai-field">
              <div class="ft-ai-endpoint-row">
                <md-outlined-text-field
                  class="ft-ai-input ft-ai-endpoint-input"
                  label="API 端点"
                  type="text"
                  placeholder="https://generativelanguage.googleapis.com/..."
                  autocomplete="off"
                >
                  <md-icon-button
                    slot="trailing-icon"
                    type="button"
                    class="ft-ai-test-icon-btn"
                    data-action="test-ai-connection"
                    touch-target="none"
                    aria-label="测试连接"
                    title="测试连接"
                  >
                    <md-icon class="ft-test-bolt-icon">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                        <path d="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78L13.5 3h1l-1 7h3.5c.66 0 .44.62.33.82L11.5 21z"/>
                      </svg>
                    </md-icon>
                    <md-icon class="ft-test-spinner hidden">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="9" stroke-opacity="0.25"></circle>
                        <path d="M12 3a9 9 0 0 1 9 9" stroke-linecap="round"></path>
                      </svg>
                    </md-icon>
                  </md-icon-button>
                </md-outlined-text-field>
              </div>
            </div>
          </div>

          <!-- 2. AI 功能开关 -->
          <div class="ft-sub-label" style="margin-top: 4px;">AI 功能</div>
          <!-- 书内问答 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">书内问答</span>
            </div>
            <label class="ft-switch" title="启用/禁用 AI 智能问答">
              <input type="checkbox" data-feature-id="aiAsk" disabled={!features.aiAsk.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- 书内问答专属高级设置 (默认折叠，点击展开) -->
          <details class="ft-ai-advanced-group" data-ai-advanced-details>
            <summary class="ft-ai-advanced-summary">
              <div class="ft-ai-advanced-title-wrap">
                <svg class="ft-ai-advanced-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                  <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 21l3.68-.99C9.48 20.63 10.71 21 12 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm0 16c-1.14 0-2.22-.29-3.17-.81l-.23-.13-2.33.63.63-2.27-.14-.24C6.27 15.22 6 13.65 6 12c0-3.31 2.69-6 6-6s6 2.69 6 6-2.69 6-6 6z"/>
                </svg>
                <span>问答与检索高级偏好</span>
              </div>
              <svg class="ft-ai-advanced-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="ft-ai-advanced-content">
              <!-- 回答方式 -->
              <div class="ft-segment-wrapper">
                <div class="ft-sub-label">回答方式</div>
                <md-chip-set class="ft-font-chip-set ft-ai-mode-chip-set">
                  <md-filter-chip class="ft-font-chip" label="检索本书 (默认)" data-ai-mode-val="retrieve" selected></md-filter-chip>
                  <md-filter-chip class="ft-font-chip" label="深度讨论" data-ai-mode-val="discussion"></md-filter-chip>
                </md-chip-set>
                <div class="ft-settings-hint-text">「检索本书」优先结合教材片段溯源；「深度讨论」注重深入推导与全面讲解，需要时按需查书。</div>
              </div>

              <!-- 来源卡片跳转方式 -->
              <div class="ft-segment-wrapper">
                <div class="ft-sub-label">来源卡片跳转</div>
                <md-chip-set class="ft-font-chip-set ft-ai-src-chip-set">
                  <md-filter-chip class="ft-font-chip" label="新窗口打开" data-ai-src-val="new" selected></md-filter-chip>
                  <md-filter-chip class="ft-font-chip" label="本页平滑跳转" data-ai-src-val="same"></md-filter-chip>
                </md-chip-set>
              </div>

              <!-- 检索片段 Top K -->
              <div class="ft-segment-wrapper">
                <div class="ft-slider-header">
                  <div class="ft-sub-label">检索片段 Top K</div>
                  <md-assist-chip class="ft-slider-val-chip ft-ai-topk-val-chip" label="8 条"></md-assist-chip>
                </div>
                <div class="ft-slider-row">
                  <span class="ft-slider-mark min">1</span>
                  <md-slider class="ft-ai-topk-slider" min="1" max="20" step="1" value="8" labeled ticks aria-label="检索片段数"></md-slider>
                  <span class="ft-slider-mark max">20</span>
                </div>
              </div>

              <!-- 上下文上限与单次 Max Token -->
              <div class="ft-ai-form-row">
                <md-outlined-text-field class="ft-ai-input ft-ai-maxctx-input" type="number" label="上下文上限 (字符)" min="-1" step="500" value="6000"></md-outlined-text-field>
                <md-outlined-text-field class="ft-ai-input ft-ai-maxtok-input" type="number" label="单次最大 Token" min="-1" step="64" value="4096"></md-outlined-text-field>
              </div>

              <!-- 窗口预设宽度 -->
              <div class="ft-segment-wrapper">
                <div class="ft-sub-label">问答窗口预设宽度</div>
                <md-chip-set class="ft-font-chip-set ft-ai-win-chip-set">
                  <md-filter-chip class="ft-font-chip" label="紧凑 (460px)" data-ai-win-val="compact"></md-filter-chip>
                  <md-filter-chip class="ft-font-chip" label="标准 (560px)" data-ai-win-val="standard" selected></md-filter-chip>
                  <md-filter-chip class="ft-font-chip" label="宽屏 (720px)" data-ai-win-val="wide"></md-filter-chip>
                  <md-filter-chip class="ft-font-chip ft-ai-win-custom-chip" label="自定义" data-ai-win-val="custom"></md-filter-chip>
                </md-chip-set>
              </div>

              <!-- 自动折叠前序思考与调用 -->
              <div class="ft-item-row ft-ai-collapse-row" style="padding: 0.4rem 0 0.2rem; border-top: 1px dashed var(--sl-color-hairline, rgba(125,125,125,0.2)); margin-top: 0.5rem;">
                <div class="ft-row-info">
                  <span class="ft-row-name" style="font-size: 0.88rem;">折叠前序过程</span>
                  <span class="ft-row-desc" style="font-size: 0.76rem; color: var(--sl-color-text-secondary, #666);">除最新回复外，自动收起前面的思考与工具调用</span>
                </div>
                <label class="ft-switch" title="开启后除最新回复外自动收起前序思考与工具调用">
                  <input type="checkbox" class="ft-ai-collapse-preceding-toggle" checked />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            </div>
          </details>

          <!-- 章节关系图谱 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">章节关系图谱</span>
            </div>
            <label class="ft-switch" title="启用/禁用章节关系图谱">
              <input type="checkbox" data-feature-id="relationGraph" disabled={!features.relationGraph.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>

          <!-- Mermaid 图表 -->
          <div class="ft-item-row">
            <div class="ft-row-info">
              <span class="ft-row-name">Mermaid 图表</span>
            </div>
            <label class="ft-switch" title="启用/禁用 Mermaid 图表">
              <input type="checkbox" data-feature-id="mermaid" disabled={!features.mermaid.enabled} />
              <span class="ft-switch-slider"></span>
            </label>
          </div>
        </div>
      </div>

      <!-- 分组五：开发者选项（仅 dev 模式展示） -->
      {
        isDev && (
          <div class="ft-section ft-section-dev">
            <div class="ft-section-title">开发者选项</div>
            <div class="ft-stack">
              <div class="ft-item-row">
                <div class="ft-row-info">
                  <div class="ft-row-title-line">
                    <span class="ft-row-name">MDX 在线精修</span>
                    <span class="ft-badge ft-badge-dev ft-m3-dev-chip">DEV</span>
                  </div>
                </div>
                <label class="ft-switch" title="启用/禁用在线精修">
                  <input type="checkbox" data-feature-id="editor" />
                  <span class="ft-switch-slider"></span>
                </label>
              </div>
            </div>
          </div>
        )
      }
    </div>

    <!-- 底部状态提示 -->
    <div class="ft-panel-footer">
      <span class="ft-footer-hint">设置保存在此浏览器</span>
    </div>
  </div>
</starlight-feature-toggles>

<style is:global>
  /* ===== AstroLib 设置面板（极简学术风格 · 精确与减法） ===== */

  /* 页面中由功能开关控制的 [data-feature] 元素在关闭时隐藏 */
  .dsh-feature-off {
    display: none !important;
  }

  /* 引用联动关闭时：禁用徽章交互，恢复中性展示 */
  .dsh-crossref-off .interactive-badge {
    pointer-events: none !important;
    cursor: default !important;
    text-decoration: none !important;
    opacity: 0.88;
  }

  /* 移动端全屏防滚动穿透 */
  html.ft-scroll-lock {
    overflow: hidden !important;
  }

  /* 宿主控件 */
  starlight-feature-toggles {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: var(--sl-font, system-ui, -apple-system, sans-serif);
  }

  starlight-feature-toggles * {
    box-sizing: border-box;
  }

  /* 顶栏与抽屉触发按钮（Android Studio 34px 极简图标按钮） */
  starlight-feature-toggles .ft-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  starlight-feature-toggles .ft-toggle-btn:hover,
  starlight-feature-toggles .ft-toggle-btn:focus-visible {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.1));
  }

  starlight-feature-toggles.ft-is-open .ft-toggle-btn {
    background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.15));
    color: var(--sl-color-text-accent);
  }

  starlight-feature-toggles .ft-toggle-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  starlight-feature-toggles .ft-gear-icon {
    width: 20px;
    height: 20px;
    display: block;
    margin: 0 auto;
  }

  /* ==========================================================================
     移动端 Bottom Sheet 模式 (< 800px) —— 独立全屏/底栏 Fragment 体验
     ========================================================================== */
  @media (max-width: 49.999rem) {
    .ft-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.48);
      z-index: calc(var(--layer-drawer) - 1);
      opacity: 0;
      display: none;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .ft-backdrop.ft-is-open,
    starlight-feature-toggles.ft-is-open .ft-backdrop {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }

    .ft-panel {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      width: 100vw;
      max-width: 100vw;
      max-height: 86vh;
      max-height: 86dvh;
      border-radius: 16px 16px 0 0;
      background-color: var(--sl-color-bg);
      color: var(--sl-color-white);
      border-top: 1px solid var(--sl-color-hairline);
      border-left: none;
      border-right: none;
      border-bottom: none;
      box-shadow: 0 -12px 36px rgba(0, 0, 0, 0.35);
      z-index: var(--layer-drawer);
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      visibility: hidden;
      pointer-events: none;
    }

    .ft-panel.ft-is-open,
    starlight-feature-toggles.ft-is-open .ft-panel {
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .ft-sheet-handle {
      display: block;
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background-color: var(--sl-color-gray-5);
      margin: 8px auto 0;
      flex-shrink: 0;
      cursor: grab;
      touch-action: none;
      user-select: none;
    }

    .ft-panel-head {
      cursor: grab;
      touch-action: none;
      user-select: none;
    }

    .ft-panel.ft-is-dragging {
      cursor: grabbing;
      user-select: none;
    }
  }

  /* ==========================================================================
     桌面端 Popover 浮层模式 (>= 800px) —— 对齐 HeaderToolsMenu 规范
     ========================================================================== */
  @media (min-width: 50rem) {
    .ft-backdrop,
    .ft-sheet-handle {
      display: none !important;
    }

    .ft-panel {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      width: 360px;
      max-height: min(84vh, 600px);
      display: flex;
      flex-direction: column;
      background-color: var(--sl-color-bg-sidebar, #ffffff) !important;
      color: var(--sl-color-white);
      border: 1px solid var(--sl-color-hairline, #e2e8f0);
      border-radius: 1rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12), 0 1px 4px rgba(0, 0, 0, 0.06);
      z-index: var(--layer-popover, 300);
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: scale(0.96) translateY(-4px);
      transform-origin: top right;
      transition: opacity 0.18s cubic-bezier(0.2, 0, 0, 1), transform 0.18s cubic-bezier(0.2, 0, 0, 1), visibility 0.18s;
    }

    .ft-panel.ft-is-open,
    starlight-feature-toggles.ft-is-open .ft-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: scale(1) translateY(0);
    }
  }

  /* 面板头部 */
  .ft-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem 0.35rem;
    border-bottom: 1px solid var(--sl-color-hairline, #e2e8f0);
    background-color: transparent !important;
    flex-shrink: 0;
  }

  .ft-panel-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .ft-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--sl-color-gray-3);
    border-radius: 4px;
    padding: 0;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .ft-close svg {
    width: 14px;
    height: 14px;
  }

  .ft-close:hover,
  .ft-close:focus-visible {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }

  .ft-close:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  @media (min-width: 50rem) {
    .ft-close {
      display: none !important;
    }
  }

  /* 面板主体内容区 */
  .ft-panel-body {
    padding: 0.625rem 0.875rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    min-height: 0;
    background-color: var(--sl-color-bg, #ffffff) !important;
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-gray-5) transparent;
  }

  @media (max-width: 49.999rem) {
    .ft-panel-body {
      padding: 12px 14px;
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 16px));
    }
  }

  /* 极简精致滚动条 */
  .ft-panel-body::-webkit-scrollbar {
    width: 3px;
  }
  .ft-panel-body::-webkit-scrollbar-track {
    background: transparent;
  }
  .ft-panel-body::-webkit-scrollbar-thumb {
    background: var(--sl-color-gray-5);
    border-radius: 3px;
  }

  /* 分组 */
  .ft-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ft-section-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    letter-spacing: 0.03em;
    padding-left: 0;
  }

  .ft-stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ft-sub-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--sl-color-gray-3);
    padding-left: 0;
    margin-bottom: 2px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* 单行特性项：纯粹学术排版，无悬停变色背景，无隐形卡片包裹 */
  .ft-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 0;
    border-radius: 0;
    background-color: transparent;
  }

  /* 行信息 */
  .ft-row-info {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .ft-row-title-line {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ft-row-name {
    font-size: 12px;
    font-weight: 500;
    color: var(--sl-color-white);
    line-height: 1.3;
  }

  /* 极简徽章 */
  .ft-badge {
    font-size: 9.5px;
    font-weight: 500;
    padding: 0 4px;
    border-radius: 4px;
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    line-height: 1.3;
  }

  .ft-badge-dev {
    color: var(--sl-color-accent);
    border-color: var(--sl-color-gray-5);
  }

  /* ===== AI 统一服务与模型配置 ===== */
  .ft-ai-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background-color: var(--sl-color-gray-6, rgba(0, 0, 0, 0.03));
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    padding: 8px 10px;
  }

  .ft-ai-field {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ft-ai-field-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ft-ai-mini-label {
    font-size: 10.5px;
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }

  .ft-ai-key-badge {
    font-size: 9.5px;
    font-weight: 500;
    padding: 1px 4px;
    border-radius: 4px;
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
  }

  .ft-ai-key-badge.configured {
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.35);
    background-color: rgba(16, 185, 129, 0.08);
  }

  .ft-ai-custom-toggle-btn {
    border: none;
    background: transparent;
    color: var(--sl-color-accent);
    font-size: 10.5px;
    cursor: pointer;
    padding: 0;
    font-weight: 500;
    transition: opacity 0.15s ease;
  }
  .ft-ai-custom-toggle-btn:hover {
    opacity: 0.8;
  }
  .ft-ai-custom-toggle-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
    border-radius: 2px;
  }

  .ft-ai-select,
  input.ft-ai-input {
    width: 100%;
    height: 27px;
    padding: 0 8px;
    border-radius: 5px;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-size: 11.5px;
    font-family: inherit;
    transition: border-color 0.15s ease;
    box-sizing: border-box;
  }

  .ft-ai-select:focus,
  input.ft-ai-input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
  }

  .ft-ai-key-row {
    position: relative;
    display: flex;
    align-items: center;
  }

  input.ft-ai-key-input {
    padding-right: 28px;
  }

  md-outlined-text-field.ft-ai-input {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
  }

  md-outlined-text-field .ft-ai-icon-btn,
  md-outlined-text-field .ft-ai-test-icon-btn {
    position: absolute;
    inset: 0;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
  }

  md-outlined-text-field md-icon.hidden,
  .ft-test-spinner.hidden,
  .ft-test-bolt-icon.hidden {
    display: none !important;
  }

  .ft-test-spinner svg {
    fill: none !important;
  }
  .ft-test-spinner svg circle,
  .ft-test-spinner svg path {
    fill: none !important;
    stroke: currentColor !important;
  }

  .ft-ai-custom-form {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    background-color: var(--sl-color-bg);
    border: 1px dashed var(--sl-color-hairline);
    border-radius: 6px;
    margin: 2px 0;
  }
  .ft-ai-custom-form.hidden {
    display: none !important;
  }

  .ft-ai-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .ft-ai-custom-actions {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 2px;
  }

  .ft-ai-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 23px;
    padding: 0 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }

  .ft-ai-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  .ft-ai-btn-ghost {
    background: transparent;
    border-color: var(--sl-color-hairline);
    color: var(--sl-color-gray-2);
  }
  .ft-ai-btn-ghost:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }

  .ft-ai-btn-primary {
    background-color: var(--sl-color-accent);
    color: var(--sl-color-text-invert, #ffffff);
  }
  .ft-ai-btn-primary:hover {
    opacity: 0.9;
  }

  /* API 端点与测试按钮行 */
  .ft-ai-endpoint-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ft-ai-test-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .ft-ai-test-icon-btn:hover {
    color: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    background-color: var(--sl-color-gray-6);
  }

  .ft-ai-test-icon-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .ft-test-spinner {
    animation: ft-spin 1s linear infinite;
  }

  @keyframes ft-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .ft-ai-key-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .ft-ai-key-chip .ft-chip-icon {
    display: none;
  }

  .ft-ai-key-chip.configured .ft-chip-icon {
    display: inline-block;
  }

  /* 书内问答专属高级偏好折叠组 */
  .ft-ai-advanced-group {
    margin-top: 6px;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    background-color: var(--sl-color-gray-6, rgba(0, 0, 0, 0.02));
    overflow: hidden;
    transition: all 0.2s ease;
  }
  .ft-ai-advanced-group[open] {
    border-color: var(--sl-color-accent);
    background-color: var(--sl-color-bg);
  }
  .ft-ai-advanced-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    cursor: pointer;
    user-select: none;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    list-style: none;
  }
  .ft-ai-advanced-summary::-webkit-details-marker {
    display: none;
  }
  .ft-ai-advanced-summary:hover {
    color: var(--sl-color-white);
  }
  .ft-ai-advanced-title-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ft-ai-advanced-icon {
    color: var(--sl-color-accent);
  }
  .ft-ai-advanced-chevron {
    transition: transform 0.2s ease;
    color: var(--sl-color-gray-3);
  }
  .ft-ai-advanced-group[open] .ft-ai-advanced-chevron {
    transform: rotate(180deg);
    color: var(--sl-color-accent);
  }
  .ft-ai-advanced-content {
    padding: 8px 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px dashed var(--sl-color-hairline);
  }
  .ft-settings-hint-text {
    font-size: 10.5px;
    color: var(--sl-color-gray-3);
    line-height: 1.4;
    margin-top: 4px;
  }

  /* Chrome 风格外观模式分段控制基础样式 */
  .ft-theme-mode-segmented {
    display: flex;
    align-items: center;
    height: 36px;
    border-radius: 9999px;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-gray-6);
    padding: 2px;
    gap: 2px;
    margin-bottom: 8px;
  }

  .ft-mode-btn {
    flex: 1;
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 11.5px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .ft-mode-btn:hover {
    color: var(--sl-color-white);
  }

  .ft-mode-btn.active {
    background-color: var(--sl-color-bg);
    color: var(--sl-color-accent);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .ft-mode-btn .ft-mode-icon {
    display: inline-block;
  }

  .ft-mode-btn .ft-mode-check-icon {
    display: none;
  }

  .ft-mode-btn.active .ft-mode-icon {
    display: none;
  }

  .ft-mode-btn.active .ft-mode-check-icon {
    display: inline-block;
  }

  /* Chrome 4x4 色板网格基础降级布局 */
  .ft-chrome-swatches-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 8px;
  }

  .ft-chrome-color-tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border-radius: 14px;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-gray-6);
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    box-shadow: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .ft-tile-check-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--sl-color-accent);
    color: #ffffff;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .ft-chrome-color-tile.active .ft-tile-check-badge {
    display: flex;
  }

  .ft-custom-color-tile {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .ft-color-native-input {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    opacity: 0 !important;
    cursor: pointer !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    z-index: 2 !important;
  }

  .ft-eyedropper-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--sl-color-gray-5);
    color: var(--sl-color-white);
    pointer-events: none;
    box-shadow: none;
    transition: background-color 0.15s ease;
  }

  /* Gmail 风格 UI 主题行基础降级 */
  .ft-gmail-theme-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ft-gmail-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    width: 100%;
  }

  .ft-gmail-theme-row:hover {
    background-color: var(--sl-color-gray-6);
  }

  .ft-gmail-theme-row.active {
    background-color: var(--sl-color-gray-6);
    border-color: var(--sl-color-accent);
  }

  /* 测试连接行 */
  .ft-ai-test-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 2px;
  }

  .ft-ai-test-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 23px;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 500;
    border-radius: 4px;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    flex-shrink: 0;
  }

  .ft-ai-test-btn:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
    background-color: var(--sl-color-gray-6);
  }

  .ft-ai-test-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  .ft-ai-test-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .ft-ai-field-head {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    min-height: 24px;
    margin-top: 6px;
    margin-bottom: 3px;
  }

  .ft-m3-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 24px;
    padding: 0 8px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 500;
    border: 1px solid var(--sl-color-hairline);
    background: transparent;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
    box-sizing: border-box;
    transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
  }

  .ft-m3-status-chip.hidden {
    display: none !important;
  }

  .ft-m3-status-chip .ft-chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .ft-m3-status-chip .ft-chip-icon.hidden {
    display: none !important;
  }

  .ft-ai-key-chip:not(.configured) .ft-chip-icon {
    display: none !important;
  }

  .ft-m3-status-chip.configured {
    background-color: var(--sl-color-accent-low, rgba(14, 165, 233, 0.15));
    color: var(--sl-color-accent-high, #38bdf8);
    border-color: transparent;
  }

  .ft-m3-status-chip.status-ok {
    background-color: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border-color: transparent;
  }

  .ft-m3-status-chip.status-err {
    background-color: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border-color: transparent;
  }

  .ft-m3-status-chip.status-loading {
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    border-color: transparent;
  }

  /* ===== 分段选择器（Segmented Control · VitePress 胶囊切换） ===== */
  .ft-segment-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ft-prewarm-wrapper {
    margin: 10px 0 6px 0;
  }

  .ft-segment-track {
    display: grid;
    gap: 3px;
    padding: 2px;
    border-radius: 6px;
    background-color: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
  }

  .ft-grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .ft-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .ft-grid-5 {
    grid-template-columns: repeat(5, 1fr);
  }

  .ft-font-btn,
  .ft-theme-chip,
  .ft-prewarm-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 24px;
    padding: 0 2px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 11px;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
    white-space: nowrap;
    overflow: hidden;
  }

  .ft-font-btn:hover,
  .ft-theme-chip:hover,
  .ft-prewarm-btn:hover {
    color: var(--sl-color-white);
  }

  .ft-font-btn:focus-visible,
  .ft-theme-chip:focus-visible,
  .ft-prewarm-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  .ft-font-btn.active,
  .ft-theme-chip.active,
  .ft-prewarm-btn.active {
    background-color: var(--sl-color-bg);
    color: var(--sl-color-accent);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .ft-theme-chip:disabled,
  .ft-theme-chip.is-disabled {
    opacity: 0.45;
    cursor: not-allowed !important;
    pointer-events: none !important;
  }

  .ft-prewarm-track .ft-prewarm-btn.active {
    box-shadow: none !important;
  }

  /* 官方 Material 3 md-filter-chip 字体选择器 */
  .ft-font-chip-set {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
  }

  .ft-font-chip {
    cursor: pointer;
  }

  /* 正文字号调节滑块 (M3 md-slider) */
  .ft-slider-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    margin-bottom: 2px;
  }

  .ft-slider-val-chip {
    --md-assist-chip-container-height: 22px;
    --md-assist-chip-container-shape: 9999px;
    --md-assist-chip-container-color: var(--md-sys-color-primary-container, var(--sl-color-accent-low, rgba(14, 165, 233, 0.1)));
    --md-assist-chip-label-text-color: var(--md-sys-color-on-primary-container, var(--sl-color-text-accent));
    --md-assist-chip-label-text-size: 11px;
    --md-assist-chip-label-text-weight: 600;
    --md-assist-chip-outline-color: transparent;
    --md-assist-chip-outline-width: 0px;
    font-family: var(--sl-font-mono, monospace);
    box-shadow: none;
    cursor: default;
    pointer-events: none;
    user-select: none;
  }

  .ft-slider-val-chip:not(:defined) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    padding: 0 8px;
    font-size: 11px;
    font-family: var(--sl-font-mono, monospace);
    font-weight: 600;
    color: var(--md-sys-color-on-primary-container, var(--sl-color-text-accent));
    background-color: var(--md-sys-color-primary-container, var(--sl-color-accent-low, rgba(14, 165, 233, 0.1)));
    border-radius: 9999px;
    border: none;
    box-sizing: border-box;
    cursor: default;
    user-select: none;
  }

  .ft-slider-row {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
