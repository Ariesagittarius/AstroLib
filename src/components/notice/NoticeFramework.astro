---
/**
 * NoticeFramework.astro
 * ============================================================================
 * 正文卡片外【提示框架】主容器（Notice Framework Host）
 * 
 * 架构规范：
 * 1. 挂载于 .main-pane 顶层、<main>（正文卡片）正上方；
 * 2. 宽度与正文卡片严格对齐 (max-width: 62rem; margin: 0 auto)；
 * 3. 服务端驱动：当前页面无提示时返回 null，零 DOM 占用；
 * 4. 数据结构驱动：自动按 variant 分发给 WikiNotice 或 ChromeNotice。
 * ============================================================================
 */

import { collections } from '@/config/collections.config.mjs';
import { resolveNotices, NOTICE_PRESETS, ROUTE_NOTICES } from '@/config/notices.config.mjs';
import WikiNotice from './WikiNotice.astro';
import ChromeNotice from './ChromeNotice.astro';

const pathname = Astro.url.pathname;
const entry = (Astro.locals as any)?.starlightRoute?.entry;
const entryId = entry?.id || '';
const entrySlug = entry?.slug || '';

let currentBook = null;
let currentCol = null;

for (const col of collections) {
  const matched = col.books.find(b => pathname.includes(`/collections/${col.slug}/${b.slug}/`));
  if (matched) {
    currentCol = col;
    currentBook = matched;
    break;
  }
}

// 1. 匹配路由/范围规则提示 (ROUTE_NOTICES)
const matchedRouteNotices = (ROUTE_NOTICES || [])
  .filter(rule => {
    if (typeof rule.pattern === 'string') {
      return pathname.startsWith(rule.pattern) || entryId.startsWith(rule.pattern) || entrySlug.startsWith(rule.pattern);
    }
    if (rule.pattern instanceof RegExp) {
      return rule.pattern.test(pathname) || rule.pattern.test(entryId) || rule.pattern.test(entrySlug);
    }
    return false;
  })
  .flatMap(rule => rule.notices || []);

// 2. 识别是否为开发文档页面（/dev 系列技术文档）
const isDevDoc = pathname.includes('/dev') || entryId.startsWith('dev') || entrySlug.startsWith('dev');

// 3. 提取当前章节 frontmatter 中的 notices (若有)
const frontmatterNotices = entry?.data?.notices || [];

// 4. 多层级优先级解析：Route -> Collection -> Book -> Frontmatter
const notices = resolveNotices(
  matchedRouteNotices,
  currentCol?.notices,
  currentBook?.notices,
  frontmatterNotices
);
---

{notices && notices.length > 0 && (
  <div class="astrolib-notice-framework" data-book-slug={currentBook?.slug || (isDevDoc ? 'dev' : undefined)}>
    {notices.map(notice => (
      notice.variant === 'chrome' ? (
        <ChromeNotice notice={notice} />
      ) : (
        <WikiNotice notice={notice} />
      )
    ))}
  </div>
)}

<style>
  .astrolib-notice-framework {
    max-width: 62rem;
    width: 100%;
    margin: 0 auto 0.85rem auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 49.999rem) {
    .astrolib-notice-framework {
      max-width: 100%;
      margin-bottom: 0.65rem;
    }
  }

  @media print {
    .astrolib-notice-framework {
      display: none !important;
    }
  }
</style>

<script is:inline>
  // 提示框架交互控制器（折叠/展开与会话级关闭记忆）
  (function initNoticeInteractions() {
    function setupNotices(root) {
      if (!root) return;
      const framework = root.querySelector('.astrolib-notice-framework');
      if (!framework) return;

      framework.querySelectorAll('.astrolib-notice-card').forEach((card) => {
        const id = card.dataset.noticeId;
        if (!id) return;

        // 检查会话级关闭状态
        if (sessionStorage.getItem('astrolib_dismissed_notice_' + id) === '1') {
          card.style.display = 'none';
          return;
        }

        // 绑定折叠展开按钮
        const toggleBtn = card.querySelector('.toggle-expand-btn');
        const expandPanel = card.querySelector('.wiki-expand-panel');
        if (toggleBtn && expandPanel && !toggleBtn.dataset.bound) {
          toggleBtn.dataset.bound = 'true';
          toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = expandPanel.hasAttribute('hidden');
            if (isHidden) {
              expandPanel.removeAttribute('hidden');
              toggleBtn.setAttribute('aria-expanded', 'true');
            } else {
              expandPanel.setAttribute('hidden', '');
              toggleBtn.setAttribute('aria-expanded', 'false');
            }
          });
        }

        // 绑定关闭按钮
        const dismissBtn = card.querySelector('.dismiss-btn');
        if (dismissBtn && !dismissBtn.dataset.bound) {
          dismissBtn.dataset.bound = 'true';
          dismissBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            card.style.opacity = '0';
            card.style.transform = 'translateY(-4px)';
            card.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
            setTimeout(() => {
              card.style.display = 'none';
              sessionStorage.setItem('astrolib_dismissed_notice_' + id, '1');
            }, 200);
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => setupNotices(document));
    } else {
      setupNotices(document);
    }

    // 兼容 SPA 路由换页生命周期
    document.addEventListener('astro:page-load', () => setupNotices(document));
  })();
</script>
