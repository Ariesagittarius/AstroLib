---
import { siteThemes } from '../config/themes.config.mjs';
---

<starlight-site-theme-select class="vp-site-theme-switch" title="切换 UI 风格主题" data-feature="theme">
  <button
    type="button"
    class="vp-site-theme-btn"
    aria-label="切换 UI 风格主题"
    title="切换 UI 风格主题"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <svg class="vp-icon-palette" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21a9 9 0 1 1 0-18c4.97 0 9 3.58 9 8 0 2.76-2.24 5-5 5h-1.7c-.55 0-1 .45-1 1 0 .28.11.53.29.71.3.3.48.71.48 1.16 0 .9-.73 1.63-1.63 1.63-1.03 0-1.87-.84-1.87-1.87 0-.45.16-.87.44-1.19" />
      <circle cx="7.5" cy="10.5" r="1.2" fill="currentColor" />
      <circle cx="12" cy="7.5" r="1.2" fill="currentColor" />
      <circle cx="16.5" cy="10.5" r="1.2" fill="currentColor" />
    </svg>
  </button>

  <div class="vp-site-theme-panel" role="listbox" aria-label="切换 UI 风格主题" aria-hidden="true">
    <div class="vp-site-theme-panel-title">UI 风格主题</div>
    <div class="vp-site-theme-options">
      {siteThemes.map((theme) => (
        <button
          type="button"
          class="vp-site-theme-option"
          data-theme-id={theme.id}
          role="option"
          aria-selected="false"
        >
          <span class="vp-site-theme-check" aria-hidden="true"></span>
          <div class="vp-site-theme-info">
            <span class="vp-site-theme-name">{theme.label}</span>
            <span class="vp-site-theme-desc">{theme.desc}</span>
          </div>
        </button>
      ))}
    </div>
  </div>
</starlight-site-theme-select>

<style>.vp-site-theme-switch {
    position: relative;
    display: flex;
    align-items: center;
  }

  .vp-site-theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    color: var(--sl-color-gray-2);
    transition: color 0.25s, background-color 0.25s;
  }
  .vp-site-theme-btn:hover,
  .vp-site-theme-btn:focus-visible {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }
  .vp-site-theme-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 1px;
  }

  .vp-icon-palette {
    width: 1.25rem;
    height: 1.25rem;
  }

  .vp-site-theme-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: none;
    flex-direction: column;
    width: min(92vw, 17.5rem);
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
    overflow: hidden;
    z-index: 2147483001;
  }
  .vp-site-theme-switch.vp-open .vp-site-theme-panel {
    display: flex;
  }

  .vp-site-theme-panel-title {
    padding: 0.625rem 0.75rem 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sl-color-gray-2);
    opacity: 0.8;
  }

  .vp-site-theme-options {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.375rem;
  }

  .vp-site-theme-option {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: var(--sl-color-text);
    transition: background-color 0.15s, color 0.15s;
  }
  .vp-site-theme-option:hover,
  .vp-site-theme-option:focus-visible {
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .vp-site-theme-option:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  .vp-site-theme-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1.25rem;
    flex-shrink: 0;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
    color: var(--sl-color-text-accent);
  }
  .vp-site-theme-option[aria-selected='true'] .vp-site-theme-check::before {
    content: '✓';
  }

  .vp-site-theme-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .vp-site-theme-name {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .vp-site-theme-desc {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--sl-color-gray-2);
    opacity: 0.8;
  }
</style>

<script>import {
    loadSiteTheme,
    applySiteTheme,
    setSiteTheme,
    parseSiteTheme,
    type SiteThemeId,
  } from '../scripts/site-themes';

  class StarlightSiteThemeSelect extends HTMLElement {
    connectedCallback() {
      const theme = loadSiteTheme();
      applySiteTheme(theme);
      this.syncSelected(theme);

      if (this.dataset.bound) return;
      this.dataset.bound = '1';

      const btn = this.querySelector<HTMLButtonElement>('.vp-site-theme-btn');
      const panel = this.querySelector<HTMLElement>('.vp-site-theme-panel');

      btn?.addEventListener('click', () => this.toggle(panel));

      this.querySelectorAll<HTMLButtonElement>('.vp-site-theme-option').forEach((opt) => {
        opt.addEventListener('click', () => {
          const targetTheme = parseSiteTheme(opt.dataset.themeId);
          setSiteTheme(targetTheme);
          this.close();
        });
      });

      window.addEventListener('site-theme-change', (e: Event) => {
        const detail = (e as CustomEvent).detail;
        if (detail?.theme) {
          this.syncSelected(detail.theme);
        }
      });
    }

    toggle(panel?: HTMLElement | null): void {
      document
        .querySelectorAll<StarlightSiteThemeSelect>('starlight-site-theme-select')
        .forEach((el) => el !== this && el.close());
      const open = this.classList.toggle('vp-open');
      panel?.setAttribute('aria-hidden', String(!open));
      this.querySelector<HTMLButtonElement>('.vp-site-theme-btn')?.setAttribute('aria-expanded', String(open));
    }

    close(): void {
      this.classList.remove('vp-open');
      this.querySelector<HTMLElement>('.vp-site-theme-panel')?.setAttribute('aria-hidden', 'true');
      this.querySelector<HTMLButtonElement>('.vp-site-theme-btn')?.setAttribute('aria-expanded', 'false');
    }

    syncSelected(currentTheme: SiteThemeId): void {
      this.querySelectorAll<HTMLButtonElement>('.vp-site-theme-option').forEach((opt) => {
        const selected = opt.dataset.themeId === currentTheme;
        opt.setAttribute('aria-selected', String(selected));
      });
    }
  }

  if (!customElements.get('starlight-site-theme-select')) {
    customElements.define('starlight-site-theme-select', StarlightSiteThemeSelect);
  }

  if (!window.__vpSiteThemeDocHandlers) {
    window.__vpSiteThemeDocHandlers = true;
    document.addEventListener('click', (e) => {
      document.querySelectorAll<StarlightSiteThemeSelect>('starlight-site-theme-select').forEach((el) => {
        if (!el.contains(e.target as Node)) el.close();
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelector<StarlightSiteThemeSelect>('starlight-site-theme-select.vp-open')?.close();
    });
  }
</script>
