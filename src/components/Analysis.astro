---
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title = "思路分析" } = Astro.props;
---

<div class="analysis-block" data-title={title} {...srcAttrs(Astro.props)}>
  <div class="analysis-header">{title}</div>
  <div class="analysis-content">
    <slot />
  </div>
</div>

<style>.analysis-block {
    background-color: transparent;
    border: none;
    border-left: 2px solid var(--sl-color-hairline);
    padding: 0.2rem 0 0.2rem 0.85rem;
    margin: 1.5rem 0 1.25rem;
  }
  .analysis-header {
    font-weight: 700;
    color: var(--sl-color-gray-1);
    margin-bottom: 0.4rem;
    font-size: 1rem;
  }
  .analysis-content {
    padding: 0;
  }
</style>
