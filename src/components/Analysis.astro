---
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title = "思路分析" } = Astro.props;
---

<div class="analysis-block" data-title={title} {...srcAttrs(Astro.props)}>
  <div class="analysis-header">{title}</div>
  <div class="analysis-content">
    <slot />
  </div>
</div>

<style>.analysis-block {
    --analysis-border: #8b5cf6;
    --analysis-bg: #faf5ff;
    --analysis-header-fg: #6b21a8;
    border-left: 3px solid var(--analysis-border);
    background-color: var(--analysis-bg);
    padding: 0.8rem 1rem;
    margin: 1rem 0;
    border-radius: 0 6px 6px 0;
  }
  .analysis-header {
    font-weight: bold;
    color: var(--analysis-header-fg);
    margin-bottom: 0.4rem;
    font-size: 0.95rem;
  }

  :global(html[data-theme='dark']) .analysis-block {
    --analysis-border: #a78bfa;
    --analysis-bg: rgba(139, 92, 246, 0.13);
    --analysis-header-fg: #c4b5fd;
  }
</style>
