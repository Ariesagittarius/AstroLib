---
const { title } = Astro.props;
const cleanId = title ? encodeURIComponent(title.trim().replace(/\s+/g, '-')) : undefined;
---

<div class="fallback-block toc-chunk" data-title={title} id={cleanId}>
  <div class="fallback-header">📦 {title}</div>
  <div class="fallback-content">
    <slot />
  </div>
</div>

<style>
  .fallback-block {
    background-color: #f1f5f9;
    border-left: 4px solid #64748b;
    padding: 0.8rem 1rem;
    margin: 1.5rem 0;
    border-radius: 0 6px 6px 0;
  }
  .fallback-header {
    font-weight: bold;
    color: #334155;
    margin-bottom: 0.4rem;
  }
</style>