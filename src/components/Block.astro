---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title } = Astro.props;
const cleanId = title ? title.trim().replace(/\s+/g, '-') : undefined;
---

<div class="fallback-block toc-chunk" data-title={title} id={cleanId} {...srcAttrs(Astro.props)}>
  {title && (
    <div class="fallback-header">
      <span class="block-mdicon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 2l-5.5 9h11z" />
          <circle cx="17.5" cy="17.5" r="4.5" />
          <path d="M3 13.5h8v8H3z" />
        </svg>
      </span>
      <span class="block-title-text" set:html={renderTitleHtml(title)}></span>
    </div>
  )}
  <div class="fallback-content">
    <slot />
  </div>
</div>

<style>
  .fallback-block {
    margin: 1.75rem 0 1.5rem;
    border-radius: var(--card-border-radius, 12px);
  }
  .fallback-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.02rem;
    font-weight: 650;
    font-family: var(--font-heading, var(--academic-font-heading, sans-serif));
    letter-spacing: 0.01em;
  }
  .block-mdicon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .fallback-content {
    line-height: 1.8;
  }
</style>