---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title } = Astro.props;
const displayTitle = title !== undefined ? title : '注意';
const cleanId = displayTitle ? displayTitle.trim().replace(/\s+/g, '-') : undefined;
---

<div class="note-block" data-title={displayTitle} id={cleanId} {...srcAttrs(Astro.props)}>
  {displayTitle && (
    <div class="note-header">
      <span class="note-mdicon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z" />
        </svg>
      </span>
      <span class="note-title-text" set:html={renderTitleHtml(displayTitle)}></span>
    </div>
  )}
  <div class="note-content">
    <slot />
  </div>
</div>

<style>.note-block {
    margin: 1.5rem 0 1.25rem;
    border-radius: var(--card-border-radius, 12px);
  }
  .note-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    font-size: 0.98rem;
    letter-spacing: 0.01em;
  }
  .note-mdicon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .note-content {
    line-height: 1.8;
  }
</style>
