---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title } = Astro.props;
const displayTitle = title !== undefined ? title : '注意';
const cleanId = displayTitle ? displayTitle.trim().replace(/\s+/g, '-') : undefined;
---

<div class="note-block" data-title={displayTitle} id={cleanId} {...srcAttrs(Astro.props)}>
  {displayTitle && <div class="note-header" set:html={renderTitleHtml(displayTitle)}></div>}
  <div class="note-content">
    <slot />
  </div>
</div>

<style>
  .note-block {
    background-color: transparent;
    border: none;
    border-left: 2px solid var(--sl-color-hairline);
    padding: 0.2rem 0 0.2rem 0.85rem;
    margin: 1.5rem 0 1.25rem;
  }
  .note-header {
    font-weight: 700;
    color: var(--sl-color-gray-1);
    margin-bottom: 0.4rem;
    font-size: 1rem;
  }
  .note-content {
    padding: 0;
  }
</style>