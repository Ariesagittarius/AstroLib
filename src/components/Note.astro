---
import { srcAttrs } from '../utils/src-attrs.mjs';
---

<div class="note-block" {...srcAttrs(Astro.props)}>
  <div class="note-header">标注说明</div>
  <div class="note-content">
    <slot />
  </div>
</div>

<style>
  .note-block {
    --note-bg: #fffbeb;
    --note-border: #fef3c7;
    --note-accent: #f59e0b; /* 橙黄色代表提醒 */
    --note-header-fg: #b45309;
    background-color: var(--note-bg);
    border: 1px solid var(--note-border);
    border-left: 4px solid var(--note-accent);
    padding: 0.8rem 1rem;
    margin: 1rem 0;
    border-radius: 0 6px 6px 0;
  }
  .note-header {
    font-weight: bold;
    color: var(--note-header-fg);
    margin-bottom: 0.3rem;
    font-size: 0.95rem;
  }

  /* 黑夜主题适配 */
  :global(html[data-theme='dark']) .note-block {
    --note-bg: rgba(245, 158, 11, 0.1);
    --note-border: rgba(245, 158, 11, 0.28);
    --note-accent: #fbbf24;
    --note-header-fg: #fcd34d;
  }
</style>