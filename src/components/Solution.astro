---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title = "查看解析与步骤" } = Astro.props;
---
<details class="solution-details" data-title={title} {...srcAttrs(Astro.props)}>
  <summary set:html={renderTitleHtml(title)}></summary>
  <div class="solution-content">
    <slot />
  </div>
</details>

<style>
  .solution-details {
    margin: 1.15rem 0 1.5rem;
    border: none;
    background-color: transparent;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0;
    font-size: 1rem;
    font-weight: 700;
    font-family: var(--font-reading);
    color: var(--sl-color-white);
    cursor: pointer;
    user-select: none;
    outline: none;
    list-style: none;
    transition: color 0.15s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--sl-color-text-accent);
  }
  summary::before {
    content: '▸';
    display: inline-block;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    transition: transform 0.15s ease, color 0.15s ease;
    line-height: 1;
  }
  .solution-details[open] > summary::before {
    transform: rotate(90deg);
    color: var(--sl-color-text-accent);
  }
  .solution-content {
    border-inline-start: 1px dashed var(--sl-color-hairline);
    padding: 0.35rem 0 0.35rem 0.85rem;
    margin: 0.35rem 0 0.5rem 0.25rem;
    background-color: transparent;
    position: relative;
    line-height: 1.82;
  }
  .solution-content::after {
    content: '∎';
    display: block;
    text-align: right;
    font-family: var(--font-latin-katex), 'STIX Two Math', 'Times New Roman', serif;
    font-size: 1rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
    line-height: 1;
  }
</style>