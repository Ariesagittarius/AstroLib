---
const { title = "查看解析与步骤" } = Astro.props;
---
<details class="solution-details">
  <summary>{title}</summary>
  <div class="solution-content">
    <slot />
  </div>
</details>

<style>
  .solution-details {
    margin-top: 1rem;
    border: 1px dashed var(--sl-color-hairline-light);
    border-radius: 6px;
    background-color: var(--sl-color-gray-6);
  }
  summary {
    padding: 0.6rem 1rem;
    font-weight: bold;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    user-select: none;
    outline: none;
  }
  summary:hover {
    color: var(--sl-color-gray-1);
  }
  .solution-content {
    padding: 1rem;
    border-top: 1px dashed var(--sl-color-hairline-light);
    background-color: var(--sl-color-bg);
  }
</style>