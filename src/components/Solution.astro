---
const { title = "查看解析与步骤" } = Astro.props;
---
<details class="solution-details">
  <summary>🔑 {title}</summary>
  <div class="solution-content">
    <slot />
  </div>
</details>

<style>
  .solution-details {
    margin-top: 1rem;
    border: 1px dashed #cbd5e1;
    border-radius: 6px;
    background-color: #f8fafc;
  }
  summary {
    padding: 0.6rem 1rem;
    font-weight: bold;
    color: #475569;
    cursor: pointer;
    user-select: none;
    outline: none;
  }
  summary:hover {
    color: #1e293b;
  }
  .solution-content {
    padding: 1rem;
    border-top: 1px dashed #cbd5e1;
    background-color: #ffffff;
  }
</style>