---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title = "查看解析与步骤" } = Astro.props;
---
<details class="solution-details" data-title={title} {...srcAttrs(Astro.props)}>
  <summary set:html={renderTitleHtml(title)}></summary>
  <div class="solution-content">
    <slot />
  </div>
</details>

<style>.solution-details {
    margin: 1.15rem 0 1.25rem;
    border: none;
    background-color: transparent;
    padding: 0;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.25rem 0.25rem 0;
    margin: 0 0 0.75rem 0;
    border-bottom: 1.5px solid var(--sl-color-hairline);
    font-size: 0.95rem;
    font-weight: 650;
    font-family: var(--font-heading, var(--academic-font-heading, sans-serif));
    color: var(--academic-color-heading, var(--sl-color-white));
    cursor: pointer;
    user-select: none;
    outline: none;
    list-style: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    border-bottom-color: var(--sl-color-gray-3);
  }
  summary::before {
    content: none;
    display: none;
  }
  summary::after {
    content: '›';
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--sl-color-gray-3);
    margin-left: 0.25rem;
    transition: transform 0.18s ease, color 0.18s ease;
    line-height: 1;
  }
  summary:hover::after {
    color: var(--academic-color-heading, var(--sl-color-white));
  }
  .solution-details[open] > summary {
    border-bottom-color: var(--sl-color-hairline);
  }
  .solution-details[open] > summary::after {
    transform: rotate(90deg);
    color: var(--sl-color-gray-2);
  }
  .solution-content {
    border: none;
    padding: 0.15rem 0 0.5rem 0;
    margin: 0;
    background-color: transparent;
    position: relative;
    line-height: 1.82;
  }
  .solution-content::after {
    content: '∎';
    display: block;
    text-align: right;
    font-family: var(--font-latin-katex), 'STIX Two Math', 'Times New Roman', serif;
    font-size: 1rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
    line-height: 1;
  }
</style>
