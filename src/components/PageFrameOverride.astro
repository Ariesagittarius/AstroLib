---
/**
 * PageFrameOverride.astro
 * ============================================================================
 * 覆盖 Starlight 默认 PageFrame：
 * 1. 继承原版全部插槽 (header, sidebar, default)；
 * 2. 在 <body> 顶层紧随 .page 渲染全站统一视窗挂载容器 <div id="astro-overlay-root"></div>；
 * 3. 使全局 Dialog, Drawer, Modal, Toast 从服务端首屏即可逃逸 .main-pane 的进入动画
 *    (transform / will-change) 与 header 的 (backdrop-filter) Stacking Context 囚禁。
 * ============================================================================
 */
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
---

<DefaultPageFrame {...Astro.props}>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
</DefaultPageFrame>
<div id="astro-overlay-root"></div>

