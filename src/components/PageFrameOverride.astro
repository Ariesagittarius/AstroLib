---
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
---

<DefaultPageFrame {...Astro.props}>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
</DefaultPageFrame>
<div id="astro-overlay-root">

  <div class="astrolib-sideload-scrim" id="astrolib-sideload-scrim" aria-hidden="true"></div>
</div>

<script is:inline>(function() {
    try {
      if (localStorage.getItem('astrolib_typography_indent') === 'false') {
        document.documentElement.dataset.paragraphIndent = 'false';
      }
      var p = localStorage.getItem('astrolib_punct_style');
      if (p) document.documentElement.dataset.punctStyle = p;
      var fs = localStorage.getItem('astrolib_font_size');
      if (fs) {
        var pxVal = parseFloat(fs);
        if (!isNaN(pxVal)) {
          document.documentElement.style.setProperty('--academic-font-size-body', (pxVal * 0.75) + 'pt');
        }
      }
      var isDesktop = window.innerWidth >= 800;
      var isWide = window.innerWidth >= 1152;
      if (isDesktop && localStorage.getItem('astrolib_sidebar_left_collapsed') === 'true') {
        document.documentElement.dataset.sidebarLeftCollapsed = 'true';
      }
      if (isWide && localStorage.getItem('astrolib_sidebar_right_collapsed') === 'true') {
        document.documentElement.dataset.sidebarRightCollapsed = 'true';
        document.documentElement.dataset.sideloadActive = 'none';
        document.documentElement.style.setProperty('--sl-sideload-width', '0rem');
      }
    } catch (e) {}
  })();
</script>
