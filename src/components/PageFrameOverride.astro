---
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
---

<DefaultPageFrame {...Astro.props}>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
</DefaultPageFrame>
<div id="astro-overlay-root"></div>

<script is:inline>(function() {
    try {
      if (localStorage.getItem('astrolib_typography_indent') === 'false') {
        document.documentElement.dataset.paragraphIndent = 'false';
      }
      var p = localStorage.getItem('astrolib_punct_style');
      if (p) document.documentElement.dataset.punctStyle = p;
      var fs = localStorage.getItem('astrolib_font_size');
      if (fs) {
        var pxVal = parseFloat(fs);
        if (!isNaN(pxVal)) {
          document.documentElement.style.setProperty('--academic-font-size-body', (pxVal * 0.75) + 'pt');
        }
      }
    } catch (e) {}
  })();
</script>
