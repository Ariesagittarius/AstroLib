---
/**
 * TwoColumnContentOverride.astro
 * ============================================================================
 * 覆盖 Starlight 原版 TwoColumnContent：
 * 1. 保留原版右侧大纲容器与两栏响应式布局；
 * 2. 在 .main-pane 内、<main>（正文卡片）正上方，挂载全站统一的 <NoticeFramework />。
 * ============================================================================
 */
import NoticeFramework from './notice/NoticeFramework.astro';

const pathname = Astro.url.pathname;
const entryData = (Astro.props as any)?.entry?.data || (Astro.locals as any)?.starlightRoute?.entry?.data;
const isDevDoc = pathname.startsWith('/dev') || entryData?.pageType === 'dev' || entryData?.pageType === 'technical' || entryData?.noindent === true;
---

<div class="lg:sl-flex">
	{
		Astro.locals.starlightRoute.toc && (
			<aside class="right-sidebar-container print:hidden">
				<div class="right-sidebar">
					<slot name="right-sidebar" />
				</div>
			</aside>
		)
	}
	<div class:list={['main-pane', { 'is-dev-doc': isDevDoc }]}>
		<NoticeFramework />
		<slot />
	</div>
</div>

<style>
	@layer starlight.core {
		.main-pane {
			isolation: isolate;
		}

		@media (min-width: 72rem) {
			.right-sidebar-container {
				order: 2;
				position: relative;
				width: max(
					var(--sl-sidebar-width),
					calc(
						var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
					)
				);
			}

			.right-sidebar {
				position: fixed;
				top: 0;
				border-inline-start: 1px solid var(--sl-color-hairline);
				padding-top: var(--sl-nav-height);
				width: 100%;
				height: 100vh;
				overflow-y: auto;
				scrollbar-width: none;
			}

			.main-pane {
				width: 100%;
			}

			:global([data-has-sidebar][data-has-toc]) .main-pane {
				--sl-content-margin-inline: auto 0;

				order: 1;
				width: min(
					calc(100% - var(--sl-sidebar-width)),
					calc(
						var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
					)
				);
			}
		}
	}
</style>
