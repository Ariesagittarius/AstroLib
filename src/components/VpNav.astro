---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---

<header class="vp-nav">
  <div class="vp-nav-container">
    <!-- Brand Logo & Title -->
    <a href="/" class="vp-brand" aria-label="AstroLib 首页">
      <div class="vp-logo-wrap" aria-hidden="true">
        <img src="/astrolib-logo.png" class="vp-logo-img" alt="AstroLib 徽标" width="28" height="22" />
      </div>
      <div class="vp-brand-text">
        <span class="vp-site-name">AstroLib</span>
      </div>
    </a>

    <!-- Quick Search Trigger (Chrome Omnibox Pill Style) -->
    <div class="vp-search-wrap">
      <a href="/library/?focus=search" class="vp-nav-search-btn" title="检索书目 (快捷键 / 或 ⌘K)">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span class="search-text">Search / 检索书目...</span>
        <kbd class="search-kbd">⌘K</kbd>
      </a>
    </div>

    <!-- Right Controls: Desktop Nav Links + Divider + Theme Switch + GitHub + Mobile Hamburger -->
    <div class="vp-nav-actions">
      <!-- Desktop Navigation Links -->
      <nav class="vp-nav-links" aria-label="主要导航">
        <a href="/library/" class:list={['vp-nav-link', { active: currentPath.startsWith('/library') }]}>
          书目检索
        </a>
        <a href="/dev/" class:list={['vp-nav-link', { active: currentPath.startsWith('/dev') }]}>
          开发文档
        </a>
      </nav>

      <!-- Vertical Divider -->
      <div class="vp-nav-divider" aria-hidden="true"></div>

      <!-- Theme Switcher (M3 34px Circular Outlined Button) -->
      <div class="vp-theme-switch-container">
        <button
          type="button"
          class="vp-theme-btn"
          id="vp-nav-theme-btn"
          role="switch"
          aria-label="切换亮/暗色主题"
          title="切换亮/暗色主题"
        >
          <!-- Google Material Symbols 官方 Outlined 空心太阳 (light_mode) -->
          <svg class="theme-icon sun-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <line x1="12" y1="2" x2="12" y2="4"></line>
            <line x1="12" y1="20" x2="12" y2="22"></line>
            <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"></line>
            <line x1="17.66" y1="17.66" x2="19.07" y2="19.07"></line>
            <line x1="2" y1="12" x2="4" y2="12"></line>
            <line x1="20" y1="12" x2="22" y2="12"></line>
            <line x1="6.34" y1="17.66" x2="4.93" y2="19.07"></line>
            <line x1="19.07" y1="4.93" x2="17.66" y2="6.34"></line>
          </svg>
          <!-- Google Material Symbols 官方 Outlined 镂空月牙 (dark_mode) -->
          <svg class="theme-icon moon-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </div>

      <!-- GitHub Link (Primer Octicon in 34px Circular Base) -->
      <a
        href="https://github.com/Ariesagittarius/AstroLib"
        target="_blank"
        rel="noopener noreferrer"
        class="vp-nav-social-btn"
        aria-label="GitHub 仓库"
        title="GitHub 仓库"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="social-icon" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button type="button" class="vp-hamburger" id="vp-nav-hamburger" aria-label="展开导航菜单" aria-expanded="false">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="vp-mobile-menu" id="vp-mobile-menu">
    <div class="vp-mobile-links">
      <a href="/library/" class="vp-mobile-link">书目检索与分类</a>
      <a href="/dev/" class="vp-mobile-link">项目开发文档</a>
      <a href="https://github.com/Ariesagittarius/AstroLib" target="_blank" rel="noopener noreferrer" class="vp-mobile-link">GitHub 仓库</a>
    </div>
  </div>
</header>

<style>
  .vp-nav {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--layer-sticky, 100);
    height: var(--sl-nav-height, 3rem);
    background-color: var(--md-sys-color-surface, #ffffff);
    border-bottom: 1px solid var(--md-sys-color-outline-variant, #e0e3e7);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  :global([data-theme='dark']) .vp-nav {
    background-color: var(--md-sys-color-surface-container-low, #131314);
    border-bottom-color: var(--md-sys-color-outline-variant, #3c4043);
  }

  .vp-nav-container {
    max-width: 1376px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Brand Logo & Title */
  .vp-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }
  .vp-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .vp-logo-img {
    width: 1.65rem;
    height: auto;
    max-height: 1.5rem;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.08));
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
  }
  .vp-brand:hover .vp-logo-img {
    transform: scale(1.06);
  }
  .vp-brand-text {
    display: flex;
    align-items: center;
  }
  .vp-site-name {
    font-family: var(--md-sys-typescale-title-medium-font, 'Google Sans', 'Plus Jakarta Sans', system-ui, sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--md-sys-color-on-surface, #1f1f1f);
    white-space: nowrap;
  }
  :global([data-theme='dark']) .vp-site-name {
    color: var(--md-sys-color-on-surface, #e3e3e3);
  }

  /* Chrome Omnibox Style Search Trigger */
  .vp-search-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    max-width: 18rem;
    margin-left: 0.5rem;
  }
  .vp-nav-search-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    height: 2.25rem;
    padding: 0 0.85rem;
    background-color: var(--md-sys-color-surface-container-high, #e8eaed);
    border: 1px solid transparent;
    border-radius: var(--md-shape-corner-full, 9999px);
    font-size: 0.8125rem;
    font-family: inherit;
    color: var(--md-sys-color-on-surface-variant, #444746);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }
  :global([data-theme='dark']) .vp-nav-search-btn {
    background-color: var(--md-sys-color-surface-container-high, #28292a);
    color: var(--md-sys-color-on-surface-variant, #c4c7c5);
  }
  .vp-nav-search-btn:hover {
    background-color: var(--md-sys-color-surface-container-highest, #dadce0);
    color: var(--md-sys-color-on-surface, #1f1f1f);
    box-shadow: var(--md-elevation-level-1, 0 1px 2px rgba(60, 64, 67, 0.1));
  }
  :global([data-theme='dark']) .vp-nav-search-btn:hover {
    background-color: var(--md-sys-color-surface-container-highest, #333537);
    color: var(--md-sys-color-on-surface, #e3e3e3);
  }
  .search-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .search-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }
  .search-kbd {
    font-family: inherit;
    font-size: 0.6875rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background-color: var(--md-sys-color-surface, #ffffff);
    border: 1px solid var(--md-sys-color-outline-variant, #e0e3e7);
    color: var(--md-sys-color-outline, #72777d);
    line-height: 1.2;
  }
  :global([data-theme='dark']) .search-kbd {
    background-color: var(--md-sys-color-surface-container-low, #18191a);
    border-color: var(--md-sys-color-outline-variant, #3c4043);
    color: var(--md-sys-color-outline, #8e918f);
  }

  /* Nav Actions */
  .vp-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
  }

  /* Nav links */
  .vp-nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .vp-nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant, #444746);
    text-decoration: none;
    border-radius: var(--md-shape-corner-full, 9999px);
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }
  :global([data-theme='dark']) .vp-nav-link {
    color: var(--md-sys-color-on-surface-variant, #c4c7c5);
  }
  .vp-nav-link:hover {
    color: var(--md-sys-color-primary, #0b57d0);
    background-color: var(--md-sys-color-surface-container-high, #e8eaed);
  }
  :global([data-theme='dark']) .vp-nav-link:hover {
    color: var(--md-sys-color-primary, #a8c7fa);
    background-color: var(--md-sys-color-surface-container-high, #28292a);
  }
  .vp-nav-link.active {
    color: var(--md-sys-color-primary, #0b57d0);
    font-weight: 600;
    background-color: var(--md-sys-color-primary-container, #d3e3fd);
  }
  :global([data-theme='dark']) .vp-nav-link.active {
    color: var(--md-sys-color-on-primary-container, #d3e3fd);
    background-color: var(--md-sys-color-primary-container, #0842a0);
  }

  /* Dividers */
  .vp-nav-divider {
    width: 1px;
    height: 1.25rem;
    background-color: var(--md-sys-color-outline-variant, #e0e3e7);
    margin: 0 0.15rem;
    flex-shrink: 0;
  }
  :global([data-theme='dark']) .vp-nav-divider {
    background-color: var(--md-sys-color-outline-variant, #3c4043);
  }

  /* 34px Circular Action Buttons (Theme Switcher & GitHub) */
  .vp-theme-switch-container {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem; /* 34px */
    height: 2.125rem;
    flex-shrink: 0;
  }
  .vp-theme-btn,
  .vp-nav-social-btn,
  .vp-hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    min-width: 2.125rem;
    min-height: 2.125rem;
    padding: 0;
    margin: 0;
    border-radius: var(--md-shape-corner-full, 9999px);
    border: none;
    background: transparent;
    color: var(--md-sys-color-on-surface-variant, #444746);
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }
  :global([data-theme='dark']) .vp-theme-btn,
  :global([data-theme='dark']) .vp-nav-social-btn,
  :global([data-theme='dark']) .vp-hamburger {
    color: var(--md-sys-color-on-surface-variant, #c4c7c5);
  }
  .vp-theme-btn:hover,
  .vp-nav-social-btn:hover,
  .vp-hamburger:hover {
    background-color: var(--md-sys-color-surface-container-highest, #dadce0);
    color: var(--md-sys-color-on-surface, #1f1f1f);
  }
  :global([data-theme='dark']) .vp-theme-btn:hover,
  :global([data-theme='dark']) .vp-nav-social-btn:hover,
  :global([data-theme='dark']) .vp-hamburger:hover {
    background-color: var(--md-sys-color-surface-container-highest, #333537);
    color: var(--md-sys-color-on-surface, #e3e3e3);
  }

  .theme-icon {
    width: 20px;
    height: 20px;
    display: none;
  }
  .sun-icon {
    display: block;
  }
  :global([data-theme='dark']) .sun-icon {
    display: none;
  }
  :global([data-theme='dark']) .moon-icon {
    display: block;
  }

  .social-icon {
    width: 20px;
    height: 20px;
  }

  /* Mobile Hamburger */
  .vp-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }
  .hamburger-bar {
    width: 1.1rem;
    height: 1.5px;
    background-color: var(--md-sys-color-on-surface, #1f1f1f);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  :global([data-theme='dark']) .hamburger-bar {
    background-color: var(--md-sys-color-on-surface, #e3e3e3);
  }

  /* Mobile Menu */
  .vp-mobile-menu {
    display: none;
    border-top: 1px solid var(--md-sys-color-outline-variant, #e0e3e7);
    background-color: var(--md-sys-color-surface, #ffffff);
    padding: 0.75rem 1.25rem 1rem;
  }
  :global([data-theme='dark']) .vp-mobile-menu {
    border-top-color: var(--md-sys-color-outline-variant, #3c4043);
    background-color: var(--md-sys-color-surface-container-low, #131314);
  }
  .vp-mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .vp-mobile-link {
    display: flex;
    align-items: center;
    padding: 0.6rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface, #1f1f1f);
    text-decoration: none;
    border-radius: 8px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  :global([data-theme='dark']) .vp-mobile-link {
    color: var(--md-sys-color-on-surface, #e3e3e3);
  }
  .vp-mobile-link:hover {
    color: var(--md-sys-color-primary, #0b57d0);
    background-color: var(--md-sys-color-surface-container-high, #e8eaed);
  }
  :global([data-theme='dark']) .vp-mobile-link:hover {
    color: var(--md-sys-color-primary, #a8c7fa);
    background-color: var(--md-sys-color-surface-container-high, #28292a);
  }

  @media (max-width: 820px) {
    .vp-nav-links,
    .vp-nav-divider {
      display: none;
    }
    .vp-search-wrap {
      max-width: 12rem;
    }
    .search-text,
    .search-kbd {
      display: none;
    }
    .vp-hamburger {
      display: flex;
    }
    .vp-mobile-menu.is-open {
      display: block;
    }
  }
</style>

<script>
  const storageKey = 'starlight-theme';
  function initTheme() {
    const themeBtn = document.getElementById('vp-nav-theme-btn');
    if (!themeBtn) return;

    function getTheme() {
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored === 'dark' || stored === 'light') return stored;
      } catch {}
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function setTheme(theme: string) {
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem(storageKey, theme);
      } catch {}
      window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme } }));
    }

    document.documentElement.dataset.theme = getTheme();

    // Avoid duplicate event listener
    if (!(themeBtn as any).__bound) {
      (themeBtn as any).__bound = true;
      themeBtn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        setTheme(next);
      });
    }
  }

  function initMobileMenu() {
    const btn = document.getElementById('vp-nav-hamburger');
    const menu = document.getElementById('vp-mobile-menu');
    if (!btn || !menu) return;

    if (!(btn as any).__bound) {
      (btn as any).__bound = true;
      btn.addEventListener('click', () => {
        const isOpen = menu.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(isOpen));
      });
    }
  }

  function initSearchShortcut() {
    if ((window as any).__searchShortcutBound) return;
    (window as any).__searchShortcutBound = true;
    window.addEventListener('keydown', (e) => {
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA')) {
        e.preventDefault();
        window.location.href = '/library/?focus=search';
      }
    });
  }

  initTheme();
  initMobileMenu();
  initSearchShortcut();
  document.addEventListener('astro:after-swap', () => {
    initTheme();
    initMobileMenu();
  });
</script>
