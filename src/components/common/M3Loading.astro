---
interface Props {

  variant?: 'default' | 'contained' | 'linear';

  size?: 'compact' | 'small' | 'medium' | 'large';

  layout?: 'inline' | 'block' | 'overlay';

  mode?: 'auto' | 'morph' | 'native';

  label?: string;

  sublabel?: string;

  value?: number;

  class?: string;

  id?: string;

  accessibility?: boolean;
}

const {
  variant = 'default',
  size = 'small',
  layout = 'inline',
  mode = 'auto',
  label,
  sublabel,
  value = -1,
  class: className = '',
  id,
  accessibility = true,
} = Astro.props;

const SIZE_PX_MAP: Record<string, number> = {
  compact: 20,
  small: 28,
  medium: 40,
  large: 56,
};

const CONTAINED_PX_MAP: Record<string, number> = {
  compact: 26,
  small: 36,
  medium: 48,
  large: 64,
};

const isContained = variant === 'contained';
const targetPx = isContained ? (CONTAINED_PX_MAP[size] || 36) : (SIZE_PX_MAP[size] || 28);
const isLinear = variant === 'linear';
const isDeterminate = isLinear && typeof value === 'number' && value >= 0 && value <= 1;

const classes = [
  'm3-loading-root',
  `m3-loading-${variant}`,
  `m3-loading-size-${size}`,
  `m3-loading-layout-${layout}`,
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div
  class={classes}
  id={id}
  role={accessibility ? 'status' : undefined}
  aria-live={accessibility ? 'polite' : undefined}
>
  {
    isLinear ? (
      isDeterminate ? (
        <md-linear-progress value={value} class="m3-loading-linear-core" />
      ) : (
        <md-linear-progress indeterminate class="m3-loading-linear-core" />
      )
    ) : (
      <m3-loading-indicator
        size={targetPx}
        variant={variant}
        mode={mode}
        class="m3-loading-indicator-core"
      >
        <md-circular-progress
          indeterminate
          slot="fallback"
          style={`--md-circular-progress-size: ${targetPx}px; width: ${targetPx}px; height: ${targetPx}px;`}
        />
      </m3-loading-indicator>
    )
  }

  {
    (label || sublabel) && (
      <div class="m3-loading-text-group">
        {label && <span class="m3-loading-label">{label}</span>}
        {sublabel && <span class="m3-loading-sublabel">{sublabel}</span>}
      </div>
    )
  }
</div>

<script>import '@material/web/progress/circular-progress.js';
  import '@material/web/progress/linear-progress.js';
  import './m3-loading-indicator';
</script>
