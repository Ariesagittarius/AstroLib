---
/**
 * M3Loading.astro: Official Material 3 Loading Indicator Component
 * ============================================================================
 * 严格遵照 Google Material 3 官方规范（m3.material.io）:
 * 1. 支持 M3 灵动形变动画（基于 @alerix/m3-loading-indicator）
 * 2. 兼容并保留 Google 官方原生组件（@material/web 的 <md-circular-progress> 与 <md-linear-progress>）
 * 3. 尊重用户偏好（支持全局通过 feature-toggles 在形变实现与官方原生实现之间无感切换）
 * 4. 供全站所有 Astro 页面与组件在 SSR 阶段或声明式静态骨架中直接插入
 * ============================================================================
 */

interface Props {
  /** 呈现形态：'default' (无底盘悬浮态) | 'contained' (M3 带圆形底盘) | 'linear' (水平进度条) */
  variant?: 'default' | 'contained' | 'linear';
  /** 尺寸档位：'compact' | 'small' | 'medium' | 'large' */
  size?: 'compact' | 'small' | 'medium' | 'large';
  /** 排版布局：'inline' (行内横向排列) | 'block' (居中纵向堆叠) | 'overlay' (全容器遮罩居中) */
  layout?: 'inline' | 'block' | 'overlay';
  /** 指示器渲染内核：'auto' (根据读者全局偏好自动适配) | 'morph' (强制灵动形变) | 'native' (强制官方原生) */
  mode?: 'auto' | 'morph' | 'native';
  /** 附带主提示文案 */
  label?: string;
  /** 附带副标题说明文案 */
  sublabel?: string;
  /** 当 variant='linear' 时确定进度 (0 ~ 1)，缺省或 -1 时为 indeterminate */
  value?: number;
  /** 附加 CSS class 类名 */
  class?: string;
  /** 根节点 ID */
  id?: string;
  /** 是否开启无障碍实时朗读 (aria-live / role="status")，默认 true */
  accessibility?: boolean;
}

const {
  variant = 'default',
  size = 'small',
  layout = 'inline',
  mode = 'auto',
  label,
  sublabel,
  value = -1,
  class: className = '',
  id,
  accessibility = true,
} = Astro.props;

const SIZE_PX_MAP: Record<string, number> = {
  compact: 20,
  small: 28,
  medium: 40,
  large: 56,
};

const CONTAINED_PX_MAP: Record<string, number> = {
  compact: 26,
  small: 36,
  medium: 48,
  large: 64,
};

const isContained = variant === 'contained';
const targetPx = isContained ? (CONTAINED_PX_MAP[size] || 36) : (SIZE_PX_MAP[size] || 28);
const isLinear = variant === 'linear';
const isDeterminate = isLinear && typeof value === 'number' && value >= 0 && value <= 1;

const classes = [
  'm3-loading-root',
  `m3-loading-${variant}`,
  `m3-loading-size-${size}`,
  `m3-loading-layout-${layout}`,
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div
  class={classes}
  id={id}
  role={accessibility ? 'status' : undefined}
  aria-live={accessibility ? 'polite' : undefined}
>
  {
    isLinear ? (
      isDeterminate ? (
        <md-linear-progress value={value} class="m3-loading-linear-core" />
      ) : (
        <md-linear-progress indeterminate class="m3-loading-linear-core" />
      )
    ) : (
      <m3-loading-indicator
        size={targetPx}
        variant={variant}
        mode={mode}
        class="m3-loading-indicator-core"
      >
        <md-circular-progress
          indeterminate
          slot="fallback"
          style={`--md-circular-progress-size: ${targetPx}px; width: ${targetPx}px; height: ${targetPx}px;`}
        />
      </m3-loading-indicator>
    )
  }

  {
    (label || sublabel) && (
      <div class="m3-loading-text-group">
        {label && <span class="m3-loading-label">{label}</span>}
        {sublabel && <span class="m3-loading-sublabel">{sublabel}</span>}
      </div>
    )
  }
</div>

<script>
  import '@material/web/progress/circular-progress.js';
  import '@material/web/progress/linear-progress.js';
  import './m3-loading-indicator';
</script>
