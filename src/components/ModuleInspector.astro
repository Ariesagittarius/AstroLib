---
import { features } from '../config/features.config.mjs';
const isDev = import.meta.env.DEV;
---

{
  features.inspector.enabled && (
    <div id="dsh-inspector-root" class="insp-root" data-is-dev={isDev ? 'true' : 'false'} aria-label="书籍模块索引与巡检速查工具">
      <div class="insp-backdrop"></div>
      <aside class="insp-panel" role="dialog" aria-label="模块巡检抽屉面板">

        <header class="insp-header">
          <div class="insp-header-left">
            <div class="insp-header-title-box">
              <div class="insp-header-kicker-row">
                <span class="insp-header-kicker">模块索引</span>
                {isDev && <span class="insp-header-dev-tag" title="开发环境巡检模式">DEV</span>}
              </div>
              <h2 class="insp-header-title">书籍模块索引</h2>
              <div class="insp-book-select-wrap">
                <select class="insp-book-select" title="切换当前索引图书"></select>
              </div>
            </div>
          </div>
          <div class="insp-header-actions">
            <button type="button" class="insp-icon-btn insp-refresh-btn" title="重新扫描全书数据 (刷新)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a9 9 0 1 1-.57-8.38l6.73-6.19" />
              </svg>
            </button>
            <button type="button" class="insp-icon-btn insp-close" title="关闭 (Esc)" aria-label="关闭">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
        </header>

        <div class="insp-toolbar">
          <div class="insp-search-box">
            <svg class="insp-search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5" />
              <path d="M12.5 12.5L17 17" />
            </svg>
            <input type="text" class="insp-search-input" placeholder="搜索模块、定义、例题、定理..." autocomplete="off" />
            <button type="button" class="insp-search-clear" title="清空检索" aria-label="清空检索">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="12" y1="4" x2="4" y2="12" />
                <line x1="4" y1="4" x2="12" y2="12" />
              </svg>
            </button>
          </div>
          <div class="insp-chapter-filter-box">
            <select class="insp-chapter-select" title="筛选所属章节"></select>
          </div>
        </div>

        <nav class="insp-tabs" aria-label="巡检视图切换">
          <button type="button" class="insp-tab active" data-tab="all">
            <span>全量索引</span>
            <span class="insp-tab-count">0</span>
          </button>
          {isDev && (
            <button type="button" class="insp-tab insp-tab-dev" data-tab="same_chapter_dups" title="同一章节内出现的重名模块（仅开发模式）">
              <span>同章冲突</span>
              <span class="insp-tab-count">0</span>
            </button>
          )}
          <button type="button" class="insp-tab" data-tab="all_dups">
            <span>跨章聚合</span>
            <span class="insp-tab-count">0</span>
          </button>
          {isDev && (
            <button type="button" class="insp-tab insp-tab-dev" data-tab="suspicious" title="OCR切分异常与清洗审查（仅开发模式）">
              <span>结构审查</span>
              <span class="insp-tab-count">0</span>
            </button>
          )}
          {isDev && (
            <button type="button" class="insp-tab insp-tab-dev" data-tab="formula_errors" title="公式语法异常排查（仅开发模式）">
              <span>公式异常</span>
              <span class="insp-tab-count">0</span>
            </button>
          )}
        </nav>

        <div class="insp-kind-chips-wrap">
          <div class="insp-kind-chips"></div>
        </div>

        <main class="insp-body">
          <div class="insp-list">
            <div class="insp-empty-state">
              <div class="insp-loading-spinner" aria-hidden="true"></div>
              <div class="insp-empty-title">正在扫描全书模块结构...</div>
              <div class="insp-empty-desc">解析章节卡片并构建索引</div>
            </div>
          </div>
        </main>

        <footer class="insp-footer">
          <div class="insp-footer-tip">
            <span class="insp-tip-desktop">快捷键：<kbd>Alt+M</kbd> 展开/收起 · <kbd>Esc</kbd> 关闭</span>
            <span class="insp-tip-mobile">点击条目即可快速定位直达正文卡片</span>
          </div>
          <span class="insp-footer-tag">AstroLib Academic</span>
        </footer>
      </aside>
    </div>
  )
}

<style is:global>:root {
    --insp-brand: var(--sl-color-accent, #1e3a8a);
    --insp-brand-hover: var(--sl-color-accent-high, #1e40af);
    --insp-brand-soft: var(--sl-color-accent-low, rgba(30, 58, 138, 0.06));
    --insp-bg: var(--sl-color-bg, #ffffff);
    --insp-bg-soft: var(--sl-color-gray-6, #f8f9fa);
    --insp-bg-mute: var(--sl-color-gray-5, #e8eaed);
    --insp-text-1: var(--sl-color-white, #1a1a1a);
    --insp-text-2: var(--sl-color-gray-2, #555960);
    --insp-text-3: var(--sl-color-gray-3, #888c94);
    --insp-border: var(--sl-color-hairline, #e8eaed);
    --insp-font-mono: var(--sl-font-mono, ui-monospace, 'Menlo', 'Monaco', monospace);
  }

  html[data-theme='dark'] {
    --insp-brand: var(--sl-color-accent, #93b4ff);
    --insp-brand-hover: var(--sl-color-accent-high, #b8ceff);
    --insp-brand-soft: var(--sl-color-accent-low, rgba(147, 180, 255, 0.1));
    --insp-bg: var(--sl-color-bg, #17171a);
    --insp-bg-soft: var(--sl-color-bg-inline-code, #202126);
    --insp-bg-mute: var(--sl-color-hairline, #28282c);
    --insp-text-1: var(--sl-color-white, #dfdfd6);
    --insp-text-2: var(--sl-color-gray-2, #98989f);
    --insp-text-3: var(--sl-color-gray-3, #6e6e76);
    --insp-border: var(--sl-color-hairline, #28282c);
  }

  .insp-root {
    position: fixed;
    inset: 0;
    z-index: 2147483002;
    pointer-events: none;
    font-family: var(--sl-font, system-ui, -apple-system, 'Segoe UI', 'PingFang SC', sans-serif);
  }
  .insp-root * {
    box-sizing: border-box;
  }

  .insp-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.16);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    z-index: 2147483002;
  }
  html[data-theme='dark'] .insp-backdrop {
    background: rgba(0, 0, 0, 0.36);
  }
  .insp-open .insp-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .insp-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    height: 100vh;
    height: 100dvh;
    width: min(92vw, 410px);
    background: var(--insp-bg);
    color: var(--insp-text-1);
    border-left: 1px solid var(--insp-border);
    box-shadow: -2px 0 16px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 2147483003;
  }
  html[data-theme='dark'] .insp-panel {
    box-shadow: -2px 0 20px rgba(0, 0, 0, 0.35);
  }
  .insp-open .insp-panel {
    transform: translateX(0);
    pointer-events: auto;
  }

  .insp-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 13px 16px 11px;
    border-bottom: 1px solid var(--insp-border);
    background: var(--insp-bg);
    gap: 10px;
    flex-shrink: 0;
  }
  .insp-header-left {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .insp-header-title-box {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .insp-header-kicker-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .insp-header-kicker {
    font-size: 11px;
    font-weight: 500;
    color: var(--insp-text-3);
    letter-spacing: 0.04em;
    line-height: 1.3;
  }
  .insp-header-dev-tag {
    font-size: 9px;
    font-family: var(--insp-font-mono);
    color: var(--insp-text-3);
    border: 1px solid var(--insp-border);
    padding: 0 3px;
    border-radius: 2px;
    line-height: 1.2;
    opacity: 0.7;
  }
  .insp-header-title {
    font-size: 13.5px;
    font-weight: 600;
    margin: 2px 0 3px;
    line-height: 1.25;
    color: var(--insp-text-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
  }
  .insp-book-select-wrap {
    display: flex;
    align-items: center;
    margin-top: 1px;
  }
  .insp-book-select {
    font-size: 11px;
    color: var(--insp-text-2);
    background: var(--insp-bg-soft);
    border: 1px solid var(--insp-border);
    border-radius: 4px;
    padding: 2px 6px;
    cursor: pointer;
    max-width: 100%;
    transition: border-color 0.15s;
  }
  .insp-book-select:focus {
    outline: none;
    border-color: var(--insp-brand);
  }
  .insp-header-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .insp-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: var(--insp-text-3);
    cursor: pointer;
    transition: background-color 0.12s, color 0.12s;
  }
  .insp-icon-btn:hover {
    background: var(--insp-bg-soft);
    color: var(--insp-text-1);
  }
  .insp-icon-btn svg {
    width: 14px;
    height: 14px;
  }
  .insp-refresh-btn.spinning svg {
    animation: insp-spin 0.75s linear infinite;
  }
  @keyframes insp-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .insp-toolbar {
    padding: 8px 16px;
    display: flex;
    gap: 8px;
    border-bottom: 1px solid var(--insp-border);
    background: var(--insp-bg);
    flex-shrink: 0;
  }
  .insp-search-box {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }
  .insp-search-icon {
    position: absolute;
    left: 8px;
    width: 13px;
    height: 13px;
    color: var(--insp-text-3);
    pointer-events: none;
  }
  .insp-search-input {
    width: 100%;
    height: 30px;
    padding: 0 26px 0 28px;
    font-size: 11.5px;
    border: 1px solid var(--insp-border);
    border-radius: 4px;
    background: var(--insp-bg-soft);
    color: var(--insp-text-1);
    transition: border-color 0.15s, background-color 0.15s;
  }
  .insp-search-input:focus {
    outline: none;
    border-color: var(--insp-brand);
    background: var(--insp-bg);
  }
  .insp-search-clear {
    position: absolute;
    right: 5px;
    width: 18px;
    height: 18px;
    border: none;
    background: transparent;
    color: var(--insp-text-3);
    cursor: pointer;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    opacity: 0;
    transform: scale(0.7);
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .insp-search-clear.visible {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
  .insp-search-clear svg {
    width: 11px;
    height: 11px;
  }
  .insp-search-clear:hover {
    color: var(--insp-text-1);
  }
  .insp-chapter-filter-box {
    width: 120px;
    flex-shrink: 0;
  }
  .insp-chapter-select {
    width: 100%;
    height: 30px;
    font-size: 11px;
    padding: 0 5px;
    border: 1px solid var(--insp-border);
    border-radius: 4px;
    background: var(--insp-bg-soft);
    color: var(--insp-text-2);
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .insp-chapter-select:focus {
    outline: none;
    border-color: var(--insp-brand);
  }

  .insp-tabs {
    display: flex;
    padding: 0 16px;
    gap: 12px;
    border-bottom: 1px solid var(--insp-border);
    background: var(--insp-bg);
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .insp-tabs::-webkit-scrollbar {
    display: none;
  }
  .insp-tab {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 7px 0 6px;
    font-size: 11.5px;
    font-weight: 500;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--insp-text-2);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.12s, border-color 0.12s;
  }
  .insp-tab:hover {
    color: var(--insp-text-1);
  }
  .insp-tab.active {
    color: var(--insp-text-1);
    border-bottom-color: var(--insp-brand);
    font-weight: 600;
  }
  .insp-tab-count {
    font-size: 10.5px;
    font-family: var(--insp-font-mono);
    color: var(--insp-text-3);
    background: transparent;
    border: none;
    padding: 0;
    font-weight: normal;
  }
  .insp-tab.active .insp-tab-count {
    color: var(--insp-brand);
    font-weight: 600;
  }
  .insp-tab-count.danger {
    color: #dc2626 !important;
  }

  .insp-kind-chips-wrap {
    padding: 6px 16px;
    border-bottom: 1px solid var(--insp-border);
    flex-shrink: 0;
    background: var(--insp-bg);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .insp-kind-chips-wrap::-webkit-scrollbar {
    display: none;
  }
  .insp-kind-chips {
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }
  .insp-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 3px;
    border: none;
    background: transparent;
    color: var(--insp-text-2);
    cursor: pointer;
    transition: color 0.12s, background-color 0.12s;
  }
  .insp-chip:hover {
    color: var(--insp-text-1);
    background: var(--insp-bg-soft);
  }
  .insp-chip.active {
    background: var(--insp-brand-soft);
    color: var(--insp-brand);
    font-weight: 600;
  }
  .insp-chip.insp-chip-empty {
    opacity: 0.35;
  }
  .insp-chip-count {
    font-size: 9.5px;
    font-family: var(--insp-font-mono);
    color: var(--insp-text-3);
    opacity: 0.85;
  }

  .insp-body {
    flex: 1;
    overflow-y: auto;
    padding: 0;
    background: var(--insp-bg);
  }
  .insp-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .insp-items-count-hint {
    font-size: 10.5px;
    color: var(--insp-text-3);
    padding: 6px 16px;
    border-bottom: 1px solid var(--insp-border);
    background: var(--insp-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .insp-count-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
  }
  .insp-count-highlight {
    color: var(--insp-text-1);
  }
  .insp-status-badge {
    font-size: 10.5px;
    color: var(--insp-text-2);
    background: transparent;
    border: none;
    padding: 0;
  }
  .insp-count-book-tag {
    display: none;
  }

  .insp-item-row {
    background: var(--insp-bg);
    border: none;
    border-bottom: 1px solid var(--insp-border);
    border-left: 2px solid transparent;
    padding: 11px 16px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    cursor: pointer;
    transition: background-color 0.12s ease, border-left-color 0.12s ease;
    content-visibility: auto;
    contain-intrinsic-size: 0 85px;
  }
  .insp-item-row:hover {
    background: var(--insp-bg-soft);
  }

  .insp-item-row.is-located {
    background: var(--insp-brand-soft);
    border-left-color: var(--insp-brand);
  }

  .insp-search-match {
    background: var(--insp-brand-soft);
    color: var(--insp-brand);
    border-radius: 2px;
    padding: 0 1.5px;
    font-weight: 600;
  }

  .insp-item-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }
  .insp-item-heading {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    flex: 1;
  }
  .insp-item-kicker {
    font-size: 11px;
    font-weight: 600;
    color: var(--insp-text-2);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .insp-item-row.is-located .insp-item-kicker {
    color: var(--insp-brand);
  }
  .insp-item-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--insp-text-1);
    line-height: 1.35;
    margin: 0;
    word-break: break-word;
  }

  .insp-item-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    padding-top: 1px;
  }
  .insp-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 10.5px;
    padding: 2px 5px;
    border-radius: 3px;
    border: none;
    background: transparent;
    color: var(--insp-text-3);
    cursor: pointer;
    transition: color 0.12s, background-color 0.12s;
  }
  .insp-action-btn:hover {
    color: var(--insp-text-1);
    background: var(--insp-bg-soft);
  }
  .insp-btn-svg {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }
  .insp-jump-btn, .insp-action-jump {
    color: var(--insp-text-2) !important;
    background: transparent !important;
    border: none !important;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 6px;
  }
  .insp-jump-btn:hover, .insp-action-jump:hover {
    color: var(--insp-brand) !important;
    background: var(--insp-brand-soft) !important;
  }
  .insp-item-row.is-located .insp-jump-btn,
  .insp-item-row.is-located .insp-action-jump {
    color: var(--insp-brand) !important;
    font-weight: 600;
  }

  .insp-item-snippet {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--insp-text-2);
    background: transparent;
    padding: 0;
    border-radius: 0;
    border-left: none;
    margin: 2px 0 0;
    white-space: pre-wrap;
    word-break: break-all;
    max-height: 50px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .insp-item-meta {
    display: flex;
    align-items: center;
    font-size: 10.5px;
    color: var(--insp-text-3);
    gap: 4px;
    margin-top: 2px;
  }
  .insp-meta-chapter {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 65%;
  }
  .insp-meta-dot {
    opacity: 0.5;
  }
  .insp-meta-line {
    font-family: var(--insp-font-mono);
    white-space: nowrap;
  }

  .insp-item-reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 1px;
  }
  .insp-reason-tag {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 10px;
    color: #dc2626;
    background: rgba(220, 38, 38, 0.05);
    padding: 0 4px;
    border-radius: 2px;
  }
  .insp-reason-svg {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .insp-dup-group {
    border-bottom: 1px solid var(--insp-border);
  }
  .insp-dup-group-head {
    padding: 7px 16px;
    background: var(--insp-bg-soft);
