---
const { title } = Astro.props;
const cleanId = title ? encodeURIComponent(title.trim().replace(/\s+/g, '-')) : undefined;
---

<div class="method-card toc-chunk" data-title={title} id={cleanId}>
  <div class="card-header">🛠️ {title}</div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .method-card {
    border: 1px solid #0d9488;
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow: hidden;
  }
  .card-header {
    background-color: #f0fdfa;
    color: #115e59;
    padding: 0.6rem 1rem;
    font-weight: bold;
    border-bottom: 1px solid #0d9488;
  }
  .card-body {
    padding: 1rem;
  }
</style>