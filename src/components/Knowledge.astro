---
import { renderTitleHtml } from '../utils/render-title.mjs';
import { srcAttrs } from '../utils/src-attrs.mjs';
const { title } = Astro.props;
const cleanId = title ? title.trim().replace(/\s+/g, '-') : undefined;

const t = title || '';
let iconKind = 'knowledge';
if (/定理/i.test(t)) {
  iconKind = 'theorem';
} else if (/推论/i.test(t)) {
  iconKind = 'corollary';
} else if (/引理/i.test(t)) {
  iconKind = 'lemma';
} else if (/公理/i.test(t)) {
  iconKind = 'axiom';
} else if (/命题/i.test(t)) {
  iconKind = 'proposition';
} else if (/定义|概念/i.test(t)) {
  iconKind = 'definition';
} else if (/性质/i.test(t)) {
  iconKind = 'property';
} else if (/法则|定律/i.test(t)) {
  iconKind = 'law';
} else if (/公式/i.test(t)) {
  iconKind = 'formula';
} else if (/准则|原理/i.test(t)) {
  iconKind = 'criterion';
} else if (/知识点/i.test(t)) {
  iconKind = 'point';
} else if (/结论|总结/i.test(t)) {
  iconKind = 'conclusion';
}
---

<div class="knowledge-card toc-chunk" data-title={title} data-icon-kind={iconKind} id={cleanId} {...srcAttrs(Astro.props)}>
  <div class="card-header">
    <span class="card-mdicon" aria-hidden="true">
      {iconKind === 'theorem' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M18 4H6v2l6.5 6L6 18v2h12v-3h-7l5-5-5-5h7z" />
        </svg>
      )}
      {iconKind === 'corollary' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M16.01 11H4v2h12.01v3L20 12l-3.99-4z" />
        </svg>
      )}
      {iconKind === 'definition' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm-1 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z" />
        </svg>
      )}
      {iconKind === 'property' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 2l-5.5 9h11z" />
          <circle cx="17.5" cy="17.5" r="4.5" />
          <path d="M3 13.5h8v8H3z" />
        </svg>
      )}
      {iconKind === 'lemma' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z" />
        </svg>
      )}
      {iconKind === 'axiom' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 7.77L18.39 18H5.61L12 7.77M12 4L2 20h20L12 4z" />
        </svg>
      )}
      {iconKind === 'proposition' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M16 9V4l1 0c.55 0 1-.45 1-1v0c0-.55-.45-1-1-1H7c-.55 0-1 .45-1 1v0c0 .55.45 1 1 1l1 0v5c0 1.66-1.34 3-3 3h0v2h5.97v7l1 1 1-1v-7H19v-2h0c-1.66 0-3-1.34-3-3z" />
        </svg>
      )}
      {iconKind === 'law' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M13 7.83c.85-.3 1.53-.98 1.83-1.83H18l-3 7c0 1.66 1.57 3 3.5 3s3.5-1.34 3.5-3l-3-7h2V4h-6.17C14.42 2.83 13.31 2 12 2S9.58 2.83 9.17 4L3 4v2h2l-3 7c0 1.66 1.57 3 3.5 3S9 14.66 9 13L6 6h3.17c.3.85.98 1.53 1.83 1.83V19H2v2h20v-2h-9V7.83zM20.37 13h-3.74l1.87-4.36L20.37 13zM7.37 13H3.63L5.5 8.64L7.37 13zM12 6c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" />
        </svg>
      )}
      {iconKind === 'formula' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M18 4H6v2l6.5 6L6 18v2h12v-3h-7l5-5-5-5h7z" />
        </svg>
      )}
      {iconKind === 'criterion' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm-7 7H3v4c0 1.1.9 2 2 2h4v-2H5v-4zM5 5h4V3H5c-1.1 0-2 .9-2 2v4h2V5zm14-2h-4v2h4v4h2V5c0-1.1-.9-2-2-2zm0 16h-4v2h4c1.1 0 2-.9 2-2v-4h-2v4z" />
        </svg>
      )}
      {iconKind === 'point' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74C19 5.14 15.86 2 12 2zm2 11.7V16h-4v-2.3C8.48 12.63 7 11.53 7 9c0-2.76 2.24-5 5-5s5 2.24 5 5c0 2.49-1.49 3.65-3 4.7z" />
        </svg>
      )}
      {iconKind === 'conclusion' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M15 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V9l-6-6zM8 17c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm0-4c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm0-4c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm6 1V4.5l5.5 5.5H14z" />
        </svg>
      )}
      {iconKind === 'knowledge' && (
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 2l-5.5 9h11z" />
          <circle cx="17.5" cy="17.5" r="4.5" />
          <path d="M3 13.5h8v8H3z" />
        </svg>
      )}
    </span>
    <span class="card-title-text" set:html={renderTitleHtml(title)}></span>
  </div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .knowledge-card {
    margin: 1.75rem 0 1.5rem;
    border-radius: var(--card-border-radius, 12px);
  }
  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.02rem;
    font-weight: 650;
    font-family: var(--font-heading, var(--academic-font-heading, sans-serif));
    letter-spacing: 0.01em;
  }
  .card-mdicon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .card-body {
    line-height: 1.8;
  }
</style>