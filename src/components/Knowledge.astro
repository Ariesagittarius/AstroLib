---
const { title } = Astro.props;
const cleanId = title ? encodeURIComponent(title.trim().replace(/\s+/g, '-')) : undefined;
---

<div class="knowledge-card toc-chunk" data-title={title} id={cleanId}>
  <div class="card-header">💡 {title}</div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .knowledge-card {
    border-left: 4px solid #3b82f6;
    background-color: #eff6ff;
    border-radius: 0 8px 8px 0;
    margin: 1.5rem 0;
    padding: 1rem;
  }
  .card-header {
    font-weight: bold;
    color: #1e3a8a;
    margin-bottom: 0.5rem;
  }
  .card-body {
    padding: 0;
  }
</style>