---
import { listTypographyPresets } from '../../publishing/typography/presets/index.ts';
import '../../styles/components/chapter-export.css';

const typographyPresets = listTypographyPresets();

function cleanPresetName(name: string): string {
  return name.replace(/\s*\([^)]*\)/g, '').trim();
}
---

<md-dialog id="chapter-export-modal" class="chapter-export-m3-dialog" aria-labelledby="chapter-export-title" aria-hidden="true">

  <div slot="headline" class="export-headline-bar">
    <div class="export-headline-text">
      <h2 id="chapter-export-title" class="export-headline-title">章节导出</h2>
      <span id="export-chapter-name" class="export-headline-subtitle">加载中...</span>
    </div>
    <md-icon-button type="button" data-close-export-modal aria-label="关闭" class="export-close-btn">
      <md-icon>close</md-icon>
    </md-icon-button>
  </div>

  <form slot="content" id="chapter-export-form" method="dialog" class="chapter-export-dialog export-form">

    <div class="setting-row">
      <label class="row-label" for="chapter-export-format">导出格式</label>
      <div class="row-control">
        <md-outlined-select id="chapter-export-format" aria-label="导出格式">
          <md-select-option value="print" selected>
            <div slot="headline">网页打印 / 另存为 PDF</div>
          </md-select-option>
          <md-select-option value="pdf-cloud">
            <div slot="headline">云端编译 PDF (GitHub Actions)</div>
          </md-select-option>
          <md-select-option value="pdf-local">
            <div slot="headline">本地编译 PDF (XeLaTeX)</div>
          </md-select-option>
          <md-select-option value="tex">
            <div slot="headline">LaTeX 源码 (.tex)</div>
          </md-select-option>
          <md-select-option value="zip">
            <div slot="headline">离线编译包 (.zip)</div>
          </md-select-option>
        </md-outlined-select>
      </div>
    </div>

    <div class="setting-row">
      <label class="row-label" for="chapter-paper-size">纸张尺寸</label>
      <div class="row-control">
        <md-outlined-select id="chapter-paper-size" aria-label="纸张尺寸">
          <md-select-option value="a4" selected>
            <div slot="headline">A4</div>
          </md-select-option>
          <md-select-option value="b5">
            <div slot="headline">B5</div>
          </md-select-option>
        </md-outlined-select>
      </div>
    </div>

    <div class="setting-row">
      <label class="row-label" for="chapter-typography">排版风格</label>
      <div class="row-control">
        <md-outlined-select id="chapter-typography" aria-label="排版风格">
          {typographyPresets.map((preset) => (
            <md-select-option value={preset.id} selected={preset.id === 'scholarly'}>
              <div slot="headline">{cleanPresetName(preset.name)}</div>
            </md-select-option>
          ))}
        </md-outlined-select>
      </div>
    </div>

    <div class="setting-row">
      <label class="row-label" for="chapter-font-size">字号</label>
      <div class="row-control">
        <md-outlined-select id="chapter-font-size" aria-label="字号">
          <md-select-option value="10.5">
            <div slot="headline">10.5 pt</div>
          </md-select-option>
          <md-select-option value="11" selected>
            <div slot="headline">11 pt</div>
          </md-select-option>
          <md-select-option value="12">
            <div slot="headline">12 pt</div>
          </md-select-option>
        </md-outlined-select>
      </div>
    </div>

    <div class="setting-row">
      <label class="row-label" for="chapter-sidenote-mode">注记排版</label>
      <div class="row-control">
        <md-outlined-select id="chapter-sidenote-mode" aria-label="注记排版">
          <md-select-option value="inline" selected>
            <div slot="headline">正文流式</div>
          </md-select-option>
          <md-select-option value="margin">
            <div slot="headline">边栏侧注</div>
          </md-select-option>
        </md-outlined-select>
      </div>
    </div>

    <div id="cloud-token-row" class="setting-row cloud-token-row" style="display: none;">
      <label class="row-label" for="input-gh-token">访问凭据</label>
      <div class="row-control token-input-group">
        <md-outlined-text-field
          id="input-gh-token"
          type="password"
          placeholder="输入 GitHub PAT 凭据 (ghp_...)"
          aria-label="GitHub PAT 凭据"
        ></md-outlined-text-field>
        <md-filled-tonal-button type="button" id="btn-save-token">
          保存
        </md-filled-tonal-button>
      </div>
    </div>

    <div id="export-progress-container" class="export-progress-box" style="display: none;">
      <md-linear-progress id="export-linear-progress" indeterminate></md-linear-progress>
      <span id="export-status-text" class="export-status-msg">准备导出数据...</span>
    </div>

    <div style="display: none;" aria-hidden="true" data-legacy-bridge>
      <select id="chapter-cjk-font">
        <option value="default">default</option>
        <option value="sourcehan" selected>sourcehan</option>
      </select>
      <select id="chapter-math-font">
        <option value="typst">typst</option>
        <option value="modern">modern</option>
        <option value="times">times</option>
        <option value="pagella">pagella</option>
      </select>
      <button type="button" id="btn-export-tex"></button>
      <button type="button" id="btn-export-zip"></button>
      <button type="button" id="btn-export-pdf"></button>
      <button type="button" id="btn-export-cloud-pdf"></button>
    </div>
  </form>

  <div slot="actions" class="export-actions">
    <md-outlined-button type="button" data-close-export-modal>取消</md-outlined-button>
    <md-filled-button type="button" id="btn-main-export">
      <md-icon slot="icon">download</md-icon>
      导出
    </md-filled-button>
  </div>
</md-dialog>

<script>let exportLoaded = false;
  let exportLoading: Promise<any> | null = null;

  async function activateExportModal() {
    if (!exportLoaded) {
      if (!exportLoading) {
        exportLoading = import('../../publishing/client/chapter-export-controller').then((m) => {
          exportLoaded = true;
          return m;
        });
      }
      const m = await exportLoading;
      m.openChapterExportModal?.();
    } else {
      const modal = document.getElementById('chapter-export-modal') as any;
      if (modal && typeof modal.show === 'function') {
        modal.show();
      }
    }
  }

  document.addEventListener(
    'pointerenter',
    (e) => {
      if (exportLoaded || exportLoading) return;
      const target = e.target instanceof Element ? e.target : (e.target as Node | null)?.parentElement;
      if (target?.closest?.('[data-chapter-export-trigger]')) {
        import('../../publishing/client/chapter-export-controller');
      }
    },
    { capture: true, passive: true }
  );

  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : (e.target as Node | null)?.parentElement;
    if (target?.closest?.('[data-chapter-export-trigger]')) {
      e.preventDefault();
      activateExportModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.altKey && (e.key === 'x' || e.key === 'X')) || (e.ctrlKey && e.altKey && (e.key === 'x' || e.key === 'X'))) {
      e.preventDefault();
      activateExportModal();
    }
  });

  window.addEventListener('chapter-export:open', () => {
    activateExportModal();
  });
</script>
