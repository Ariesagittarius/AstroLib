---
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from './sidebar/CustomSidebarSublist.astro';
import fs from 'node:fs';
import { features } from '../config/features.config.mjs';
import { collections } from '../config/collections.config.mjs';
import { buildTwoTierSidebar } from '../utils/sidebar/sidebar-tree';

const { sidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

const filteredSidebar = buildTwoTierSidebar(sidebar, pathname, collections);
const bookMatch = pathname.match(/\/collections\/([^/]+)\/([^/]+)/);

let epubHref = null;
if (features.epub.enabled && bookMatch) {
  const bookSlug = bookMatch[2];
  const epubPath = `public/epub/${bookSlug}.epub`;
  try {
    if (fs.existsSync(epubPath)) {
      epubHref = `/epub/${bookSlug}.epub`;
    } else if (features.epub?.config?.releaseBaseUrl) {
      epubHref = `${features.epub.config.releaseBaseUrl}/${bookSlug}.epub`;
    }
  } catch {
    if (features.epub?.config?.releaseBaseUrl) {
      epubHref = `${features.epub.config.releaseBaseUrl}/${bookSlug}.epub`;
    }
  }
}
---

<SidebarPersister>
  <SidebarSublist sublist={filteredSidebar} />
</SidebarPersister>
<script is:inline>(() => {
    try {
      const top = parseInt(sessionStorage.getItem('astrolib_sidebar_scroll') || '', 10);
      const scroller = document.getElementById('starlight__sidebar');
      if (scroller && !isNaN(top) && top > 0) {
        scroller.scrollTop = top;
      }
    } catch {}
  })();
</script>

{features.epub.enabled && epubHref && (
  <div class="epub-entry" data-feature="epub">
    <a href={epubHref} download title="下载本书 EPUB（离线阅读）" aria-label="下载本书 EPUB">
      <svg class="epub-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="3" x2="12" y2="15" />
      </svg>
    </a>
  </div>
)}

<style>.epub-entry {
    margin: auto 0.75rem 0.25rem 0;
    display: flex;
    justify-content: flex-end;
    padding-top: 0.5rem;
  }
  .epub-entry a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    color: var(--sl-color-gray-4);
    opacity: 0.85;
    text-decoration: none;
    transition: color 0.15s ease, opacity 0.15s ease, background-color 0.15s ease;
  }
  .epub-entry a .epub-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .epub-entry a:hover,
  .epub-entry a:focus-visible {
    opacity: 1;
    color: var(--sl-color-text-accent);
    background-color: color-mix(in srgb, var(--sl-color-text-accent) 12%, transparent);
  }
</style>

<script>import '../scripts/navigation/recent-reading';
  import '../scripts/navigation/spa-engine';
  import '../scripts/navigation/academic-resource';
</script>
