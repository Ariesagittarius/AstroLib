---
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import fs from 'node:fs';

const { sidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

// 性能优化：侧边栏只保留当前所在图书的子树（首页等非图书页仍显示全部图书）。
// 避免每页都序列化全部 300+ 章节，显著减小 HTML 体积与首屏时间。
let filteredSidebar = sidebar;
const bookMatch = pathname.match(/\/collections\/([^/]+)\/([^/]+)/);
if (bookMatch) {
  const prefix = `/collections/${bookMatch[1]}/${bookMatch[2]}/`;
  const kept = [];
  for (const entry of sidebar) {
    if (entry.type !== 'group') continue;
    const books = (entry.entries || []).filter(
      (b) => b.type === 'group' && (b.entries || []).some(
        (i) => i.type === 'link' && typeof i.href === 'string' && i.href.startsWith(prefix)
      )
    );
    if (books.length > 0) kept.push({ ...entry, entries: books });
  }
  if (kept.length > 0) filteredSidebar = kept;
}

// 当前图书的 EPUB 下载链接（构建期检测 public/epub/<slug>.epub 是否存在）
let epubHref = null;
if (bookMatch) {
  const epubPath = `public/epub/${bookMatch[2]}.epub`;
  try {
    if (fs.existsSync(epubPath)) epubHref = `/epub/${bookMatch[2]}.epub`;
  } catch {
    epubHref = null;
  }
}
---

<!-- 1. 渲染过滤后的侧边栏结构 -->
{epubHref && (
  <div class="epub-download">
    <a href={epubHref} download>📕 下载全书 EPUB</a>
    <span class="epub-hint">离线阅读 · 公式已排版</span>
  </div>
)}
<SidebarPersister>
  <SidebarSublist sublist={filteredSidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .epub-download {
    margin: 0.75rem 0.9rem 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .epub-download a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
    background-color: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 35%, transparent);
    border-radius: 8px;
    padding: 0.45rem 0.7rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .epub-download a:hover {
    background-color: color-mix(in srgb, var(--sl-color-text-accent) 18%, transparent);
  }
  .epub-hint {
    font-size: 0.72rem;
    color: var(--sl-color-gray-4);
    padding-left: 0.2rem;
  }
</style>

<!-- 2. 注入客户端脚本，同时渲染“侧边栏”与“页面大标题 (h1)”中的数学公式 -->
<script>
  // @ts-ignore
  import renderMathInElement from 'katex/dist/contrib/auto-render.mjs';
  // 注意：katex.min.css 已通过 astro.config.mjs 的 customCss 全局引入（且先于
  // custom.css 加载，保证 .tag 流内定位覆盖生效），这里不再重复引入。
    import { initSidebarResizers } from '../scripts/sidebar-resizer';

  // 侧边栏公式只渲染一次：SPA 局部导航后侧边栏 DOM 并未变化，无需重复渲染
  let sidebarMathRendered = false;

  function renderCustomMath() {
    // 渲染参数配置
    const katexConfig = {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false },
      ],
      throwOnError: false
    };

    if (!sidebarMathRendered) {
      const sidebar = document.querySelector('.sidebar') || document.querySelector('aside');
      if (sidebar) {
        renderMathInElement(sidebar, katexConfig);
        sidebarMathRendered = true;
      }
    }

    // 页面大标题每个新页面都不同，需要每次导航后重新渲染
    const mainTitle = document.querySelector('h1');
    if (mainTitle) {
      renderMathInElement(mainTitle, katexConfig);
    }
  }

  // 页面初次加载时执行一次
    initSidebarResizers();
  renderCustomMath();

  // 监听 Astro 页面过渡和加载事件，确保在路由切换后依然生效
  document.addEventListener('astro:page-load', () => {
    renderCustomMath();
    initSidebarResizers();
  });
</script>

<!-- 3. SPA 局部刷新导航：点击内部链接时只替换正文与右侧大纲，保留头部与左侧栏 -->
<script>
  if (!window.__spaNavInstalled) {
    window.__spaNavInstalled = true;

    // 按 URL 缓存已抓取的页面（限制数量，防止内存膨胀）
    const pageCache = new Map();
    const CACHE_MAX = 24;
    // 导航令牌：快速连续点击时，只允许最新一次导航真正替换 DOM
    let navToken = 0;

    function isNavLink(a) {
      if (a.hasAttribute('download')) return false;
      if (a.target && a.target !== '_self') return false;
      if ((a.getAttribute('rel') || '').split(' ').includes('external')) return false;
      try {
        const url = new URL(a.href, location.href);
        return url.origin === location.origin && /^https?:$/.test(url.protocol);
      } catch {
        return false;
      }
    }

    function fetchPage(url) {
      const key = url.href;
      if (pageCache.has(key)) return pageCache.get(key);
      const p = fetch(url, { headers: { Accept: 'text/html' }, credentials: 'same-origin' })
        .then((r) => {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.text();
        })
        .then((html) => new DOMParser().parseFromString(html, 'text/html'));
      pageCache.set(key, p);
      if (pageCache.size > CACHE_MAX) {
        pageCache.delete(pageCache.keys().next().value);
      }
      return p;
    }

    function normPath(p) {
      return p === '/' ? p : p.replace(/\/+$/, '');
    }

    // 新内容来自 DOMParser，插入前移除 script，避免意外执行
    function stripScripts(root) {
      root.querySelectorAll('script').forEach((s) => s.remove());
    }

    // 更新左侧栏当前页高亮，并展开所属分组
    function updateSidebarActive(pathname) {
      const sidebar = document.querySelector('nav.sidebar, .sidebar');
      if (!sidebar) return;
      let matched = null;
      sidebar.querySelectorAll('a[aria-current="page"]').forEach((a) => a.removeAttribute('aria-current'));
      sidebar.querySelectorAll('a[href]').forEach((a) => {
        let url;
        try {
          url = new URL(a.href, location.href);
        } catch {
          return;
        }
        if (normPath(url.pathname) === normPath(pathname)) {
          matched = a;
          let node = a.parentElement;
          while (node && node !== sidebar) {
            if (node.tagName === 'DETAILS') node.open = true;
            node = node.parentElement;
          }
        }
      });
      if (matched) matched.setAttribute('aria-current', 'page');
    }

    // 移动端：点击侧边栏链接后收起菜单遮罩
    function closeMobileMenu() {
      const btn = document.querySelector('starlight-menu-button button');
      if (btn && document.body.hasAttribute('data-mobile-menu-expanded')) btn.click();
    }

    async function loadPage(url, { restoreScroll = false } = {}) {
      const token = ++navToken;
      const doc = await fetchPage(url);
      if (token !== navToken) return; // 已被更新的导航取代

      const newMain = doc.querySelector('.main-pane');
      const currentMain = document.querySelector('.main-pane');
      if (!newMain || !currentMain) throw new Error('main-pane not found');

      const flexWrap = currentMain.parentElement;
      const newRight = doc.querySelector('.right-sidebar-container');
      const currentRight = document.querySelector('.right-sidebar-container');

      document.title = doc.title || document.title;

      stripScripts(newMain);
      currentMain.replaceWith(newMain);
      if (newRight) {
        stripScripts(newRight);
        if (currentRight) currentRight.replaceWith(newRight);
        else flexWrap?.prepend(newRight);
      } else if (currentRight) {
        currentRight.remove();
      }

      updateSidebarActive(url.pathname);
      closeMobileMenu();

      // 滚动处理：带锚点滚动到目标；后退时恢复保存的滚动位置
      if (url.hash) {
        const targetId = decodeURIComponent(url.hash.slice(1));
        const el = document.getElementById(targetId);
        if (el) el.scrollIntoView({ block: 'start' });
        else window.scrollTo(0, 0);
      } else {
        const y = restoreScroll && history.state && typeof history.state.scrollY === 'number'
          ? history.state.scrollY
          : 0;
        window.scrollTo(0, y);
      }

      // 触发既有初始化逻辑（大纲重建、选择题重构、公式二次渲染等）
      document.dispatchEvent(new CustomEvent('astro:page-load'));
    }

    // 拦截所有站内链接
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const a = target.closest('a[href]');
      if (!a || !isNavLink(a)) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      const url = new URL(a.href, location.href);
      if (normPath(url.pathname) === normPath(location.pathname)) {
        if (!url.hash) e.preventDefault(); // 同页无锚点：不触发整页刷新
        return;
      }

      e.preventDefault();
      // 立即更新地址栏并保存当前滚动位置，随后异步替换内容
      history.replaceState({ ...(history.state || {}), scrollY: window.scrollY }, '');
      history.pushState({ scrollY: 0 }, '', url.href);
      loadPage(url).catch(() => {
        window.location.href = url.href;
      });
    });

    // 悬停左侧栏链接时预取（短延迟去抖），点击时几乎瞬时完成替换
    let prefetchTimer = 0;
    document.addEventListener('pointerover', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const a = target.closest('a[href]');
      if (!a || !isNavLink(a) || !a.closest('nav.sidebar, .sidebar')) return;
      const url = new URL(a.href, location.href);
      if (normPath(url.pathname) === normPath(location.pathname)) return;
      clearTimeout(prefetchTimer);
      prefetchTimer = setTimeout(() => fetchPage(url).catch(() => {}), 120);
    });

    // 浏览器前进/后退
    window.addEventListener('popstate', () => {
      const url = new URL(location.href);
      loadPage(url, { restoreScroll: true }).catch(() => {
        location.reload();
      });
    });
  }
</script>
