---
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import fs from 'node:fs';
import { features } from '../config/features.config.mjs';

const { sidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

let filteredSidebar = sidebar;
const bookMatch = pathname.match(/\/collections\/([^/]+)\/([^/]+)/);
if (bookMatch) {
  const prefix = `/collections/${bookMatch[1]}/${bookMatch[2]}/`;
  const kept = [];
  for (const entry of sidebar) {
    if (entry.type !== 'group') continue;
    const books = (entry.entries || []).filter(
      (b) => b.type === 'group' && (b.entries || []).some(
        (i) => i.type === 'link' && typeof i.href === 'string' && i.href.startsWith(prefix)
      )
    );
    if (books.length > 0) kept.push({ ...entry, entries: books });
  }
  if (kept.length > 0) filteredSidebar = kept;
} else if (pathname.startsWith('/dev')) {
  const kept = sidebar.filter(
    (entry) => entry.type === 'group' && (entry.label.includes('开发文档') || (entry.entries || []).some(
      (i) => (i.type === 'link' && typeof i.href === 'string' && i.href.startsWith('/dev')) ||
             (i.type === 'group' && (i.entries || []).some((sub) => typeof sub.href === 'string' && sub.href.startsWith('/dev')))
    ))
  );
  if (kept.length > 0) filteredSidebar = kept;
}

let epubHref = null;
if (features.epub.enabled && bookMatch) {
  const bookSlug = bookMatch[2];
  const epubPath = `public/epub/${bookSlug}.epub`;
  try {
    if (fs.existsSync(epubPath)) {
      epubHref = `/epub/${bookSlug}.epub`;
    } else if (features.epub?.config?.releaseBaseUrl) {
      epubHref = `${features.epub.config.releaseBaseUrl}/${bookSlug}.epub`;
    }
  } catch {
    if (features.epub?.config?.releaseBaseUrl) {
      epubHref = `${features.epub.config.releaseBaseUrl}/${bookSlug}.epub`;
    }
  }
}
---

<SidebarPersister>
  <SidebarSublist sublist={filteredSidebar} />
</SidebarPersister>

{features.epub.enabled && epubHref && (
  <div class="epub-entry" data-feature="epub">
    <a href={epubHref} download title="下载本书 EPUB（离线阅读）" aria-label="下载本书 EPUB">
      <svg class="epub-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="3" x2="12" y2="15" />
      </svg>
    </a>
  </div>
)}

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>.epub-entry {
    margin: auto 0.75rem 0.25rem 0;
    display: flex;
    justify-content: flex-end;
    padding-top: 0.5rem;
  }
  .epub-entry a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    color: var(--sl-color-gray-4);
    opacity: 0.85;
    text-decoration: none;
    transition: color 0.15s ease, opacity 0.15s ease, background-color 0.15s ease;
  }
  .epub-entry a .epub-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .epub-entry a:hover,
  .epub-entry a:focus-visible {
    opacity: 1;
    color: var(--sl-color-text-accent);
    background-color: color-mix(in srgb, var(--sl-color-text-accent) 12%, transparent);
  }
</style>

<script>import renderMathInElement from 'katex/dist/contrib/auto-render.mjs';

    import { initSidebarResizers } from '../scripts/sidebar-resizer';

  let sidebarMathRendered = false;

  function renderCustomMath() {

    const katexConfig = {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false },
      ],
      throwOnError: false
    };

    if (!sidebarMathRendered) {
      const sidebar = document.querySelector('.sidebar') || document.querySelector('aside');
      if (sidebar) {
        renderMathInElement(sidebar, katexConfig);
        sidebarMathRendered = true;
      }
    }

    const mainTitle = document.querySelector('h1');
    if (mainTitle) {
      renderMathInElement(mainTitle, katexConfig);
    }
  }

    initSidebarResizers();
  renderCustomMath();

  document.addEventListener('astro:page-load', () => {
    renderCustomMath();
    initSidebarResizers();
  });
</script>

<script>if (!window.__spaNavInstalled) {
    window.__spaNavInstalled = true;

    const pageCache = new Map();
    const CACHE_MAX = 24;

    let navToken = 0;

    function isNavLink(a) {
      if (a.hasAttribute('download')) return false;
      if (a.target && a.target !== '_self') return false;
      if ((a.getAttribute('rel') || '').split(' ').includes('external')) return false;
      try {
        const url = new URL(a.href, location.href);
        return url.origin === location.origin && /^https?:$/.test(url.protocol);
      } catch {
        return false;
      }
    }

    function fetchPage(url) {
      const key = url.href;
      if (pageCache.has(key)) return pageCache.get(key);
      const p = fetch(url, { headers: { Accept: 'text/html' }, credentials: 'same-origin' })
        .then((r) => {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.text();
        })
        .then((html) => new DOMParser().parseFromString(html, 'text/html'));
      pageCache.set(key, p);
      if (pageCache.size > CACHE_MAX) {
        pageCache.delete(pageCache.keys().next().value);
      }
      return p;
    }

    function normPath(p) {
      return p === '/' ? p : p.replace(/\/+$/, '');
    }

    function stripScripts(root) {
      root.querySelectorAll('script').forEach((s) => s.remove());
    }

    function updateSidebarActive(pathname) {
      const sidebar = document.querySelector('nav.sidebar, .sidebar');
      if (!sidebar) return;
      let matched = null;
      sidebar.querySelectorAll('a[aria-current="page"]').forEach((a) => a.removeAttribute('aria-current'));
      sidebar.querySelectorAll('a[href]').forEach((a) => {
        let url;
        try {
          url = new URL(a.href, location.href);
        } catch {
          return;
        }
        if (normPath(url.pathname) === normPath(pathname)) {
          matched = a;
          let node = a.parentElement;
          while (node && node !== sidebar) {
            if (node.tagName === 'DETAILS') node.open = true;
            node = node.parentElement;
          }
        }
      });
      if (matched) matched.setAttribute('aria-current', 'page');
    }

    function closeMobileMenu() {
      const btn = document.querySelector('starlight-menu-button button');
      if (btn && document.body.hasAttribute('data-mobile-menu-expanded')) btn.click();
    }

    document.addEventListener('click', (e) => {
      if (!document.body.hasAttribute('data-mobile-menu-expanded')) return;
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (target.closest('starlight-menu-button') || target.closest('.sidebar-pane')) return;
      closeMobileMenu();
    });

    async function loadPage(url, { restoreScroll = false } = {}) {
      const token = ++navToken;
      const doc = await fetchPage(url);
      if (token !== navToken) return;

      const newMain = doc.querySelector('.main-pane');
      const currentMain = document.querySelector('.main-pane');
      if (!newMain || !currentMain) throw new Error('main-pane not found');

      const flexWrap = currentMain.parentElement;
      const newRight = doc.querySelector('.right-sidebar-container');
      const currentRight = document.querySelector('.right-sidebar-container');

      document.title = doc.title || document.title;

      stripScripts(newMain);
      currentMain.replaceWith(newMain);
      if (newRight) {
        stripScripts(newRight);
        if (currentRight) currentRight.replaceWith(newRight);
        else flexWrap?.prepend(newRight);
      } else if (currentRight) {
        currentRight.remove();
      }

      updateSidebarActive(url.pathname);
      closeMobileMenu();

      if (url.hash) {
        const targetId = decodeURIComponent(url.hash.slice(1));
        const el = document.getElementById(targetId);
        if (el) el.scrollIntoView({ block: 'start' });
        else window.scrollTo(0, 0);
      } else {
        const y = restoreScroll && history.state && typeof history.state.scrollY === 'number'
          ? history.state.scrollY
          : 0;
        window.scrollTo(0, y);
      }

      document.dispatchEvent(new CustomEvent('astro:page-load'));
    }

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const a = target.closest('a[href]');
      if (!a || !isNavLink(a)) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      const url = new URL(a.href, location.href);
      if (normPath(url.pathname) === normPath(location.pathname)) {
        if (!url.hash) e.preventDefault();
        return;
      }

      e.preventDefault();

      history.replaceState({ ...(history.state || {}), scrollY: window.scrollY }, '');
      history.pushState({ scrollY: 0 }, '', url.href);
      loadPage(url).catch(() => {
        window.location.href = url.href;
      });
    });

    let prefetchTimer = 0;
    function isPrefetchable(a) {
      return !!a.closest('nav.sidebar, .sidebar, .pagination-links, footer');
    }
    document.addEventListener('pointerover', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const a = target.closest('a[href]');
      if (!a || !isNavLink(a) || !isPrefetchable(a)) return;
      const url = new URL(a.href, location.href);
      if (normPath(url.pathname) === normPath(location.pathname)) return;
      clearTimeout(prefetchTimer);
      prefetchTimer = setTimeout(() => fetchPage(url).catch(() => {}), 50);
    });

    document.addEventListener('pointerdown', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const a = target.closest('a[href]');
      if (!a || !isNavLink(a)) return;
      const url = new URL(a.href, location.href);
      if (normPath(url.pathname) === normPath(location.pathname)) return;
      clearTimeout(prefetchTimer);
      fetchPage(url).catch(() => {});
    }, { passive: true });

    window.addEventListener('popstate', () => {
      const url = new URL(location.href);
      loadPage(url, { restoreScroll: true }).catch(() => {
        location.reload();
      });
    });
  }
</script>
