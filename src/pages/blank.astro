---
import ScratchpadWorkspace from '../features/scratchpad/ui/ScratchpadWorkspace.astro';
import ChapterExportModal from '../components/publishing/ChapterExportModal.astro';
import Analytics from '../components/Analytics.astro';
import { features } from '../config/features.config.mjs';

import 'katex/dist/katex.min.css';
import '../styles/tokens/layers.css';
import '../styles/custom.css';
import '../styles/vitepress-theme.css';
import '../themes/material-you/theme.css';
import '@fontsource-variable/noto-sans-sc/index.css';
import '@fontsource-variable/noto-serif-sc/index.css';
import '@fontsource-variable/plus-jakarta-sans/index.css';
import '../styles/fonts.css';
import '../styles/components/exercise-m3.css';
import '../styles/components/translation-dock.css';
import '../styles/components/scratchpad.css';

const pageTitle = '空白文档与学术工作台 · AstroLib';
const pageDescription = '支持自主编辑元数据与正文，具备公式/Mermaid实时渲染、双语助读与PDF导出能力的学术实验工作台。';
---

<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />

    <script is:inline>(function() {
        try {
          var theme = localStorage.getItem('astrolib-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          var siteTheme = localStorage.getItem('astrolib-site-theme') || 'material-you';
          document.documentElement.setAttribute('data-site-theme', siteTheme);

          var fontKey = 'starlight-font';
          var rawFont = localStorage.getItem(fontKey);
          if (rawFont) {
            var parsed = JSON.parse(rawFont);
            if (parsed && typeof parsed === 'object') {
              if (parsed.latin) document.documentElement.dataset.fontLatin = parsed.latin;
              if (parsed.cjk) document.documentElement.dataset.fontCjk = parsed.cjk;
            }
          }

          var fontSizeKey = 'astrolib_font_size';
          var fontSize = localStorage.getItem(fontSizeKey);
          if (fontSize) {
            var pt = parseInt(fontSize, 10) * 0.75;
            document.documentElement.style.setProperty('--academic-font-size-body', pt + 'pt');
          }

          var colorKey = 'starlight-m3-theme-color';
          var m3Color = localStorage.getItem(colorKey);
          if (m3Color) document.documentElement.dataset.m3ThemeColor = m3Color;
          var cachedCss = localStorage.getItem('astrolib_m3_cached_css');
          if (cachedCss && siteTheme === 'material-you') {
            var styleEl = document.createElement('style');
            styleEl.id = 'm3-dynamic-color-theme';
            styleEl.textContent = cachedCss;
            document.head.appendChild(styleEl);
          }
        } catch (e) {}
      })();
</script>
  </head>
  <body class="scratchpad-page-body">
    <div class="blank-page-shell">

      <div class="blank-page-main">
        <ScratchpadWorkspace />
      </div>
    </div>

    <div id="astro-overlay-root">
      <div class="astrolib-sideload-scrim" id="astrolib-sideload-scrim" aria-hidden="true"></div>
      {features.chapterExport?.enabled && <ChapterExportModal />}
    </div>

    <Analytics />

    <style is:global>body.scratchpad-page-body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        height: 100vh;
        width: 100vw;
        background-color: var(--sl-color-bg, #ffffff);
      }

      .blank-page-shell {
        display: flex;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        position: relative;
      }

      .blank-page-main {
        flex: 1;
        width: 100%;
        min-width: 0;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
</style>
  </body>
</html>
