    <div class="modal-backdrop" id="token-modal" style="display: none;">
      <div class="modal-card">
        <h3 class="modal-title">配置 MinerU API 凭证</h3>
        <p style="font-size: 0.85rem; color: var(--md-sys-color-outline, #72777d); margin: 0;">
          每个账号每天拥有 1000 页面免费极速解析额度。<br />
          可在 <a href="https://mineru.net" target="_blank" style="color: var(--md-sys-color-primary, #0b57d0);">mineru.net</a> 用户中心免费获取 Token。
        </p>
        <input type="text" class="modal-input" id="token-input" placeholder="粘贴 API Token (如 f31d7c3a...)" />
        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="btn-close-token">取消</button>
          <button type="button" class="btn-primary" id="btn-save-token">保存</button>
        </div>
      </div>
    </div>

    <div class="modal-backdrop" id="export-modal" style="display: none;">
      <div class="modal-card">
        <h3 class="modal-title">转入 AstroLib 书籍合集</h3>
        <p style="font-size: 0.85rem; color: var(--md-sys-color-outline, #72777d); margin: 0;">
          自动将解析成果清洗并转换为合法 MDX，注入全书侧边栏与阅读器。
        </p>
        <div>
          <label style="font-size: 0.8rem; font-weight: 500; display: block; margin-bottom: 0.3rem;">所属学科合集</label>
          <select class="modal-select" id="export-collection-select">
            {collections.map(c => (
              <option value={c.slug}>{c.title} ({c.slug})</option>
            ))}
          </select>
        </div>
        <div>
          <label style="font-size: 0.8rem; font-weight: 500; display: block; margin-bottom: 0.3rem;">书籍/论文 Slug (URL 路径)</label>
          <input type="text" class="modal-input" id="export-slug-input" placeholder="如 my-paper-2026" />
        </div>
        <div>
          <label style="font-size: 0.8rem; font-weight: 500; display: block; margin-bottom: 0.3rem;">显示书名/文献标题</label>
          <input type="text" class="modal-input" id="export-title-input" placeholder="文献完整标题" />
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="btn-close-export">取消</button>
          <button type="button" class="btn-primary" id="btn-confirm-export">确认入库</button>
        </div>
      </div>
    </div>

    <script>import { marked } from 'marked';
      import katex from 'katex';

      (function () {
        const urlParams = new URLSearchParams(window.location.search);
        let currentTaskId = urlParams.get('taskId') || '';
        let currentEngine = 'api';
        let currentViewMode: 'structured' | 'bilingual' | 'continuous' = 'structured';
        let translationProvider = 'google';
        const blockTranslationCache = new Map<string, string>();
        let currentBlocks = [];
        let currentMarkdown = '';
        let pdfDocInstance = null;
        let pollTimer = null;
        let isTranslatingAll = false;

        const chipApi = document.getElementById('chip-api');
        const chipAgent = document.getElementById('chip-agent');
        const chipLocal = document.getElementById('chip-local');
        const viewStructured = document.getElementById('view-structured');
        const viewBilingual = document.getElementById('view-bilingual');
        const viewContinuous = document.getElementById('view-continuous');
        const bilingualToolbar = document.getElementById('bilingual-toolbar');
        const bilingualProviderSelect = document.getElementById('bilingual-provider-select') as HTMLSelectElement;
        const btnTranslatePage = document.getElementById('btn-translate-page');
        const btnTranslateAll = document.getElementById('btn-translate-all');

        const pageRangeInput = document.getElementById('page-range-input') as HTMLInputElement;
        const btnParse = document.getElementById('btn-parse') as HTMLButtonElement;
        const btnParseText = document.getElementById('btn-parse-text');
        const btnDownloadZip = document.getElementById('btn-download-zip') as HTMLButtonElement;
        const btnExportBook = document.getElementById('btn-export-book') as HTMLButtonElement;
        const statusBarText = document.getElementById('status-text');
        const progressFill = document.getElementById('progress-fill');
        const docNameText = document.getElementById('doc-name-text');
        const docPagesText = document.getElementById('doc-pages-text');
        const panePdf = document.getElementById('pane-pdf');
        const pdfEmptyState = document.getElementById('pdf-empty-state');
        const mdEmptyState = document.getElementById('md-empty-state');
        const structuredBlocksContainer = document.getElementById('structured-blocks-container');
        const continuousReadingContainer = document.getElementById('continuous-reading-container');

        const tokenModal = document.getElementById('token-modal');
        const tokenInput = document.getElementById('token-input') as HTMLInputElement;
        const btnOpenTokenModal = document.getElementById('btn-open-token-modal');
        const btnCloseToken = document.getElementById('btn-close-token');
        const btnSaveToken = document.getElementById('btn-save-token');

        const exportModal = document.getElementById('export-modal');
        const exportColSelect = document.getElementById('export-collection-select') as HTMLSelectElement;
        const exportSlugInput = document.getElementById('export-slug-input') as HTMLInputElement;
        const exportTitleInput = document.getElementById('export-title-input') as HTMLInputElement;
        const btnCloseExport = document.getElementById('btn-close-export');
        const btnConfirmExport = document.getElementById('btn-confirm-export');

        function setEngine(engine: string) {
          currentEngine = engine;
          chipApi?.classList.toggle('active', engine === 'api');
          chipAgent?.classList.toggle('active', engine === 'agent');
          chipLocal?.classList.toggle('active', engine === 'local');

          if (engine === 'agent') {
            const pageNum = parseInt(docPagesText?.textContent?.replace(/\D/g, '') || '0', 10);
            if (pageNum > 20) {
              updateStatus(`提示：当前文档共 ${pageNum} 页，Agent 免密模式支持最多 20 页。建议在上方输入切片范围（如 1-20），或切换【高精 API】`, 100);
            }
          }
        }

        chipApi?.addEventListener('click', () => setEngine('api'));
        chipAgent?.addEventListener('click', () => setEngine('agent'));
        chipLocal?.addEventListener('click', () => setEngine('local'));

        function setViewMode(mode: 'structured' | 'bilingual' | 'continuous') {
          currentViewMode = mode;
          try {
            localStorage.setItem('astrolib_ingest_view_mode', mode);
          } catch {}

          viewStructured?.classList.toggle('active', mode === 'structured');
          viewBilingual?.classList.toggle('active', mode === 'bilingual');
          viewContinuous?.classList.toggle('active', mode === 'continuous');

          if (bilingualToolbar) {
            bilingualToolbar.style.display = mode === 'bilingual' ? 'inline-flex' : 'none';
          }

          if (currentMarkdown || currentBlocks.length > 0) {
            if (mode === 'structured' || mode === 'bilingual') {
              if (structuredBlocksContainer) structuredBlocksContainer.style.display = 'flex';
              if (continuousReadingContainer) continuousReadingContainer.style.display = 'none';

              document.querySelectorAll('.pdf-overlay-layer').forEach((el) => {
                (el as HTMLElement).style.display = 'block';
              });

              document.querySelectorAll('.block-item-translation').forEach((el) => {
                const blockId = el.getAttribute('data-block-id');
                if (mode === 'bilingual') {
                  (el as HTMLElement).style.display = 'block';
                } else {
                  (el as HTMLElement).style.display = 'none';
                }
              });

              if (mode === 'bilingual') {

                translateCurrentVisiblePage(false);
              }
            } else {

              if (structuredBlocksContainer) structuredBlocksContainer.style.display = 'none';
              if (continuousReadingContainer) continuousReadingContainer.style.display = 'block';

              document.querySelectorAll('.pdf-overlay-layer').forEach((el) => {
                (el as HTMLElement).style.display = 'none';
              });
            }
          }
        }

        try {
          const savedMode = localStorage.getItem('astrolib_ingest_view_mode') as any;
          if (savedMode === 'continuous' || savedMode === 'structured' || savedMode === 'bilingual') {
            currentViewMode = savedMode;
            viewStructured?.classList.toggle('active', savedMode === 'structured');
            viewBilingual?.classList.toggle('active', savedMode === 'bilingual');
            viewContinuous?.classList.toggle('active', savedMode === 'continuous');
          }
        } catch {}

        viewStructured?.addEventListener('click', () => setViewMode('structured'));
        viewBilingual?.addEventListener('click', () => setViewMode('bilingual'));
        viewContinuous?.addEventListener('click', () => setViewMode('continuous'));

        bilingualProviderSelect?.addEventListener('change', () => {
          translationProvider = bilingualProviderSelect.value;
          if (currentViewMode === 'bilingual') {
            translateCurrentVisiblePage(true);
          }
        });

        btnTranslatePage?.addEventListener('click', () => {
          translateCurrentVisiblePage(true);
        });

        btnTranslateAll?.addEventListener('click', () => {
          translateAllDocument();
        });

        btnOpenTokenModal?.addEventListener('click', () => {
          if (tokenModal) tokenModal.style.display = 'flex';
        });
        btnCloseToken?.addEventListener('click', () => {
          if (tokenModal) tokenModal.style.display = 'none';
        });
        btnSaveToken?.addEventListener('click', async () => {
          const val = tokenInput?.value?.trim();
          if (!val) return;
          try {
            const res = await fetch('/api/ingest/token', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ token: val }),
            });
            const data = await res.json();
            if (data.success) {
              alert('MinerU API Token 保存成功！');
              if (tokenModal) tokenModal.style.display = 'none';
            } else {
              alert('保存失败: ' + (data.error || '未知错误'));
            }
          } catch (e) {
            alert('保存异常');
          }
        });

        if (currentTaskId) {
          loadTaskInfo(currentTaskId);
        } else {
          updateStatus('请在首页上传 PDF 或将文件拖拽至此', 0);
        }

        async function loadTaskInfo(taskId: string) {
          try {
            updateStatus('正在加载文档元数据...', 10);
            const res = await fetch(`/api/ingest/status?taskId=${encodeURIComponent(taskId)}`);
            if (!res.ok) throw new Error(`未找到任务 ${taskId}`);
            const data = await res.json();
            const task = data.task;

            if (docNameText) docNameText.textContent = task.fileName;
            if (docPagesText) docPagesText.textContent = `共 ${task.pageCount} 页`;
            if (exportTitleInput) exportTitleInput.value = task.fileName.replace(/\.pdf$/i, '');
            if (exportSlugInput) exportSlugInput.value = task.fileName.replace(/\.pdf$/i, '').toLowerCase().replace(/[^a-z0-9_-]/g, '-');

            btnParse.disabled = false;

            loadPdfDocument(`/api/ingest/pdf?taskId=${encodeURIComponent(taskId)}`);

            if (task.status === 'completed') {
              updateStatus('解析已完成', 100);
              fetchAndRenderResult(taskId);
            } else if (task.status === 'processing' || task.status === 'uploading' || task.status === 'waiting-file' || task.status === 'downloading' || task.status === 'unpacking') {
              startPollingStatus(taskId);
            } else if (task.status === 'failed') {
              updateStatus('解析失败：' + (task.error || '未知错误'), 0);
            } else {
              updateStatus('文档就绪，请点击“开始解析”', 0);
            }
          } catch (err) {
            updateStatus('任务加载失败：' + (err instanceof Error ? err.message : String(err)), 0);
          }
        }

        btnParse?.addEventListener('click', async () => {
          if (!currentTaskId) return;

          btnParse.disabled = true;
          if (btnParseText) btnParseText.textContent = '解析任务进行中...';

          try {
            const pageRanges = pageRangeInput?.value?.trim();
            const res = await fetch('/api/ingest/parse', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                taskId: currentTaskId,
                engine: currentEngine,
                pageRanges,
              }),
            });

            if (!res.ok) {
              const errData = await res.json();
              throw new Error(errData.error || '请求解析失败');
            }

            const labelMap: Record<string, string> = {
              api: '已提交云端 VLM 识别集群...',
              agent: '已提交 Agent 免密极速轻量解析...',
              local: '启动本地 5060 推理引擎...',
            };
            updateStatus(labelMap[currentEngine] || '正在解析...', 25);
            startPollingStatus(currentTaskId);
          } catch (err) {
            alert('启动解析失败：' + (err instanceof Error ? err.message : String(err)));
            btnParse.disabled = false;
            if (btnParseText) btnParseText.textContent = '开始解析';
          }
        });

        function startPollingStatus(taskId: string) {
          if (pollTimer) clearInterval(pollTimer);

          pollTimer = window.setInterval(async () => {
            try {
              const res = await fetch(`/api/ingest/status?taskId=${encodeURIComponent(taskId)}`);
              if (!res.ok) return;
              const data = await res.json();
              const task = data.task;

              const stateMap: Record<string, string> = {
                'uploading': '正在上传文档...',
                'waiting-file': '云端排队中...',
                'pending': 'MinerU 调度解析中...',
                'processing': 'MinerU 高精度识别中 (版面/公式/表格)...',
                'downloading': '下载结构化成果 ZIP...',
                'unpacking': '解包与资产格式化...',
                'completed': '解析完成！',
                'failed': '解析失败：' + (task.error || '未知错误'),
              };

              const msg = stateMap[task.status] || task.status;
              updateStatus(msg, task.progress || 50);

              if (task.status === 'completed') {
                clearInterval(pollTimer);
                btnParse.disabled = false;
                if (btnParseText) btnParseText.textContent = '重新解析';
                fetchAndRenderResult(taskId);
              } else if (task.status === 'failed') {
                clearInterval(pollTimer);
                btnParse.disabled = false;
                if (btnParseText) btnParseText.textContent = '重试解析';
              }
            } catch {

            }
          }, 2000);
        }

        async function fetchAndRenderResult(taskId: string) {
          try {
            updateStatus('正在加载解析渲染数据...', 98);
            const res = await fetch(`/api/ingest/result?taskId=${encodeURIComponent(taskId)}`);
            if (!res.ok) return;
            const data = await res.json();
            const result = data.result;

            currentBlocks = result.layoutBlocks || [];
            currentMarkdown = result.markdown || '';

            renderStructuredBlocks(currentBlocks, currentMarkdown, taskId);
            renderContinuousMarkdown(currentMarkdown, taskId);

            renderOverlayBboxes(currentBlocks);

            setViewMode(currentViewMode);

            if (btnDownloadZip) btnDownloadZip.style.display = 'inline-flex';
            if (btnExportBook) btnExportBook.style.display = 'inline-flex';

            updateStatus(`解析完成，提取 ${currentBlocks.length} 个结构化块`, 100);
          } catch (e) {
            updateStatus('渲染解析结果失败', 100);
          }
        }

        function renderStructuredBlocks(blocks: any[], md: string, taskId: string) {
          if (!structuredBlocksContainer) return;
          structuredBlocksContainer.innerHTML = '';

          if (mdEmptyState) mdEmptyState.style.display = 'none';

          blocks.forEach((block) => {
            try {

              if (!block.html && !block.text) return;

              const item = document.createElement('div');
              item.className = `structured-block-item type-${block.type || 'text'}`;
              item.id = `card_${block.id}`;
              item.setAttribute('data-block-id', block.id);
              item.setAttribute('data-page-index', String(block.pageIndex));

              const body = document.createElement('div');
              body.className = 'block-item-body';

              if (block.html) {

                body.innerHTML = block.html;
              } else if (block.type === 'equation') {
                try {
                  const cleanEq = (block.text || '').replace(/^\$\$|\$\$$/g, '').trim();
                  body.innerHTML = `<div class="doc-equation-display">${katex.renderToString(cleanEq, { displayMode: true, throwOnError: false })}</div>`;
                } catch {
                  body.textContent = block.text || '';
                }
              } else if (block.type === 'image' || block.type === 'figure') {
                const match = (block.text || '').match(/!\[(.*?)\]\((.*?)\)/);
                const alt = match ? match[1] : (block.caption || '插图');
                const src = match ? match[2] : '';
                const imgName = src.split('/').pop() || `img_${block.id}.png`;
                body.innerHTML = `<figure class="doc-figure"><img src="/api/ingest/image?taskId=${encodeURIComponent(taskId)}&name=${encodeURIComponent(imgName)}" alt="${alt}" loading="lazy" />${alt ? `<figcaption class="doc-figcaption">${alt}</figcaption>` : ''}</figure>`;
              } else if (block.type === 'table') {
                if ((block.text || '').includes('<table')) {
                  body.innerHTML = `<div class="doc-table-wrapper">${block.text}</div>`;
                } else {
                  body.innerHTML = safeParseMathMarkdown(block.text || '', taskId);
                }
              } else {
                body.innerHTML = safeParseMathMarkdown(block.text || '', taskId);
              }

              item.appendChild(body);

              const transContainer = document.createElement('div');
              transContainer.className = 'block-item-translation';
              transContainer.id = `trans_${block.id}`;
              transContainer.setAttribute('data-block-id', block.id);
              transContainer.style.display = currentViewMode === 'bilingual' ? 'block' : 'none';
              const cachedHtml = blockTranslationCache.get(block.id);
              transContainer.innerHTML = `<div class="translation-body">${cachedHtml || '<span class="translation-loading">待研判 (点击右上角“研判”立即生成)</span>'}</div>`;
              item.appendChild(transContainer);

              if ((block.type === 'text' || block.type === 'title') && block.text && block.text.trim()) {
                const transBtn = document.createElement('button');
                transBtn.type = 'button';
                transBtn.className = 'block-translate-trigger';
                transBtn.title = '双语学术研判';
                transBtn.innerHTML = `
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>
                  </svg>
                  <span>研判</span>
                `;
                transBtn.addEventListener('click', (e) => {
                  e.stopPropagation();
                  translateBlock(block, true, transBtn);
                });
                item.appendChild(transBtn);
              }

              item.addEventListener('mouseenter', () => {
                const targetBbox = document.getElementById(`bbox_${block.id}`);
                if (targetBbox) targetBbox.classList.add('hover-bbox');
              });
              item.addEventListener('mouseleave', () => {
                const targetBbox = document.getElementById(`bbox_${block.id}`);
                if (targetBbox) targetBbox.classList.remove('hover-bbox');
              });

              item.addEventListener('click', () => {
                focusBlock(block.id, block.pageIndex);
              });

              structuredBlocksContainer.appendChild(item);
            } catch (blockErr) {
              console.error(`渲染块 ${block.id} 出错，跳过继续:`, blockErr);
            }
          });
        }

        function renderContinuousMarkdown(md: string, taskId: string) {
          if (!continuousReadingContainer || !md) return;
          continuousReadingContainer.innerHTML = safeParseMathMarkdown(md, taskId);
        }

        function safeParseMathMarkdown(content: string, taskId: string): string {
          if (!content) return '';

          const displayMathMap: string[] = [];
          const inlineMathMap: string[] = [];

          let protectedMd = content.replace(/\$\$([\s\S]*?)\$\$/g, (_, eq) => {
            const idx = displayMathMap.length;
            try {
              const rendered = katex.renderToString(eq.trim(), { displayMode: true, throwOnError: false });
              displayMathMap.push(`<div class="doc-equation-display">${rendered}</div>`);
            } catch {
              displayMathMap.push(`<div class="doc-equation-display">$$\n${eq}\n$$</div>`);
            }
            return `\n\n%%ASTROLIB_DISPLAY_MATH_${idx}%%\n\n`;
          });

          protectedMd = protectedMd.replace(/\$([^\$\n]+?)\$/g, (_, eq) => {
            const idx = inlineMathMap.length;
            try {
              const rendered = katex.renderToString(eq.trim(), { displayMode: false, throwOnError: false });
              inlineMathMap.push(`<span class="katex-inline-wrapper">${rendered}</span>`);
            } catch {
              inlineMathMap.push(`$${eq}$`);
            }
            return `%%ASTROLIB_INLINE_MATH_${idx}%%`;
          });

          protectedMd = protectedMd.replace(/!\[(.*?)\]\((.*?)\)/g, (match, alt, src) => {
            const imgName = src.split('/').pop() || src;
            const targetSrc = `/api/ingest/image?taskId=${encodeURIComponent(taskId)}&name=${encodeURIComponent(imgName)}`;
            return `![${alt}](${targetSrc})`;
          });

          let html = '';
          try {
            html = marked.parse(protectedMd) as string;
          } catch (err) {
            console.error('Marked parse error:', err);
            html = `<pre>${content}</pre>`;
          }

          html = html.replace(/%%ASTROLIB_DISPLAY_MATH_(\d+)%%/g, (_, idx) => {
            return displayMathMap[parseInt(idx, 10)] || '';
          });

          html = html.replace(/%%ASTROLIB_INLINE_MATH_(\d+)%%/g, (_, idx) => {
            return inlineMathMap[parseInt(idx, 10)] || '';
          });

          return html;
        }

        async function translateBlock(block: any, forceRefresh = false, triggerBtn?: HTMLElement) {
          const transEl = document.getElementById(`trans_${block.id}`);
          if (!transEl) return;
          const transBody = transEl.querySelector('.translation-body') as HTMLElement;
          if (!transBody) return;

          if (!forceRefresh && blockTranslationCache.has(block.id)) {
            transEl.style.display = 'block';
            transBody.innerHTML = blockTranslationCache.get(block.id)!;
            return;
          }

          transEl.style.display = 'block';
          transBody.innerHTML = '<span class="translation-loading">正在进行结构保护学术研判翻译...</span>';
          if (triggerBtn) triggerBtn.style.opacity = '0.5';

          try {
            const res = await fetch('/api/translate', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                text: block.text,
                provider: translationProvider,
                sourceLang: 'en',
                targetLang: 'zh',
                preserveStructure: true,
              }),
            });
            const data = await res.json();
            if (data.ok && data.translatedText) {
              const rendered = safeParseMathMarkdown(data.translatedText, currentTaskId);
              blockTranslationCache.set(block.id, rendered);
              transBody.innerHTML = rendered;
            } else {
              transBody.innerHTML = `<span class="translation-error">研判未完成: ${data.error || '服务响应异常'}</span>`;
            }
          } catch (err) {
            transBody.innerHTML = `<span class="translation-error">研判请求失败: ${err instanceof Error ? err.message : String(err)}</span>`;
          } finally {
            if (triggerBtn) triggerBtn.style.opacity = '';
          }
        }

        function getCurrentVisiblePageIndex(): number {

          if (panePdf) {
            const paneRect = panePdf.getBoundingClientRect();
            const pdfPages = Array.from(panePdf.querySelectorAll('.pdf-page-container'));
            for (let i = 0; i < pdfPages.length; i++) {
              const r = pdfPages[i].getBoundingClientRect();
              if (r.bottom > paneRect.top + 50 && r.top < paneRect.bottom - 50) {
                return i;
              }
            }
          }

          const paneMd = document.getElementById('pane-markdown');
          if (paneMd && structuredBlocksContainer && structuredBlocksContainer.style.display !== 'none') {
            const paneRect = paneMd.getBoundingClientRect();
            const items = Array.from(structuredBlocksContainer.querySelectorAll('.structured-block-item'));
            for (const item of items) {
              const r = item.getBoundingClientRect();
              if (r.bottom > paneRect.top + 20 && r.top < paneRect.bottom - 20) {
                const p = item.getAttribute('data-page-index');
                if (p !== null) return parseInt(p, 10);
              }
            }
          }

          return 0;
        }

        async function translateCurrentVisiblePage(forceRefresh = false) {
          if (!currentBlocks || currentBlocks.length === 0) return;

          const targetPageIndex = getCurrentVisiblePageIndex();

          const pageBlocks = currentBlocks.filter(
            (b) => b.pageIndex === targetPageIndex && (b.type === 'text' || b.type === 'title') && b.text && b.text.trim().length > 0
          );

          if (pageBlocks.length === 0) {
            updateStatus(`第 ${targetPageIndex + 1} 页无需要研判的正文段落`, 100);
            return;
          }

          pageBlocks.forEach((b) => {
            const transEl = document.getElementById(`trans_${b.id}`);
            if (transEl) {
              transEl.style.display = 'block';
              if (forceRefresh || !blockTranslationCache.has(b.id)) {
                const transBody = transEl.querySelector('.translation-body');
                if (transBody) {
                  transBody.innerHTML = '<span class="translation-loading">正在进行结构保护学术研判...</span>';
                }
              }
            }
          });

          const firstBlockEl = document.getElementById(`card_${pageBlocks[0].id}`);
          if (firstBlockEl && structuredBlocksContainer && structuredBlocksContainer.style.display !== 'none') {
            firstBlockEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }

          updateStatus(`正在进行第 ${targetPageIndex + 1} 页双语研判 (${pageBlocks.length} 个段落)...`, 40);

          const queue = [...pageBlocks];
          const concurrency = 3;
          const workers = Array(Math.min(concurrency, queue.length)).fill(null).map(async () => {
            while (queue.length > 0) {
              const block = queue.shift();
              if (!block) break;
              if (forceRefresh || !blockTranslationCache.has(block.id)) {
                await translateBlock(block, forceRefresh);
              }
            }
          });

          await Promise.all(workers);
          updateStatus(`第 ${targetPageIndex + 1} 页双语研判完成 (共 ${pageBlocks.length} 个段落)`, 100);
        }

        async function translateAllDocument() {
          if (isTranslatingAll) return;
          if (!currentBlocks || currentBlocks.length === 0) return;

          const translatableBlocks = currentBlocks.filter(
            (b) => (b.type === 'text' || b.type === 'title') && b.text && b.text.trim().length > 0
          );

          if (translatableBlocks.length === 0) return;

          isTranslatingAll = true;
          if (btnTranslateAll) btnTranslateAll.textContent = '全篇研判中...';
          updateStatus(`开始全篇自动学术研判，共 ${translatableBlocks.length} 个段落...`, 10);

          document.querySelectorAll('.block-item-translation').forEach((el) => {
            (el as HTMLElement).style.display = 'block';
          });

          let completedCount = 0;
          const queue = [...translatableBlocks];
          const concurrency = 4;
          const workers = Array(concurrency).fill(null).map(async () => {
            while (queue.length > 0) {
              const block = queue.shift();
              if (!block) break;
              if (!blockTranslationCache.has(block.id)) {
                await translateBlock(block, false);
              }
              completedCount++;
              const pct = Math.min(99, Math.round((completedCount / translatableBlocks.length) * 100));
              updateStatus(`全篇双语研判进行中: ${completedCount}/${translatableBlocks.length} (${pct}%)`, pct);
            }
          });

          await Promise.all(workers);
          isTranslatingAll = false;
          if (btnTranslateAll) btnTranslateAll.textContent = '全篇研判';
          updateStatus(`🎉 全篇双语研判完成！共研判 ${translatableBlocks.length} 个段落`, 100);
        }

        async function loadPdfDocument(pdfUrl: string) {
          if (!window.pdfjsLib || !panePdf) return;

          try {
            panePdf.innerHTML = '';
            pdfDocInstance = await window.pdfjsLib.getDocument(pdfUrl).promise;
            const totalPages = pdfDocInstance.numPages;

            if (docPagesText) {
              docPagesText.textContent = `共 ${totalPages} 页`;
            }

            const availableWidth = Math.max(300, (panePdf.clientWidth || 560) - 40);

            for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
              try {
                const page = await pdfDocInstance.getPage(pageNum);
                const unscaledViewport = page.getViewport({ scale: 1.0 });
                const scale = availableWidth / unscaledViewport.width;
                const viewport = page.getViewport({ scale });

                const pageWrapper = document.createElement('div');
                pageWrapper.className = 'pdf-page-container';
                pageWrapper.id = `pdf-page-${pageNum - 1}`;
                pageWrapper.style.width = '100%';
                pageWrapper.style.maxWidth = `${viewport.width}px`;
                pageWrapper.style.aspectRatio = `${unscaledViewport.width} / ${unscaledViewport.height}`;

                const canvas = document.createElement('canvas');
                canvas.className = 'pdf-page-canvas';

                const pixelRatio = window.devicePixelRatio || 1;
                canvas.width = Math.floor(viewport.width * pixelRatio);
                canvas.height = Math.floor(viewport.height * pixelRatio);
                canvas.style.width = '100%';
                canvas.style.height = '100%';

                const context = canvas.getContext('2d');
                if (pixelRatio !== 1) {
                  context?.scale(pixelRatio, pixelRatio);
                }
                await page.render({ canvasContext: context, viewport }).promise;

                const overlayLayer = document.createElement('div');
                overlayLayer.className = 'pdf-overlay-layer';
                overlayLayer.setAttribute('data-page-index', String(pageNum - 1));

                pageWrapper.appendChild(canvas);
                pageWrapper.appendChild(overlayLayer);
                panePdf.appendChild(pageWrapper);

                if (currentBlocks.length > 0) {
                  renderOverlayBboxesForPage(pageNum - 1, currentBlocks);
                }
              } catch (pageErr) {
                console.error(`渲染第 ${pageNum} 页出错，跳过继续:`, pageErr);
              }
            }
          } catch (err) {
            if (pdfEmptyState) {
              pdfEmptyState.innerHTML = `<p style="color: #d32f2f;">PDF 加载失败: ${err instanceof Error ? err.message : String(err)}</p>`;
            }
          }
        }

        function renderOverlayBboxes(blocks: any[]) {
          if (!blocks || blocks.length === 0) return;

          const pageIndices = new Set(blocks.map((b) => b.pageIndex));
          pageIndices.forEach((pIdx) => {
            renderOverlayBboxesForPage(pIdx, blocks);
          });
        }

        function renderOverlayBboxesForPage(pageIndex: number, blocks: any[]) {
          const pageContainer = document.getElementById(`pdf-page-${pageIndex}`);
          if (!pageContainer) return;

          const overlay = pageContainer.querySelector('.pdf-overlay-layer');
          if (!overlay) return;

          overlay.innerHTML = '';

          const typeNameMap: Record<string, string> = {
            title: '标题',
            text: '文本',
            equation: '公式',
            table: '表格',
            image: '图片',
            figure: '插图',
            header: '页眉',
            footer: '页脚',
            aside: '旁注',
            list: '列表',
          };

          const pageBlocks = blocks.filter((b) => b.pageIndex === pageIndex);

          pageBlocks.forEach((block) => {
            const bbox = block.bbox;
            if (!bbox || bbox.length !== 4) return;

            const pw = block.pageWidth || 1000;
            const ph = block.pageHeight || 1000;

            const [x0, y0, x1, y1] = bbox;
            const leftPct = (x0 / pw) * 100;
            const topPct = (y0 / ph) * 100;
            const widthPct = ((x1 - x0) / pw) * 100;
            const heightPct = ((y1 - y0) / ph) * 100;

            const rect = document.createElement('div');
            rect.className = `bbox-highlight type-${block.type || 'text'}`;
            rect.id = `bbox_${block.id}`;
            rect.style.left = `${leftPct}%`;
            rect.style.top = `${topPct}%`;
            rect.style.width = `${widthPct}%`;
            rect.style.height = `${heightPct}%`;

            const tag = document.createElement('span');
            tag.className = 'bbox-tag';
            tag.textContent = typeNameMap[block.type] || block.type;
            rect.appendChild(tag);

            rect.addEventListener('mouseenter', () => {
              const targetCard = document.getElementById(`card_${block.id}`);
              if (targetCard) targetCard.classList.add('hover-block');
            });
            rect.addEventListener('mouseleave', () => {
              const targetCard = document.getElementById(`card_${block.id}`);
              if (targetCard) targetCard.classList.remove('hover-block');
            });

            rect.addEventListener('click', (e) => {
              e.stopPropagation();
              focusBlock(block.id, block.pageIndex);
            });

            overlay.appendChild(rect);
          });
        }

        function focusBlock(blockId: string, pageIndex: number) {

          document.querySelectorAll('.bbox-highlight').forEach((r) => r.classList.remove('active'));
          const targetRect = document.getElementById(`bbox_${blockId}`);
          if (targetRect) {
            targetRect.classList.add('active');
            targetRect.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            const pageEl = document.getElementById(`pdf-page-${pageIndex}`);
            if (pageEl) pageEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }

          document.querySelectorAll('.structured-block-item').forEach((c) => c.classList.remove('active-block'));
          const targetCard = document.getElementById(`card_${blockId}`);
          if (targetCard) {
            targetCard.classList.add('active-block');
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }

        btnDownloadZip?.addEventListener('click', () => {
          if (!currentTaskId) return;
          window.location.href = `/api/ingest/download-zip?taskId=${encodeURIComponent(currentTaskId)}`;
        });

        btnExportBook?.addEventListener('click', () => {
          if (exportModal) exportModal.style.display = 'flex';
        });
        btnCloseExport?.addEventListener('click', () => {
          if (exportModal) exportModal.style.display = 'none';
        });
        btnConfirmExport?.addEventListener('click', async () => {
          if (!currentTaskId) return;
          const col = exportColSelect?.value;
          const slug = exportSlugInput?.value?.trim();
          const title = exportTitleInput?.value?.trim();

          if (!col || !slug) {
            alert('请完整填写合集与 Slug');
            return;
          }

          try {
            btnConfirmExport.textContent = '入库中...';
            const res = await fetch('/api/ingest/export-book', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                taskId: currentTaskId,
                collectionSlug: col,
                bookSlug: slug,
                bookTitle: title || slug,
              }),
            });

            const data = await res.json();
            if (data.success) {
              alert(`🎉 成功转入书籍合集！\n路径: /collections/${col}/${slug}/01_全文研判/`);
              if (exportModal) exportModal.style.display = 'none';
              window.location.href = `/collections/${col}/${slug}/01_全文研判/`;
            } else {
              alert('入库失败: ' + (data.error || '未知错误'));
            }
          } catch (e) {
            alert('入库请求异常');
          } finally {
            btnConfirmExport.textContent = '确认入库';
          }
        });

        function updateStatus(text: string, percent: number) {
          if (statusBarText) statusBarText.textContent = text;
          if (progressFill) progressFill.style.width = `${percent}%`;
        }
      })();
</script>
  </body>
