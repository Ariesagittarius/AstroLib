---
import { collections } from '../config/collections.config.mjs';
import { features } from '../config/features.config.mjs';
import { buildBookCatalog } from '../core/catalog/book-catalog.mjs';
import VpNav from '../components/VpNav.astro';
import VpFooter from '../components/VpFooter.astro';
import Analytics from '../components/Analytics.astro';

const siteUrl = (features.seo?.config?.siteUrl || 'https://astrolib.cloud').replace(/\/$/, '');
const pageTitle = '网站地图 · 全书目录索引 - AstroLib';
const pageDescription = 'AstroLib 全站教材目录与章节索引。包含高等数学、数学分析、工科数分、线性代数、概率统计与大学物理全书章节导航。';

const sitemapData = collections.map(col => {
  return {
    ...col,
    books: col.books.map(book => {
      const catalog = buildBookCatalog(`src/content/docs/collections/${col.slug}/${book.slug}`);
      return {
        ...book,
        catalog,
      };
    }),
  };
});

let totalChapters = 0;
function countChapters(nodes: any[]): number {
  let count = 0;
  for (const node of nodes) {
    if (node.type === 'chapter') count++;
    if (node.children) count += countChapters(node.children);
  }
  return count;
}
sitemapData.forEach(col => {
  col.books.forEach(b => {
    totalChapters += countChapters(b.catalog);
  });
});
---

<!DOCTYPE html>
<html lang="zh-CN" data-site-theme="material-you">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={`${siteUrl}/sitemap/`} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${siteUrl}/sitemap/`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/astrolib-logo.png`} />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/astrolib-logo.png`} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <style>:root {
        --m3-bg: #fdfcff;
        --m3-surface: #ffffff;
        --m3-surface-container: #f0f4f9;
        --m3-on-surface: #1a1c1e;
        --m3-on-surface-variant: #43474e;
        --m3-outline: #c3c7cf;
        --m3-primary: #00639b;
        --m3-primary-container: #cce5ff;
        --m3-on-primary-container: #001d32;
      }
      :root[data-theme='dark'] {
        --m3-bg: #111318;
        --m3-surface: #1a1c1e;
        --m3-surface-container: #1e2024;
        --m3-on-surface: #e2e2e6;
        --m3-on-surface-variant: #c3c7cf;
        --m3-outline: #8d9199;
        --m3-primary: #91cdff;
        --m3-primary-container: #004b77;
        --m3-on-primary-container: #cce5ff;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
        background-color: var(--m3-bg);
        color: var(--m3-on-surface);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .sitemap-container {
        max-width: 960px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
      }

      .sitemap-header {
        margin-bottom: 2.5rem;
        border-bottom: 1px solid var(--m3-outline);
        padding-bottom: 1.5rem;
      }
      .sitemap-title {
        font-size: 2rem;
        font-weight: 700;
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
      }
      .sitemap-meta {
        font-size: 0.95rem;
        color: var(--m3-on-surface-variant);
        margin: 0;
      }

      .sitemap-collection {
        margin-bottom: 3rem;
      }
      .collection-heading {
        font-size: 1.4rem;
        font-weight: 600;
        margin: 0 0 1rem;
        padding-left: 0.5rem;
        border-left: 4px solid var(--m3-primary);
      }

      .book-block {
        background-color: var(--m3-surface);
        border: 1px solid var(--m3-outline);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
      }
      .book-title {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0 0 0.5rem;
        color: var(--m3-primary);
      }
      .book-desc {
        font-size: 0.875rem;
        color: var(--m3-on-surface-variant);
        margin: 0 0 1rem;
      }

      .chapter-list {
        list-style: none;
        padding-left: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 0.5rem 1rem;
      }
      .chapter-item a {
        display: inline-block;
        font-size: 0.875rem;
        color: var(--m3-on-surface);
        text-decoration: none;
        padding: 0.25rem 0.4rem;
        border-radius: 6px;
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .chapter-item a:hover {
        background-color: var(--m3-surface-container);
        color: var(--m3-primary);
        text-decoration: underline;
      }
      .chapter-group-title {
        grid-column: 1 / -1;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--m3-on-surface-variant);
        margin-top: 0.75rem;
        padding-top: 0.5rem;
        border-top: 1px dashed var(--m3-outline);
      }
</style>
  </head>
  <body>
    <VpNav />

    <main class="sitemap-container">
      <header class="sitemap-header">
        <h1 class="sitemap-title">网站地图 (Sitemap)</h1>
        <p class="sitemap-meta">
          AstroLib 全站共收录 <strong>{collections.length}</strong> 大学科合集、
          <strong>{collections.reduce((acc, c) => acc + c.books.length, 0)}</strong> 部精品教材、
          <strong>{totalChapters}</strong> 个数字化核心章节。
        </p>
      </header>

      {sitemapData.map(col => (
        <section class="sitemap-collection">
          <h2 class="collection-heading">{col.title} ({col.books.length} 部教材)</h2>

          {col.books.map(book => (
            <article class="book-block">
              <h3 class="book-title">《{book.title}》</h3>
              {book.description && <p class="book-desc">{book.description}</p>}

              <ul class="chapter-list">
                {book.catalog.map((item: any) => {
                  if (item.type === 'chapter') {
                    return (
                      <li class="chapter-item">
                        <a href={`/${item.slug}/`}>{item.title}</a>
                      </li>
                    );
                  }
                  if (item.type === 'group' && item.children) {
                    return (
                      <>
                        <li class="chapter-group-title">{item.title}</li>
                        {item.children.map((subItem: any) => (
                          <li class="chapter-item">
                            <a href={`/${subItem.slug}/`}>{subItem.title}</a>
                          </li>
                        ))}
                      </>
                    );
                  }
                  return null;
                })}
              </ul>
            </article>
          ))}
        </section>
      ))}
    </main>

    <VpFooter />
    <Analytics />
  </body>
</html>
