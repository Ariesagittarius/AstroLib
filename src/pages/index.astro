---
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/noto-serif-sc';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/tokens/layers.css';
import '../themes/material-you/tokens.css';
import '../styles/fonts.css';

import VpNav from '../components/VpNav.astro';
import Analytics from '../components/Analytics.astro';
import { collections, getAllBooks } from '../config/collections.config.mjs';
import { features } from '../config/features.config.mjs';
import { cleanSlug } from '../utils/slug.mjs';

const siteUrl = (features.seo?.config?.siteUrl || 'https://astrolib.cloud').replace(/\/$/, '');
const siteTitle = 'AstroLib · 理工科数学与物理教材数字化平台';
const pageDescription = features.seo?.config?.defaultDescription || 'AstroLib 是面向高校师生与自学者的大学理工科教材与学术资料数字化阅读与自测系统。提供高清数学排版、推导过程、离线 EPUB 与配套习题检索。收录数学分析、高等代数、工科数学分析、概率论与数理统计、大学物理等经典教材。';
const pageKeywords = 'AstroLib, 数学分析, 工科数学分析, 线性代数, 概率论与数理统计, 大学物理, 数学教材, 高等数学, 考研数学, 教材电子书, 教材真题';

const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'AstroLib',
      alternateName: 'AstroLib 数学与物理教材数字化阅读系统',
      description: pageDescription,
      inLanguage: 'zh-CN',
    },
    {
      '@type': 'EducationalOrganization',
      '@id': `${siteUrl}/#organization`,
      name: 'AstroLib',
      url: `${siteUrl}/`,
      logo: `${siteUrl}/astrolib-logo.png`,
      sameAs: [
        'https://github.com/Ariesagittarius/AstroLib',
      ],
    },
  ],
};

const allBooks = getAllBooks().map(book => ({
  ...book,
  readUrl: `/collections/${book.collectionSlug}/${book.slug}/${cleanSlug(book.entryPoint)}/`,
}));

// 按学科分类组织教材
const collectionsWithBooks = collections.map(col => ({
  ...col,
  books: col.books.map(book => ({
    ...book,
    readUrl: `/collections/${col.slug}/${book.slug}/${cleanSlug(book.entryPoint)}/`,
  })),
}));

// 快捷学科分类 Chips (Google Play 交互范式：初始均未选中)
const disciplineChips = [
  { id: 'math', label: '数学', query: 'math', type: 'collection' },
  { id: 'physics', label: '物理', query: 'science', type: 'collection' },
  { id: 'math-analysis', label: '数学分析', query: '数学分析', type: 'keyword' },
  { id: 'engineering-analysis', label: '工科分析', query: '工科数学分析', type: 'keyword' },
  { id: 'linear-algebra', label: '线性代数', query: '线性代数', type: 'keyword' },
  { id: 'probability-statistics', label: '概率统计', query: '概率论', type: 'keyword' },
];
---

<!DOCTYPE html>
<html lang="zh-CN" data-site-theme="material-you">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <link rel="canonical" href={`${siteUrl}/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/astrolib-logo.png`} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/astrolib-logo.png`} />

    <!-- 站长工具验证（配置时注入） -->
    {features.seo?.config?.googleSiteVerification && (
      <meta name="google-site-verification" content={features.seo.config.googleSiteVerification} />
    )}
    {features.seo?.config?.bingSiteVerification && (
      <meta name="msvalidate.01" content={features.seo.config.bingSiteVerification} />
    )}

    <!-- Schema.org 结构化数据 (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- 首屏免闪烁即时初始化脚本 (Anti-Flicker Script) -->
    <script is:inline>
      (function () {
        try {
          var themeKey = 'starlight-site-theme';
          var theme = localStorage.getItem(themeKey);
          if (!theme || theme === 'vitepress' || theme === 'starlight') {
            theme = 'material-you';
          }
          document.documentElement.dataset.siteTheme = theme;

          var colorThemeKey = 'starlight-theme';
          var colorTheme = localStorage.getItem(colorThemeKey);
          if (colorTheme === 'dark' || colorTheme === 'light') {
            document.documentElement.dataset.theme = colorTheme;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.dataset.theme = 'dark';
          } else {
            document.documentElement.dataset.theme = 'light';
          }

          var fontKey = 'starlight-font';
          var rawFont = localStorage.getItem(fontKey);
          if (rawFont) {
            var parsed = JSON.parse(rawFont);
            if (parsed && typeof parsed === 'object') {
              if (parsed.latin) document.documentElement.dataset.fontLatin = parsed.latin;
              if (parsed.cjk) document.documentElement.dataset.fontCjk = parsed.cjk;
            }
          }
          var colorKey = 'starlight-m3-theme-color';
          var m3Color = localStorage.getItem(colorKey);
          if (m3Color) document.documentElement.dataset.m3ThemeColor = m3Color;

          var cachedCss = localStorage.getItem('astrolib_m3_cached_css');
          if (cachedCss && theme === 'material-you') {
            var styleEl = document.createElement('style');
            styleEl.id = 'm3-dynamic-color-theme';
            styleEl.textContent = cachedCss;
            document.head.appendChild(styleEl);
          }
        } catch (e) {}
      })();
    </script>

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: var(--md-font-google-sans, 'Google Sans', 'Google Sans Text', 'Noto Sans SC', system-ui, sans-serif);
        background-color: var(--md-sys-color-background, #ffffff);
        color: var(--md-sys-color-on-background, #1f1f1f);
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        overflow-x: hidden;
        transition: background-color 0.2s ease, color 0.2s ease;
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      .m3-container {
        max-width: 1040px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* ==========================================================================
         Hero Section — Google Chrome / Material You Quiet STEM Header
         ========================================================================== */
      .m3-hero-wrapper {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid var(--md-sys-color-outline-variant, #e0e3e7);
        background-color: var(--md-sys-color-surface, #ffffff);
        transition: background-color 0.2s ease, border-color 0.2s ease;
      }
      :global([data-theme='dark']) .m3-hero-wrapper {
        background-color: var(--md-sys-color-surface, #1e1f20);
        border-bottom-color: var(--md-sys-color-outline-variant, #3c4043);
      }

      /* Subtle Mathematical Watermark */
      .math-watermark-plane {
        position: absolute;
        inset: 0;
        pointer-events: none;
        user-select: none;
        overflow: hidden;
        z-index: var(--layer-base, 0);
      }
      .math-watermark-svg {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        min-width: 960px;
        color: var(--md-sys-color-on-surface, #1f1f1f);
        opacity: 0.025;
        transform: translate3d(0, 0, 0);
      }
      :global([data-theme='dark']) .math-watermark-svg {
        color: var(--md-sys-color-on-surface, #e3e3e3);
        opacity: 0.035;
      }

      .m3-hero {
        position: relative;
        z-index: 1;
        padding: 3.25rem 0 2.75rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .m3-hero-header {
        margin-bottom: 1.5rem;
      }
      .m3-hero-brand-line {
        display: flex;
        align-items: baseline;
        gap: 0.85rem;
        flex-wrap: wrap;
      }
      .m3-hero-title {
        font-family: var(--md-sys-typescale-title-large-font, 'Google Sans', 'Plus Jakarta Sans', system-ui, sans-serif);
        font-size: clamp(2rem, 4.5vw, 2.75rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.1;
        margin: 0;
        color: var(--md-sys-color-on-surface, #1f1f1f);
      }
      :global([data-theme='dark']) .m3-hero-title {
        color: var(--md-sys-color-on-surface, #e3e3e3);
      }
      .m3-hero-subtitle {
        font-family: var(--font-sans, system-ui, sans-serif);
        font-size: clamp(0.95rem, 1.8vw, 1.125rem);
        font-weight: 400;
        color: var(--md-sys-color-on-surface-variant, #444746);
      }
      :global([data-theme='dark']) .m3-hero-subtitle {
        color: var(--md-sys-color-on-surface-variant, #c4c7c5);
      }

      /* Google Chrome Omnibox / Google Search Field */
      .m3-hero-search {
        width: 100%;
        max-width: 680px;
        margin-bottom: 1.25rem;
      }
      .m3-search-form {
        display: flex;
        align-items: center;
        height: 52px;
        border: 1px solid var(--md-sys-color-outline-variant, #e0e3e7);
        border-radius: var(--md-shape-corner-full, 9999px);
        background-color: var(--md-sys-color-surface-container-high, #e8eaed);
        padding: 0 0.5rem 0 1.25rem;
        transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
      }
      :global([data-theme='dark']) .m3-search-form {
        background-color: var(--md-sys-color-surface-container-high, #28292a);
        border-color: var(--md-sys-color-outline-variant, #3c4043);
      }
      .m3-search-form:hover {
        background-color: var(--md-sys-color-surface-container-highest, #dadce0);
        box-shadow: var(--md-elevation-level-1, 0 1px 3px rgba(60, 64, 67, 0.1));
      }
      :global([data-theme='dark']) .m3-search-form:hover {
        background-color: var(--md-sys-color-surface-container-highest, #333537);
      }
      .m3-search-form:focus-within {
        border-color: var(--md-sys-color-primary, #0b57d0);
        background-color: var(--md-sys-color-surface, #ffffff);
        box-shadow: 0 0 0 3px var(--md-sys-color-primary-container, #d3e3fd);
      }
      :global([data-theme='dark']) .m3-search-form:focus-within {
        background-color: var(--md-sys-color-surface-container-lowest, #0b0c0d);
        border-color: var(--md-sys-color-primary, #a8c7fa);
        box-shadow: 0 0 0 3px var(--md-sys-color-primary-container, #0842a0);
      }

      .m3-search-icon {
        width: 20px;
        height: 20px;
        color: var(--md-sys-color-on-surface-variant, #444746);
        margin-right: 0.75rem;
        flex-shrink: 0;
      }
      :global([data-theme='dark']) .m3-search-icon {
        color: var(--md-sys-color-on-surface-variant, #c4c7c5);
      }
      .m3-search-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.95rem;
        color: var(--md-sys-color-on-surface, #1f1f1f);
        font-family: inherit;
        padding: 0.5rem 0;
      }
      :global([data-theme='dark']) .m3-search-input {
        color: var(--md-sys-color-on-surface, #e3e3e3);
      }
      .m3-search-input::placeholder {
        color: var(--md-sys-color-outline, #72777d);
      }
      :global([data-theme='dark']) .m3-search-input::placeholder {
        color: var(--md-sys-color-outline, #8e918f);
      }

      /* Clear button */
      .m3-search-clear {
        display: none;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border: none;
        background: transparent;
        color: var(--md-sys-color-on-surface-variant, #444746);
        border-radius: var(--md-shape-corner-full, 9999px);
        cursor: pointer;
        padding: 0;
        margin-right: 0.25rem;
        transition: background-color 0.15s ease;
      }
      .m3-search-clear:hover {
        background-color: var(--md-sys-color-surface-container-highest, #dadce0);
      }
      .m3-search-clear.is-visible {
        display: inline-flex;
      }

      .m3-search-submit {
        background-color: var(--md-sys-color-primary, #0b57d0);
        color: var(--md-sys-color-on-primary, #ffffff);
        border: none;
        border-radius: var(--md-shape-corner-full, 9999px);
        padding: 0.45rem 1.15rem;
        font-size: 0.875rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: background-color 0.15s ease, box-shadow 0.15s ease;
        flex-shrink: 0;
      }
      :global([data-theme='dark']) .m3-search-submit {
        background-color: var(--md-sys-color-primary, #a8c7fa);
        color: var(--md-sys-color-on-primary, #062e6f);
      }
      .m3-search-submit:hover {
        box-shadow: var(--md-elevation-level-1, 0 1px 2px rgba(60, 64, 67, 0.1));
        filter: brightness(0.95);
      }

      /* Discipline Filter Chips (Google Play Archetype) */
      .m3-chip-set {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .m3-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        height: 32px;
        padding: 0 0.85rem;
        border-radius: var(--md-shape-corner-small, 8px);
        border: 1px solid var(--md-sys-color-outline-variant, #e0e3e7);
        background-color: transparent;
        color: var(--md-sys-color-on-surface-variant, #444746);
        font-size: 0.8125rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        user-select: none;
      }
      :global([data-theme='dark']) .m3-filter-chip {
        border-color: var(--md-sys-color-outline-variant, #3c4043);
        color: var(--md-sys-color-on-surface-variant, #c4c7c5);
      }
      .m3-filter-chip:hover {
        background-color: var(--md-sys-color-surface-container-high, #e8eaed);
        color: var(--md-sys-color-on-surface, #1f1f1f);
      }
      :global([data-theme='dark']) .m3-filter-chip:hover {
        background-color: var(--md-sys-color-surface-container-high, #28292a);
        color: var(--md-sys-color-on-surface, #e3e3e3);
      }
      .m3-filter-chip.is-selected {
        background-color: var(--md-sys-color-secondary-container, #c2e7ff);
        color: var(--md-sys-color-on-secondary-container, #001d35);
        border-color: transparent;
        font-weight: 600;
      }
      :global([data-theme='dark']) .m3-filter-chip.is-selected {
        background-color: var(--md-sys-color-secondary-container, #004a77);
        color: var(--md-sys-color-on-secondary-container, #c2e7ff);
        border-color: transparent;
      }
      .m3-chip-check {
        display: none;
        width: 14px;
        height: 14px;
      }
      .m3-filter-chip.is-selected .m3-chip-check {
        display: inline-block;
      }

      /* ==========================================================================
         Recent Reading — M3 Filled Tonal Card
         ========================================================================== */
      .recent-reading-wrapper {
        padding: 1.25rem 0 0;
      }
      .recent-reading-card {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 0.85rem 1.25rem;
        border-radius: var(--md-shape-corner-large, 16px);
        background-color: var(--md-sys-color-surface-container-low, #f8f9fa);
        border: none;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        transition: background-color 0.2s ease;
      }
      :global([data-theme='dark']) .recent-reading-card {
        background-color: var(--md-sys-color-surface-container-low, #18191a);
      }
      .recent-reading-card:hover {
        background-color: var(--md-sys-color-surface-container, #f0f2f5);
      }
      :global([data-theme='dark']) .recent-reading-card:hover {
        background-color: var(--md-sys-color-surface-container, #1e1f20);
      }

      .recent-reading-left {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.85rem;
        color: var(--md-sys-color-on-surface-variant, #444746);
        min-width: 0;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      }
      :global([data-theme='dark']) .recent-reading-left {
        color: var(--md-sys-color-on-surface-variant, #c4c7c5);
      }
      .recent-reading-icon {
        width: 20px;
        height: 20px;
        color: var(--md-sys-color-primary, #0b57d0);
        flex-shrink: 0;
      }
      :global([data-theme='dark']) .recent-reading-icon {
        color: var(--md-sys-color-primary, #a8c7fa);
      }
      .recent-reading-label {
        color: var(--md-sys-color-outline, #72777d);
        font-weight: 500;
        white-space: nowrap;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      }
      :global([data-theme='dark']) .recent-reading-label {
        color: var(--md-sys-color-outline, #8e918f);
      }
      .recent-reading-book {
        font-weight: 600;
        color: var(--md-sys-color-on-surface, #1f1f1f);
        white-space: nowrap;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      }
      :global([data-theme='dark']) .recent-reading-book {
        color: var(--md-sys-color-on-surface, #e3e3e3);
      }
      .recent-reading-sep {
        opacity: 0.4;
      }
      .recent-reading-chapter {
        color: var(--md-sys-color-on-surface-variant, #444746);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      }
      :global([data-theme='dark']) .recent-reading-chapter {
        color: var(--md-sys-color-on-surface-variant, #c4c7c5);
      }
      .recent-reading-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.35rem 0.85rem;
        border-radius: var(--md-shape-corner-full, 9999px);
        background-color: var(--md-sys-color-surface-container-high, #e8eaed);
        color: var(--md-sys-color-primary, #0b57d0);
        font-size: 0.8125rem;
        font-weight: 600;
        white-space: nowrap;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        transition: background-color 0.15s ease;
      }
      :global([data-theme='dark']) .recent-reading-cta {
        background-color: var(--md-sys-color-surface-container-high, #28292a);
        color: var(--md-sys-color-primary, #a8c7fa);
      }
      .recent-reading-cta:hover {
        background-color: var(--md-sys-color-surface-container-highest, #dadce0);
        transform: none !important;
      }
      :global([data-theme='dark']) .recent-reading-cta:hover {
        background-color: var(--md-sys-color-surface-container-highest, #333537);
        transform: none !important;
      }

      /* ==========================================================================
         Book Results Section — Material You Filled Tonal Cards (整卡可点击)
         ========================================================================== */
      .book-results-section {
        padding: 2.25rem 0 4.5rem;
        transition: opacity 0.25s ease;
      }
      .m3-book-list {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      /* Material You Filled Tonal Card (整卡可点击，无悬停位移动效，思源黑体，支持 Ripple) */
      .m3-book-card {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: flex-start;
        gap: 1.35rem;
        padding: 1.25rem 1.5rem;
        border-radius: var(--md-shape-corner-large, 16px);
        background-color: var(--md-sys-color-surface-container-low, #f8f9fa);
        border: none;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        transform: none !important;
        box-shadow: none !important;
        transition: background-color 0.15s ease;
      }
      :global([data-theme='dark']) .m3-book-card {
        background-color: var(--md-sys-color-surface-container-low, #18191a);
      }
      .m3-book-card:hover {
        background-color: var(--md-sys-color-surface-container, #f0f2f5);
        transform: none !important;
        box-shadow: none !important;
      }
      :global([data-theme='dark']) .m3-book-card:hover {
        background-color: var(--md-sys-color-surface-container, #222325);
        transform: none !important;
        box-shadow: none !important;
      }

      /* Material Ripple 基础层 */
      md-ripple {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        --md-ripple-hover-opacity: 0.04;
        --md-ripple-pressed-opacity: 0.12;
        --md-ripple-pressed-color: var(--md-sys-color-primary, #0b57d0);
      }
      :global([data-theme='dark']) md-ripple {
        --md-ripple-pressed-color: var(--md-sys-color-primary, #a8c7fa);
      }

      /* Book Cover Thumbnail */
      .m3-book-cover-col {
        flex-shrink: 0;
      }
      .m3-book-cover-wrap {
        width: 56px;
        height: 78px;
        border-radius: var(--md-shape-corner-small, 8px);
        overflow: hidden;
        border: 1px solid var(--md-sys-color-outline-variant, #e0e3e7);
        background-color: var(--md-sys-color-surface-container, #f0f2f5);
        box-shadow: var(--md-elevation-level-1, 0 1px 3px rgba(60, 64, 67, 0.1));
        display: flex;
        align-items: center;
        justify-content: center;
      }
      :global([data-theme='dark']) .m3-book-cover-wrap {
        border-color: var(--md-sys-color-outline-variant, #3c4043);
        background-color: var(--md-sys-color-surface-container, #1e1f20);
      }
      .m3-book-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* Metadata & Content (统一使用思源黑体) */
      .m3-book-main-col {
        flex: 1;
        min-width: 0;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .m3-book-title {
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.35;
        margin: 0 0 0.35rem;
        color: var(--md-sys-color-on-surface, #1f1f1f);
        transition: color 0.15s ease;
      }
      :global([data-theme='dark']) .m3-book-title {
        color: var(--md-sys-color-on-surface, #e3e3e3);
      }
      .m3-book-card:hover .m3-book-title {
        color: var(--md-sys-color-primary, #0b57d0);
      }
      :global([data-theme='dark']) .m3-book-card:hover .m3-book-title {
        color: var(--md-sys-color-primary, #a8c7fa);
      }

      /* Metadata Chip Group (使用主题色与官方 md-assist-chip) */
      .m3-book-chip-set {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0.35rem 0 0.6rem;
        pointer-events: none;
        --md-assist-chip-container-shape: var(--md-shape-corner-small, 8px);
        --md-assist-chip-container-color: var(--md-sys-color-secondary-container, #c2e7ff);
        --md-assist-chip-label-text-color: var(--md-sys-color-on-secondary-container, #001d35);
        --md-assist-chip-outline-color: transparent;
        --md-assist-chip-outline-width: 0px;
        --md-assist-chip-container-height: 26px;
        --md-assist-chip-label-text-size: 0.775rem;
        --md-assist-chip-label-text-weight: 500;
        --md-assist-chip-label-text-font: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', sans-serif;
      }
      :global([data-theme='dark']) .m3-book-chip-set {
        --md-assist-chip-container-color: var(--md-sys-color-secondary-container, #004a77);
        --md-assist-chip-label-text-color: var(--md-sys-color-on-secondary-container, #c2e7ff);
      }

      /* Fallback and styling before hydration */
      md-assist-chip:not(:defined) {
        display: inline-flex;
        align-items: center;
        height: 26px;
        padding: 0 0.65rem;
        border-radius: var(--md-shape-corner-small, 8px);
        background-color: var(--md-sys-color-secondary-container, #c2e7ff);
        color: var(--md-sys-color-on-secondary-container, #001d35);
        font-size: 0.775rem;
        font-weight: 500;
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', sans-serif;
        border: none;
        box-sizing: border-box;
      }
      :global([data-theme='dark']) md-assist-chip:not(:defined) {
        background-color: var(--md-sys-color-secondary-container, #004a77);
        color: var(--md-sys-color-on-secondary-container, #c2e7ff);
      }
      md-assist-chip:defined .m3-chip-fallback {
        display: none;
      }

      .m3-book-desc {
        font-family: 'Noto Sans SC Variable', 'Noto Sans SC', 'Source Han Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--md-sys-color-on-surface-variant, #444746);
        margin: 0;
      }
      :global([data-theme='dark']) .m3-book-desc {
        color: var(--md-sys-color-on-surface-variant, #c4c7c5);
      }

      /* Catalogue Empty State */
      .catalogue-empty {
        padding: 3.5rem 1.5rem;
        text-align: center;
        font-size: 0.95rem;
        color: var(--md-sys-color-on-surface-variant, #444746);
        border: 1px dashed var(--md-sys-color-outline-variant, #e0e3e7);
        border-radius: var(--md-shape-corner-large, 16px);
        background-color: var(--md-sys-color-surface-container-low, #f8f9fa);
        margin-top: 1.5rem;
      }
      :global([data-theme='dark']) .catalogue-empty {
        background-color: var(--md-sys-color-surface-container-low, #18191a);
        border-color: var(--md-sys-color-outline-variant, #3c4043);
        color: var(--md-sys-color-on-surface-variant, #c4c7c5);
      }
      .empty-icon {
        width: 40px;
        height: 40px;
        color: var(--md-sys-color-outline, #72777d);
        margin-bottom: 0.75rem;
      }
      :global([data-theme='dark']) .empty-icon {
        color: var(--md-sys-color-outline, #8e918f);
      }
      .catalogue-empty-btn {
        display: inline-flex;
        align-items: center;
        margin-top: 0.75rem;
        padding: 0.4rem 1.15rem;
        border-radius: var(--md-shape-corner-full, 9999px);
        background-color: var(--md-sys-color-primary, #0b57d0);
        color: var(--md-sys-color-on-primary, #ffffff);
        font-size: 0.85rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
      }
      :global([data-theme='dark']) .catalogue-empty-btn {
        background-color: var(--md-sys-color-primary, #a8c7fa);
        color: var(--md-sys-color-on-primary, #062e6f);
      }

      /* ==========================================================================
         Footer — Material You Clean Minimal Footer (无分割线、纯净单行)
         ========================================================================== */
      .site-footer {
        padding: 2.5rem 0;
        background-color: var(--md-sys-color-surface, #ffffff);
        font-size: 0.8125rem;
        color: var(--md-sys-color-outline, #72777d);
        border: none;
        transition: background-color 0.2s ease;
      }
      :global([data-theme='dark']) .site-footer {
        background-color: var(--md-sys-color-surface-container-low, #131314);
        border: none;
        color: var(--md-sys-color-outline, #8e918f);
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding-bottom: 0;
        border: none;
      }
      :global([data-theme='dark']) .footer-inner {
        border: none;
      }
      .footer-brand {
        font-family: var(--md-sys-typescale-title-medium-font, 'Google Sans', sans-serif);
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--md-sys-color-on-surface, #1f1f1f);
      }
      :global([data-theme='dark']) .footer-brand {
        color: var(--md-sys-color-on-surface, #e3e3e3);
      }
      .footer-links {
        display: flex;
        gap: 1.5rem;
      }
      .footer-links a {
        color: var(--md-sys-color-on-surface-variant, #444746);
        transition: color 0.15s ease;
      }
      :global([data-theme='dark']) .footer-links a {
        color: var(--md-sys-color-on-surface-variant, #c4c7c5);
      }
      .footer-links a:hover {
        color: var(--md-sys-color-primary, #0b57d0);
      }
      :global([data-theme='dark']) .footer-links a:hover {
        color: var(--md-sys-color-primary, #a8c7fa);
      }

      /* ==========================================================================
         Responsive Breakpoints
         ========================================================================== */
      @media (max-width: 680px) {
        .m3-hero {
          padding: 2.25rem 0 2rem;
        }
        .m3-search-form {
          height: 48px;
          padding: 0 0.35rem 0 1rem;
        }
        .m3-search-submit {
          padding: 0.4rem 0.9rem;
          font-size: 0.8125rem;
        }
        .book-results-section {
          padding: 1.75rem 0 3.5rem;
        }
        .m3-book-card {
          gap: 0.85rem;
          padding: 1rem 1rem;
        }
        .m3-book-cover-wrap {
          width: 46px;
          height: 66px;
        }
        .footer-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.75rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Navigation Bar (Chrome Top App Bar) -->
    <VpNav currentPath="/" />

    <!-- Hero Section -->
    <section class="m3-hero-wrapper">
      <!-- Watermark Background -->
      <div class="math-watermark-plane" aria-hidden="true">
        <svg class="math-watermark-svg" viewBox="0 0 1200 600" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 6">
            <line x1="100" y1="0" x2="100" y2="600" />
            <line x1="300" y1="0" x2="300" y2="600" />
            <line x1="500" y1="0" x2="500" y2="600" />
            <line x1="700" y1="0" x2="700" y2="600" />
            <line x1="900" y1="0" x2="900" y2="600" />
            <line x1="1100" y1="0" x2="1100" y2="600" />
            <line x1="0" y1="120" x2="1200" y2="120" />
            <line x1="0" y1="280" x2="1200" y2="280" />
            <line x1="0" y1="440" x2="1200" y2="440" />
          </g>
          <g stroke="currentColor" stroke-width="1" stroke-linecap="round">
            <path d="M620 480C700 480 750 470 780 410C810 350 830 200 860 200C890 200 910 350 940 410C970 470 1020 480 1100 480" stroke-width="1.2" />
            <path d="M750 300A180 180 0 0 1 930 120A120 120 0 0 1 1050 240A80 80 0 0 1 970 320" stroke-dasharray="4 4" />
            <circle cx="950" cy="380" r="90" stroke-width="0.8" />
            <line x1="950" y1="290" x2="1080" y2="290" stroke-width="1.2" />
            <line x1="950" y1="380" x2="1013" y2="316" stroke-width="1" />
          </g>
          <g fill="currentColor" font-family="KaTeX_Main, Georgia, 'Times New Roman', serif" font-size="28" font-style="italic">
            <text x="680" y="100" font-size="44" font-style="normal">∫</text>
            <text x="705" y="90" font-size="16">∞</text>
            <text x="698" y="125" font-size="14">-∞</text>
            <text x="730" y="100">e<tspan dy="-10" font-size="18">-x²</tspan><tspan dy="10"> dx = √π</tspan></text>
            <text x="820" y="270" font-size="36" font-style="normal">∑</text>
            <text x="825" y="245" font-size="14">n=1</text>
            <text x="830" y="295" font-size="16">∞</text>
            <text x="865" y="270">1/nˢ</text>
            <text x="620" y="220" font-size="22">lim <tspan font-size="14" dy="8">x→0</tspan><tspan dy="-8"> (sin x)/x = 1</tspan></text>
            <text x="960" y="170" font-size="24">∇ × B = μ₀J + μ₀ε₀(∂E/∂t)</text>
            <text x="720" y="380" font-size="22">ds² = g<tspan dy="6" font-size="14">μν</tspan><tspan dy="-6"> dx</tspan><tspan dy="-6" font-size="14">μ</tspan><tspan dy="6"> dx</tspan><tspan dy="-6" font-size="14">ν</tspan></text>
            <text x="560" y="340" font-size="32" font-style="normal">ℝⁿ</text>
            <text x="640" y="440" font-size="26">∂Ω</text>
            <text x="840" y="520" font-size="22">∀ε &gt; 0, ∃δ &gt; 0</text>
          </g>
        </svg>
      </div>

      <div class="m3-container">
        <div class="m3-hero">
          <div class="m3-hero-header">
            <div class="m3-hero-brand-line">
              <h1 class="m3-hero-title">AstroLib</h1>
              <span class="m3-hero-subtitle">数学与物理教材</span>
            </div>
          </div>

          <!-- Google Omnibox Search Input -->
          <div class="m3-hero-search">
            <form action="/library/" method="GET" class="m3-search-form" id="search-form" role="search">
              <svg class="m3-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
              <input
                type="text"
                name="q"
                id="homepage-search-input"
                class="m3-search-input"
                placeholder="搜索书名、作者、ISBN 或章节……"
                autocomplete="off"
                aria-label="搜索书名、作者、ISBN 或章节"
              />
              <button type="button" class="m3-search-clear" id="homepage-search-clear" aria-label="清空搜索词" title="清空">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
              <button type="submit" class="m3-search-submit">搜索</button>
            </form>
          </div>

          <!-- Discipline Filter Chips (Google Play Archetype: 仅在点击时展示) -->
          <div class="m3-chip-set" id="discipline-chip-set" role="toolbar" aria-label="学科分类筛选">
            {disciplineChips.map((chip) => (
              <button
                type="button"
                class="m3-filter-chip"
                data-discipline-id={chip.id}
                data-type={chip.type}
                data-query={chip.query}
                role="button"
                aria-pressed="false"
              >
                <svg class="m3-chip-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{chip.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Reading (M3 Filled Tonal Card - Client-side populated) -->
    <section id="recent-reading-section" class="recent-reading-wrapper" style="display: none;">
      <div class="m3-container">
        <div class="recent-reading-card">
          <md-ripple></md-ripple>
          <div class="recent-reading-left">
            <svg class="recent-reading-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            <span class="recent-reading-label">最近阅读：</span>
            <span class="recent-reading-book" id="recent-reading-book"></span>
            <span class="recent-reading-sep" aria-hidden="true">·</span>
            <span class="recent-reading-chapter" id="recent-reading-chapter"></span>
          </div>
          <a id="recent-reading-link" href="#" class="recent-reading-cta">继续阅读 →</a>
        </div>
      </div>
    </section>

    <!-- Main Content: Book Results (按需呈现：默认隐藏，仅在 Chip 选中或搜索时展示) -->
    <main class="m3-container">
      <section class="book-results-section" id="book-results-section" style="display: none;">
        <!-- Book Cards Stack (Material You Filled Tonal Cards) -->
        <div class="m3-book-list" id="book-list">
          {collectionsWithBooks.map(col =>
            col.books.map(book => (
              <a
                href={book.readUrl}
                class="m3-book-card"
                id={`book-${book.id}`}
                data-collection-id={col.id}
                data-search-text={`${book.title} ${book.author} ${book.publisher} ${book.edition || ''} ${book.isbn || ''} ${book.description} ${col.title}`.toLowerCase()}
              >
                <md-ripple></md-ripple>
                <!-- Left: Cover Thumbnail -->
                <div class="m3-book-cover-col">
                  <div class="m3-book-cover-wrap">
                    <img src={book.cover} alt={book.title} class="m3-book-cover-img" loading="lazy" />
                  </div>
                </div>

                <!-- Right: Title, Citation Meta Chips & Abstract (无标签、无开始阅读字样，整卡可点) -->
                <div class="m3-book-main-col">
                  <h3 class="m3-book-title">{book.title}</h3>

                  <md-chip-set class="m3-book-chip-set" role="list" aria-label="教材元数据">
                    <md-assist-chip label={book.author}>
                      <span class="m3-chip-fallback">{book.author}</span>
                    </md-assist-chip>
                    <md-assist-chip label={`${book.publisher}${book.edition ? ` (${book.edition})` : ''}`}>
                      <span class="m3-chip-fallback">{book.publisher}{book.edition ? ` (${book.edition})` : ''}</span>
                    </md-assist-chip>
                    {book.isbn && (
                      <md-assist-chip label={`ISBN ${book.isbn}`}>
                        <span class="m3-chip-fallback">ISBN {book.isbn}</span>
                      </md-assist-chip>
                    )}
                  </md-chip-set>

                  <p class="m3-book-desc">{book.description}</p>
                </div>
              </a>
            ))
          )}
        </div>

        <!-- Empty Match State -->
        <div id="catalogue-empty" class="catalogue-empty" style="display: none;">
          <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <p style="margin: 0 0 0.4rem; font-weight: 500; font-size: 1rem;">未找到匹配教材</p>
          <p style="margin: 0 0 0.85rem; font-size: 0.85rem; color: var(--md-sys-color-outline, #72777d);">
            可尝试简化关键词，或进入完整检索页进行多维度筛选。
          </p>
          <button type="button" class="catalogue-empty-btn" id="catalogue-reset-btn">
            重置筛选条件
          </button>
        </div>
      </section>
    </main>

    <!-- Footer (无分割线、纯净单行) -->
    <footer class="site-footer">
      <div class="m3-container">
        <div class="footer-inner">
          <div class="footer-brand">
            <span>AstroLib</span>
          </div>

          <div class="footer-links">
            <a href="/library/">目录</a>
            <a href="/library/?focus=search">搜索</a>
            <a href="/sitemap/">网站地图</a>
            <a href="/dev/">开发文档</a>
            <a href="https://github.com/Ariesagittarius/AstroLib" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- 全局视窗挂载容器 (Overlay Root for Modals / Settings) -->
    <div id="astro-overlay-root"></div>

    <!-- Client-Side Recent Reading & Real-Time Catalogue Filter -->
    <script is:inline>
      (() => {
        // 1. 读取并渲染最近阅读记录
        try {
          const raw = localStorage.getItem('astrolib_recent_reading');
          if (raw) {
            const data = JSON.parse(raw);
            if (data && data.url && data.chapterTitle) {
              const sec = document.getElementById('recent-reading-section');
              const bookEl = document.getElementById('recent-reading-book');
              const chapterEl = document.getElementById('recent-reading-chapter');
              const linkEl = document.getElementById('recent-reading-link');

              if (sec && chapterEl && linkEl) {
                if (bookEl) {
                  const slugNames = {
                    'math_senior': '新高考数学',
                    'math_analysis': '数学分析',
                    'engineering_analysis': '工科数学分析基础',
                    'linear_algebra': '线性代数及其应用',
                    'probability_statistics': '概率论与数理统计教程',
                    'university_physics': '大学物理学'
                  };
                  bookEl.textContent = slugNames[data.bookSlug] || data.bookTitle || '章节';
                }
                chapterEl.textContent = data.chapterTitle;
                linkEl.href = data.url;
                sec.style.display = 'block';
              }
            }
          }
        } catch {}

        // 2. 首页 Filter Chip 驱动式教材展示与实时搜索
        const searchInput = document.getElementById('homepage-search-input');
        const clearBtn = document.getElementById('homepage-search-clear');
        const resultsSection = document.getElementById('book-results-section');
        const emptyBox = document.getElementById('catalogue-empty');
        const resetBtn = document.getElementById('catalogue-reset-btn');
        const cards = Array.from(document.querySelectorAll('.m3-book-card'));
        const chips = Array.from(document.querySelectorAll('.m3-filter-chip'));

        let activeChipId = null;

        function updateDisplay() {
          const query = (searchInput?.value || '').trim().toLowerCase();

          // 切换 Clear 按钮可见性
          if (clearBtn) {
            clearBtn.classList.toggle('is-visible', query.length > 0);
          }

          // 核心逻辑：仅在 chip 选中或者搜索框中有内容时，才展现书籍容器
          if (!activeChipId && !query) {
            if (resultsSection) resultsSection.style.display = 'none';
            return;
          }

          if (resultsSection) resultsSection.style.display = 'block';

          let matchCount = 0;
          const activeChip = chips.find(c => c.getAttribute('data-discipline-id') === activeChipId);
          const chipType = activeChip?.getAttribute('data-type');
          const chipQuery = activeChip?.getAttribute('data-query')?.toLowerCase() || '';

          cards.forEach(card => {
            const text = card.getAttribute('data-search-text') || '';
            const colId = card.getAttribute('data-collection-id') || '';

            let matches = true;

            // Chip 过滤
            if (activeChipId) {
              if (chipType === 'collection') {
                matches = colId === chipQuery;
              } else if (chipType === 'keyword') {
                matches = text.includes(chipQuery);
              }
            }

            // 搜索输入过滤
            if (matches && query) {
              matches = text.includes(query);
            }

            card.style.display = matches ? 'flex' : 'none';
            if (matches) matchCount++;
          });

          if (emptyBox) {
            emptyBox.style.display = matchCount === 0 ? 'block' : 'none';
          }
        }

        // 绑定搜索输入
        if (searchInput) {
          searchInput.addEventListener('input', () => {
            updateDisplay();
          });
        }

        // 绑定清空按钮
        if (clearBtn && searchInput) {
          clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            searchInput.focus();
            updateDisplay();
          });
        }

        // 绑定 Chip 点击 (点击已激活的 Chip 则取消选中并重新收起列表)
        chips.forEach(chip => {
          chip.addEventListener('click', () => {
            const id = chip.getAttribute('data-discipline-id');
            if (activeChipId === id) {
              // 反选取消
              activeChipId = null;
              chip.classList.remove('is-selected');
              chip.setAttribute('aria-pressed', 'false');
            } else {
              // 选中新 chip
              activeChipId = id;
              chips.forEach(c => {
                const isTarget = c === chip;
                c.classList.toggle('is-selected', isTarget);
                c.setAttribute('aria-pressed', isTarget ? 'true' : 'false');
              });
            }
            updateDisplay();
          });
        });

        // 绑定空状态重置按钮
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            activeChipId = null;
            chips.forEach(c => {
              c.classList.remove('is-selected');
              c.setAttribute('aria-pressed', 'false');
            });
            updateDisplay();
          });
        }
      })();
    </script>

    <!-- 异步载入 Material You 运行时组件及 Web Components -->
    <script>
      import '@material/web/chips/chip-set.js';
      import '@material/web/chips/assist-chip.js';
      import '@material/web/ripple/ripple.js';

      import('../themes/material-you/index')
        .then((m) => {
          m.initMaterialYouTheme?.();
          m.initColorEngine?.();
        })
        .catch(() => {});
    </script>

    <Analytics />
  </body>
</html>


