---
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/noto-serif-sc';
import '@fontsource-variable/plus-jakarta-sans';
import VpNav from '../components/VpNav.astro';
import Analytics from '../components/Analytics.astro';
import { collections, getAllBooks } from '../config/collections.config.mjs';
import { cleanSlug } from '../utils/sidebar.mjs';

const allBooks = getAllBooks().map(book => ({
  ...book,
  readUrl: `/collections/${book.collectionSlug}/${book.slug}/${cleanSlug(book.entryPoint)}/`,
}));

const totalBooks = allBooks.length;
const totalCollections = collections.length;

// 按学科分类组织教材
const collectionsWithBooks = collections.map(col => ({
  ...col,
  books: col.books.map(book => ({
    ...book,
    readUrl: `/collections/${col.slug}/${book.slug}/${cleanSlug(book.entryPoint)}/`,
  })),
}));
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AstroLib · 数学与物理教材</title>
    <meta name="description" content="AstroLib：收录大学与中学数学、物理教材，支持 LaTeX 公式排版与章节检索。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --font-sans: 'Noto Sans SC Variable', 'Noto Sans SC', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-serif: 'Noto Serif SC Variable', 'Noto Serif SC', 'Songti SC', 'Source Han Serif SC', STSong, Georgia, serif;
        --font-brand: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, sans-serif;
        --font-math: 'KaTeX_Main', Georgia, 'Times New Roman', serif;

        /* Light Theme */
        --vp-c-bg: #fafafa;
        --vp-c-bg-alt: #f4f4f5;
        --vp-c-bg-soft: #f0f0f2;
        --vp-c-bg-elv: #ffffff;
        --vp-c-divider: #e4e4e7;
        --vp-c-border: #e4e4e7;
        --vp-c-text-1: #18181b;
        --vp-c-text-2: #52525b;
        --vp-c-text-3: #71717a;
        --vp-c-brand-1: #3451b2;
        --vp-c-brand-2: #284094;
        --vp-c-brand-soft: rgba(52, 81, 178, 0.08);

        /* Mathematical Watermark Tone */
        --math-watermark-color: #27272a;
        --math-watermark-opacity: 0.02;
      }

      :root[data-theme='dark'] {
        /* Dark Theme */
        --vp-c-bg: #121214;
        --vp-c-bg-alt: #18181b;
        --vp-c-bg-soft: #1a1a1e;
        --vp-c-bg-elv: #202024;
        --vp-c-divider: rgba(255, 255, 255, 0.08);
        --vp-c-border: rgba(255, 255, 255, 0.09);
        --vp-c-text-1: #ececed;
        --vp-c-text-2: #a1a1aa;
        --vp-c-text-3: #71717a;
        --vp-c-brand-1: #818cf8;
        --vp-c-brand-2: #6366f1;
        --vp-c-brand-soft: rgba(129, 140, 248, 0.12);

        /* Subtle Mathematical Watermark Tone */
        --math-watermark-color: #e4e4e7;
        --math-watermark-opacity: 0.03;
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background-color: var(--vp-c-bg);
        color: var(--vp-c-text-1);
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        overflow-x: hidden;
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      .vp-container {
        max-width: 1040px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* ==========================================================================
         Hero Section — Quiet STEM Header
         ========================================================================== */
      .vp-hero-wrapper {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid var(--vp-c-divider);
        background-color: var(--vp-c-bg);
      }

      .math-watermark-plane {
        position: absolute;
        inset: 0;
        pointer-events: none;
        user-select: none;
        overflow: hidden;
        z-index: 0;
      }
      .math-watermark-svg {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        min-width: 960px;
        color: var(--math-watermark-color);
        opacity: var(--math-watermark-opacity);
        transform: translate3d(0, 0, 0);
      }

      .vp-hero {
        position: relative;
        z-index: 1;
        padding: 2.75rem 0 2.25rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .vp-hero-header {
        margin-bottom: 1.35rem;
      }
      .vp-hero-brand-line {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      }
      .vp-hero-title {
        font-family: var(--font-brand);
        font-size: clamp(1.85rem, 4vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.1;
        margin: 0;
        color: var(--vp-c-text-1);
      }
      .vp-hero-subtitle {
        font-family: var(--font-sans);
        font-size: clamp(0.95rem, 1.8vw, 1.125rem);
        font-weight: 400;
        color: var(--vp-c-text-3);
      }

      /* Search Bar */
      .vp-hero-search {
        width: 100%;
        max-width: 680px;
        margin-bottom: 0.9rem;
      }
      .vp-search-form {
        display: flex;
        align-items: center;
        border: 1px solid var(--vp-c-border);
        border-radius: 4px;
        background-color: var(--vp-c-bg-soft);
        padding: 0.35rem 0.5rem 0.35rem 0.75rem;
        transition: border-color 0.15s, background-color 0.15s;
      }
      .vp-search-form:focus-within {
        border-color: var(--vp-c-brand-1);
        background-color: var(--vp-c-bg);
      }
      .vp-search-icon {
        width: 1rem;
        height: 1rem;
        color: var(--vp-c-text-3);
        margin-right: 0.5rem;
        flex-shrink: 0;
      }
      .vp-search-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.9rem;
        color: var(--vp-c-text-1);
        font-family: inherit;
        padding: 0.2rem 0;
      }
      .vp-search-input::placeholder {
        color: var(--vp-c-text-3);
      }
      .vp-search-submit {
        background: transparent;
        color: var(--vp-c-text-2);
        border: 1px solid var(--vp-c-border);
        border-radius: 3px;
        padding: 0.2rem 0.55rem;
        font-size: 0.775rem;
        font-family: inherit;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
      }
      .vp-search-submit:hover {
        color: var(--vp-c-brand-1);
        border-color: var(--vp-c-brand-1);
      }

      /* Discipline Navigation */
      .vp-discipline-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.45rem;
        font-size: 0.825rem;
        color: var(--vp-c-text-3);
      }
      .vp-discipline-link {
        color: var(--vp-c-text-2);
        transition: color 0.15s;
      }
      .vp-discipline-link:hover {
        color: var(--vp-c-brand-1);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .vp-discipline-dot {
        opacity: 0.35;
      }

      /* ==========================================================================
         Recent Reading — Simple Banner
         ========================================================================== */
      .recent-reading-wrapper {
        border-bottom: 1px solid var(--vp-c-divider);
        background-color: var(--vp-c-bg-alt);
        padding: 0.65rem 0;
        font-size: 0.825rem;
      }
      .recent-reading-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .recent-reading-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--vp-c-text-2);
        min-width: 0;
      }
      .recent-reading-label {
        font-weight: 500;
        color: var(--vp-c-text-3);
      }
      .recent-reading-book {
        font-weight: 500;
        color: var(--vp-c-text-1);
      }
      .recent-reading-chapter {
        color: var(--vp-c-text-2);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .recent-reading-sep {
        opacity: 0.35;
      }
      .recent-reading-cta {
        color: var(--vp-c-brand-1);
        font-weight: 500;
        white-space: nowrap;
      }
      .recent-reading-cta:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* ==========================================================================
         Catalogue Section
         ========================================================================== */
      .catalogue-section {
        padding: 2.75rem 0 4.5rem;
      }
      .catalogue-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid var(--vp-c-divider);
        margin-bottom: 2rem;
      }
      .catalogue-title {
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 0;
        color: var(--vp-c-text-1);
      }
      .search-filter-status {
        font-size: 0.8rem;
        color: var(--vp-c-brand-1);
      }

      /* Collection Groups */
      .collection-group {
        margin-bottom: 2.75rem;
      }
      .collection-header {
        margin-bottom: 0.5rem;
      }
      .collection-title {
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0;
        color: var(--vp-c-text-2);
        letter-spacing: 0.02em;
      }

      /* Bibliographic Entries List */
      .biblio-list {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--vp-c-divider);
      }

      .biblio-entry {
        display: flex;
        align-items: flex-start;
        gap: 1.15rem;
        padding: 1.15rem 0;
        border-bottom: 1px solid var(--vp-c-divider);
      }

      /* Small Cover Thumbnail */
      .biblio-cover-col {
        flex-shrink: 0;
      }
      .biblio-cover-wrap {
        width: 50px;
        height: 70px;
        border-radius: 2px;
        overflow: hidden;
        border: 1px solid var(--vp-c-border);
        background-color: var(--vp-c-bg-soft);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .biblio-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* Metadata & Content */
      .biblio-main-col {
        flex: 1;
        min-width: 0;
      }
      .biblio-headline {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.25rem;
        flex-wrap: wrap;
      }
      .biblio-title {
        font-family: var(--font-serif);
        font-size: 1.075rem;
        font-weight: 600;
        line-height: 1.35;
        margin: 0;
        color: var(--vp-c-text-1);
      }
      .biblio-title a {
        color: inherit;
        transition: color 0.15s;
      }
      .biblio-title a:hover {
        color: var(--vp-c-brand-1);
      }

      .biblio-tags {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.725rem;
        color: var(--vp-c-text-3);
      }
      .biblio-tag {
        border: 1px solid var(--vp-c-border);
        border-radius: 2px;
        padding: 0.05rem 0.3rem;
        background-color: var(--vp-c-bg-soft);
      }

      /* Citation Meta Line */
      .biblio-meta-line {
        font-size: 0.8rem;
        color: var(--vp-c-text-3);
        margin-bottom: 0.4rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
      }
      .biblio-meta-sep {
        opacity: 0.4;
      }

      .biblio-desc {
        font-size: 0.835rem;
        line-height: 1.55;
        color: var(--vp-c-text-2);
        margin: 0 0 0.5rem;
      }

      /* Reading Action Link */
      .biblio-action-row {
        display: flex;
        align-items: center;
      }
      .biblio-read-link {
        font-size: 0.825rem;
        color: var(--vp-c-brand-1);
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
      }
      .biblio-read-link:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* Catalogue Empty State */
      .catalogue-empty {
        padding: 2.5rem 1.5rem;
        text-align: center;
        font-size: 0.875rem;
        color: var(--vp-c-text-3);
        border: 1px dashed var(--vp-c-divider);
        border-radius: 3px;
        background-color: var(--vp-c-bg-alt);
        margin-top: 1rem;
      }
      .catalogue-empty a {
        color: var(--vp-c-brand-1);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* ==========================================================================
         Footer
         ========================================================================== */
      .site-footer {
        padding: 2.5rem 0 2rem;
        background-color: var(--vp-c-bg);
        font-size: 0.8rem;
        color: var(--vp-c-text-3);
        border-top: 1px solid var(--vp-c-divider);
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--vp-c-divider);
      }
      .footer-brand {
        font-weight: 600;
        color: var(--vp-c-text-1);
      }
      .footer-links {
        display: flex;
        gap: 1.25rem;
      }
      .footer-links a {
        color: var(--vp-c-text-2);
        transition: color 0.15s;
      }
      .footer-links a:hover {
        color: var(--vp-c-brand-1);
      }
      .footer-bottom {
        padding-top: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      /* ==========================================================================
         Responsive Breakpoints
         ========================================================================== */
      @media (max-width: 680px) {
        .vp-hero {
          padding: 2rem 0 1.75rem;
        }
        .catalogue-section {
          padding: 2rem 0 3rem;
        }
        .biblio-entry {
          gap: 0.85rem;
          padding: 1rem 0;
        }
        .biblio-cover-wrap {
          width: 44px;
          height: 62px;
        }
        .footer-inner, .footer-bottom {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.75rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Navigation Bar -->
    <VpNav currentPath="/" />

    <!-- Hero Section -->
    <section class="vp-hero-wrapper">
      <!-- Watermark Background -->
      <div class="math-watermark-plane" aria-hidden="true">
        <svg class="math-watermark-svg" viewBox="0 0 1200 600" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 6">
            <line x1="100" y1="0" x2="100" y2="600" />
            <line x1="300" y1="0" x2="300" y2="600" />
            <line x1="500" y1="0" x2="500" y2="600" />
            <line x1="700" y1="0" x2="700" y2="600" />
            <line x1="900" y1="0" x2="900" y2="600" />
            <line x1="1100" y1="0" x2="1100" y2="600" />
            <line x1="0" y1="120" x2="1200" y2="120" />
            <line x1="0" y1="280" x2="1200" y2="280" />
            <line x1="0" y1="440" x2="1200" y2="440" />
          </g>
          <g stroke="currentColor" stroke-width="1" stroke-linecap="round">
            <path d="M620 480C700 480 750 470 780 410C810 350 830 200 860 200C890 200 910 350 940 410C970 470 1020 480 1100 480" stroke-width="1.2" />
            <path d="M750 300A180 180 0 0 1 930 120A120 120 0 0 1 1050 240A80 80 0 0 1 970 320" stroke-dasharray="4 4" />
            <circle cx="950" cy="380" r="90" stroke-width="0.8" />
            <line x1="950" y1="290" x2="1080" y2="290" stroke-width="1.2" />
            <line x1="950" y1="380" x2="1013" y2="316" stroke-width="1" />
          </g>
          <g fill="currentColor" font-family="KaTeX_Main, Georgia, 'Times New Roman', serif" font-size="28" font-style="italic">
            <text x="680" y="100" font-size="44" font-style="normal">∫</text>
            <text x="705" y="90" font-size="16">∞</text>
            <text x="698" y="125" font-size="14">-∞</text>
            <text x="730" y="100">e<tspan dy="-10" font-size="18">-x²</tspan><tspan dy="10"> dx = √π</tspan></text>
            <text x="820" y="270" font-size="36" font-style="normal">∑</text>
            <text x="825" y="245" font-size="14">n=1</text>
            <text x="830" y="295" font-size="16">∞</text>
            <text x="865" y="270">1/nˢ</text>
            <text x="620" y="220" font-size="22">lim <tspan font-size="14" dy="8">x→0</tspan><tspan dy="-8"> (sin x)/x = 1</tspan></text>
            <text x="960" y="170" font-size="24">∇ × B = μ₀J + μ₀ε₀(∂E/∂t)</text>
            <text x="720" y="380" font-size="22">ds² = g<tspan dy="6" font-size="14">μν</tspan><tspan dy="-6"> dx</tspan><tspan dy="-6" font-size="14">μ</tspan><tspan dy="6"> dx</tspan><tspan dy="-6" font-size="14">ν</tspan></text>
            <text x="560" y="340" font-size="32" font-style="normal">ℝⁿ</text>
            <text x="640" y="440" font-size="26">∂Ω</text>
            <text x="840" y="520" font-size="22">∀ε &gt; 0, ∃δ &gt; 0</text>
          </g>
        </svg>
      </div>

      <div class="vp-container">
        <div class="vp-hero">
          <div class="vp-hero-header">
            <div class="vp-hero-brand-line">
              <h1 class="vp-hero-title">AstroLib</h1>
              <span class="vp-hero-subtitle">数学与物理教材</span>
            </div>
          </div>

          <!-- Search Input -->
          <div class="vp-hero-search">
            <form action="/library/" method="GET" class="vp-search-form" id="search-form">
              <svg class="vp-search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="8.5" cy="8.5" r="5.5" />
                <path d="M12.5 12.5L17 17" stroke-linecap="round" />
              </svg>
              <input
                type="text"
                name="q"
                id="homepage-search-input"
                class="vp-search-input"
                placeholder="搜索书名、作者、ISBN 或章节……"
                autocomplete="off"
              />
              <button type="submit" class="vp-search-submit">搜索</button>
            </form>
          </div>

          <!-- Quick Navigation Links -->
          <nav class="vp-discipline-nav" aria-label="分类导航">
            <a href="#collection-math" class="vp-discipline-link">数学</a>
            <span class="vp-discipline-dot">·</span>
            <a href="#collection-science" class="vp-discipline-link">物理</a>
            <span class="vp-discipline-dot">·</span>
            <a href="#book-math-analysis" class="vp-discipline-link">数学分析</a>
            <span class="vp-discipline-dot">·</span>
            <a href="#book-engineering-analysis" class="vp-discipline-link">工科分析</a>
            <span class="vp-discipline-dot">·</span>
            <a href="#book-linear-algebra" class="vp-discipline-link">线性代数</a>
            <span class="vp-discipline-dot">·</span>
            <a href="#book-probability-statistics" class="vp-discipline-link">概率统计</a>
          </nav>
        </div>
      </div>
    </section>

    <!-- Recent Reading (Client-side populated) -->
    <section id="recent-reading-section" class="recent-reading-wrapper" style="display: none;">
      <div class="vp-container">
        <div class="recent-reading-bar">
          <div class="recent-reading-left">
            <span class="recent-reading-label">最近阅读：</span>
            <span class="recent-reading-book" id="recent-reading-book"></span>
            <span class="recent-reading-sep" aria-hidden="true">·</span>
            <span class="recent-reading-chapter" id="recent-reading-chapter"></span>
          </div>
          <a id="recent-reading-link" href="#" class="recent-reading-cta">继续阅读 →</a>
        </div>
      </div>
    </section>

    <!-- Main Content: Catalogue -->
    <main class="vp-container">
      <section class="catalogue-section">
        <!-- Section Header -->
        <header class="catalogue-header">
          <h2 class="catalogue-title">教材目录</h2>
          <div id="search-filter-status" class="search-filter-status" aria-live="polite"></div>
        </header>

        <!-- Catalogue Entries Grouped by Discipline -->
        <div id="catalogue-groups">
          {collectionsWithBooks.map(col => (
            <div class="collection-group" id={`collection-${col.id}`} data-collection-id={col.id}>
              <div class="collection-header">
                <h3 class="collection-title">{col.title}</h3>
              </div>

              <div class="biblio-list">
                {col.books.map(book => (
                  <article
                    class="biblio-entry"
                    id={`book-${book.id}`}
                    data-search-text={`${book.title} ${book.author} ${book.publisher} ${book.edition || ''} ${book.isbn || ''} ${book.description} ${(book.tags || []).join(' ')}`.toLowerCase()}
                  >
                    <!-- Left: Cover Thumbnail -->
                    <div class="biblio-cover-col">
                      <div class="biblio-cover-wrap">
                        <img src={book.cover} alt={book.title} class="biblio-cover-img" loading="lazy" />
                      </div>
                    </div>

                    <!-- Right: Bibliographic Citation and Abstract -->
                    <div class="biblio-main-col">
                      <div class="biblio-headline">
                        <h4 class="biblio-title">
                          <a href={book.readUrl}>{book.title}</a>
                        </h4>
                        <div class="biblio-tags">
                          <span class="biblio-tag">{book.stageLabel}</span>
                          <span class="biblio-tag">{book.categoryLabel}</span>
                        </div>
                      </div>

                      <div class="biblio-meta-line">
                        <span>{book.author}</span>
                        <span class="biblio-meta-sep">·</span>
                        <span>{book.publisher} {book.edition ? `(${book.edition})` : ''}</span>
                        {book.isbn && (
                          <>
                            <span class="biblio-meta-sep">·</span>
                            <span>ISBN {book.isbn}</span>
                          </>
                        )}
                      </div>

                      <p class="biblio-desc">{book.description}</p>

                      <div class="biblio-action-row">
                        <a href={book.readUrl} class="biblio-read-link">
                          阅读 →
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Empty Match State -->
        <div id="catalogue-empty" class="catalogue-empty" style="display: none;">
          <p style="margin: 0 0 0.35rem;">未找到匹配教材。</p>
          <p style="margin: 0; font-size: 0.825rem;">
            可尝试简化关键词，或按回车进入 <a id="catalogue-empty-link" href="/library/">检索页</a>。
          </p>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="vp-container">
        <div class="footer-inner">
          <div class="footer-brand">
            <span>AstroLib</span>
          </div>

          <div class="footer-links">
            <a href="/library/">目录</a>
            <a href="/library/?focus=search">搜索</a>
            <a href="/dev/">开发文档</a>
            <a href="https://github.com/withastro/starlight" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>

        <div class="footer-bottom">
          <span>数学与物理教材数字化整理</span>
          <span>© {new Date().getFullYear()} AstroLib</span>
        </div>
      </div>
    </footer>

    <!-- Client-Side Recent Reading & Real-Time Catalogue Filter -->
    <script is:inline>
      (() => {
        // 1. 读取并渲染最近阅读记录
        try {
          const raw = localStorage.getItem('astrolib_recent_reading');
          if (raw) {
            const data = JSON.parse(raw);
            if (data && data.url && data.chapterTitle) {
              const sec = document.getElementById('recent-reading-section');
              const bookEl = document.getElementById('recent-reading-book');
              const chapterEl = document.getElementById('recent-reading-chapter');
              const linkEl = document.getElementById('recent-reading-link');

              if (sec && chapterEl && linkEl) {
                if (bookEl) {
                  const slugNames = {
                    'math_senior': '新高考数学',
                    'math_analysis': '数学分析',
                    'engineering_analysis': '工科数学分析基础',
                    'linear_algebra': '线性代数及其应用',
                    'probability_statistics': '概率论与数理统计教程',
                    'university_physics': '大学物理学'
                  };
                  bookEl.textContent = slugNames[data.bookSlug] || '章节';
                }
                chapterEl.textContent = data.chapterTitle;
                linkEl.href = data.url;
                sec.style.display = 'block';
              }
            }
          }
        } catch {}

        // 2. 首页目录即时过滤交互
        const searchInput = document.getElementById('homepage-search-input');
        const filterStatus = document.getElementById('search-filter-status');
        const emptyBox = document.getElementById('catalogue-empty');
        const emptyLink = document.getElementById('catalogue-empty-link');
        const entries = Array.from(document.querySelectorAll('.biblio-entry'));
        const groups = Array.from(document.querySelectorAll('.collection-group'));

        if (searchInput && entries.length > 0) {
          searchInput.addEventListener('input', () => {
            const query = (searchInput.value || '').trim().toLowerCase();

            if (!query) {
              entries.forEach(el => { el.style.display = ''; });
              groups.forEach(g => { g.style.display = ''; });
              if (filterStatus) filterStatus.textContent = '';
              if (emptyBox) emptyBox.style.display = 'none';
              return;
            }

            let matchCount = 0;
            entries.forEach(el => {
              const text = el.getAttribute('data-search-text') || '';
              const matched = text.includes(query);
              el.style.display = matched ? '' : 'none';
              if (matched) matchCount++;
            });

            groups.forEach(g => {
              const visibleEntries = g.querySelectorAll('.biblio-entry:not([style*="display: none"])');
              g.style.display = visibleEntries.length > 0 ? '' : 'none';
            });

            if (filterStatus) {
              filterStatus.textContent = matchCount > 0 ? `找到 ${matchCount} 本教材` : '';
            }

            if (emptyBox) {
              emptyBox.style.display = matchCount === 0 ? 'block' : 'none';
              if (emptyLink) {
                emptyLink.href = `/library/?q=${encodeURIComponent(query)}`;
              }
            }
          });
        }
      })();
    </script>

    <Analytics />
  </body>
</html>
