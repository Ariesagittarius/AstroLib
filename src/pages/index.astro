---
import '@fontsource-variable/plus-jakarta-sans';
import VpNav from '../components/VpNav.astro';
import { LoremIpsum } from 'lorem-ipsum';

const lorem = new LoremIpsum({
  sentencesPerParagraph: { max: 4, min: 2 },
  wordsPerSentence: { max: 12, min: 4 }
});
const content = lorem.generateParagraphs(2);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AstroLib · 数理文献数字化整理与检索系统</title>
    <meta name="description" content="AstroLib 数理文献数字化整理与检索系统，收录初高中及大学本科理科（数学、物理）核心教材与文献，提供规范化 LaTeX 公式排版与章节检索。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --font-brand: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --vp-c-bg: #ffffff;
        --vp-c-bg-alt: #f6f6f7;
        --vp-c-bg-soft: #f6f6f7;
        --vp-c-bg-elv: #ffffff;
        --vp-c-divider: #e2e2e3;
        --vp-c-text-1: #3c3c43;
        --vp-c-text-2: #67676c;
        --vp-c-text-3: #929295;
        --vp-c-brand-1: #3451b2;
        --vp-c-brand-2: #3a5ccc;
        --vp-c-brand-3: #5672cd;
        --vp-c-brand-soft: rgba(100, 108, 255, 0.14);
        --vp-shadow-1: 0 1px 2px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.06);
        --vp-shadow-2: 0 3px 12px rgba(0, 0, 0, 0.07), 0 1px 4px rgba(0, 0, 0, 0.07);
      }
      :root[data-theme='dark'] {
        --vp-c-bg: #1b1b1f;
        --vp-c-bg-alt: #161618;
        --vp-c-bg-soft: #202127;
        --vp-c-bg-elv: #202127;
        --vp-c-divider: #2e2e32;
        --vp-c-text-1: #dfdfd6;
        --vp-c-text-2: #98989f;
        --vp-c-text-3: #6a6a71;
        --vp-c-brand-1: #a8b1ff;
        --vp-c-brand-2: #5c73e7;
        --vp-c-brand-3: #3e63dd;
        --vp-c-brand-soft: rgba(100, 108, 255, 0.16);
        --vp-shadow-1: 0 1px 2px rgba(0, 0, 0, 0.2), 0 1px 2px rgba(0, 0, 0, 0.24);
        --vp-shadow-2: 0 3px 12px rgba(0, 0, 0, 0.28), 0 1px 4px rgba(0, 0, 0, 0.24);
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
          'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC Variable', sans-serif;
        background-color: var(--vp-c-bg);
        color: var(--vp-c-text-1);
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      .vp-container {
        max-width: 1152px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Hero */
      .vp-hero {
        padding: 5rem 0 4rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .vp-hero-clip-title {
        font-family: var(--font-brand);
        font-size: clamp(2.4rem, 6vw, 4.25rem);
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1.12;
        margin: 0 0 0.5rem;
        background: linear-gradient(120deg, #bd34fe 30%, #41d1ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
        text-rendering: optimizeLegibility;
      }

      .vp-hero-subtitle {
        font-size: clamp(1.4rem, 3.2vw, 2.1rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: 1.25;
        color: var(--vp-c-text-1);
        margin: 0 0 1.25rem;
      }

      .vp-hero-tagline {
        margin: 0 0 2rem;
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--vp-c-text-2);
        max-width: 720px;
      }

      /* Action Buttons */
      .vp-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-bottom: 2rem;
      }

      .vp-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 1.25rem;
        height: 2.5rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1;
        transition: color 0.25s, border-color 0.25s, background-color 0.25s, transform 0.15s;
        cursor: pointer;
        user-select: none;
      }
      .vp-btn:hover {
        transform: translateY(-1px);
      }

      .vp-btn-brand {
        background-color: var(--vp-c-brand-1);
        border: 1px solid var(--vp-c-brand-1);
        color: #ffffff;
      }
      .vp-btn-brand:hover {
        background-color: var(--vp-c-brand-2);
        border-color: var(--vp-c-brand-2);
        color: #ffffff;
      }

      .vp-btn-alt {
        background-color: var(--vp-c-bg-soft);
        border: 1px solid var(--vp-c-divider);
        color: var(--vp-c-text-1);
      }
      .vp-btn-alt:hover {
        background-color: var(--vp-c-bg-alt);
        border-color: var(--vp-c-brand-1);
        color: var(--vp-c-brand-1);
      }

      /* Search Box */
      .vp-hero-search {
        width: 100%;
        max-width: 620px;
      }
      .vp-search-form {
        display: flex;
        align-items: center;
        border: 1px solid var(--vp-c-divider);
        border-radius: 8px;
        background-color: var(--vp-c-bg-soft);
        padding: 0.35rem 0.35rem 0.35rem 0.85rem;
        transition: border-color 0.25s, background-color 0.25s, box-shadow 0.25s;
      }
      .vp-search-form:focus-within {
        border-color: var(--vp-c-brand-1);
        background-color: var(--vp-c-bg);
        box-shadow: 0 0 0 3px var(--vp-c-brand-soft);
      }
      .vp-search-icon {
        width: 1.1rem;
        height: 1.1rem;
        color: var(--vp-c-text-3);
        margin-right: 0.65rem;
        flex-shrink: 0;
      }
      .vp-search-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.9rem;
        color: var(--vp-c-text-1);
        font-family: inherit;
      }
      .vp-search-input::placeholder {
        color: var(--vp-c-text-3);
      }
      .vp-search-submit {
        background-color: var(--vp-c-brand-1);
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 0.5rem 1.1rem;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
      }
      .vp-search-submit:hover {
        background-color: var(--vp-c-brand-2);
      }

      @media (max-width: 640px) {
        .vp-hero {
          padding: 3rem 0 2rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Nav -->
    <VpNav currentPath="/" />

    <main class="vp-container">
      <section class="vp-hero">
        <h1 class="vp-hero-clip-title">AstroLib</h1>
        <div class="vp-hero-subtitle">
          <ruby>数理典籍 <rp>(</rp><rt>きゅうりしょ</rt><rp>)</rp></ruby>
          数字化整理与检索
        </div>
        <p class="vp-hero-tagline">
          {content}
        </p>

        <!-- Action Buttons -->
        <div class="vp-hero-actions">
          <a href="/library/" class="vp-btn vp-btn-brand">
            开始阅读 →
          </a>
          <a href="/dev/" class="vp-btn vp-btn-alt">
            Developer Docs
          </a>
        </div>

        <!-- Search Bar -->
        <div class="vp-hero-search">
          <form action="/library/" method="GET" class="vp-search-form">
            <svg class="vp-search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="8.5" cy="8.5" r="5.5" />
              <path d="M12.5 12.5L17 17" stroke-linecap="round" />
            </svg>
            <input
              type="text"
              name="q"
              class="vp-search-input"
              placeholder="书名、编著者、ISBN 或学科关键词..."
              autocomplete="off"
            />
            <button type="submit" class="vp-search-submit">检索</button>
          </form>
        </div>
      </section>
    </main>
  </body>
</html>
