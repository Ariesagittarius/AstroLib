---
import { collections } from '../config/collections.config.mjs';
import { cleanSlug } from '../utils/sidebar.mjs';
import fs from 'node:fs';

// 构建期探测该书是否有已生成的 EPUB 下载文件
function hasEpub(slug) {
  try {
    return fs.existsSync(`public/epub/${slug}.epub`);
  } catch {
    return false;
  }
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>教辅数字化智能智库</title>
    <style>
      /* ===== VitePress 色板（与内容页 vitepress-theme.css 保持一致） ===== */
      :root {
        --vp-bg: #ffffff;
        --vp-bg-alt: #f6f6f7;
        --vp-bg-soft: #f6f6f7;
        --vp-divider: #e2e2e3;
        --vp-text-1: #3c3c43;
        --vp-text-2: #67676c;
        --vp-text-3: #929295;
        --vp-brand-1: #3451b2;
        --vp-brand-2: #3a5ccc;
        --vp-brand-3: #5672cd;
        --vp-brand-soft: rgba(100, 108, 255, 0.14);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --vp-bg: #1b1b1f;
          --vp-bg-alt: #161618;
          --vp-bg-soft: #202127;
          --vp-divider: #2e2e32;
          --vp-text-1: #dfdfd6;
          --vp-text-2: #98989f;
          --vp-text-3: #6a6a71;
          --vp-brand-1: #a8b1ff;
          --vp-brand-2: #5c73e7;
          --vp-brand-3: #3e63dd;
          --vp-brand-soft: rgba(100, 108, 255, 0.16);
        }
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
          'Hiragino Sans GB', 'Microsoft YaHei', sans-serif, 'Apple Color Emoji',
          'Segoe UI Emoji';
        background-color: var(--vp-bg);
        color: var(--vp-text-1);
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        overflow-x: clip; /* 兜底：任何超宽元素不撑破手机视口 */
      }
      a {
        color: inherit;
      }

      /* ===== Hero（VitePress VPHomeHero 风格） ===== */
      .vp-home {
        max-width: 1152px;
        margin: 0 auto;
        padding: 0 24px 64px;
      }
      .vp-hero {
        text-align: center;
        padding: 88px 0 56px;
      }
      .hero-name {
        margin: 0;
        font-size: clamp(2.25rem, 6vw, 3.5rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.02em;
        background: linear-gradient(120deg, var(--vp-brand-1) 30%, #8a6ff0);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .hero-tagline {
        margin: 20px auto 0;
        max-width: 576px;
        font-size: 1.15rem;
        line-height: 1.75;
        color: var(--vp-text-2);
      }
      .hero-actions {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin-top: 36px;
        flex-wrap: wrap;
      }
      .vp-btn {
        display: inline-block;
        padding: 0 22px;
        line-height: 40px;
        font-size: 0.9rem;
        font-weight: 500;
        border-radius: 20px;
        text-decoration: none;
        transition: background-color 0.25s, color 0.25s, border-color 0.25s;
        white-space: nowrap;
      }
      .vp-btn.brand {
        background-color: var(--vp-brand-3);
        color: #ffffff;
      }
      .vp-btn.brand:hover {
        background-color: var(--vp-brand-2);
      }
      .vp-btn.alt {
        color: var(--vp-text-1);
        border: 1px solid var(--vp-divider);
        background-color: var(--vp-bg);
      }
      .vp-btn.alt:hover {
        border-color: var(--vp-text-3);
        color: var(--vp-brand-1);
      }
      @media (prefers-color-scheme: dark) {
        .vp-btn.brand {
          color: #1b1b1f; /* VitePress 暗色 brand 按钮反色文字 */
        }
      }

      /* ===== 合集板块 ===== */
      .collection-section {
        margin: 48px 0;
      }
      .collection-head {
        margin-bottom: 20px;
      }
      .collection-title {
        margin: 0 0 8px;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .collection-desc {
        margin: 0;
        color: var(--vp-text-2);
        font-size: 0.95rem;
      }

      /* ===== 图书卡片（VitePress VPFeature 风格） ===== */
      .grid {
        display: grid;
        /* min(300px, 100%) 防止极小屏（<300px 内容区）时网格被下限撑破 */
        grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
        gap: 20px;
      }
      .vp-feature {
        display: flex;
        flex-direction: column;
        background-color: var(--vp-bg-soft);
        border: 1px solid var(--vp-bg-soft);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color 0.25s, background-color 0.25s,
          transform 0.25s, box-shadow 0.25s;
      }
      .vp-feature:hover {
        border-color: var(--vp-divider);
        background-color: var(--vp-bg);
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      }
      .feature-main {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
      }
      .cover-img {
        width: 100%;
        height: 170px;
        background-size: cover;
        background-position: center;
      }
      .feature-body {
        padding: 20px 22px 14px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }
      .feature-title {
        margin: 0 0 8px;
        font-size: 1.05rem;
        font-weight: 600;
        line-height: 1.4;
      }
      .feature-desc {
        margin: 0;
        font-size: 0.875rem;
        line-height: 1.65;
        color: var(--vp-text-2);
        flex-grow: 1;
      }
      .feature-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 0 22px 18px;
        flex-wrap: wrap;
      }
      .feature-link {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--vp-brand-1);
        text-decoration: none;
      }
      .feature-link:hover {
        color: var(--vp-brand-2);
      }
      .feature-epub {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--vp-text-2);
        border: 1px solid var(--vp-divider);
        padding: 3px 12px;
        border-radius: 999px;
        text-decoration: none;
        transition: border-color 0.25s, color 0.25s;
      }
      .feature-epub:hover {
        border-color: var(--vp-brand-1);
        color: var(--vp-brand-1);
      }

      @media (max-width: 30rem) {
        .vp-hero {
          padding: 64px 0 40px;
        }
        .cover-img {
          height: 150px;
        }
      }
    </style>
  </head>
  <body>
    <div class="vp-home">
      <!-- Hero -->
      <div class="vp-hero">
        <h1 class="hero-name">教辅数字化智能智库</h1>
        <p class="hero-tagline">数学 · 物理教辅书籍数字化 · KaTeX 公式排版 · 卡片化知识分块 · 离线 EPUB 下载</p>
        <div class="hero-actions">
          <a class="vp-btn brand" href="#collections">开始阅读 →</a>
          <a class="vp-btn alt" href="#collections">浏览全部书目</a>
        </div>
      </div>

      <!-- 合集板块 -->
      <div id="collections">
        {collections.map(col => (
          <section class="collection-section">
            <div class="collection-head">
              <h2 class="collection-title">{col.title}</h2>
              <p class="collection-desc">{col.description}</p>
            </div>

            <div class="grid">
              {col.books.map(book => (
                <div class="vp-feature">
                  <a
                    href={`/collections/${col.slug}/${book.slug}/${cleanSlug(book.entryPoint)}/`}
                    class="feature-main"
                  >
                    <div class="cover-img" style={`background-image: url(${book.cover});`}></div>
                    <div class="feature-body">
                      <h3 class="feature-title">{book.title}</h3>
                      <p class="feature-desc">{book.description}</p>
                    </div>
                  </a>
                  <div class="feature-actions">
                    <a
                      href={`/collections/${col.slug}/${book.slug}/${cleanSlug(book.entryPoint)}/`}
                      class="feature-link"
                    >开始学习 →</a>
                    {hasEpub(book.slug) && (
                      <a href={`/epub/${book.slug}.epub`} class="feature-epub" download>⬇ 下载 EPUB</a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </body>
</html>
